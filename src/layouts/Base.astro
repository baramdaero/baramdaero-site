---
// 전 페이지 공통 레이아웃. 홈은 헤더를 투명(overlay) 변형으로 사용.
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Chatbot from '../components/Chatbot.astro';
import { SITE_CONFIG } from '../config.js';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 페이지 추가 JSON-LD (Article, BreadcrumbList 등) — 전역 HVACBusiness에 더해 렌더 */
  jsonLd?: object | object[];
  /** 홈 전용: 헤더를 영상 위 투명 오버레이로 */
  headerVariant?: 'overlay' | 'solid';
  ogImage?: string;
}
const {
  title,
  description = SITE_CONFIG.DESCRIPTION,
  jsonLd,
  headerVariant = 'solid',
  ogImage = SITE_CONFIG.OG_IMAGE,
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://baramdaero.com';
const pageTitle = title ? `${title} — ${SITE_CONFIG.SITE_NAME}` : SITE_CONFIG.HOME_TITLE;
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// 전역 JSON-LD — HVACBusiness (schema.org)
const businessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  name: SITE_CONFIG.SITE_NAME,
  // 브랜드(name)와 운영 법인을 잇는다 — 값은 푸터와 같은 config 의 BUSINESS (사업자등록증 기준)
  legalName: SITE_CONFIG.BUSINESS.NAME,
  taxID: SITE_CONFIG.BUSINESS.REG_NO,
  slogan: SITE_CONFIG.SLOGAN,
  url: siteUrl,
  image: `${siteUrl}${SITE_CONFIG.HERO_POSTER}`,
  areaServed: { '@type': 'AdministrativeArea', name: '수도권' },
  knowsAbout: ['에어컨 설치', '에어컨 세척', '에어컨 유지관리', '에어컨 AS'],
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '에어컨 설치', areaServed: '수도권' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '에어컨 세척·유지관리', areaServed: '수도권' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '에어컨 점검·AS', areaServed: '수도권' } },
  ],
};

const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" sizes="180x180" />
    <meta name="theme-color" content="#00293A" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {SITE_CONFIG.NAVER_SITE_VERIFICATION && (
      <meta name="naver-site-verification" content={SITE_CONFIG.NAVER_SITE_VERIFICATION} />
    )}
    {SITE_CONFIG.GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={SITE_CONFIG.GOOGLE_SITE_VERIFICATION} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* 화면 넘어갈 때 겹쳐 바뀌게 켜는 규칙 — 설명·길이는 global.css '화면 넘어갈 때'. 반드시 <head> 안에 인라인(is:inline)으로 둔다:
        따로 받는 CSS 파일에 두거나 <body> 안으로 내리면 크롬에서 전환이 조용히 빠진다
        (2026-11-12 빌드본 실측: 바깥 파일 0/6 · body 안 인라인 1/6 · head 인라인 6/6).
        모션 줄이기는 이 @media 가 막는다 — global.css 의 전역 0.01ms 규칙은 ::view-transition-* 에 닿지 않는다 */}
    <style is:inline>@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }</style>
    {/* 겹쳐 바뀌는 동안(--dur-ui)은 화면이 찍힌 그림이라 누름이 전부 <html> 로 간다(pointer-events 로는 안 풀린다) — 도착하자마자 누른 메뉴·링크가 먹통이 된다.
        그때 누르면 전환을 바로 끝내고 그 자리에 있는 것을 대신 누른다. pagereveal 은 body 끝 스크립트보다 먼저 지나가므로 여기 인라인으로 둔다 */}
    <script is:inline>
      addEventListener('pagereveal', function (e) {
        var vt = e.viewTransition;
        if (!vt) return;
        var ended = false, px = null, py = 0; // px · py: 겹치는 동안 누르기 시작한 자리
        var onDown = function (ev) {
          if (!ended) { px = ev.clientX; py = ev.clientY; return; }
          // 겹치는 동안 누르기 시작해 끝난 뒤에 뗀 누름도 <html> 로 온다 — 그래서 끝나자마자가 아니라, 끝난 뒤 새로 누르기 시작할 때 그만 듣는다
          removeEventListener('pointerdown', onDown, true);
          removeEventListener('click', onClick, true);
        };
        var onClick = function (ev) {
          if (!ev.isTrusted || ev.target !== document.documentElement) return;
          ev.stopPropagation(); // 대신 누른 것만 남긴다 — 이 누름이 '바깥 누름'으로 읽혀 방금 연 메뉴를 닫지 않게
          vt.skipTransition();
          if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return; // 새 탭으로 열기 같은 누름은 대신 누르지 않는다 — el.click() 은 보조키를 잃어 같은 탭에서 열린다
          var el = document.elementFromPoint(ev.clientX, ev.clientY);
          // 누르기 시작한 자리와 뗀 자리가 다르면 브라우저가 하듯 둘을 함께 감싼 것이 눌린다 — 끌다 뗀 것이 뗀 자리의 링크·단추를 누르지 않게
          var from = px === null ? el : document.elementFromPoint(px, py);
          while (from && !from.contains(el)) from = from.parentElement;
          el = from;
          while (el && typeof el.click !== 'function') el = el.parentElement; // SVG 안쪽(로고·아이콘)에는 click() 이 없다 — 누를 수 있는 조상까지 올라간다
          if (!el || el === document.documentElement) return;
          if (el.matches('input, textarea, select')) el.focus({ preventScroll: true }); // click() 은 초점을 옮기지 않는다 — 글 칸을 눌렀으면 바로 칠 수 있게(진짜 누름처럼 화면은 밀지 않는다)
          el.click();
        };
        addEventListener('pointerdown', onDown, true);
        addEventListener('click', onClick, true);
        var end = function () { ended = true; };
        vt.finished.then(end, end);
      });
    </script>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

    <script type="application/ld+json" set:html={JSON.stringify(businessJsonLd)} />
    {extraJsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body>
    {/* 앰비언트 배경 — 유리 표면 뒤에 비치는 레이어. 장식이라 aria-hidden */}
    <div class="br-ambient" aria-hidden="true"></div>
    <a href="#main" class="skip-link">본문 바로가기</a>
    <SiteHeader variant={headerVariant} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <Chatbot />
    <script>
      // 공용 모션 v2 — 리빌·카운트업 (no-JS 시 콘텐츠 전부 노출)
      import '../scripts/motion.ts';
      // 펼침 모션 — 모든 <details> 높이·내용이 부드럽게 (data-no-expand 제외)
      import '../scripts/expand.ts';
      // 누름·바람결 — 누를 수 있는 것은 전부 눌렸다 스프링으로 돌아온다. 누른 직후 새로 온 목록은 gust() 로 차례로 온다(DESIGN.md §4)
      import '../scripts/press.ts';
      // 엣지 글로우 — 유리 카드 전부(.br-glass) + [data-glow], data-glow="off" 제외. hover 기기 전용
      import '../scripts/border-glow.ts';
      // Specular 림 — [data-specular] 버튼(런처·CTA 밴드), hover 기기 전용
      import '../scripts/specular.ts';
    </script>
  </body>
</html>
