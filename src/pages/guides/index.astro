---
// 가이드 목록 — 질문형 콘텐츠. draft는 프로덕션에서 제외(로컬 개발에서만 표시).
// 홈·헤더에는 노출하지 않는다 (발행 글 생길 때 별도 판단).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const guides = (await getCollection('guides', ({ data }) => (import.meta.env.PROD ? !data.draft : true)))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ko'));

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '가이드', item: `${siteUrl}/guides/` },
  ],
};
---
<Base title="에어컨 가이드" description="설치·배관·세척에 대해 자주 받는 질문을 현장 기준으로 정리했습니다." jsonLd={breadcrumb}>
  <section class="bd-section guides">
    <div class="bd-container">
      <p class="bd-microlabel">Guides</p>
      <h1 class="bd-section-title">에어컨 가이드</h1>
      {guides.length === 0 && <p class="guides__empty">발행된 가이드가 아직 없습니다.</p>}
      <ul class="guides__list">
        {guides.map((g) => (
          <li>
            <a class="guides__item" href={`/guides/${g.id}/`}>
              <span class="guides__title">{g.data.title}</span>
              {g.data.draft && <span class="guides__draft">초안 — 로컬 전용</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .guides .bd-container { max-width: 760px; }
  .guides__empty { color: var(--ink-soft); }
  .guides__list { list-style: none; }
  .guides__item {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-weight: 600;
    font-size: 18px;
    transition: background-color var(--dur-color) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .guides__item:hover { background: var(--bg-soft); }
  }
  .guides__draft {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    color: var(--copper);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 3px 10px;
  }
</style>
