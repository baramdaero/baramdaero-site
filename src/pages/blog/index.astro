---
// 블로그 목록
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// sample: true 글은 형식 참고용 템플릿 — 프로덕션 미노출 (md에서 플래그를 지우면 자동 노출)
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.sample)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '블로그', item: `${siteUrl}/blog/` },
  ],
};
---
<Base title="블로그" description="에어컨 관리에 도움이 되는 글." jsonLd={breadcrumb}>
  <section class="bd-section blog">
    <div class="bd-container">
      <p class="bd-microlabel">Blog</p>
      <h1 class="bd-section-title">블로그</h1>
      {posts.length > 0 ? (
        <ul class="blog__list">
          {posts.map((post) => (
            <li>
              <a class="blog__item" href={`/blog/${post.id}/`}>
                <span class="blog__date">{post.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                <span class="blog__title">{post.data.title}</span>
                <span class="blog__desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="blog__pending">글을 준비 중입니다.</p>
      )}
    </div>
  </section>
</Base>

<style>
  .blog .bd-container { max-width: 760px; }
  .blog__pending { color: var(--br-text-sub); padding: 32px 0; }
  .blog__list { list-style: none; }
  .blog__item {
    display: grid;
    gap: 6px;
    padding: 22px 4px;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-color) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .blog__item:hover { background: var(--bg-soft); }
  }
  .blog__date { font-size: 12.5px; color: var(--ink-soft); }
  .blog__title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 19px;
  }
  .blog__desc { font-size: 14.5px; color: var(--ink-soft); }
</style>
