---
// 자주 묻는 질문 — faq.json 전 항목 (IA v3 신설, 콘텐츠 소스는 기존 faq.json 유지).
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import { loadFaq } from '../../lib/faq.ts';

const faq = loadFaq();
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '자주 묻는 질문', item: `${siteUrl}/faq/` },
    ],
  },
];
if (faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<Base title="자주 묻는 질문" description="설치·세척·정기관리에 대해 자주 받는 질문과 답변." jsonLd={jsonLd}>
  <PageHero eyebrow="자주 묻는 질문">
    묻기 전에<br />먼저 답해 둡니다
  </PageHero>

  <section class="bd-section faq-page">
    <div class="bd-container">
      {faq.length > 0 ? (
        <dl class="faq-page__list br-reveal">
          {faq.map((f) => (
            <div class="faq-page__item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      ) : (
        /* faq.json이 전부 sample이면 빈 목록 대신 상담으로 연결 */
        <div class="faq-page__pending br-reveal">
          <p class="faq-page__pending-title">질문 목록을 준비하고 있습니다.</p>
          <p class="faq-page__pending-body">궁금한 점은 챗봇으로 바로 물어보실 수 있습니다.</p>
          <button type="button" class="bd-cta" data-chat-tree="menu">바로 문의하기</button>
        </div>
      )}
    </div>
  </section>

  <CtaBand>
    답이 없는 질문은<br />직접 <em>답</em>해 드립니다
    <Fragment slot="sub">기종과 상황을 알려주시면 상담으로 이어드립니다.</Fragment>
  </CtaBand>
</Base>

<style>
  .faq-page { background: var(--br-base); }
  .faq-page__list { display: grid; gap: 0; max-width: 760px; border-top: 2px solid var(--br-teal); }
  .faq-page__item { padding: 18px 4px; border-bottom: 1px solid var(--br-line); }
  .faq-page__item dt { font-weight: 700; font-size: 16px; margin-bottom: 6px; color: var(--br-ink); }
  .faq-page__item dd { font-size: 15px; color: var(--br-ink-sub); }
  .faq-page__pending { text-align: center; padding: 24px 0; }
  .faq-page__pending-title { font-size: 20px; font-weight: 800; color: var(--br-teal); }
  .faq-page__pending-body { margin-top: 12px; font-size: 15px; color: var(--br-ink-sub); }
  .faq-page__pending .bd-cta { margin-top: 28px; }
</style>
