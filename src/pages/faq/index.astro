---
// 자주 묻는 질문 — 물어보면 답하는 구조(2026-09-23).
// 히어로(teal-deep, DESIGN.md §3)의 입력창에 평소 말로 물으면, 적어 둔 답 중 가장 가까운 문항 하나로 답한다.
// 짧은 답 먼저 → '자세히 보기' 로 전체 답 → 관련 페이지 링크. 전체 목록은 그 아래 그대로 둔다.
// 그 자리에서 지어내는 답이 아니다 — faq.json 에 적어 둔 답만 꺼내 보여 준다(근거 없는 말이 나올 틈이 없다).
// 콘텐츠는 faq.json 단일 소스. hold 문항은 페이지·JSON-LD 모두 제외.
// 목록은 순수 details/summary — JS가 죽어도 전 문항이 HTML로 노출된다.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import { loadFaqPage, renderFaqMd, faqPlainText, FAQ_CATEGORIES } from '../../lib/faq.ts';
import { normFaq } from '../../scripts/faq-rank';
import { SITE_CONFIG } from '../../config.js';

const items = loadFaqPage();
/** 분류마다 처음 보이는 문항 수 — 나머지는 'N개 더 보기'로 접힌다 */
const FAQ_VISIBLE = 3;

// 검색 인덱스 — 질의·대상 모두 공백 제거+소문자 후 부분 일치 (마크다운 기호 제거한 평문 기준)
const norm = normFaq;

// 입력창 아래 예시 질문 — 누르면 그 문항으로 바로 답한다. 문항이 없으면(hold 등) 빌드에서 뺀다
const EXAMPLES_ALL = [
  { t: '에어컨에서 냄새가 나요', id: 'faq-smell' },
  { t: '천장형 에어컨에서 물이 떨어져요', id: 'faq-drip-ceiling' },
  { t: '세척은 얼마나 자주 해야 하나요', id: 'faq-clean-cycle' },
  { t: '추가비용은 언제 생기나요', id: 'faq-extra-cost' },
  { t: '분해 세척이랑 일반 세척은 뭐가 달라요', id: 'faq-deep-vs-basic' },
  { t: '우리 집 천장에도 달 수 있나요', id: 'faq-ceiling-check' },
];
const EXAMPLES = EXAMPLES_ALL.filter((e) => items.some((f) => f.id === e.id)).slice(0, 5);
EXAMPLES_ALL.filter((e) => !items.some((f) => f.id === e.id)).forEach((e) => console.warn(`[faq 예시] live 문항 없음, 칩에서 뺌: ${e.id}`));

// 물어본 질문에 먼저 보일 짧은 답과 '자세히 보기' 에 들어갈 나머지.
// 짧은 답 = short_a(페이지용) → chat_a(챗봇용으로 다듬어 둔 답) → 본문이 문단으로 시작하면 그 문단 → 한 줄 요약(hook).
//   본문이 소제목으로 시작하는 문항에서 소제목 글자('네 단계로 진행합니다')가 답이 되던 것을 막는다.
// 나머지에서는 짧은 답과 같은(앞 20자가 같은) 문단을 빼 같은 말이 두 번 나오지 않게 한다
const isPara = (b: string) => !/^(##|-|\|)/.test(b);
/** 문단에서 이미 한 말(said 에 통째로 든 문장)을 뺀다. 목록·표·소제목은 건드리지 않는다 */
const trimSaid = (b: string, said: string) => {
  if (!isPara(b)) return b;
  const ss = b.split(/(?<=[.?!])\s+/);
  return ss.filter((x) => { const t = norm(faqPlainText(x)); return t.length < 6 || !said.includes(t); }).join(' ');
};
const answers = items.map((f) => {
  const blocks = f.a.split(/\n\s*\n/).map((b) => b.trim()).filter(Boolean);
  const first = blocks[0] ?? '';
  const short = f.shortA || f.chatA || (isPara(first) ? faqPlainText(first) : f.hook || faqPlainText(blocks.find(isPara) ?? first));
  const head = norm(short).slice(0, 20);
  const hook = f.hook && norm(f.hook) !== norm(short) && !norm(short).startsWith(norm(f.hook)) ? trimSaid(f.hook, norm(short)) : '';
  // 짧은 답·굵은 첫 줄에서 이미 한 문장은 펼친 쪽 문단 앞머리에서 뗀다(문단 뒤쪽 새 정보는 남긴다)
  const said = norm(short) + '|' + norm(hook);
  const rest = blocks.map((b) => trimSaid(b, said)).filter((b) => b && norm(faqPlainText(b)).slice(0, 20) !== head).join('\n\n');
  return { f, short, rest, hook };
});

// 처음 온 분이 순서대로 읽는 길 — 알아보는 순서(달 수 있나 → … → 관리)대로 한 문항씩. 문항이 없으면(hold 등) 그 단계는 뺀다
const GUIDE_ALL = [
  { id: 'faq-ceiling-check', label: '달 수 있나' },
  { id: 'faq-capacity-rooms', label: '몇 대·크기' },
  { id: 'faq-price-how', label: '비용' },
  { id: 'faq-brand-choice', label: '브랜드' },
  { id: 'faq-ask-first', label: '견적' },
  { id: 'faq-install-flow', label: '설치 날' },
  { id: 'faq-install-check', label: '끝나고 확인' },
  { id: 'faq-filter-cycle', label: '관리' },
];
const GUIDE = GUIDE_ALL.flatMap((g) => answers.filter((a) => a.f.id === g.id).map((a) => ({ ...a, label: g.label })));
GUIDE_ALL.filter((g) => !items.some((f) => f.id === g.id)).forEach((g) => console.warn(`[faq 순서대로] live 문항 없음, 단계에서 뺌: ${g.id}`));

// 카테고리 순서 고정 (비용 먼저) — 문항이 있는 카테고리만 섹션 생성
const sections = FAQ_CATEGORIES
  .map((cat) => ({ cat, items: items.filter((i) => i.category === cat) }))
  .filter((s) => s.items.length > 0);

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '자주 묻는 질문', item: `${siteUrl}/faq/` },
    ],
  },
];
if (items.length) {
  // FAQPage — live 문항의 q+a 전체 (hook 제외)
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: faqPlainText(f.a) },
    })),
  });
}
---
<Base title="자주 묻는 질문" description="에어컨 설치·세척·고장·관리, 자주 묻는 질문과 답." jsonLd={jsonLd}>
  <PageHero>
    자주 묻는 질문
    <Fragment slot="extra">
      {items.length > 0 && (
        <Fragment>
          <div class="faq-hero">
          {/* 첫 화면에서 바로 보이게 히어로에 둔다 — 누르면 아래 '순서대로 보기' 를 펼쳐 1단계로.
              모서리의 겹친 판 네 장은 장식(aria-hidden) — 누르거나 올리면 판이 모서리로 모인다 */}
          {GUIDE.length > 0 && (
            <a class="faq-start" href="#faq-guide" data-faq-guide-go>
              <span class="faq-start__sheets" aria-hidden="true">
                {GUIDE.map((_, i) => <i style={`--i:${i}`}><b>{i + 1}</b></i>)}
              </span>
              <span class="faq-start__pocket">
                <span class="faq-start__t">처음이세요? · {GUIDE.length}단계</span>
                <span class="faq-start__h">순서대로 보기 <span aria-hidden="true">→</span></span>
              </span>
            </a>
          )}
          <div class="faq-hero__ask">
          {/* 입력에 name 이 없다 — 적은 말(연락처 등)이 주소창·서버 기록에 남지 않게. JS 가 없어도 전 문항은 아래에 있다 */}
          <form class="faq-ask" role="search" data-faq-form>
            <label class="faq-ask__label" for="faq-q">궁금한 걸 물어보세요</label>
            <div class="faq-ask__bar">
              <input
                id="faq-q"
                type="search"
                class="faq-ask__input"
                placeholder="예: 에어컨에서 냄새가 나요"
                autocomplete="off"
                enterkeyhint="send"
                required
                data-faq-search
              />
              <button type="submit" class="faq-ask__send" aria-label="묻기">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></svg>
              </button>
            </div>
          </form>
          {EXAMPLES.length > 0 && (
            <div class="faq-ex">
              <p class="faq-ex__t" id="faq-ex-t">예)</p>
              {/* 예시는 두 개만 늘어놓고 나머지는 목록 버튼 안에 */}
              <div class="faq-ex__list" role="group" aria-labelledby="faq-ex-t">
                {EXAMPLES.slice(0, 2).map((e) => (
                  <button type="button" class="faq-ex__chip" data-faq-ask={e.id} data-faq-text={e.t}>{e.t}</button>
                ))}
              </div>
              {EXAMPLES.length > 2 && (
                <details class="faq-ex__more">
                  <summary class="list-btn list-btn--deep"><span class="list-btn__bars" aria-hidden="true"><span class="list-btn__bar list-btn__bar--a"></span><span class="list-btn__bar list-btn__bar--b"></span><span class="list-btn__bar list-btn__bar--a"></span></span><span>예시 {EXAMPLES.length - 2}개 더</span></summary>
                  <div class="faq-ex__rest">
                    {EXAMPLES.slice(2).map((e) => (
                      <button type="button" class="faq-ex__row" data-faq-ask={e.id} data-faq-text={e.t}>{e.t}</button>
                    ))}
                  </div>
                </details>
              )}
            </div>
          )}
          </div>
          </div>
        </Fragment>
      )}
    </Fragment>
  </PageHero>

  <section class="bd-section faq-page">
    <div class="bd-container">
      {items.length > 0 ? (
        <Fragment>
          {/* 순서대로 보기 — JS 가 없으면 펼쳤을 때 전 단계가 차례로 다 보인다. JS 가 있으면 한 화면에 한 문항 + 이전/다음 */}
          {GUIDE.length > 0 && (
            <details class="faq-guide" id="faq-guide" data-faq-guide data-no-expand>
              <summary class="faq-guide__open">처음이세요? 순서대로 보기 <span aria-hidden="true">→</span></summary>
              <div class="faq-guide__bar" aria-hidden="true"><i data-faq-guide-bar></i></div>
              <ol class="faq-guide__list">
                {GUIDE.map(({ f, short, rest, hook, label }, i) => (
                  <li class="faq-guide__step br-glass br-glass--medium" data-faq-step>
                    <p class="faq-guide__n">{i + 1} / {GUIDE.length} · {label}</p>
                    <h2 class="faq-guide__q" tabindex="-1" data-faq-step-q>{f.q}</h2>
                    <p class="faq-guide__short">{short}</p>
                    {(rest || f.priceNote) && (
                      <details class="faq-ans__more">
                        <summary class="faq-ans__toggle">자세히 보기</summary>
                        <div class="faq-ans__full">
                          {hook && rest && <p class="faq-item__hook">{hook}</p>}
                          {rest && <div class="faq-item__a" set:html={renderFaqMd(rest)} />}
                          {f.priceNote && <p class="faq-item__price">{f.priceNote}</p>}
                        </div>
                      </details>
                    )}
                    {i === GUIDE.length - 1 && (
                      <div class="faq-guide__end">
                        <p>다 읽으셨습니다. 궁금한 게 남았으면 물어보세요.</p>
                        <div class="faq-guide__end-btns">
                          {SITE_CONFIG.PHONE && <a class="bd-cta" href={`tel:${SITE_CONFIG.PHONE.replace(/[^0-9]/g, '')}`}>전화하기 {SITE_CONFIG.PHONE}</a>}
                          <button disabled aria-describedby="chat-unavailable" type="button" class:list={[SITE_CONFIG.PHONE ? 'br-pill' : 'bd-cta']} data-chat-tree="etc">상담으로 묻기</button>
                        </div>
                      </div>
                    )}
                  </li>
                ))}
              </ol>
              <div class="faq-guide__nav" data-faq-guide-nav hidden>
                <button type="button" class="faq-guide__btn" data-faq-guide-prev>◀ 이전</button>
                <button type="button" class="faq-guide__btn faq-guide__btn--next" data-faq-guide-next>다음 ▶</button>
              </div>
            </details>
          )}

          {/* 묻고 답하기 — 물으면 나타난다. 가장 최근 질문 하나만 보여 준다 */}
          <div class="faq-chat" data-faq-chat hidden>
            <p class="faq-chat__me"><span class="visually-hidden">물어본 질문: </span><span data-faq-me></span></p>

            {/* 답 — 아래 숨긴 문항별 답을 복제해 넣는다 */}
            <div class="faq-chat__we br-glass br-glass--medium" data-faq-we hidden></div>

            {/* 하나로 못 박기 어려울 때 — 고르게 한다 */}
            <div class="faq-chat__we br-glass br-glass--medium" data-faq-pick hidden>
              <p class="faq-chat__who">바람대로</p>
              <p class="faq-chat__lead" tabindex="-1" data-faq-focus data-faq-pick-title></p>
              <div class="faq-chat__chips" data-faq-pick-list></div>
            </div>

            {/* 걸리는 문항이 없을 때 */}
            <div class="faq-chat__we br-glass br-glass--medium" data-faq-none hidden>
              <p class="faq-chat__who">바람대로</p>
              <p class="faq-chat__lead" tabindex="-1" data-faq-focus>맞는 답을 찾지 못했습니다.</p>
              <p class="faq-chat__alt">예)</p>
              <div class="faq-chat__chips faq-chat__chips--tight" role="group" aria-label="예시 검색어">
                {['누수', '소음', '냄새', '필터', '설치비'].map((t) => <button type="button" data-faq-term={t}>{t}</button>)}
              </div>
            </div>

            <div class="faq-chat__next" data-faq-next hidden>
              <p class="faq-chat__next-t" id="faq-next-t">관련 질문</p>
              <div class="faq-chat__chips" role="group" aria-labelledby="faq-next-t" data-faq-next-list></div>
            </div>

            {/* 어느 상태에서든 사람에게 닿는 길 — 이 칸은 접수 창구가 아니다(접수는 챗봇 단일, DESIGN.md §6) */}
            <div class="faq-chat__foot">
              <button type="button" class="faq-chat__again" data-faq-again>다른 질문하기</button>
              {/* 채널톡(상담)을 바로 연다 — 물어본 말을 입력칸에 채워 둔다. 채널톡이 아직 안 떴으면 챗봇 '기타 문의'(상담 연결)로 */}
              <button disabled aria-describedby="chat-unavailable" type="button" class="br-pill faq-chat__bot-btn" data-chat-tree="etc" data-faq-consult>상담으로 묻기</button>
            </div>
          </div>

          {/* 문항별 답 — 물으면 이 중 하나를 복제해 답 카드에 넣는다. <template> 안에서는 Astro 식이 안 풀려 숨긴 div 로 둔다 */}
          <div hidden data-faq-bank>
          {answers.map(({ f, short, rest, hook }) => (
              <div data-faq-ans={f.id}>
                <p class="faq-chat__who">바람대로</p>
                <h2 class="faq-ans__q" tabindex="-1" data-faq-focus>{f.q}</h2>
                <p class="faq-ans__short">{short}</p>
                {(rest || f.priceNote) && (
                  <details class="faq-ans__more">
                    <summary class="faq-ans__toggle">자세히 보기</summary>
                    <div class="faq-ans__full">
                      {hook && rest && <p class="faq-item__hook">{hook}</p>}
                      {rest && <div class="faq-item__a" set:html={renderFaqMd(rest)} />}
                      {f.priceNote && <p class="faq-item__price">{f.priceNote}</p>}
                    </div>
                  </details>
                )}
                {f.related.length > 0 && (
                  <p class="faq-ans__links">
                    <span class="faq-ans__links-t">더 알아보기</span>
                    {f.related.map((r) => (
                      <a class="br-pill" href={r.href}>{r.label} <span aria-hidden="true">→</span></a>
                    ))}
                  </p>
                )}
              </div>
          ))}
          </div>

          <h2 class="faq-all__title">전체 질문</h2>
          {/* 분류 — 칩을 늘어놓지 않고 목록 버튼 하나. 펼치면 분류가 한 줄씩 */}
          <details class="faq-nav br-reveal" data-faq-nav>
            <summary class="list-btn"><span class="list-btn__bars" aria-hidden="true"><span class="list-btn__bar list-btn__bar--a"></span><span class="list-btn__bar list-btn__bar--b"></span><span class="list-btn__bar list-btn__bar--a"></span></span><span>분류 {sections.length}개</span></summary>
            <nav class="faq-nav__list" aria-label="분류">
              {sections.map((s) => (
                <a class="faq-nav__row" href={`#cat-${s.cat}`}><span>{s.cat}</span> <span class="faq-nav__n">{s.items.length}문항</span></a>
              ))}
            </nav>
          </details>

          {sections.map((s) => (
            <div class="faq-cat" id={`cat-${s.cat}`} data-faq-cat>
              <h3 class="faq-cat__title">{s.cat}</h3>
              {s.items.map((f, i) => (
                <Fragment>
                  <details
                    class="faq-item br-glass br-glass--medium"
                    id={f.id}
                    data-faq-item
                    data-cat={f.category}
                    data-q={norm(f.q)}
                    data-kw={norm(f.keywords.join(' '))}
                    data-hook={norm(f.hook)}
                    data-body={norm(faqPlainText(f.a))}
                  >
                    <summary class="faq-item__q">{f.q}</summary>
                    <div class="faq-item__body">
                      {/* 답이 굵은 첫 줄과 같은 문장으로 시작하면 첫 줄을 빼 같은 말을 두 번 하지 않는다 */}
                      {f.hook && !norm(faqPlainText(f.a)).startsWith(norm(f.hook)) && <p class="faq-item__hook">{f.hook}</p>}
                      <div class="faq-item__a" set:html={renderFaqMd(f.a, 4)} />
                      {f.priceNote && <p class="faq-item__price">{f.priceNote}</p>}
                      {f.related.length > 0 && (
                        <p class="faq-item__related br-pills">
                          {f.related.map((r) => (
                            <a class="br-pill" href={r.href}>{r.label} <span aria-hidden="true">→</span></a>
                          ))}
                        </p>
                      )}
                    </div>
                  </details>
                  {/* 분류마다 앞 3문항만(2026-10-02 대표: 너무 많이 늘어놓지 않기) — 토글을 3번째 문항 바로 뒤에 둬서, 열면 Tab 이 새로 보인 문항으로 이어진다.
                      닫힌 동안 뒤 문항은 CSS 형제 선택자로 숨긴다(문항 HTML·검색 마크업은 그대로 다 있다) */}
                  {i === FAQ_VISIBLE - 1 && s.items.length > FAQ_VISIBLE && (
                    <details class="faq-more" data-no-expand>
                      <summary>
                        <span class="faq-more__open">{s.items.length - FAQ_VISIBLE}개 더 보기</span>
                        <span class="faq-more__close">접기</span>
                        <span class="visually-hidden"> — {s.cat}</span>
                      </summary>
                    </details>
                  )}
                </Fragment>
              ))}
            </div>
          ))}
        </Fragment>
      ) : (
        <div class="faq-page__pending br-reveal">
          <p class="faq-page__pending-title">질문 목록을 준비하고 있습니다.</p>
          <button disabled aria-describedby="chat-unavailable" type="button" class="bd-cta" data-chat-tree="menu">바로 문의하기</button>
        </div>
      )}
    </div>
  </section>

  <CtaBand>
    답이 없는 질문은<br />직접 <em>답</em>해 드립니다
  </CtaBand>
</Base>

<script>
  // 순서대로 보기 카드 — 마우스가 없는 기기는 카드가 화면에 들어올 때 판을 한 번 올린다(마우스는 CSS :hover)
  {
    const card = document.querySelector<HTMLElement>('.faq-start');
    if (card && !matchMedia('(hover: hover) and (pointer: fine)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) { card.classList.add('is-in'); io.disconnect(); }
      }, { threshold: 0.6 });
      io.observe(card);
    }
  }

  // 분류 목록에서 고르면 목록을 닫고 그 분류로 내려간다
  document.querySelectorAll<HTMLAnchorElement>('.faq-nav__row').forEach((a) =>
    a.addEventListener('click', () => { const d = a.closest('details'); if (d) d.open = false; }));

  // N개 더 보기 — 숨어 있던 문항이 아래로 차례로 떠오른다(접을 때는 바로 닫는다)
  document.querySelectorAll<HTMLDetailsElement>('.faq-more').forEach((m) => {
    m.addEventListener('toggle', () => {
      if (!m.open || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let el = m.nextElementSibling as HTMLElement | null, k = 0;
      while (el && k < 30) {
        if (el.matches('.faq-item')) el.animate([{ opacity: 0, transform: 'translateY(20px)' }, { opacity: 1, transform: 'none' }],
          { duration: 600, delay: Math.min(k, 10) * 50, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards' });
        el = el.nextElementSibling as HTMLElement | null; k++;
      }
    });
  });

  // 순서대로 보기 — 한 화면에 한 단계. 이전/다음으로 넘기고, 넘길 때 질문으로 초점을 옮긴다
  {
    const guide = document.querySelector<HTMLDetailsElement>('[data-faq-guide]');
    const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-step]'));
    const nav = document.querySelector<HTMLElement>('[data-faq-guide-nav]');
    const prev = document.querySelector<HTMLButtonElement>('[data-faq-guide-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-faq-guide-next]');
    const bar = document.querySelector<HTMLElement>('[data-faq-guide-bar]');
    const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';
    let at = 0;
    let busy: Animation | null = null;
    // 넘길 때 — 지금 카드는 넘기는 쪽으로 밀려 나가고, 새 카드가 반대쪽에서 들어온 뒤 안 글줄이 60ms 씩 떠오른다
    const swap = (from: HTMLElement | undefined, to: HTMLElement, dir: number) => {
      const enter = () => {
        steps.forEach((s) => { s.hidden = s !== to; });
        if (still()) return;
        to.animate([{ opacity: 0, transform: `translateX(${dir * 56}px)` }, { opacity: 1, transform: 'none' }], { duration: 520, easing: EASE });
        Array.from(to.children).forEach((el, k) =>
          (el as HTMLElement).animate([{ opacity: 0, transform: 'translateY(14px)' }, { opacity: 1, transform: 'none' }],
            { duration: 520, delay: 120 + k * 60, easing: EASE, fill: 'backwards' }));
      };
      busy?.finish();
      if (!from || from === to || from.hidden || still()) { enter(); return; }
      busy = from.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translateX(${-dir * 56}px)` }], { duration: 200, easing: 'ease-in' });
      busy.onfinish = () => { busy = null; enter(); };
    };
    const go = (i: number, focus = true) => {
      const before = at;
      at = Math.max(0, Math.min(steps.length - 1, i));
      swap(steps[before], steps[at], at >= before ? 1 : -1);
      if (bar) bar.style.transform = `scaleX(${(at + 1) / steps.length})`;
      if (prev) prev.disabled = at === 0;
      if (nextBtn) nextBtn.hidden = at === steps.length - 1;
      if (focus) {
        const q = steps[at]?.querySelector<HTMLElement>('[data-faq-step-q]');
        q?.focus({ preventScroll: true });
        guide?.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    };
    if (guide && steps.length && nav) {
      nav.hidden = false;
      go(0, false);
      prev?.addEventListener('click', () => go(at - 1));
      nextBtn?.addEventListener('click', () => go(at + 1));
      guide.addEventListener('toggle', () => {
        if (!guide.open) return;
        steps.forEach((s, k) => { s.hidden = k !== 0; });
        at = 0;
        go(0);
        if (!still()) guide.animate([{ opacity: 0, transform: 'translateY(32px) scale(0.98)' }, { opacity: 1, transform: 'none' }], { duration: 600, easing: EASE });
      });
      document.querySelector('[data-faq-guide-go]')?.addEventListener('click', (e) => {
        e.preventDefault();
        if (guide.open) go(0); else guide.open = true;   // toggle 이벤트가 go(0) 을 부른다
      });
    }
  }

  // 묻고 답하기 — 물어본 말에 가장 가까운 문항 하나로 답한다. 고르는 규칙은 faq-rank.ts.
  import { decideFaq, type FaqDoc } from '../../scripts/faq-rank';
  import { ensureChannel, openConsult } from '../../lib/channel';

  const form = document.querySelector<HTMLFormElement>('[data-faq-form]');
  const input = document.querySelector<HTMLInputElement>('[data-faq-search]');
  const chat = document.querySelector<HTMLElement>('[data-faq-chat]');
  const me = document.querySelector<HTMLElement>('[data-faq-me]');
  const we = document.querySelector<HTMLElement>('[data-faq-we]');
  const pick = document.querySelector<HTMLElement>('[data-faq-pick]');
  const pickTitle = document.querySelector<HTMLElement>('[data-faq-pick-title]');
  const pickList = document.querySelector<HTMLElement>('[data-faq-pick-list]');
  const none = document.querySelector<HTMLElement>('[data-faq-none]');
  const next = document.querySelector<HTMLElement>('[data-faq-next]');
  const nextList = document.querySelector<HTMLElement>('[data-faq-next-list]');
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]'));
  const byId = new Map(items.map((el) => [el.id, el]));
  const docs: FaqDoc[] = items.map((el) => ({
    id: el.id, q: el.dataset.q ?? '', kw: el.dataset.kw ?? '', hook: el.dataset.hook ?? '', body: el.dataset.body ?? '',
  }));
  const qOf = (id: string) => byId.get(id)?.querySelector('summary')?.textContent?.trim() ?? '';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function chips(list: HTMLElement | null, ids: string[]) {
    if (!list) return;
    list.textContent = '';
    for (const id of ids) {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.faqAsk = id;
      b.textContent = qOf(id);
      list.append(b);
    }
  }

  function show(which: HTMLElement | null) {
    for (const el of [we, pick, none]) if (el) el.hidden = el !== which;
    if (next && which !== we) next.hidden = true;
  }

  function answer(id: string, near: string[]) {
    const src = document.querySelector<HTMLElement>(`[data-faq-bank] [data-faq-ans="${CSS.escape(id)}"]`);
    if (!src || !we) return false;
    we.replaceChildren(...Array.from(src.children, (n) => n.cloneNode(true)));
    show(we);
    // 관련 질문 — 같이 걸린 문항, 모자라면 같은 분류에서 채운다
    const rel = near.filter((r) => r !== id).slice(0, 3);
    const cat = byId.get(id)?.dataset.cat;
    for (const el of items) {
      if (rel.length >= 3) break;
      if (el.dataset.cat === cat && el.id !== id && !rel.includes(el.id)) rel.push(el.id);
    }
    chips(nextList, rel);
    if (next) next.hidden = rel.length === 0;
    return true;
  }

  // 주소에는 고객이 적은 말을 남기지 않는다(연락처를 적는 사람이 있다). 답이 정해졌을 때만 그 문항의 질문을 남겨
  // 새로고침·공유해도 같은 답이 나오게 한다 — 문항 질문으로 물으면 그 답이 나온다는 건 test:faq 1) 이 보장한다
  function remember(id: string | null) {
    const url = new URL(location.href);
    url.hash = '';
    if (id) url.searchParams.set('q', qOf(id)); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  let lastQ = '';
  function ask(raw: string, id?: string) {
    const q = raw.trim();
    if (!q || !chat) return;
    lastQ = q;
    void ensureChannel();                              // 상담 버튼을 누를 때 바로 열리도록 미리 띄운다(처음 한 번)
    if (input) input.value = q;
    if (me) me.textContent = q;
    chat.hidden = false;

    if (id && answer(id, [])) remember(id);
    else {
      const d = decideFaq(q, docs);
      if (d.kind === 'answer') { answer(d.id, d.near); remember(d.id); }
      else if (d.kind === 'pick') {
        if (pickTitle) pickTitle.textContent = d.vague ? '어떤 게 궁금하세요?' : '혹시 이 질문인가요?';
        chips(pickList, d.ids);
        show(pick);
        remember(null);
      } else { show(none); remember(null); }
    }

    // 새 답이 들어왔다는 걸 눈에 보이게 — 같은 자리에서 바뀌면 바뀐 줄 모른다
    chat.classList.remove('is-new');
    void chat.offsetWidth;
    chat.classList.add('is-new');

    // 답으로 초점을 옮긴다 — 화면 읽기 프로그램이 답을 읽고, 모바일은 키보드가 내려간다
    const focus = [we, pick, none].find((el) => el && !el.hidden)?.querySelector<HTMLElement>('[data-faq-focus]');
    focus?.focus({ preventScroll: true });
    chat.scrollIntoView({ block: 'start', behavior: reduced ? 'auto' : 'smooth' });
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input) return;
    // 공백만 친 경우 — required 가 못 막는다. 비워서 브라우저 안내를 띄운다
    if (!input.value.trim()) { input.value = ''; input.reportValidity(); return; }
    ask(input.value);
  });
  document.addEventListener('click', (e) => {
    // 답 안의 /faq/#문항 링크 — 새로 불러오면 답이 사라지므로 그 자리에서 그 문항으로 답한다
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="/faq/#"]');
    const hid = a?.hash.slice(1);
    if (hid && byId.has(hid)) { e.preventDefault(); ask(qOf(hid), hid); return; }
    // 못 찾았을 때의 예시 검색어
    const term = (e.target as HTMLElement).closest<HTMLElement>('[data-faq-term]')?.dataset.faqTerm;
    if (term) { ask(term); return; }
    // 예시·관련 질문·고르기 — 문항 id 로 바로 답한다
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-faq-ask]');
    if (!b?.dataset.faqAsk) return;
    ask(b.dataset.faqText ?? qOf(b.dataset.faqAsk), b.dataset.faqAsk);
  });
  // 상담 — 채널톡이 열리면 챗봇(문서에 걸린 data-chat-tree 처리)까지 가지 않게 여기서 멈춘다
  document.querySelector('[data-faq-consult]')?.addEventListener('click', (e) => {
    if (openConsult(lastQ || undefined)) e.stopPropagation();
  });
  document.querySelector('[data-faq-again]')?.addEventListener('click', () => {
    input?.select();
    input?.focus({ preventScroll: true });
    input?.scrollIntoView({ block: 'center', behavior: reduced ? 'auto' : 'smooth' });
  });

  // 링크로 들어온 질문(?q=)이나 문항(#faq-…)에 바로 답한다 — 챗봇·다른 페이지에서 이 답으로 보낼 수 있다
  const initial = new URL(location.href).searchParams.get('q');
  const hashId = decodeURIComponent(location.hash.slice(1));
  if (byId.has(hashId)) ask(qOf(hashId), hashId);
  else if (initial) ask(initial);
</script>

<style>
  /* 본문 너비를 히어로와 맞춘다(08-27 지시). 읽기 폭은 항목 내부에서 잡는다 */
  .faq-page { background: transparent; } /* 유리 카드 호스트 */
  .faq-page .bd-container { max-width: var(--maxw); }

  /* ── 묻는 칸 — 어두운 히어로 위의 옅은 유리 판 + 흰 알약 ─────────────
     참고 시안(유리 판 + 흰 알약 입력, 포커스 시 반전)에서 판과 알약만 가져왔다.
     뒤에서 번지는 빛은 뺐다(09-23 "이렇게까지 반짝거리는 걸 바라지 않았다") — 판은 흰 8% + 테두리 한 줄.
     보내기 버튼은 알약 안 오른쪽 — 물어보는 칸이라는 걸 모양으로 알린다 */
  .faq-ask {
    max-width: 600px;
    display: grid; gap: 10px;
    padding: 14px;
    border-radius: 24px;
    background: color-mix(in srgb, #fff 8%, transparent);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, #fff 16%, transparent);
    border-top-color: color-mix(in srgb, #fff 45%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 10%, transparent);
  }
  .faq-ask__label {
    margin-left: 10px;
    font-size: 14px; font-weight: 700; letter-spacing: 0.02em;
    color: #fff;
  }
  /* 알약 — 올리거나 누르면 teal-deep 으로 뒤집힌다. 반전된 알약이 어두운 판에 묻히지 않게 ice 윤곽 한 줄 */
  .faq-ask__bar {
    display: flex; align-items: center; gap: 8px;
    padding: 6px 6px 6px 20px;
    border-radius: 999px;
    background: #fff;
    transition: background-color var(--dur-color) var(--ease-out), box-shadow var(--dur-color) var(--ease-out);
  }
  /* 투명 outline — 평소엔 안 보이고, 고대비 모드(forced-colors)에서는 시스템 색으로 그려져 초점 표시가 된다 */
  .faq-ask__bar:focus-within { background: var(--br-teal-deep); box-shadow: 0 0 0 1px color-mix(in srgb, var(--br-ice) 60%, transparent); outline: 2px solid transparent; outline-offset: 2px; }
  @media (forced-colors: active) { .faq-ask__bar { border: 1px solid CanvasText; } }
  .faq-ask__input {
    flex: 1; min-width: 0;
    border: 0; outline: none; background: transparent;
    font: inherit; font-size: 17px;   /* 16px 미만이면 iOS 가 확대한다 */
    color: var(--br-ink);
    padding: 10px 0;
  }
  .faq-ask__input::placeholder { color: var(--br-ink-sub); }
  .faq-ask__bar:focus-within .faq-ask__input { color: #fff; }
  .faq-ask__bar:focus-within .faq-ask__input::placeholder { color: color-mix(in srgb, var(--br-ice) 78%, transparent); }
  .faq-ask__send {
    flex: none;
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border: 0; border-radius: 50%;
    background: var(--br-teal-deep); color: #fff;
    cursor: pointer;
    transition: background-color var(--dur-color) ease, color var(--dur-color) ease, transform 160ms var(--ease-out);
  }
  .faq-ask__bar:focus-within .faq-ask__send { background: var(--br-ice); color: var(--br-teal-deep); }
  .faq-ask__send:active { transform: scale(0.94); }
  .faq-ask__send:focus-visible { outline: 2px solid var(--br-ice); outline-offset: 2px; }
  @media (hover: hover) {
    .faq-ask__bar:hover { background: var(--br-teal-deep); box-shadow: 0 0 0 1px color-mix(in srgb, var(--br-ice) 60%, transparent); }
    .faq-ask__bar:hover .faq-ask__input { color: #fff; }
    .faq-ask__bar:hover .faq-ask__input::placeholder { color: color-mix(in srgb, var(--br-ice) 78%, transparent); }
    .faq-ask__bar:hover .faq-ask__send { background: var(--br-ice); color: var(--br-teal-deep); }
  }

  /* 예시 질문 — 어두운 히어로 위 */
  .faq-ex { margin-top: 18px; max-width: 600px; }
  .faq-ex__t { margin: 0 0 8px 4px; font-size: 13px; font-weight: 600; color: color-mix(in srgb, #fff 72%, transparent); }
  .faq-ex__list { display: flex; flex-wrap: wrap; gap: 8px; }
  .faq-ex__chip {
    display: inline-flex; align-items: center;
    min-height: 44px; padding: 0 16px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #fff 28%, transparent);
    background: color-mix(in srgb, #fff 6%, transparent);
    color: #fff;
    font: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
    transition: background-color var(--dur-color) ease, color var(--dur-color) ease;
  }
  @media (hover: hover) { .faq-ex__chip:hover { background: var(--br-ice); color: var(--br-teal-deep); } }
  .faq-ex__chip:active { transform: scale(0.96); }
  .faq-ex__chip:focus-visible { outline: 2px solid var(--br-ice); outline-offset: 2px; }

  /* ── 묻고 답하기 ─────────────────────────────────────────────
     내 질문은 오른쪽 말풍선(teal-deep), 답은 왼쪽 유리 카드 — 목록의 문항 카드와 같은 재질 */
  .faq-chat { max-width: 760px; margin-bottom: 64px; display: grid; gap: 14px; scroll-margin-top: 88px; }
  .faq-chat__me {
    justify-self: end; max-width: 85%;
    padding: 12px 18px;
    border-radius: 20px 20px 6px 20px;
    background: var(--br-teal-deep); color: #fff;
    font-size: 16px; font-weight: 600; line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .faq-chat__we { padding: 22px 24px 24px; }
  .faq-chat__who { margin-bottom: 8px; font-size: 13px; font-weight: 700; letter-spacing: 0.02em; color: var(--br-ink-sub); }
  .faq-chat__lead { font-size: 17px; font-weight: 700; line-height: 1.55; color: var(--br-ink); outline: none; }
  .faq-chat__alt { margin: 16px 0 14px; font-size: 15px; line-height: 1.7; color: var(--br-ink-sub); }
  .faq-chat__alt + .faq-chat__chips--tight { margin-top: -6px; }
  .faq-chat__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  /* 칩은 스크립트가 만든다 — 스코프 속성이 없어 :global */
  .faq-chat__chips :global(button) {
    min-height: 44px; padding: 8px 16px;
    border-radius: 22px;
    border: 1px solid var(--br-line);
    background: var(--br-base);
    color: var(--br-teal);
    font: inherit; font-size: 14.5px; font-weight: 600; line-height: 1.45; text-align: left;
    cursor: pointer;
    transition: border-color var(--dur-color) ease, background-color var(--dur-color) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .faq-chat__chips :global(button:hover) { border-color: var(--br-teal); background: var(--br-mist); }
  }
  .faq-chat__chips :global(button:focus-visible) { outline: 2px solid var(--br-teal); outline-offset: 2px; }
  .faq-chat__next { padding: 4px 4px 0; }
  .faq-chat__next-t { font-size: 13px; font-weight: 700; color: var(--br-ink-sub); }
  .faq-chat__next .faq-chat__chips { margin-top: 8px; }
  .faq-chat__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 20px; }
  .faq-chat__again {
    min-height: 44px; padding: 0 4px;
    border: 0; background: none;
    font: inherit; font-size: 14.5px; font-weight: 700; color: var(--br-teal);
    text-decoration: underline; text-underline-offset: 4px;
    cursor: pointer;
  }
  .faq-chat__again:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 2px; }

  /* 답 카드 */
  .faq-ans__q { font-size: 19px; font-weight: 700; line-height: 1.45; color: var(--br-ink); outline: none; }
  .faq-ans__short { margin-top: 10px; font-size: 16.5px; line-height: 1.8; color: var(--br-ink); }
  .faq-ans__more { margin-top: 14px; border-top: 1px solid var(--br-line); }
  .faq-ans__toggle {
    list-style: none; cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px; padding-top: 4px;
    font-size: 15px; font-weight: 700; color: var(--br-teal);
  }
  .faq-ans__toggle::-webkit-details-marker { display: none; }
  .faq-ans__toggle::after {
    content: ''; width: 8px; height: 8px;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .faq-ans__more[open] .faq-ans__toggle::after { transform: translateY(2px) rotate(-135deg); }
  .faq-ans__toggle:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 2px; border-radius: 4px; }
  .faq-ans__full { padding: 8px 0 4px; }
  .faq-ans__links { margin-top: 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .faq-ans__links-t { margin-right: 4px; font-size: 13px; font-weight: 700; color: var(--br-ink-sub); }

  @media (prefers-reduced-motion: no-preference) {
    /* 물으면 — 내 말풍선이 오른쪽에서 붙고, 답 카드가 아래에서 올라온 뒤 안 글줄·관련 질문이 차례로 떠오른다 */
    .faq-chat.is-new > .faq-chat__me { animation: faq-me var(--dur-reveal) var(--ease-out) both; }
    .faq-chat.is-new > .faq-chat__we:not([hidden]) { animation: faq-in var(--dur-reveal) var(--ease-out) 120ms both; }
    .faq-chat.is-new > .faq-chat__we:not([hidden]) > * { animation: faq-line var(--dur-reveal) var(--ease-out) both; }
    .faq-chat.is-new > .faq-chat__we > :nth-child(2) { animation-delay: 240ms; }
    .faq-chat.is-new > .faq-chat__we > :nth-child(3) { animation-delay: 300ms; }
    .faq-chat.is-new > .faq-chat__we > :nth-child(4) { animation-delay: 360ms; }
    .faq-chat.is-new > .faq-chat__we > :nth-child(n + 5) { animation-delay: 420ms; }
    .faq-chat.is-new > .faq-chat__next { animation: faq-in var(--dur-reveal) var(--ease-out) 420ms both; }
    .faq-chat.is-new :global(.faq-chat__chips > button) { animation: faq-line var(--dur-reveal) var(--ease-out) both; }
    .faq-chat.is-new :global(.faq-chat__chips > button:nth-child(2)) { animation-delay: 60ms; }
    .faq-chat.is-new :global(.faq-chat__chips > button:nth-child(n + 3)) { animation-delay: 120ms; }
    .faq-chat.is-new > .faq-chat__foot { animation: faq-in var(--dur-reveal) var(--ease-out) 480ms both; }
  }
  @keyframes faq-in { from { opacity: 0; transform: translateY(28px) scale(0.98); } }
  @keyframes faq-me { from { opacity: 0; transform: translateX(32px) scale(0.92); } }
  @keyframes faq-line { from { opacity: 0; transform: translateY(12px); } }
  /* 순서대로 보기 진행 막대 — 단계가 넘어갈 때 차오른다 */
  .faq-guide__bar { height: 6px; margin-top: 20px; border-radius: 999px; background: color-mix(in srgb, var(--br-teal) 12%, transparent); overflow: hidden; }
  .faq-guide__bar i { display: block; height: 100%; background: var(--br-teal); border-radius: inherit; transform-origin: left; transform: scaleX(0.125); transition: transform var(--dur-reveal) var(--ease-out); }
  .faq-guide__btn:active:not(:disabled) { transform: scale(0.96); }
  .faq-guide__btn { transition: transform 160ms var(--ease-out), background-color var(--dur-color) ease; }

  @media (max-width: 640px) {
    .faq-ask { padding: 10px; border-radius: 22px; }
    .faq-ask__bar { padding-left: 16px; }
    .faq-chat__we { padding: 18px 18px 20px; }
    .faq-chat__me { max-width: 92%; }
  }

  /* ── 전체 질문 ─────────────────────────────────────────────── */
  /* 히어로 — 넓은 화면은 왼쪽 묻기, 오른쪽 '순서대로 보기' 카드 */
  .faq-hero { display: grid; gap: 20px; }
  @media (min-width: 960px) {
    .faq-hero { grid-template-columns: minmax(0, 600px) minmax(300px, 380px); justify-content: space-between; align-items: start; }
    .faq-hero .faq-start { order: 2; min-height: 248px; }
  }

  /* 순서대로 보기 카드 — 색인 탭이 꽂힌 서류철. 단계 수만큼 종이가 꽂혀 있고 탭에 단계 번호가 있다(장식이 아니라 8단계를 보여 준다).
     앞 주머니는 반투명 유리라 뒤 종이가 비친다. 마우스를 대면(터치 기기는 화면에 들어올 때 한 번) 종이가 1번부터 60ms 씩 차례로 올라온다.
     transform 만 쓴다 */
  .faq-start {
    position: relative; overflow: hidden; isolation: isolate;
    display: block; min-height: 220px; border-radius: 24px;
    background: var(--br-teal);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 18%, transparent), 0 12px 30px color-mix(in srgb, var(--br-teal-deep) 50%, transparent);
    color: #fff; text-decoration: none;
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .faq-start:active { transform: scale(0.98); }
  .faq-start:focus-visible { outline: 2px solid var(--br-ice); outline-offset: 3px; }
  .faq-start__sheets { position: absolute; left: 18px; right: 18px; top: 52px; bottom: 0; }
  .faq-start__sheets i {
    position: absolute; inset: 0;
    top: calc(var(--i) * 3px);
    border-radius: 10px 10px 0 0;
    background: color-mix(in srgb, var(--br-ice) calc(var(--i) * 9%), var(--br-base));
    border-top: 1px solid #fff;
    box-shadow: 0 -2px 8px color-mix(in srgb, var(--br-teal-deep) 18%, transparent);
    transform: translateY(46px);
    transition: transform var(--dur-reveal) var(--ease-out);
    transition-delay: calc(var(--i) * 60ms);
  }
  /* 탭 — 종이마다 자리를 옮겨 꽂아 번호가 한 줄로 보인다 */
  .faq-start__sheets b {
    position: absolute; top: -22px; left: calc(var(--i) * 12.5%);
    width: calc(12.5% - 3px); height: 23px;
    display: grid; place-items: center;
    border-radius: 7px 7px 0 0;
    background: inherit; border-top: 1px solid #fff;
    font-size: 13px; font-weight: 700; color: var(--br-ink-sub); font-variant-numeric: tabular-nums;
  }
  .faq-start__pocket {
    position: absolute; left: 0; right: 0; bottom: 0; min-height: 56%;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 18px 22px 22px;
    background: color-mix(in srgb, var(--br-teal) 72%, transparent);
    -webkit-backdrop-filter: blur(8px) saturate(120%); backdrop-filter: blur(8px) saturate(120%);
    border-top: 1.5px solid color-mix(in srgb, #fff 55%, transparent);
    border-radius: 18px 18px 24px 24px;
  }
  .faq-start__t { font-size: 15px; font-weight: 700; color: rgba(255, 255, 255, 0.8); }
  .faq-start__h { margin-top: 4px; font-size: 26px; font-weight: 700; line-height: 1.3; }
  .faq-start.is-in .faq-start__sheets i,
  .faq-start:focus-visible .faq-start__sheets i { transform: translateY(0); }
  @media (hover: hover) and (pointer: fine) {
    .faq-start:hover .faq-start__sheets i { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-start__sheets i { transition: none; transform: none; }
  }
  /* JS 가 돌면 아래 펼침 버튼은 숨긴다 — 히어로 카드가 그 일을 한다(같은 버튼 두 개 금지). JS 가 없으면 카드는 이 펼침으로 내려온다 */
  :global(html.br-js) .faq-guide > .faq-guide__open { display: none; }
  :global(html.br-js) .faq-guide:not([open]) { margin: 0; }
  .faq-guide__end-btns { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .faq-guide { scroll-margin-top: 80px; }
  /* 순서대로 보기 — 큰 글씨·큰 버튼(어르신도 누르기 쉽게 48px 이상) */
  .faq-guide { margin-bottom: 40px; }
  .faq-guide__open {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 60px; padding: 14px 20px; border-radius: 999px;
    background: var(--br-teal-deep); color: #fff;
    font-size: 19px; font-weight: 700; cursor: pointer; list-style: none;
  }
  .faq-guide__open::-webkit-details-marker { display: none; }
  .faq-guide[open] > .faq-guide__open { background: var(--br-base); color: var(--br-teal); border: 1px solid var(--br-line); }
  .faq-guide__open:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 3px; }
  .faq-guide__list { display: grid; gap: 16px; margin: 20px 0 0; padding: 0; list-style: none; }
  .faq-guide__step { padding: 24px 20px; }
  .faq-guide__n { font-size: 15px; font-weight: 700; color: var(--br-teal); }
  .faq-guide__q { margin-top: 8px; font-size: 22px; font-weight: 700; line-height: 1.45; color: var(--br-ink); outline: none; text-wrap: balance; }
  .faq-guide__short { margin-top: 12px; font-size: 19px; line-height: 1.8; color: var(--br-ink); }
  .faq-guide__step .faq-ans__toggle { font-size: 17px; min-height: 48px; }
  .faq-guide__step .faq-ans__full { font-size: 17px; }
  .faq-guide__end { display: grid; gap: 14px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--br-line); font-size: 18px; color: var(--br-ink); }
  .faq-guide__nav { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
  .faq-guide__btn {
    min-height: 60px; border-radius: 14px; border: 1px solid var(--br-line);
    background: var(--br-base); color: var(--br-teal);
    font: inherit; font-size: 19px; font-weight: 700; cursor: pointer;
  }
  .faq-guide__btn--next { background: var(--br-teal); border-color: var(--br-teal); color: #fff; }
  .faq-guide__btn:disabled { opacity: 0.4; cursor: default; }
  .faq-guide__btn[hidden] { display: none; }
  .faq-guide__btn:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 2px; }

  .faq-all__title { margin-bottom: 18px; font-size: 22px; color: var(--br-ink); }

  /* 목록 버튼 — 막대 세 줄 위 점이 마우스를 대거나 펼치면 서로 엇갈려 미끄러진다(Uiverse setting-btn 을 우리 색으로) */
  .list-btn {
    display: inline-flex; align-items: center; gap: 12px;
    min-height: 48px; padding: 4px 18px 4px 4px; border-radius: 14px;
    cursor: pointer; list-style: none;
    font-size: 16px; font-weight: 700; color: var(--br-teal);
    background: var(--br-base); border: 1px solid var(--br-line);
    transition: transform var(--dur-ui) var(--ease-out), border-color var(--dur-color) ease;
  }
  .list-btn::-webkit-details-marker { display: none; }
  .list-btn:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 2px; }
  .list-btn:active { transform: scale(0.96); }
  .list-btn__bars {
    width: 40px; height: 40px; flex: none;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    border-radius: 10px; background: var(--br-teal);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--br-ice) 80%, transparent);
  }
  .list-btn__bar { position: relative; display: flex; align-items: center; justify-content: center; width: 50%; height: 2px; border-radius: 2px; background: var(--br-ice); }
  .list-btn__bar::before {
    content: ""; position: absolute; width: 2px; height: 2px; border-radius: 50%;
    background: var(--br-teal); border: 2px solid #fff;
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .list-btn__bar--a::before { transform: translateX(-4px); }
  .list-btn__bar--b::before { transform: translateX(4px); }
  [open] > .list-btn .list-btn__bar--a::before { transform: translateX(4px); }
  [open] > .list-btn .list-btn__bar--b::before { transform: translateX(-4px); }
  @media (hover: hover) and (pointer: fine) {
    .list-btn:hover { border-color: var(--br-teal); }
    .list-btn:hover .list-btn__bar--a::before { transform: translateX(4px); }
    .list-btn:hover .list-btn__bar--b::before { transform: translateX(-4px); }
  }
  /* 딥 히어로 위 — 유리 바탕, 흰 글자 */
  .list-btn--deep { background: color-mix(in srgb, #fff 8%, transparent); border-color: color-mix(in srgb, #fff 28%, transparent); color: #fff; }
  .list-btn--deep .list-btn__bars { background: var(--br-ice); box-shadow: none; }
  .list-btn--deep .list-btn__bar { background: var(--br-teal); }
  .list-btn--deep .list-btn__bar::before { background: var(--br-ice); border-color: var(--br-teal-deep); }
  @media (hover: hover) and (pointer: fine) { .list-btn--deep:hover { border-color: var(--br-ice); } }

  .faq-ex__more { margin-top: 10px; }
  .faq-ex__rest { display: grid; gap: 6px; margin-top: 10px; max-width: 600px; }
  .faq-ex__row {
    min-height: 48px; padding: 10px 16px; border-radius: 12px; text-align: left;
    font: inherit; font-size: 15px; font-weight: 600; cursor: pointer;
    color: #fff; background: color-mix(in srgb, #fff 6%, transparent);
    border: 1px solid color-mix(in srgb, #fff 22%, transparent);
    transition: transform var(--dur-ui) var(--ease-out), background-color var(--dur-color) ease;
  }
  .faq-ex__row:focus-visible { outline: 2px solid var(--br-ice); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .faq-ex__row:hover { transform: translateX(4px); background: color-mix(in srgb, #fff 12%, transparent); } }

  .faq-nav { margin-bottom: 36px; }
  .faq-nav__list { display: grid; margin-top: 10px; max-width: 420px; border-radius: 14px; overflow: hidden; border: 1px solid var(--br-line); background: var(--br-base); }
  .faq-nav__row {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    min-height: 52px; padding: 0 18px;
    font-size: 16px; font-weight: 700; color: var(--br-ink);
    border-top: 1px solid var(--br-line);
    transition: background-color var(--dur-color) ease, padding var(--dur-ui) var(--ease-out);
  }
  .faq-nav__row:first-child { border-top: 0; }
  .faq-nav__row:focus-visible { outline: 2px solid var(--br-teal); outline-offset: -2px; }
  @media (hover: hover) and (pointer: fine) { .faq-nav__row:hover { background: var(--br-mist); padding-left: 24px; } }
  .faq-nav__n { font-size: 13px; font-weight: 600; color: var(--br-ink-sub); font-variant-numeric: tabular-nums; }

  .faq-cat { margin-top: 44px; scroll-margin-top: 80px; }
  .faq-nav + .faq-cat { margin-top: 0; }
  .faq-cat__title {
    font-size: 20px;
    color: var(--br-ink);
    padding-bottom: 10px;
    border-bottom: 2px solid var(--br-teal);
  }

  .faq-item { margin-bottom: 12px; padding: 4px 16px; scroll-margin-top: 88px; } /* 하단 선 목록 → 유리 카드. 고정 헤더 아래로 착지 */
  .faq-item__q {
    cursor: pointer;
    font-weight: 700;
    font-size: 17px;
    line-height: 1.6;
    padding: 18px 4px;
    color: var(--br-ink);
    list-style: none;
    display: flex; justify-content: space-between; align-items: center; gap: 14px;
  }
  .faq-item__q::-webkit-details-marker { display: none; }
  /* 열림 표시 — 꺾쇠(글자 테두리, 자주 묻는 답 '자세히 보기'와 같은 방식)가 열면 뒤집힌다(기본 ▶ 대신) */
  .faq-item__q::after {
    content: ''; flex: none; width: 10px; height: 10px; margin-right: 6px;
    border-right: 2.4px solid var(--br-teal); border-bottom: 2.4px solid var(--br-teal);
    transform: translateY(-3px) rotate(45deg);
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .faq-item[open] > .faq-item__q::after { transform: translateY(3px) rotate(-135deg); }
  @media (hover: hover) and (pointer: fine) {
    .faq-item:not([open]) > .faq-item__q:hover::after { transform: translateY(0) rotate(45deg); }
  }
  .faq-item__body { padding: 2px 4px 24px; }

  /* 후킹 한 줄 — 답의 얼굴. 질문(17px/700 ink)보다 한 단계 아래 — 질문을 훑어 내려가는 게 FAQ 의 기본 동작이다
     (2026-09-23 teal→무채색 전환 뒤 hook 18px ink 가 질문보다 커져 위계가 뒤집혔다) */
  .faq-item__hook {
    font-size: 16px;
    font-weight: 600;
    color: var(--br-ink-sub);
    line-height: 1.6;
    margin-bottom: 12px;
  }

  /* 본문 — 길어도 읽히게 */
  .faq-item__a { font-size: 15.5px; line-height: 1.85; color: var(--br-ink-sub); }
  .faq-item__a :global(p) { margin-bottom: 14px; }
  .faq-item__a :global(p:last-child) { margin-bottom: 0; }
  .faq-item__a :global(h3), .faq-item__a :global(h4) { font-size: 16px; color: var(--br-ink); margin: 22px 0 10px; }
  .faq-item__a :global(ul) { margin: 0 0 14px 4px; list-style: none; display: grid; gap: 8px; }
  .faq-item__a :global(li) { padding-left: 16px; position: relative; }
  .faq-item__a :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 8px;
    height: 1px;
    background: var(--br-teal);
  }
  .faq-item__a :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    margin: 16px 0;
  }
  .faq-item__a :global(th), .faq-item__a :global(td) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--br-line);
  }
  .faq-item__a :global(th) { color: var(--br-ink); font-weight: 700; }
  /* 좁은 화면 — 4열 표가 카드 밖으로 밀려나지 않게 표만 옆으로 넘긴다 */
  @media (max-width: 640px) {
    .faq-item__a :global(table) { display: block; overflow-x: auto; }
    .faq-item__a :global(table) { font-size: 13px; }
    .faq-item__a :global(th), .faq-item__a :global(td) { padding: 8px 6px; }
  }
  .faq-item__a :global(strong) { color: var(--br-ink); }

  .faq-item__price {
    margin-top: 14px;
    padding: 12px 16px;
    background: var(--br-mist);
    border-left: 3px solid var(--br-teal);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--br-teal);
  }

  .faq-item__related { margin-top: 16px; }

  /* 분류별 앞 3문항 — 토글(3번째 문항 뒤)이 닫혀 있으면 그 뒤 문항을 숨긴다 */
  .faq-more:not([open]) ~ .faq-item { display: none; }
  .faq-more summary {
    display: inline-flex; align-items: center; min-height: 44px;
    list-style: none; cursor: pointer;
    font-size: 15px; font-weight: 700; color: var(--br-teal);
  }
  .faq-more summary::-webkit-details-marker { display: none; }
  .faq-more summary:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 2px; border-radius: 4px; }
  .faq-more[open] .faq-more__open,
  .faq-more:not([open]) .faq-more__close { display: none; }

  .faq-page__pending { text-align: center; padding: 24px 0; }
  .faq-page__pending-title { font-size: 20px; font-weight: 700; color: var(--br-ink); margin-bottom: 24px; }

  /* 작은 반응 — 누를 수 있는 것마다 마우스를 대면 저마다 다르게 움직인다(2026-10-02 대표 '귀여운 툴바' 참고).
     transform 만, hover 기기에서만. 누르면 살짝 눌린다 */
  .faq-ex__chip, .faq-ask__send, .faq-chat__again,
  .faq-start__h > span, .faq-ask__send svg, .faq-chat__chips :global(button) {
    transition: transform var(--dur-ui) var(--ease-out), background-color var(--dur-color) ease, color var(--dur-color) ease, border-color var(--dur-color) ease, box-shadow var(--dur-ui) var(--ease-out);
  }
  .faq-start__h > span { display: inline-block; }
