---
// 자주 묻는 질문 — 물어보면 답하는 구조(2026-09-23).
// 히어로(teal-deep, DESIGN.md §3)의 입력창에 평소 말로 물으면, 적어 둔 답 중 가장 가까운 문항 하나로 답한다.
// 짧은 답 먼저 → '자세히 보기' 로 전체 답 → 관련 페이지 링크. 전체 목록은 그 아래 그대로 둔다.
// 그 자리에서 지어내는 답이 아니다 — faq.json 에 적어 둔 답만 꺼내 보여 준다(근거 없는 말이 나올 틈이 없다).
// 콘텐츠는 faq.json 단일 소스. hold 문항은 페이지·JSON-LD 모두 제외.
// 목록은 순수 details/summary — JS가 죽어도 전 문항이 HTML로 노출된다.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import { loadFaqPage, renderFaqMd, faqPlainText, FAQ_CATEGORIES } from '../../lib/faq.ts';
import { normFaq } from '../../scripts/faq-rank';

const items = loadFaqPage();
/** 분류마다 처음 보이는 문항 수 — 나머지는 'N개 더 보기'로 접힌다 */
const FAQ_VISIBLE = 5;

// 검색 인덱스 — 질의·대상 모두 공백 제거+소문자 후 부분 일치 (마크다운 기호 제거한 평문 기준)
const norm = normFaq;

// 입력창 아래 예시 질문 — 누르면 그 문항으로 바로 답한다. 문항이 없으면(hold 등) 빌드에서 뺀다
const EXAMPLES_ALL = [
  { t: '에어컨에서 냄새가 나요', id: 'faq-smell' },
  { t: '천장형 에어컨에서 물이 떨어져요', id: 'faq-drip-ceiling' },
  { t: '세척은 얼마나 자주 해야 하나요', id: 'faq-clean-cycle' },
  { t: '추가비용은 언제 생기나요', id: 'faq-extra-cost' },
  { t: '분해 세척이랑 일반 세척은 뭐가 달라요', id: 'faq-deep-vs-basic' },
  { t: '우리 집 천장에도 달 수 있나요', id: 'faq-ceiling-check' },
];
const EXAMPLES = EXAMPLES_ALL.filter((e) => items.some((f) => f.id === e.id)).slice(0, 5);
EXAMPLES_ALL.filter((e) => !items.some((f) => f.id === e.id)).forEach((e) => console.warn(`[faq 예시] live 문항 없음, 칩에서 뺌: ${e.id}`));

// 물어본 질문에 먼저 보일 짧은 답과 '자세히 보기' 에 들어갈 나머지.
// 짧은 답 = short_a(페이지용) → chat_a(챗봇용으로 다듬어 둔 답) → 본문이 문단으로 시작하면 그 문단 → 한 줄 요약(hook).
//   본문이 소제목으로 시작하는 문항에서 소제목 글자('네 단계로 진행합니다')가 답이 되던 것을 막는다.
// 나머지에서는 짧은 답과 같은(앞 20자가 같은) 문단을 빼 같은 말이 두 번 나오지 않게 한다
const isPara = (b: string) => !/^(##|-|\|)/.test(b);
const answers = items.map((f) => {
  const blocks = f.a.split(/\n\s*\n/).map((b) => b.trim()).filter(Boolean);
  const first = blocks[0] ?? '';
  const short = f.shortA || f.chatA || (isPara(first) ? faqPlainText(first) : f.hook || faqPlainText(blocks.find(isPara) ?? first));
  const head = norm(short).slice(0, 20);
  const rest = blocks.filter((b) => norm(faqPlainText(b)).slice(0, 20) !== head).join('\n\n');
  const hook = f.hook && norm(f.hook) !== norm(short) && !norm(short).startsWith(norm(f.hook)) ? f.hook : '';
  return { f, short, rest, hook };
});

// 카테고리 순서 고정 (비용 먼저) — 문항이 있는 카테고리만 섹션 생성
const sections = FAQ_CATEGORIES
  .map((cat) => ({ cat, items: items.filter((i) => i.category === cat) }))
  .filter((s) => s.items.length > 0);

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '자주 묻는 질문', item: `${siteUrl}/faq/` },
    ],
  },
];
if (items.length) {
  // FAQPage — live 문항의 q+a 전체 (hook 제외)
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: faqPlainText(f.a) },
    })),
  });
}
---
<Base title="자주 묻는 질문" description="에어컨 설치·세척·고장·관리, 자주 묻는 질문과 답." jsonLd={jsonLd}>
  <PageHero>
    자주 묻는 질문
    <Fragment slot="extra">
      {items.length > 0 && (
        <Fragment>
          {/* 입력에 name 이 없다 — 적은 말(연락처 등)이 주소창·서버 기록에 남지 않게. JS 가 없어도 전 문항은 아래에 있다 */}
          <form class="faq-ask" role="search" data-faq-form>
            <label class="faq-ask__label" for="faq-q">궁금한 걸 물어보세요</label>
            <div class="faq-ask__bar">
              <input
                id="faq-q"
                type="search"
                class="faq-ask__input"
                placeholder="예: 에어컨에서 냄새가 나요"
                autocomplete="off"
                enterkeyhint="send"
                required
                data-faq-search
              />
              <button type="submit" class="faq-ask__send" aria-label="묻기">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></svg>
              </button>
            </div>
          </form>
          {EXAMPLES.length > 0 && (
            <div class="faq-ex">
              <p class="faq-ex__t" id="faq-ex-t">예)</p>
              <div class="faq-ex__list" role="group" aria-labelledby="faq-ex-t">
                {EXAMPLES.map((e) => (
                  <button type="button" class="faq-ex__chip" data-faq-ask={e.id} data-faq-text={e.t}>{e.t}</button>
                ))}
              </div>
            </div>
          )}
        </Fragment>
      )}
    </Fragment>
  </PageHero>

  <section class="bd-section faq-page">
    <div class="bd-container">
      {items.length > 0 ? (
        <Fragment>
          {/* 묻고 답하기 — 물으면 나타난다. 가장 최근 질문 하나만 보여 준다 */}
          <div class="faq-chat" data-faq-chat hidden>
            <p class="faq-chat__me"><span class="visually-hidden">물어본 질문: </span><span data-faq-me></span></p>

            {/* 답 — 아래 숨긴 문항별 답을 복제해 넣는다 */}
            <div class="faq-chat__we br-glass br-glass--medium" data-faq-we hidden></div>

            {/* 하나로 못 박기 어려울 때 — 고르게 한다 */}
            <div class="faq-chat__we br-glass br-glass--medium" data-faq-pick hidden>
              <p class="faq-chat__who">바람대로</p>
              <p class="faq-chat__lead" tabindex="-1" data-faq-focus data-faq-pick-title></p>
              <div class="faq-chat__chips" data-faq-pick-list></div>
            </div>

            {/* 걸리는 문항이 없을 때 */}
            <div class="faq-chat__we br-glass br-glass--medium" data-faq-none hidden>
              <p class="faq-chat__who">바람대로</p>
              <p class="faq-chat__lead" tabindex="-1" data-faq-focus>맞는 답을 찾지 못했습니다.</p>
              <p class="faq-chat__alt">예)</p>
              <div class="faq-chat__chips faq-chat__chips--tight" role="group" aria-label="예시 검색어">
                {['누수', '소음', '냄새', '필터', '설치비'].map((t) => <button type="button" data-faq-term={t}>{t}</button>)}
              </div>
            </div>

            <div class="faq-chat__next" data-faq-next hidden>
              <p class="faq-chat__next-t" id="faq-next-t">관련 질문</p>
              <div class="faq-chat__chips" role="group" aria-labelledby="faq-next-t" data-faq-next-list></div>
            </div>

            {/* 어느 상태에서든 사람에게 닿는 길 — 이 칸은 접수 창구가 아니다(접수는 챗봇 단일, DESIGN.md §6) */}
            <div class="faq-chat__foot">
              <button type="button" class="faq-chat__again" data-faq-again>다른 질문하기</button>
              {/* 채널톡(상담)을 바로 연다 — 물어본 말을 입력칸에 채워 둔다. 채널톡이 아직 안 떴으면 챗봇 '기타 문의'(상담 연결)로 */}
              <button disabled aria-describedby="chat-unavailable" type="button" class="br-pill faq-chat__bot-btn" data-chat-tree="etc" data-faq-consult>상담으로 묻기</button>
            </div>
          </div>

          {/* 문항별 답 — 물으면 이 중 하나를 복제해 답 카드에 넣는다. <template> 안에서는 Astro 식이 안 풀려 숨긴 div 로 둔다 */}
          <div hidden data-faq-bank>
          {answers.map(({ f, short, rest, hook }) => (
              <div data-faq-ans={f.id}>
                <p class="faq-chat__who">바람대로</p>
                <h2 class="faq-ans__q" tabindex="-1" data-faq-focus>{f.q}</h2>
                <p class="faq-ans__short">{short}</p>
                {(rest || f.priceNote) && (
                  <details class="faq-ans__more">
                    <summary class="faq-ans__toggle">자세히 보기</summary>
                    <div class="faq-ans__full">
                      {hook && rest && <p class="faq-item__hook">{hook}</p>}
                      {rest && <div class="faq-item__a" set:html={renderFaqMd(rest)} />}
                      {f.priceNote && <p class="faq-item__price">{f.priceNote}</p>}
                    </div>
                  </details>
                )}
                {f.related.length > 0 && (
                  <p class="faq-ans__links">
                    <span class="faq-ans__links-t">더 알아보기</span>
                    {f.related.map((r) => (
                      <a class="br-pill" href={r.href}>{r.label} <span aria-hidden="true">→</span></a>
                    ))}
                  </p>
                )}
              </div>
          ))}
          </div>

          <h2 class="faq-all__title">전체 질문</h2>
          <nav class="faq-nav br-reveal" aria-label="분류" data-faq-nav>
            {sections.map((s) => (
              <a class="faq-nav__chip" href={`#cat-${s.cat}`}>{s.cat} <span class="faq-nav__n">{s.items.length}</span></a>
            ))}
          </nav>

          {sections.map((s) => (
            <div class="faq-cat" id={`cat-${s.cat}`} data-faq-cat>
              <h3 class="faq-cat__title">{s.cat}</h3>
              {s.items.map((f, i) => (
                <Fragment>
                  <details
                    class="faq-item br-glass br-glass--medium"
                    id={f.id}
                    data-faq-item
                    data-cat={f.category}
                    data-q={norm(f.q)}
                    data-kw={norm(f.keywords.join(' '))}
                    data-hook={norm(f.hook)}
                    data-body={norm(faqPlainText(f.a))}
                  >
                    <summary class="faq-item__q">{f.q}</summary>
                    <div class="faq-item__body">
                      {f.hook && <p class="faq-item__hook">{f.hook}</p>}
                      <div class="faq-item__a" set:html={renderFaqMd(f.a, 4)} />
                      {f.priceNote && <p class="faq-item__price">{f.priceNote}</p>}
                      {f.related.length > 0 && (
                        <p class="faq-item__related br-pills">
                          {f.related.map((r) => (
                            <a class="br-pill" href={r.href}>{r.label} <span aria-hidden="true">→</span></a>
                          ))}
                        </p>
                      )}
                    </div>
                  </details>
                  {/* 분류마다 앞 5문항만 — 토글을 5번째 문항 바로 뒤에 둬서, 열면 Tab 이 새로 보인 문항으로 이어진다.
                      닫힌 동안 뒤 문항은 CSS 형제 선택자로 숨긴다(문항 HTML·검색 마크업은 그대로 다 있다) */}
                  {i === FAQ_VISIBLE - 1 && s.items.length > FAQ_VISIBLE && (
                    <details class="faq-more">
                      <summary>
                        <span class="faq-more__open">{s.items.length - FAQ_VISIBLE}개 더 보기</span>
                        <span class="faq-more__close">접기</span>
                        <span class="visually-hidden"> — {s.cat}</span>
                      </summary>
                    </details>
                  )}
                </Fragment>
              ))}
            </div>
          ))}
        </Fragment>
      ) : (
        <div class="faq-page__pending br-reveal">
          <p class="faq-page__pending-title">질문 목록을 준비하고 있습니다.</p>
          <button disabled aria-describedby="chat-unavailable" type="button" class="bd-cta" data-chat-tree="menu">바로 문의하기</button>
        </div>
      )}
    </div>
  </section>

  <CtaBand>
    답이 없는 질문은<br />직접 <em>답</em>해 드립니다
  </CtaBand>
</Base>

<script>
  // 묻고 답하기 — 물어본 말에 가장 가까운 문항 하나로 답한다. 고르는 규칙은 faq-rank.ts.
  import { decideFaq, type FaqDoc } from '../../scripts/faq-rank';
  import { ensureChannel, openConsult } from '../../lib/channel';

  const form = document.querySelector<HTMLFormElement>('[data-faq-form]');
  const input = document.querySelector<HTMLInputElement>('[data-faq-search]');
  const chat = document.querySelector<HTMLElement>('[data-faq-chat]');
  const me = document.querySelector<HTMLElement>('[data-faq-me]');
  const we = document.querySelector<HTMLElement>('[data-faq-we]');
  const pick = document.querySelector<HTMLElement>('[data-faq-pick]');
  const pickTitle = document.querySelector<HTMLElement>('[data-faq-pick-title]');
  const pickList = document.querySelector<HTMLElement>('[data-faq-pick-list]');
  const none = document.querySelector<HTMLElement>('[data-faq-none]');
  const next = document.querySelector<HTMLElement>('[data-faq-next]');
  const nextList = document.querySelector<HTMLElement>('[data-faq-next-list]');
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]'));
  const byId = new Map(items.map((el) => [el.id, el]));
  const docs: FaqDoc[] = items.map((el) => ({
    id: el.id, q: el.dataset.q ?? '', kw: el.dataset.kw ?? '', hook: el.dataset.hook ?? '', body: el.dataset.body ?? '',
  }));
  const qOf = (id: string) => byId.get(id)?.querySelector('summary')?.textContent?.trim() ?? '';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function chips(list: HTMLElement | null, ids: string[]) {
    if (!list) return;
    list.textContent = '';
    for (const id of ids) {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.faqAsk = id;
      b.textContent = qOf(id);
      list.append(b);
    }
  }

  function show(which: HTMLElement | null) {
    for (const el of [we, pick, none]) if (el) el.hidden = el !== which;
    if (next && which !== we) next.hidden = true;
  }

  function answer(id: string, near: string[]) {
    const src = document.querySelector<HTMLElement>(`[data-faq-bank] [data-faq-ans="${CSS.escape(id)}"]`);
    if (!src || !we) return false;
    we.replaceChildren(...Array.from(src.children, (n) => n.cloneNode(true)));
    show(we);
    // 관련 질문 — 같이 걸린 문항, 모자라면 같은 분류에서 채운다
    const rel = near.filter((r) => r !== id).slice(0, 3);
    const cat = byId.get(id)?.dataset.cat;
    for (const el of items) {
      if (rel.length >= 3) break;
      if (el.dataset.cat === cat && el.id !== id && !rel.includes(el.id)) rel.push(el.id);
    }
    chips(nextList, rel);
    if (next) next.hidden = rel.length === 0;
    return true;
  }

  // 주소에는 고객이 적은 말을 남기지 않는다(연락처를 적는 사람이 있다). 답이 정해졌을 때만 그 문항의 질문을 남겨
  // 새로고침·공유해도 같은 답이 나오게 한다 — 문항 질문으로 물으면 그 답이 나온다는 건 test:faq 1) 이 보장한다
  function remember(id: string | null) {
    const url = new URL(location.href);
    url.hash = '';
    if (id) url.searchParams.set('q', qOf(id)); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  let lastQ = '';
  function ask(raw: string, id?: string) {
    const q = raw.trim();
    if (!q || !chat) return;
    lastQ = q;
    void ensureChannel();                              // 상담 버튼을 누를 때 바로 열리도록 미리 띄운다(처음 한 번)
    if (input) input.value = q;
    if (me) me.textContent = q;
    chat.hidden = false;

    if (id && answer(id, [])) remember(id);
    else {
      const d = decideFaq(q, docs);
      if (d.kind === 'answer') { answer(d.id, d.near); remember(d.id); }
      else if (d.kind === 'pick') {
        if (pickTitle) pickTitle.textContent = d.vague ? '어떤 게 궁금하세요?' : '혹시 이 질문인가요?';
        chips(pickList, d.ids);
        show(pick);
        remember(null);
      } else { show(none); remember(null); }
    }

    // 새 답이 들어왔다는 걸 눈에 보이게 — 같은 자리에서 바뀌면 바뀐 줄 모른다
    chat.classList.remove('is-new');
    void chat.offsetWidth;
    chat.classList.add('is-new');

    // 답으로 초점을 옮긴다 — 화면 읽기 프로그램이 답을 읽고, 모바일은 키보드가 내려간다
    const focus = [we, pick, none].find((el) => el && !el.hidden)?.querySelector<HTMLElement>('[data-faq-focus]');
    focus?.focus({ preventScroll: true });
    chat.scrollIntoView({ block: 'start', behavior: reduced ? 'auto' : 'smooth' });
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input) return;
    // 공백만 친 경우 — required 가 못 막는다. 비워서 브라우저 안내를 띄운다
    if (!input.value.trim()) { input.value = ''; input.reportValidity(); return; }
    ask(input.value);
  });
  document.addEventListener('click', (e) => {
    // 답 안의 /faq/#문항 링크 — 새로 불러오면 답이 사라지므로 그 자리에서 그 문항으로 답한다
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="/faq/#"]');
    const hid = a?.hash.slice(1);
    if (hid && byId.has(hid)) { e.preventDefault(); ask(qOf(hid), hid); return; }
    // 못 찾았을 때의 예시 검색어
    const term = (e.target as HTMLElement).closest<HTMLElement>('[data-faq-term]')?.dataset.faqTerm;
    if (term) { ask(term); return; }
    // 예시·관련 질문·고르기 — 문항 id 로 바로 답한다
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-faq-ask]');
    if (!b?.dataset.faqAsk) return;
    ask(b.dataset.faqText ?? qOf(b.dataset.faqAsk), b.dataset.faqAsk);
  });
  // 상담 — 채널톡이 열리면 챗봇(문서에 걸린 data-chat-tree 처리)까지 가지 않게 여기서 멈춘다
  document.querySelector('[data-faq-consult]')?.addEventListener('click', (e) => {
    if (openConsult(lastQ || undefined)) e.stopPropagation();
  });
  document.querySelector('[data-faq-again]')?.addEventListener('click', () => {
    input?.select();
    input?.focus({ preventScroll: true });
    input?.scrollIntoView({ block: 'center', behavior: reduced ? 'auto' : 'smooth' });
  });

  // 링크로 들어온 질문(?q=)이나 문항(#faq-…)에 바로 답한다 — 챗봇·다른 페이지에서 이 답으로 보낼 수 있다
  const initial = new URL(location.href).searchParams.get('q');
  const hashId = decodeURIComponent(location.hash.slice(1));
  if (byId.has(hashId)) ask(qOf(hashId), hashId);
  else if (initial) ask(initial);
</script>

