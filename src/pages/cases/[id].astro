---
// 시공사례 상세
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import { COMPLEX_BY_SLUG, complexLine } from '../../lib/caselog';
import { SITE_CONFIG } from '../../config.js';

export async function getStaticPaths() {
  // sample: true는 페이지 자체를 만들지 않는다 — 목록에서 빼도 URL이 살아 있으면
  // sitemap·검색으로 노출되므로 여기서 막아야 완전히 차단된다
  const entries = (await getCollection('cases')).filter((e) => !e.data.sample);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { region, space, brand, type, units, date, cover, sample, photos, answer, qa, updated } = entry.data;
// 같은 단지의 시공 기록(있을 때) — 단지 페이지로 잇는다
const complex = entry.data.apt ? COMPLEX_BY_SLUG.get(entry.data.apt) : undefined;
const title = entry.data.title || `${region} ${space} ${brand} ${type} ${units}대`;
const description = answer || `${title} 시공 기록.`;
// 화면 제목은 '｜' 앞을 크게, 뒤를 작은 줄로(검색용 한 줄 제목이 막대에서 어색하게 꺾이던 것). <title>·JSON-LD 는 원문 그대로
const [tMain, tSub] = title.split(/\s*[｜|]\s*/);
const altTitle = tSub ? `${tMain} — ${tSub}` : tMain;   // 화면낭독기가 '｜'를 읽지 않게
// 본문 아래 사진 — cover 와 본문에 이미 넣은 사진은 뺀다
const gallery = photos.filter((p) => p.file !== cover && !entry.body?.includes(p.file));
const dateLabel = date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const pageUrl = `${siteUrl}/cases/${entry.id}/`;
const org = { '@type': 'Organization', name: '바람대로', url: `${siteUrl}/` };
const images = photos.length ? photos.map((p) => `${siteUrl}${p.file}`) : cover ? [`${siteUrl}${cover}`] : [];
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    author: org,
    publisher: org,
    mainEntityOfPage: pageUrl,
    inLanguage: 'ko-KR',
    about: { '@type': 'Service', name: `에어컨 ${type}`, areaServed: region, provider: org },
    ...(images.length ? { image: images } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '시공사례', item: `${siteUrl}/cases/` },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
if (qa.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: qa.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}

// 같은 지역의 다른 사진 사례 — 날짜가 가까운 순으로 네 건
const nearby = (await getCollection('cases'))
  .filter((e) => !e.data.sample && e.id !== entry.id && e.data.region === region)
  .sort((a, b) => Math.abs(+a.data.date - +date) - Math.abs(+b.data.date - +date))
  .slice(0, 4);

const specs = [
  ['지역', region],
  ...(complex && complexLine(complex) ? [['단지', complexLine(complex)]] : []),
  ['공간', space],
  ['브랜드', brand],
  ['작업', type],
  ['대수', `${units}대`],
  ['작업일', dateLabel],
];
---
<Base title={title} description={description} jsonLd={jsonLd} ogImage={cover}>
  <article class="bd-section case-detail">
    <div class="bd-container">
      {/* 2026-10-02 대표: 배경 위에 글·사진을 바로 두지 말고 흰 유리판 한 장 안에(블로그 본문 카드와 같은 flat 유리) */}
      <div class="case-detail__card br-glass br-glass--flat">
      <p class="bd-microlabel">{type} · {region}</p>
      <h1 class="case-detail__title">{tMain}{tSub && <span class="case-detail__sub">{tSub}</span>}</h1>
      {sample && <p class="case-detail__sample">샘플 콘텐츠 — 실제 사례로 교체 예정</p>}

      {cover && <img class="case-detail__cover" src={cover} alt={`${altTitle} 현장`} />}

      <dl class="case-detail__specs">
        {specs.map(([k, v]) => (
          <div class="case-detail__spec">
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>

      {/* 견적 문의 — 사례를 본 자리에서 바로(2026-10-06 대표: 견적 문의 유도) */}
      <div class="case-detail__cta">
        <button disabled aria-describedby="chat-unavailable" type="button" class="bd-cta" data-chat-tree={type === '세척' ? 'clean' : 'install'}>{complex ? '이 단지 견적 문의' : '비슷한 조건 견적 문의'}</button>
        {SITE_CONFIG.PHONE && <a class="br-pill" href={`tel:${SITE_CONFIG.PHONE.replace(/[^0-9]/g, '')}`}>전화 {SITE_CONFIG.PHONE}</a>}
        {complex && <a class="br-pill" href={`/cases/apt/${complex.slug}/`}>{complex.name} 기록 {complex.records.length}건 <span aria-hidden="true">→</span></a>}
      </div>


      <div class="case-detail__body">
        <Content />
      </div>

      {gallery.length > 0 && (
        <div class="case-detail__photos">
          {gallery.map((p) => (
            <figure>
              <img src={p.file} alt={p.caption ? `${tMain} — ${p.caption}` : `${altTitle} 현장`} loading="lazy" decoding="async" />
              {p.caption && <figcaption>{p.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}

      {qa.length > 0 && (
        <section class="case-detail__qa">
          <h2>이 현장 질문</h2>
          {qa.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      {/* 관련 안내 — 모든 사례에 같은 줄(내비게이션). 사례 본문에는 '비슷한 집이라면' 같은 공통 안내를 쓰지 않는다(2026-10-01 반복 문단 정리) */}
      <nav class="case-detail__more" aria-label="관련 안내">
        <p>관련 안내</p>
        <ul>
          {(type === '세척'
            ? [['세척 안내', '/care/'], ['세척 범위', '/faq/#faq-clean-scope'], ['가격 안내', '/price/']]
            : [['설치 안내', '/install/'], ['천장 설치 조건', '/faq/#faq-ceiling-check'], ['배관을 넣는 시기', '/faq/#faq-pre-post'], ['단배관과 다배관', '/faq/#faq-pipe-type'], ['가격 안내', '/price/']]
          ).map(([t, h]) => <li><a href={h}>{t}</a></li>)}
        </ul>
      </nav>

      {nearby.length > 0 && (
        <nav class="case-detail__more" aria-label={`${region} 다른 사례`}>
          <p>{region} 다른 사례</p>
          <ul>
            {nearby.map((e) => <li><a href={`/cases/${e.id}/`}>{(e.data.title || '').split(/\s*[｜|]\s*/)[0]}</a></li>)}
          </ul>
        </nav>
      )}
      </div>

      <p class="case-detail__back"><a class="br-pill" href="/cases/">목록으로</a></p>
    </div>
  </article>
  <CtaBand chatTree={type === '세척' ? 'clean' : 'install'}>
    다음 현장이<br /><em>우리 집</em>이어도 됩니다
    <Fragment slot="sub">기종과 대수, 설치 위치. 이 정도면 됩니다.</Fragment>
  </CtaBand>
</Base>

<style>
  .case-detail { background: transparent; } /* 유리 카드 호스트 */
  .case-detail .bd-container { max-width: 760px; }
  .case-detail__card { padding: 24px 20px 28px; }
  @media (min-width: 768px) { .case-detail__card { padding: 40px 40px 44px; } }
  .case-detail__title { font-size: clamp(24px, 3.4vw, 34px); margin: 10px 0 14px; text-wrap: balance; overflow-wrap: anywhere; } /* 긴 단지명이 320px 카드 밖으로 나가지 않게 */
  .case-detail__sub { display: block; margin-top: 6px; font-family: var(--sans); font-size: 0.56em; font-weight: 600; line-height: 1.5; color: var(--ink-soft); } /* h1 안이지만 부제는 본문 글꼴(제목 글꼴은 Bold 한 벌뿐) */
  .case-detail__sample {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    color: var(--copper);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 4px 12px;
    margin-bottom: 8px;
  }
  .case-detail__cover {
    width: 100%;
    margin: 20px 0;
    border-radius: calc(var(--radius) - 4px); /* 유리판 안 — 판 모서리보다 한 단 작게 */
    outline: 1px solid oklch(0 0 0 / 0.08);
    outline-offset: -1px;
  }
  .case-detail__specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px 20px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
    margin: 24px 0 32px;
  }
  .case-detail__spec dt { font-size: 12px; color: var(--ink-soft); margin-bottom: 2px; }
  .case-detail__spec dd { font-size: 15px; font-weight: 600; }
  .case-detail__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin: 22px 0 6px; }
  .case-detail__body { font-size: 16px; color: var(--ink); max-width: 36em; text-wrap: pretty; word-break: keep-all; }
  /* 본문 사진 — 아주 긴 세로 사진이 한 화면을 넘게 차지하지 않게 */
  .case-detail__body :global(img) { max-height: min(80vh, 760px); width: auto; margin-inline: auto; border-radius: calc(var(--radius) - 4px); }
  .case-detail__body :global(p) { margin-bottom: 14px; }
  .case-detail__body :global(ul) { margin: 0 0 14px 20px; }
  .case-detail__body :global(blockquote) {
    border-left: 2px solid var(--copper);
    padding: 6px 0 6px 16px;
    color: var(--ink-soft);
    margin-bottom: 18px;
  }
  .case-detail__body :global(a) { color: var(--br-teal-deep); text-decoration: underline; text-underline-offset: 3px; }
  .case-detail__body :global(h2) { font-size: 20px; margin: 32px 0 12px; }
  .case-detail__photos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 32px; }
  @media (min-width: 768px) { .case-detail__photos { grid-template-columns: repeat(3, 1fr); } }
  .case-detail__photos img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: calc(var(--radius) - 4px); }
  .case-detail__photos figcaption { font-size: 13px; color: var(--ink-soft); margin-top: 6px; }
  .case-detail__qa { margin-top: 40px; }
  .case-detail__qa h2 { font-size: 20px; margin-bottom: 8px; }
  .case-detail__qa details { border-bottom: 1px solid var(--line); }
  .case-detail__qa summary { cursor: pointer; font-weight: 700; font-size: 16px; padding: 16px 4px; }
  .case-detail__qa p { font-size: 15px; color: var(--ink-soft); padding: 0 4px 16px; line-height: 1.8; }
  .case-detail__more { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); }
  .case-detail__qa + .case-detail__more { margin-top: 28px; padding-top: 0; border-top: 0; } /* 질문 마지막 선과 겹쳐 빈 칸처럼 보이던 두 줄 */
  .case-detail__more p { font-size: 14px; font-weight: 700; color: var(--ink-soft); }
  .case-detail__more ul { margin-top: 10px; list-style: none; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .case-detail__more a { color: var(--br-teal-deep); text-decoration: underline; text-underline-offset: 3px; font-size: 15px; }
  .case-detail__back { margin-top: 40px; }
  @media (max-width: 600px) {
    .case-detail__specs { grid-template-columns: repeat(2, 1fr); }
  }
</style>
