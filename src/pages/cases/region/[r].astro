---
// 지역(시·구)별 시공 기록 — 단지 목록과 날짜순 기록. 숫자는 case-log.json 에서 센다
import Base from '../../../layouts/Base.astro';
import CtaBand from '../../../components/v2/CtaBand.astro';
import LogTable from '../../../components/cases/LogTable.astro';
import { REGIONS, stats, brandLine, fmtDate, fmtYm, ymOf, regionSlug, LOG_UPDATED } from '../../../lib/caselog';

export function getStaticPaths() {
  return REGIONS.map((g) => ({ params: { r: regionSlug(g.region) }, props: { g } }));
}
const { g } = Astro.props;
const s = stats(g.records);
// 같은 지역에 이름이 같은 단지가 둘이면 동을 붙여 구분한다
const seen = new Map<string, number>();
for (const c of g.complexes) seen.set(c.name, (seen.get(c.name) ?? 0) + 1);
const dupName = new Set([...seen].filter(([, n]) => n > 1).map(([k]) => k));
const answer = `바람대로가 ${g.region}에서 마친 시스템에어컨 현장은 ${s.n}건입니다(${fmtYm(ymOf(s.first))}~${fmtYm(ymOf(s.last))}).${g.complexes.length ? ` 단지명이 확인된 곳은 ${g.complexes.length}곳이고,` : ''}${s.brands.length ? ` 브랜드는 ${brandLine(s.brands)}입니다.` : ''}`;
const title = `${g.region} 시스템에어컨 시공 기록 ${s.n}건`;
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const pageUrl = `${siteUrl}/cases/region/${regionSlug(g.region)}/`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description: answer, url: pageUrl, inLanguage: 'ko-KR', dateModified: s.last,
    about: { '@type': 'Service', name: '시스템에어컨 설치', areaServed: g.region, provider: { '@type': 'Organization', name: '바람대로', url: `${siteUrl}/` } } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '시공사례', item: `${siteUrl}/cases/` },
    { '@type': 'ListItem', position: 3, name: g.region, item: pageUrl },
  ] },
];
---
<Base title={title} description={answer} jsonLd={jsonLd}>
  <article class="bd-section logp">
    <div class="bd-container">
      <div class="logp__card br-glass br-glass--flat">
        <nav class="logp__crumb" aria-label="위치"><a href="/cases/">시공사례</a></nav>
        <h1 class="logp__title">{g.region} 시공 기록<span class="logp__sub">{s.n}건{g.complexes.length > 0 && ` · 단지 ${g.complexes.length}곳`}</span></h1>
        <p class="logp__answer">{answer}</p>
        <div class="logp__cta"><button disabled aria-describedby="chat-unavailable" type="button" class="bd-cta" data-chat-tree="install">{g.region} 견적 문의</button></div>

        {g.complexes.length > 0 && (
          <Fragment>
            <h2 class="logp__h">단지</h2>
            <ul class="logp__apts">
              {g.complexes.map((c) => <li><a class="br-pill" href={`/cases/apt/${c.slug}/`}>{dupName.has(c.name) ? `${c.dong} ${c.name}` : c.name} <span class="logp__n">{c.records.length}건</span></a></li>)}
            </ul>
          </Fragment>
        )}

        <h2 class="logp__h">날짜별 기록</h2>
        <LogTable records={g.records} showRegion={false} caption={`${g.region} 시스템에어컨 시공 기록`} />
        <p class="logp__note">일정 기록 기준 · {fmtDate(LOG_UPDATED)} 갱신</p>
      </div>
    </div>
  </article>
  <CtaBand chatTree="install">
    다음 현장이<br /><em>우리 집</em>이어도 됩니다
    <Fragment slot="sub">기종과 대수, 설치 위치. 이 정도면 됩니다.</Fragment>
  </CtaBand>
</Base>

<style>
  .logp { background: transparent; }
  .logp .bd-container { max-width: 920px; }
  .logp__card { padding: 26px 20px 30px; }
  .logp__crumb { font-size: 13px; font-weight: 600; }
  .logp__crumb a { color: var(--br-teal); text-decoration: underline; text-underline-offset: 3px; }
  .logp__title { margin: 12px 0 0; font-size: clamp(26px, 3.6vw, 38px); line-height: 1.25; text-wrap: balance; }
  .logp__sub { display: block; margin-top: 6px; font-family: var(--sans); font-size: 0.52em; font-weight: 600; color: var(--br-ink-sub); font-variant-numeric: tabular-nums; }
  .logp__answer { margin: 18px 0 0; font-size: 17px; line-height: 1.8; max-width: 36em; text-wrap: pretty; word-break: keep-all; }
  .logp__cta { margin-top: 22px; }
  .logp__h { margin: 40px 0 12px; font-size: 20px; }
  .logp__apts { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .logp__n { font-weight: 600; color: var(--br-ink-sub); font-variant-numeric: tabular-nums; }
  .logp__note { margin-top: 10px; font-size: 13px; color: var(--br-ink-sub); }
  @media (min-width: 720px) { .logp__card { padding: 40px 44px 44px; } }
</style>
