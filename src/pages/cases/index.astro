---
// 시공사례 목록 v2 — 짧은 히어로 + region/type 필터 + CTA 밴드.
// 구 버전은 src/legacy/cases-index-v1.astro.txt 보존.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';

// sample: true 사례는 형식 참고용 템플릿 — 프로덕션 미노출 (md frontmatter에서 플래그를 지우면 자동 노출)
const entries = (await getCollection('cases'))
  .filter((e) => !e.data.sample)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const regions = [...new Set(entries.map((e) => e.data.region))];
const types = [...new Set(entries.map((e) => e.data.type))];

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '시공사례', item: `${siteUrl}/cases/` },
  ],
};
---
<Base title="시공사례" description="바람대로 에어컨 설치·세척·복원 시공사례." jsonLd={breadcrumb}>
  <PageHero eyebrow="시공사례">
    말보다 현장으로<br />보여드립니다
    <Fragment slot="sub">작업 전·후 상태를 사진과 기록으로 남깁니다. 실측값이 없는 수치는 쓰지 않습니다.</Fragment>
  </PageHero>

  <section class="bd-section">
    <div class="bd-container">
      {entries.length > 0 ? (
        <Fragment>
          <div class="case-filters br-reveal" data-case-filters>
            <div class="case-filters__group" role="group" aria-label="지역 필터">
              <button type="button" class="case-filters__btn is-active" data-filter-region="">전체 지역</button>
              {regions.map((r) => (
                <button type="button" class="case-filters__btn" data-filter-region={r}>{r}</button>
              ))}
            </div>
            <div class="case-filters__group" role="group" aria-label="작업 유형 필터">
              <button type="button" class="case-filters__btn is-active" data-filter-type="">전체 작업</button>
              {types.map((t) => (
                <button type="button" class="case-filters__btn" data-filter-type={t}>{t}</button>
              ))}
            </div>
          </div>

          <div class="case-grid" data-case-grid>
            {entries.map((entry) => <CaseCard entry={entry} />)}
          </div>
          <p class="case-empty" data-case-empty hidden>조건에 맞는 사례가 아직 없습니다.</p>
        </Fragment>
      ) : (
        <div class="case-pending br-reveal">
          <p class="case-pending__title">시공 기록을 준비 중입니다.</p>
          <p class="case-pending__body">작업 전·후 사진과 현장 기록이 정리되는 대로 올립니다.<br />지금 필요한 상담은 챗봇으로 바로 접수하실 수 있습니다.</p>
          <button type="button" class="bd-cta case-pending__cta" data-chat-tree="menu">상담 접수하기</button>
        </div>
      )}
    </div>
  </section>

  <CtaBand>
    다음 현장이<br /><em>우리 집</em>이어도 됩니다
    <Fragment slot="sub">사진 몇 장이면 견적 상담이 시작됩니다.</Fragment>
  </CtaBand>
</Base>

<script>
  // region/type 필터 — data-attr 매칭, 상태는 버튼 is-active로만 (v1 로직 그대로)
  const root = document.querySelector('[data-case-filters]');
  const grid = document.querySelector('[data-case-grid]');
  const empty = document.querySelector('[data-case-empty]');
  if (root && grid) {
    let region = '';
    let type = '';
    const apply = () => {
      let visible = 0;
      grid.querySelectorAll<HTMLElement>('.bd-case-card').forEach((card) => {
        const ok =
          (!region || card.dataset.region === region) &&
          (!type || card.dataset.type === type);
        card.style.display = ok ? '' : 'none';
        if (ok) visible += 1;
      });
      if (empty) (empty as HTMLElement).hidden = visible > 0;
    };
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      if (btn.dataset.filterRegion !== undefined) {
        region = btn.dataset.filterRegion ?? '';
        btn.parentElement?.querySelectorAll('.is-active').forEach((b) => b.classList.remove('is-active'));
      } else if (btn.dataset.filterType !== undefined) {
        type = btn.dataset.filterType ?? '';
        btn.parentElement?.querySelectorAll('.is-active').forEach((b) => b.classList.remove('is-active'));
      } else return;
      btn.classList.add('is-active');
      apply();
    });
  }
</script>

<style>
  .case-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-bottom: 32px;
  }
  .case-filters__group { display: flex; flex-wrap: wrap; gap: 8px; }
  .case-filters__btn {
    font-size: 13px;
    font-weight: 500;
    padding: 9px 14px;
    min-height: 40px;
    border: 1px solid var(--br-line);
    border-radius: 999px;
    color: var(--br-text-sub);
    transition: color var(--dur-color) ease, border-color var(--dur-color) ease, background-color var(--dur-color) ease;
  }
  .case-filters__btn:active { transform: scale(0.96); }
  @media (pointer: coarse) {
    .case-filters__btn { min-height: 44px; padding: 11px 16px; }
  }
  @media (hover: hover) and (pointer: fine) {
    .case-filters__btn:hover { border-color: var(--br-canopy); color: var(--br-canopy); }
  }
  .case-filters__btn.is-active {
    background: var(--br-canopy);
    border-color: var(--br-canopy);
    color: #fff;
  }
  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .case-empty { color: var(--br-text-sub); padding: 40px 0; }

  /* 실사례 0건 폴백 — 빈 그리드 대신 안내 + 챗봇 접수 */
  .case-pending {
    border: 1px solid var(--br-line);
    border-radius: 16px;
    background: var(--br-bg-alt);
    padding: 48px 24px;
    text-align: center;
  }
  .case-pending__title { font-size: 20px; font-weight: 800; color: var(--br-canopy); }
  .case-pending__body { margin-top: 12px; font-size: 15px; line-height: 1.7; color: var(--br-text-sub); }
  .case-pending__cta { margin-top: 28px; }
  @media (max-width: 900px) {
    .case-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .case-grid { grid-template-columns: 1fr; }
  }
</style>
