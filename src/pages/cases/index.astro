---
// 시공사례 목록 v2 — 짧은 히어로 + region/type 필터 + CTA 밴드.
// 구 버전은 src/legacy/cases-index-v1.astro.txt 보존.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';

// sample: true 사례는 형식 참고용 템플릿 — 프로덕션 미노출 (md frontmatter에서 플래그를 지우면 자동 노출)
const entries = (await getCollection('cases'))
  .filter((e) => !e.data.sample)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const regions = [...new Set(entries.map((e) => e.data.region))];
const types = [...new Set(entries.map((e) => e.data.type))];
// 레코드 확장 축 — 값이 있는 사례가 하나라도 있을 때만 필터 그룹이 나온다
const tags = [...new Set(entries.flatMap((e) => e.data.tags))];
const models = [...new Set(entries.map((e) => e.data.model).filter(Boolean))];

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '시공사례', item: `${siteUrl}/cases/` },
  ],
};
---
<Base title="시공사례" description="바람대로 에어컨 설치·세척·복원 시공사례." jsonLd={breadcrumb}>
  <PageHero eyebrow="시공사례">
    기록을 쌓는<br />중입니다
    <Fragment slot="sub">작업 전·후 상태를 사진과 기록으로 남깁니다.</Fragment>
  </PageHero>

  {/* 사례가 0건이면 섹션째 그리지 않는다 — 준비 중 안내·접수 버튼은 히어로·CTA 밴드와 같은 말이었다 */}
  {entries.length > 0 && (
  <section class="bd-section cases">
    <div class="bd-container">
        <Fragment>
          <div class="case-filters br-reveal" data-case-filters>
            <div class="case-filters__group" role="group" aria-label="지역 필터">
              <button type="button" class="case-filters__btn is-active" data-filter-region="">전체 지역</button>
              {regions.map((r) => (
                <button type="button" class="case-filters__btn" data-filter-region={r}>{r}</button>
              ))}
            </div>
            <div class="case-filters__group" role="group" aria-label="작업 유형 필터">
              <button type="button" class="case-filters__btn is-active" data-filter-type="">전체 작업</button>
              {types.map((t) => (
                <button type="button" class="case-filters__btn" data-filter-type={t}>{t}</button>
              ))}
            </div>
            {models.length > 0 && (
              <div class="case-filters__group" role="group" aria-label="기종 필터">
                <button type="button" class="case-filters__btn is-active" data-filter-model="">전체 기종</button>
                {models.map((m) => (
                  <button type="button" class="case-filters__btn" data-filter-model={m}>{m}</button>
                ))}
              </div>
            )}
            {tags.length > 0 && (
              <div class="case-filters__group" role="group" aria-label="태그 필터">
                <button type="button" class="case-filters__btn is-active" data-filter-tag="">전체 태그</button>
                {tags.map((t) => (
                  <button type="button" class="case-filters__btn" data-filter-tag={t}>{t}</button>
                ))}
              </div>
            )}
          </div>

          <div class="case-grid" data-case-grid>
            {entries.map((entry) => (
              <div class="case-grid__cell" data-model={entry.data.model} data-tags={entry.data.tags.join('|')}>
                <CaseCard entry={entry} />
              </div>
            ))}
          </div>
          <p class="case-empty" data-case-empty hidden>조건에 맞는 사례가 아직 없습니다.</p>
        </Fragment>
    </div>
  </section>
  )}

  <CtaBand>
    다음 현장이<br /><em>우리 집</em>이어도 됩니다
    <Fragment slot="sub">기종과 대수, 설치 위치. 이 정도면 됩니다.</Fragment>
  </CtaBand>
</Base>

<script>
  // region/type 필터 — data-attr 매칭, 상태는 버튼 is-active로만 (v1 로직 그대로)
  const root = document.querySelector('[data-case-filters]');
  const grid = document.querySelector('[data-case-grid]');
  const empty = document.querySelector('[data-case-empty]');
  if (root && grid) {
    let region = '';
    let type = '';
    let model = '';
    let tag = '';
    // 선택 상태를 스크린리더에도 알린다 — 틴트만으로는 눈에만 보인다
    const sync = () => root.querySelectorAll('.case-filters__btn').forEach((b) => b.setAttribute('aria-pressed', String(b.classList.contains('is-active'))));
    sync();
    const apply = () => {
      let visible = 0;
      grid.querySelectorAll<HTMLElement>('.case-grid__cell').forEach((cell) => {
        const card = cell.querySelector<HTMLElement>('.bd-case-card');
        const cellTags = (cell.dataset.tags ?? '').split('|').filter(Boolean);
        const ok =
          (!region || card?.dataset.region === region) &&
          (!type || card?.dataset.type === type) &&
          (!model || cell.dataset.model === model) &&
          (!tag || cellTags.includes(tag));
        cell.style.display = ok ? '' : 'none';
        if (ok) visible += 1;
      });
      if (empty) (empty as HTMLElement).hidden = visible > 0;
    };
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      if (btn.dataset.filterRegion !== undefined) region = btn.dataset.filterRegion ?? '';
      else if (btn.dataset.filterType !== undefined) type = btn.dataset.filterType ?? '';
      else if (btn.dataset.filterModel !== undefined) model = btn.dataset.filterModel ?? '';
      else if (btn.dataset.filterTag !== undefined) tag = btn.dataset.filterTag ?? '';
      else return;
      btn.parentElement?.querySelectorAll('.is-active').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      sync();
      apply();
    });
  }
</script>

<style>
  .case-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-bottom: 32px;
  }
  .case-filters__group { display: flex; flex-wrap: wrap; gap: 8px; }
  .case-filters__btn {
    font-size: 13px;
    font-weight: 500;
    padding: 9px 14px;
    min-height: 40px;
    border: 1px solid var(--br-line);
    border-radius: 999px;
    color: var(--br-ink-sub);
    transition: color var(--dur-color) ease, border-color var(--dur-color) ease, background-color var(--dur-color) ease;
  }
  .case-filters__btn:active { transform: scale(0.96); }
  @media (pointer: coarse) {
    .case-filters__btn { min-height: 44px; padding: 11px 16px; }
  }
  @media (hover: hover) and (pointer: fine) {
    .case-filters__btn:hover { border-color: var(--br-teal); color: var(--br-teal); }
  }
  /* 선택 = 틴트 + teal 글자·테두리. teal 채움은 문의 버튼(.bd-cta) 모양이라 쓰지 않는다 */
  .case-filters__btn.is-active {
    background: var(--tint-strong);
    border-color: var(--br-teal);
    color: var(--br-teal);
  }
  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .case-empty { color: var(--br-ink-sub); padding: 40px 0; }

  .cases { background: transparent; } /* 유리 카드 호스트 */
  @media (max-width: 900px) {
    .case-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .case-grid { grid-template-columns: 1fr; }
  }
</style>
