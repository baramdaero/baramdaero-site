---
// 시공사례 목록 — region/type 필터 (클라이언트 필터, 빌드 시 전체 렌더)
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';

const entries = (await getCollection('cases'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const regions = [...new Set(entries.map((e) => e.data.region))];
const types = [...new Set(entries.map((e) => e.data.type))];

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '시공사례', item: `${siteUrl}/cases/` },
  ],
};
---
<Base title="시공사례" description="바람대로 에어컨 설치·세척·복원 시공사례." jsonLd={breadcrumb}>
  <section class="bd-section">
    <div class="bd-container">
      <p class="bd-microlabel">Cases</p>
      <h1 class="bd-section-title">시공사례</h1>

      <div class="case-filters" data-case-filters>
        <div class="case-filters__group" role="group" aria-label="지역 필터">
          <button type="button" class="case-filters__btn is-active" data-filter-region="">전체 지역</button>
          {regions.map((r) => (
            <button type="button" class="case-filters__btn" data-filter-region={r}>{r}</button>
          ))}
        </div>
        <div class="case-filters__group" role="group" aria-label="작업 유형 필터">
          <button type="button" class="case-filters__btn is-active" data-filter-type="">전체 작업</button>
          {types.map((t) => (
            <button type="button" class="case-filters__btn" data-filter-type={t}>{t}</button>
          ))}
        </div>
      </div>

      <div class="case-grid" data-case-grid>
        {entries.map((entry) => <CaseCard entry={entry} />)}
      </div>
      <p class="case-empty" data-case-empty hidden>조건에 맞는 사례가 아직 없습니다.</p>
    </div>
  </section>
</Base>

<script>
  // region/type 필터 — data-attr 매칭, 상태는 버튼 is-active로만
  const root = document.querySelector('[data-case-filters]');
  const grid = document.querySelector('[data-case-grid]');
  const empty = document.querySelector('[data-case-empty]');
  if (root && grid) {
    let region = '';
    let type = '';
    const apply = () => {
      let visible = 0;
      grid.querySelectorAll<HTMLElement>('.bd-case-card').forEach((card) => {
        const ok =
          (!region || card.dataset.region === region) &&
          (!type || card.dataset.type === type);
        card.style.display = ok ? '' : 'none';
        if (ok) visible += 1;
      });
      if (empty) (empty as HTMLElement).hidden = visible > 0;
    };
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      if (btn.dataset.filterRegion !== undefined) {
        region = btn.dataset.filterRegion ?? '';
        btn.parentElement?.querySelectorAll('.is-active').forEach((b) => b.classList.remove('is-active'));
      } else if (btn.dataset.filterType !== undefined) {
        type = btn.dataset.filterType ?? '';
        btn.parentElement?.querySelectorAll('.is-active').forEach((b) => b.classList.remove('is-active'));
      } else return;
      btn.classList.add('is-active');
      apply();
    });
  }
</script>

<style>
  .case-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-bottom: 32px;
  }
  .case-filters__group { display: flex; flex-wrap: wrap; gap: 8px; }
  .case-filters__btn {
    font-size: 13px;
    font-weight: 500;
    padding: 9px 14px;
    min-height: 40px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    transition: color var(--dur-color) ease, border-color var(--dur-color) ease, background-color var(--dur-color) ease;
  }
  .case-filters__btn:active { transform: scale(0.96); }
  @media (pointer: coarse) {
    .case-filters__btn { min-height: 44px; padding: 11px 16px; }
  }
  @media (hover: hover) and (pointer: fine) {
    .case-filters__btn:hover { border-color: var(--ink-soft); color: var(--ink); }
  }
  .case-filters__btn.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .case-empty { color: var(--ink-soft); padding: 40px 0; }
  @media (max-width: 900px) {
    .case-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .case-grid { grid-template-columns: 1fr; }
  }
</style>
