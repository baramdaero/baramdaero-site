---
// 시공사례 목록 v3(2026-10-01 대표) — 아파트명·지역 검색 + 지역별 묶음.
// 검색은 단지명이 든 제목·지역·공간·브랜드·작업·기종·태그를 띄어쓰기 없이 비교한다(예: '봇들마을' '성남' '삼성').
// 띄어 쓴 말은 따로 찾아 모두 들어 있는 사례만 보인다(예: '봇들마을 성남'). 주소 ?q= 로 검색어를 넘길 수 있다(공유용).
// 필터 버튼(v2)은 검색으로 대체 — 구 버전은 git 기록.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import { normFaq } from '../../scripts/faq-rank';

// sample: true 사례는 비공개(사람이 사진 확인 뒤 줄을 지우면 자동 노출)
const entries = (await getCollection('cases'))
  .filter((e) => !e.data.sample)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 지역 묶음 — region 은 '시·도 시·구'(예: 경기 성남). 서울 → 경기 → 인천 → 나머지 가나다
const PROVINCE_ORDER = ['서울', '경기', '인천'];
const rank = (r: string) => { const k = PROVINCE_ORDER.indexOf(r.split(' ')[0]); return k < 0 ? 99 : k; };
const groups = [...new Set(entries.map((e) => e.data.region))]
  .sort((a, b) => rank(a) - rank(b) || a.localeCompare(b, 'ko'))
  .map((region) => ({ region, items: entries.filter((e) => e.data.region === region) }));
const haystack = (e: (typeof entries)[number]) => normFaq([
  e.data.title, e.data.region, e.data.space, e.data.brand, e.data.type, e.data.model, e.data.building, ...e.data.tags,
].filter(Boolean).join(' '));

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '시공사례', item: `${siteUrl}/cases/` },
    ],
  },
  ...(entries.length ? [{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '바람대로 시공사례',
    itemListElement: entries.map((e, k) => ({
      '@type': 'ListItem', position: k + 1, url: `${siteUrl}/cases/${e.id}/`,
      name: e.data.title || `${e.data.region} ${e.data.space} ${e.data.brand} ${e.data.type} ${e.data.units}대`,
    })),
  }] : []),
];
---
<Base title="시공사례" description="바람대로 시스템에어컨 설치·세척 시공사례. 아파트명이나 지역으로 찾을 수 있습니다." jsonLd={jsonLd}>
  <PageHero eyebrow="시공사례">
    기록을 쌓는<br />중입니다
    <Fragment slot="sub">작업 전·후 상태를 사진과 기록으로 남깁니다.</Fragment>
  </PageHero>

  {/* 사례가 0건이면 섹션째 그리지 않는다 */}
  {entries.length > 0 && (
  <section class="bd-section cases">
    <div class="bd-container">
      <form class="case-search" role="search" data-case-search action="/cases/" method="get">
        <label class="case-search__label" for="case-q">아파트명이나 지역으로 찾기</label>
        <div class="case-search__row">
          <input class="case-search__input" id="case-q" name="q" type="search" placeholder="예) 봇들마을, 성남" autocomplete="off" enterkeyhint="search" />
          <p class="case-search__count" data-case-count aria-live="polite">{entries.length}건</p>
        </div>
      </form>

      <div class="case-regions">
      {groups.map((g) => (
        <section class="case-region" data-case-region>
          <h2 class="case-region__h">{g.region} <span data-region-count>{g.items.length}건</span></h2>
          <div class="case-grid">
            {g.items.map((entry) => (
              <div class="case-grid__cell" data-q={haystack(entry)}>
                <CaseCard entry={entry} />
              </div>
            ))}
          </div>
        </section>
      ))}
      </div>
      <p class="case-empty" data-case-empty hidden>찾는 사례가 아직 없습니다. 아파트명이나 지역을 줄여서 찾아보세요.</p>
    </div>
  </section>
  )}

  <CtaBand>
    다음 현장이<br /><em>우리 집</em>이어도 됩니다
    <Fragment slot="sub">기종과 대수, 설치 위치. 이 정도면 됩니다.</Fragment>
  </CtaBand>
</Base>

<script>
  // 검색 — 띄어쓰기 없이 부분 일치. 지역 묶음은 남은 카드가 없으면 통째로 숨긴다
  const form = document.querySelector<HTMLFormElement>('[data-case-search]');
  const input = document.querySelector<HTMLInputElement>('#case-q');
  if (form && input) {
    // 서버 data-q(normFaq: 공백 제거·소문자)와 같은 규칙으로 낱말마다 비교한다
    const regions = [...document.querySelectorAll<HTMLElement>('[data-case-region]')];
    const count = document.querySelector<HTMLElement>('[data-case-count]');
    const empty = document.querySelector<HTMLElement>('[data-case-empty]');
    const apply = () => {
      // 한글 조합 중 끝에 붙는 홑자모(ㅂ, 봇ㄷ)는 떼고 본다 — 치는 동안 0건이 깜빡이지 않게
      const terms = input.value.replace(/[ㄱ-ㆎ]+$/, '').toLowerCase().split(/\s+/).filter(Boolean);
      let total = 0;
      for (const r of regions) {
        let n = 0;
        r.querySelectorAll<HTMLElement>('.case-grid__cell').forEach((c) => {
          const ok = terms.every((t) => (c.dataset.q ?? '').includes(t));
          c.hidden = !ok; if (ok) n += 1;
        });
        r.hidden = n === 0;
        const rc = r.querySelector<HTMLElement>('[data-region-count]'); if (rc) rc.textContent = `${n}건`;
        total += n;
      }
      if (count) count.textContent = `${total}건`;
      if (empty) empty.hidden = total > 0;
      const u = new URL(location.href);
      if (input.value.trim()) u.searchParams.set('q', input.value.trim()); else u.searchParams.delete('q');
      history.replaceState(null, '', u);
    };
    input.value = new URLSearchParams(location.search).get('q') ?? '';
    input.addEventListener('input', apply);
    form.addEventListener('submit', (e) => { e.preventDefault(); apply(); input.blur(); });
    apply();
  }
</script>

<style>
  .cases { background: transparent; } /* 유리 카드 호스트 */
  .case-search { margin-bottom: 40px; max-width: 560px; }
  .case-search__label { display: block; font-size: 14px; font-weight: 700; color: var(--br-ink-sub); }
  .case-search__row { margin-top: 10px; display: flex; align-items: center; gap: 14px; }
  .case-search__input {
    flex: 1; min-width: 0; min-height: 52px; padding: 0 18px;
    border: 1px solid var(--br-line); border-radius: 10px; background: #fff;
    font: inherit; font-size: 16px; color: var(--br-ink); /* 16px — iOS 확대 방지 */
  }
  .case-search__input::placeholder { color: var(--br-ink-sub); }
  .case-search__input:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 1px; border-color: var(--br-teal); }
  .case-search__count { flex: none; font-size: 14px; font-weight: 600; color: var(--br-ink-sub); font-variant-numeric: tabular-nums; }

  .case-regions { display: grid; gap: 48px; } /* 숨긴 묶음은 간격을 만들지 않는다 */
  .case-region[hidden] { display: none; }
  .case-region__h {
    display: flex; align-items: baseline; gap: 8px;
    padding-bottom: 12px; margin-bottom: 20px; border-bottom: 1px solid var(--br-ink);
    font-size: 20px; font-weight: 800; color: var(--br-ink);
  }
  .case-region__h span { font-size: 14px; font-weight: 600; color: var(--br-ink-sub); font-variant-numeric: tabular-nums; }
  .case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .case-grid__cell[hidden] { display: none; }
  .case-empty { color: var(--br-ink-sub); padding: 40px 0; }
  @media (max-width: 900px) { .case-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .case-grid { grid-template-columns: 1fr; } }
</style>
