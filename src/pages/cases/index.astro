---
// 시공사례 목록 v4(2026-10-01 대표: '사례 쌓이면 스크롤 500번?') — 검색 + 시·도/시·구 거르기 + 최신순 12건씩 '더 보기'.
// 지역별로 길게 쌓던 v3 묶음은 걷어냈다(카드에 지역이 이미 보인다).
// 검색은 단지명이 든 제목·지역·공간·브랜드·작업·기종·태그를 띄어쓰기 없이 비교한다(예: '봇들마을' '성남' '삼성').
// 띄어 쓴 말은 따로 찾아 모두 들어 있는 사례만 보인다(예: '봇들마을 성남'). 주소 ?q= 로 검색어를 넘길 수 있다(공유용).
// 필터 버튼(v2)은 검색으로 대체 — 구 버전은 git 기록.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import { normFaq } from '../../scripts/faq-rank';
import LogTable from '../../components/cases/LogTable.astro';
import { RECORDS, COMPLEXES, MONTHS, REGIONS, stats, fmtYm, fmtDate, ymOf, regionSlug, LOG_UPDATED } from '../../lib/caselog';

// sample: true 사례는 비공개(사람이 사진 확인 뒤 줄을 지우면 자동 노출)
const entries = (await getCollection('cases'))
  .filter((e) => !e.data.sample)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 거르기 목록 — region 은 '시·도 시·구'(예: 경기 성남). 시·도는 서울 → 경기 → 인천 → 나머지 가나다
const PROVINCE_ORDER = ['서울', '경기', '인천'];
const rank = (p: string) => { const k = PROVINCE_ORDER.indexOf(p); return k < 0 ? 99 : k; };
const provOf = (r: string) => r.split(' ')[0];
// 거르기 목록은 사진 사례와 시공 기록(전체)의 지역을 합친다
const allRegions = [...new Set([...entries.map((e) => e.data.region), ...REGIONS.map((g) => g.region)])];
const provinces = [...new Set(allRegions.map(provOf))].sort((a, b) => rank(a) - rank(b) || a.localeCompare(b, 'ko'));
const cities = allRegions.sort((a, b) => a.localeCompare(b, 'ko'));
const PAGE = 12;
const total = stats(RECORDS);
const LATEST = 20;
/** 첫 화면에 싣는 단지 수 — 나머지는 /cases/apt-index.json 에서 받아 그린다 */
const APT_FIRST = 12;
const haystack = (e: (typeof entries)[number]) => normFaq([
  e.data.title, e.data.region, e.data.space, e.data.brand, e.data.type, e.data.model, e.data.building, ...e.data.tags,
].filter(Boolean).join(' '));

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '시공사례', item: `${siteUrl}/cases/` },
    ],
  },
  ...(entries.length ? [{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '바람대로 시공사례',
    itemListElement: entries.map((e, k) => ({
      '@type': 'ListItem', position: k + 1, url: `${siteUrl}/cases/${e.id}/`,
      name: e.data.title || `${e.data.region} ${e.data.space} ${e.data.brand} ${e.data.type} ${e.data.units}대`,
    })),
  }] : []),
];
---
<Base title="시공사례" description="바람대로 시스템에어컨 설치·세척 시공사례. 아파트명이나 지역으로 찾을 수 있습니다." jsonLd={jsonLd}>
  {/* 제목은 '시공사례' 그대로(2026-10-06 대표: '기록을 쌓는 중입니다' 폐기) — 제목이 분류를 말하므로 라벨 행은 뺀다 */}
  <PageHero>
    시공사례
    <Fragment slot="sub">{fmtYm(ymOf(total.first))}부터 마친 현장 {total.n.toLocaleString('ko-KR')}건 · 단지 {COMPLEXES.length.toLocaleString('ko-KR')}곳</Fragment>
  </PageHero>

  {/* 사진 사례도 기록도 없으면 섹션째 그리지 않는다 */}
  {(entries.length > 0 || RECORDS.length > 0) && (
  <section class="bd-section cases">
    <div class="bd-container">
      <form class="case-find" role="search" data-case-find action="/cases/" method="get">
        <label class="case-find__label" for="case-q">아파트명이나 지역으로 찾기</label>
        <input class="case-find__input" id="case-q" name="q" type="search" placeholder="예) 봇들마을, 성남" autocomplete="off" enterkeyhint="search" />
        <div class="case-find__row">
          <div class="case-seg" role="radiogroup" aria-label="시·도" data-prov-group>
            <button type="button" role="radio" aria-checked="true" data-prov="">전체</button>
            {provinces.map((p) => <button type="button" role="radio" aria-checked="false" data-prov={p}>{p}</button>)}
          </div>
          <label class="case-find__city" hidden data-city-wrap>
            <span class="sr-only">시·구</span>
            <select id="case-city" data-city>
              <option value="">시·구 전체</option>
              {cities.map((c) => <option value={c} data-prov={provOf(c)}>{c.split(' ').slice(1).join(' ') || c}</option>)}
            </select>
          </label>
        </div>
      </form>

      {/* 단지 — 기록이 많은 순. 검색·지역을 고르면 그 안에서 다시 추린다 */}
      {COMPLEXES.length > 0 && (
        <section class="case-sec" data-apts>
          <h2 class="case-sec__h">단지 <span class="case-sec__n" data-apt-count aria-live="polite">{COMPLEXES.length.toLocaleString('ko-KR')}곳</span></h2>
          <ul class="apt-list" data-apt-list>
            {COMPLEXES.slice(0, APT_FIRST).map((c) => (
              <li class="apt-row">
                <a href={`/cases/apt/${c.slug}/`}>
                  <span class="apt-row__name">{c.name}</span>
                  <span class="apt-row__where">{c.region} {c.dong}</span>
                  <span class="apt-row__n">{c.records.length}건</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="case-empty" data-apt-empty hidden>찾는 단지가 아직 없습니다. 이름을 줄여서 찾아보세요.</p>
          <p class="case-more"><button type="button" class="br-pill" data-apt-more hidden={COMPLEXES.length <= APT_FIRST}>더 보기 ({(COMPLEXES.length - APT_FIRST).toLocaleString('ko-KR')}곳)</button></p>
        </section>
      )}

      {entries.length > 0 && (
      <section class="case-sec" data-list>
      <h2 class="case-sec__h">사진 사례 <span class="case-sec__n" data-list-count aria-live="polite">{entries.length}건</span></h2>

      <div class="case-grid" data-case-grid>
        {entries.map((entry, k) => (
          <div class="case-grid__cell" data-cell data-q={haystack(entry)} data-prov={provOf(entry.data.region)} data-city={entry.data.region} hidden={k >= PAGE}>
            <CaseCard entry={entry} />
          </div>
        ))}
      </div>
      <p class="case-empty" data-list-empty hidden>사진을 올린 사례가 아직 없습니다.</p>
      <p class="case-more"><button type="button" class="br-pill" data-list-more hidden>더 보기</button></p>
      </section>
      )}

      {/* 날짜별 — 최근 기록 + 달마다 전체 */}
      {RECORDS.length > 0 && (
        <section class="case-sec">
          <h2 class="case-sec__h">날짜별 기록</h2>
          <LogTable records={RECORDS.slice(0, LATEST)} caption="최근 시공 기록" />
          <p class="case-sec__note">일정 기록 기준 · {fmtDate(LOG_UPDATED)} 갱신</p>
          <ul class="case-months">
            {MONTHS.map((m) => <li><a class="br-pill" href={`/cases/log/${m.ym}/`}>{fmtYm(m.ym)} <span class="case-months__n">{m.records.length}건</span></a></li>)}
          </ul>
        </section>
      )}

      {REGIONS.length > 0 && (
        <section class="case-sec">
          <h2 class="case-sec__h">지역별 기록</h2>
          <ul class="case-months">
            {REGIONS.map((g) => <li><a class="br-pill" href={`/cases/region/${regionSlug(g.region)}/`}>{g.region} <span class="case-months__n">{g.records.length}건</span></a></li>)}
          </ul>
        </section>
      )}
    </div>
  </section>
  )}

  <CtaBand>
    다음 현장이<br /><em>우리 집</em>이어도 됩니다
    <Fragment slot="sub">기종과 대수, 설치 위치. 이 정도면 됩니다.</Fragment>
  </CtaBand>
</Base>

<script>
  // 검색(낱말마다 모두 포함) + 시·도 + 시·구 → 최신순 12건씩. 주소 ?q=&r= 로 같은 결과를 다시 열 수 있다
  const form = document.querySelector<HTMLFormElement>('[data-case-find]');
  const input = document.querySelector<HTMLInputElement>('#case-q');
  if (form && input) {
    const PAGE = 12;
    // 목록 둘(단지·사진 사례)이 같은 검색·지역 조건을 따른다. 목록마다 12개씩 '더 보기'
    const lists = [...document.querySelectorAll<HTMLElement>('[data-list]')].map((el) => ({
      cells: [...el.querySelectorAll<HTMLElement>('[data-cell]')],
      count: el.querySelector<HTMLElement>('[data-list-count]'),
      empty: el.querySelector<HTMLElement>('[data-list-empty]'),
      more: el.querySelector<HTMLButtonElement>('[data-list-more]')!,
      unit: el.querySelector('.apt-list') ? '곳' : '건',
      shown: PAGE,
    }));
    const provBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-prov-group] [data-prov]')];
    const citySel = document.querySelector<HTMLSelectElement>('[data-city]')!;
    const cityWrap = document.querySelector<HTMLElement>('[data-city-wrap]')!;
    const cityOpts = [...citySel.options].slice(1);
    let prov = '';
    // 단지 목록 — 첫 12곳만 HTML 에 있고, 찾거나 거르거나 '더 보기'를 누르면 색인을 한 번 받아 그린다
    const aptList = document.querySelector<HTMLElement>('[data-apt-list]');
    const aptCount = document.querySelector<HTMLElement>('[data-apt-count]');
    const aptEmpty = document.querySelector<HTMLElement>('[data-apt-empty]');
    const aptMore = document.querySelector<HTMLButtonElement>('[data-apt-more]');
    type Apt = [string, string, string, string, number, string];
    let apts: Apt[] | null = null, aptShown = PAGE, aptLoading: Promise<void> | null = null;
    const loadApts = () => (aptLoading ??= fetch('/cases/apt-index.json').then((r) => r.json()).then((j: Apt[]) => { apts = j; }).catch(() => { aptLoading = null; }));
    const aptRow = ([slug, name, dong, region, n]: Apt) => {
      const li = document.createElement('li'); li.className = 'apt-row';
      const a = document.createElement('a'); a.href = `/cases/apt/${slug}/`;
      for (const [cls, text] of [['apt-row__name', name], ['apt-row__where', `${region} ${dong}`], ['apt-row__n', `${n}건`]]) {
        const sp = document.createElement('span'); sp.className = cls; sp.textContent = text; a.append(sp);
      }
      li.append(a); return li;
    };
    const drawApts = (terms: string[], bare: (t: string) => string, city: string, from = 0) => {
      if (!apts || !aptList || !aptMore) return;
      const hits = apts.filter((c) => (!prov || c[3].split(' ')[0] === prov) && (!city || c[3] === city)
        && terms.every((t) => c[5].includes(t) || c[5].includes(bare(t))));
      const rows = hits.slice(0, aptShown).map(aptRow);
      aptList.replaceChildren(...rows);
      const left = hits.length - rows.length;
      aptMore.hidden = left <= 0;
      aptMore.textContent = `더 보기 (${left.toLocaleString('ko-KR')}곳)`;
      if (aptCount) aptCount.textContent = `${hits.length.toLocaleString('ko-KR')}곳`;
      if (aptEmpty) aptEmpty.hidden = hits.length > 0;
      // 새로 열린 줄이 차례로 떠오른다(띡 나타나지 않게)
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) rows.slice(from).forEach((c, k) =>
        c.animate([{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }],
          { duration: 600, delay: Math.min(k, 12) * 40, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards' }));
      if (from) rows[from]?.querySelector('a')?.focus({ preventScroll: true });
    };
    const setProv = (p: string) => {
      prov = p;
      provBtns.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.prov === p)));
      cityOpts.forEach((o) => { o.hidden = !!p && o.dataset.prov !== p; });
      const n = cityOpts.filter((o) => !o.hidden).length;
      cityWrap.hidden = !p || n < 2;                 // 시·도를 골라야, 그 안에 시·구가 둘 이상일 때만
      // 시·도를 '전체'로 돌리면 시·구도 푼다 — 숨긴 선택 상자에 값이 남아 1건에 갇히던 것(2026-10-01)
      if (citySel.value && (!p || cityOpts.find((o) => o.value === citySel.value)?.hidden)) citySel.value = '';
    };
    const apply = (reset = true) => {
      if (reset) { lists.forEach((l) => { l.shown = PAGE; }); aptShown = PAGE; }
      // 한글 조합 중 끝 홑자모는 떼고 본다 — 치는 동안 0건이 깜빡이지 않게
      const terms = input.value.replace(/[ㄱ-ㆎ]+$/, '').toLowerCase().split(/\s+/).filter(Boolean);
      const city = citySel.value;
      // '성남시'·'구로구'처럼 행정구역 끝말을 붙여 쳐도 찾게 — 끝말을 뗀 꼴로 한 번 더 본다
      const bare = (t: string) => (t.length > 2 ? t.replace(/(특별자치시|특별자치도|특별시|광역시|시|도|구|군)$/, '') : t);
      // 조건이 하나라도 걸리면 단지 색인을 받아 다시 그린다(조건이 없으면 처음 12곳 그대로)
      if (aptList && (terms.length || prov || city || apts)) void loadApts().then(() => drawApts(terms, bare, city));
      for (const l of lists) {
        const hits = l.cells.filter((c) => (!prov || c.dataset.prov === prov) && (!city || c.dataset.city === city)
          && terms.every((t) => (c.dataset.q ?? '').includes(t) || (c.dataset.q ?? '').includes(bare(t))));
        l.cells.forEach((c) => { c.hidden = true; });
        hits.slice(0, l.shown).forEach((c) => { c.hidden = false; });
        const left = hits.length - Math.min(l.shown, hits.length);
        l.more.hidden = left <= 0;
        l.more.textContent = `더 보기 (${left.toLocaleString('ko-KR')}${l.unit})`;
        if (l.count) l.count.textContent = `${hits.length.toLocaleString('ko-KR')}${l.unit}`;
        if (l.empty) l.empty.hidden = hits.length > 0;
      }
      const u = new URL(location.href);
      input.value.trim() ? u.searchParams.set('q', input.value.trim()) : u.searchParams.delete('q');
      (city || prov) ? u.searchParams.set('r', city || prov) : u.searchParams.delete('r');
      history.replaceState(null, '', u);
    };
    const qs = new URLSearchParams(location.search);
    input.value = qs.get('q') ?? '';
    const r = qs.get('r') ?? '';
    if (r) { setProv(r.split(' ')[0]); if (r.includes(' ')) citySel.value = r; }
    input.addEventListener('input', () => apply());
    form.addEventListener('submit', (e) => { e.preventDefault(); apply(); input.blur(); });
    provBtns.forEach((b, i) => {
      b.addEventListener('click', () => { setProv(b.dataset.prov ?? ''); apply(); });
      b.addEventListener('keydown', (e) => {                       // 라디오 묶음 — 방향키로 옮기며 고른다
        const d = ['ArrowRight', 'ArrowDown'].includes(e.key) ? 1 : ['ArrowLeft', 'ArrowUp'].includes(e.key) ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = provBtns[(i + d + provBtns.length) % provBtns.length];
        n.focus(); setProv(n.dataset.prov ?? ''); apply();
      });
    });
    citySel.addEventListener('change', () => apply());
    aptMore?.addEventListener('click', () => {
      const from = aptList?.children.length ?? 0;
      aptShown = from + PAGE * 2;
      const terms = input.value.replace(/[ㄱ-ㆎ]+$/, '').toLowerCase().split(/\s+/).filter(Boolean);
      const bare = (t: string) => (t.length > 2 ? t.replace(/(특별자치시|특별자치도|특별시|광역시|시|도|구|군)$/, '') : t);
      void loadApts().then(() => drawApts(terms, bare, citySel.value, from));
    });
    for (const l of lists) l.more.addEventListener('click', () => {
      const first = l.cells.filter((c) => !c.hidden).length;
      l.shown += PAGE * 2; apply(false);
      const fresh = l.cells.filter((c) => !c.hidden).slice(first);
      fresh[0]?.querySelector('a')?.focus({ preventScroll: true });   // 새로 열린 첫 줄로
      // 새로 열린 줄이 차례로 떠오른다(띡 나타나지 않게)
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) fresh.forEach((c, k) =>
        c.animate([{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }],
          { duration: 600, delay: Math.min(k, 12) * 40, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards' }));
    });
    apply(false);
  }
</script>

<style>
  .cases { background: transparent; } /* 유리 카드 호스트 */
  .case-find { margin-bottom: 32px; display: grid; gap: 12px; }
  .case-find__label { font-size: 14px; font-weight: 700; color: var(--br-ink-sub); }
  .case-find__input {
    width: 100%; max-width: 560px; min-height: 52px; padding: 0 18px;
    border: 1px solid var(--br-line); border-radius: 10px; background: #fff;
    font: inherit; font-size: 16px; color: var(--br-ink); /* 16px — iOS 확대 방지 */
  }
  .case-find__input::placeholder { color: var(--br-ink-sub); }
  .case-find__input:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 1px; border-color: var(--br-teal); }
  .case-find__row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  /* 시·도 — 홈 방 목록과 같은 세그먼트(회색 판, 고른 칸만 흰 판) */
  .case-seg { display: inline-flex; gap: 2px; padding: 4px; border-radius: 8px; background: var(--br-mist); box-shadow: 0 0 0 1px color-mix(in srgb, var(--br-teal) 12%, transparent); }
  .case-seg button {
    min-height: 40px; padding: 0 16px; border: 0; border-radius: 6px; background: transparent; cursor: pointer;
    font: inherit; font-size: 15px; font-weight: 500; color: var(--br-ink-sub);
  }
  .case-seg button[aria-checked='true'] { background: #fff; color: var(--br-ink); font-weight: 600; box-shadow: 0 1px 2px rgba(0, 41, 58, .08); }
  .case-seg button:focus-visible { outline: 2px solid var(--br-teal); outline-offset: -2px; }
  .case-find__city select {
    min-height: 48px; padding: 0 36px 0 14px; border: 1px solid var(--br-line); border-radius: 8px; background-color: #fff;
    font: inherit; font-size: 15px; color: var(--br-ink);
  }
  .case-find__city select:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 1px; }
  .case-sec { margin-top: 56px; }
  .case-find + .case-sec { margin-top: 8px; }
  .case-sec__h { display: flex; align-items: baseline; gap: 10px; margin-bottom: 16px; font-size: 22px; color: var(--br-ink); }
  .case-sec__n { font-family: var(--sans); font-size: 14px; font-weight: 600; color: var(--br-ink-sub); font-variant-numeric: tabular-nums; }
  .case-sec__note { margin-top: 10px; font-size: 13px; color: var(--br-ink-sub); }
  .apt-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .apt-list :global(.apt-row[hidden]) { display: none; }
  .apt-list :global(.apt-row a) {
    display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; align-items: baseline;
    min-height: 68px; padding: 14px 16px; border-radius: var(--radius);
    background: var(--br-base); border: 1px solid var(--br-line);
