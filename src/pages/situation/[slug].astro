---
// 상황별 안내 — situations.json의 키 하나 = 페이지 하나 (JSON에 키를 추가하면 페이지가 생긴다).
// 수치·가격 하드코딩 금지 (DESIGN.md §7) — 절차·확인 항목만 다룬다.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import StandardsStory from '../../components/v2/StandardsStory.astro';
import StoryRow from '../../components/v2/StoryRow.astro';
import { loadSituations } from '../../lib/situations.ts';
import { loadStandards } from '../../lib/standards.ts';
import { loadFaqPage, renderFaqMd } from '../../lib/faq.ts';

export function getStaticPaths() {
  return loadSituations().map((situation) => ({ params: { slug: situation.slug }, props: { situation } }));
}

const { situation } = Astro.props;
const { meta, timeline, prewired, groupBuy, faqIds, related } = situation;

const standards = loadStandards();

// faq_ids 화이트리스트 — 적은 순서대로. /faq/ 와 같은 본문(a)을 쓴다.
// loadFaq()(챗봇용 chat_a)를 쓰면 챗봇 축약답이 화면 본문으로 찍힌다 — 08-25 실측 후 교체.
const faqById = new Map(loadFaqPage().map((f) => [f.id, f]));
const faq = faqIds.map((id) => faqById.get(id)!).filter(Boolean);

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: '상황별 안내' },
      { '@type': 'ListItem', position: 3, name: meta.title, item: `${siteUrl}/situation/${situation.slug}/` },
    ],
  },
];
// FAQPage는 발행하지 않는다 — /faq/ 가 전 문항을 발행하는 정본이고 이 페이지는 발췌다.
// 같은 Q&A를 두 URL로 내보내면 검색엔진에 정본이 둘이 된다 (상황별 랜딩이 늘수록 배로 는다).
// 화면 아코디언 렌더는 그대로 두고 구조화 데이터만 뺀다.
---
<Base title={meta.title} description={meta.description} jsonLd={jsonLd}>
  <PageHero eyebrow={meta.eyebrow}>
    {meta.headlineLines.map((line, i) => (
      <Fragment>{i > 0 && <br />}{line}</Fragment>
    ))}
    <Fragment slot="sub">{meta.intro}</Fragment>
  </PageHero>

  {(timeline.length > 0 || prewired) && (
    <section class="sit-journey" aria-label="진행 순서">
      {/* 단계마다 article을 쪼개면 눈썹이 반복되고 stage가 h2로 올라가
          섹션 제목과 같은 층위가 된다(08-27 실측). 한 블록에 모은다. */}
      {timeline.length > 0 && (
        <article class="bd-section sit-journey__story sit-journey__story--mist" data-layout-section="newhome-timeline">
          <div class="bd-container">
            <span class="br-eyebrow br-reveal">진행 순서</span>
            <h2 class="br-h br-reveal">언제 무엇을 정하나</h2>
            <ol class="sit-journey__list">
              {timeline.map((st, i) => (
                <li class="sit-journey__card br-reveal">
                  <span class="sit-journey__no">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="sit-journey__stage">{st.stage}</h3>
                  {/* when이 있으면 접어 둔다 — 펼쳐 두면 모바일에서 페이지가 1화면 넘게 길어진다(08-27 실측) */}
                  {st.when ? (
                    <details class="sit-journey__details">
                      <summary>{st.when}</summary>
                      <ul class="sit-journey__todo">{st.todo.map((item) => <li>{item}</li>)}</ul>
                      {st.caution && <p class="sit-journey__caution">{st.caution}</p>}
                    </details>
                  ) : (
                    <Fragment>
                      <ul class="sit-journey__todo">{st.todo.map((item) => <li>{item}</li>)}</ul>
                      {st.caution && <p class="sit-journey__caution">{st.caution}</p>}
                    </Fragment>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </article>
      )}

      {prewired && (
        <article
          class:list={['bd-section', 'sit-journey__story', timeline.length % 2 === 0 ? 'sit-journey__story--base' : 'sit-journey__story--mist']}
          data-layout-section="newhome-prewired"
        >
          <div class="bd-container">
            <StoryRow
              slotId={`${situation.slug}-prewired`}
              slotLabel={`${situation.slug}-prewired`}
              imageSide={timeline.length % 2 === 0 ? 'left' : 'right'}
            >
              <span class="br-eyebrow br-reveal">현장 확인</span>
              <h2 class="br-h br-reveal">{prewired.title}</h2>
              {prewired.bodyLines.length > 0 ? (
                <details class="sit-journey__details br-reveal">
                  <summary>{prewired.bodyLines[0]}</summary>
                  {prewired.bodyLines.length > 1 && (
                    <p class="br-body">
                      {prewired.bodyLines.slice(1).map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}
                    </p>
                  )}
                  <ul class="sit-journey__todo">{prewired.checkItems.map((item) => <li>{item}</li>)}</ul>
                </details>
              ) : (
                <ul class="sit-journey__todo br-reveal">{prewired.checkItems.map((item) => <li>{item}</li>)}</ul>
              )}
            </StoryRow>
          </div>
        </article>
      )}
    </section>
  )}

  <StandardsStory
    promise={standards.promiseInstall}
    baseline={standards.baselineInstall}
    noExtra={standards.noExtra}
    slotPrefix={situation.slug}
    startSide="right"
    startTone="mist"
  />

  <section class="bd-section sit-close">
    <div class="bd-container">
      {faq.length > 0 && (
        <div class="sit-faq" data-layout-section="newhome-faq">
          <span class="br-eyebrow br-reveal">자주 묻는 질문</span>
          <h2 class="br-h br-reveal">이 상황에서<br />많이 묻는 것</h2>
          <div class="sit-faq__list br-reveal">
            {faq.map((f, i) => (
              <details class="sit-faq__item" id={f.id} open={i === 0}>
                <summary class="sit-faq__q">{f.q}</summary>
                <div class="sit-faq__a" set:html={renderFaqMd(f.a)} />
              </details>
            ))}
          </div>
          <p class="sit-faq__more br-reveal">
            <a class="sit-faq__link" href="/faq/">전체 질문 보기 <span aria-hidden="true">→</span></a>
          </p>
        </div>
      )}

      {groupBuy && (
        <div class="sit-group" data-layout-section="newhome-group-buy">
          <StoryRow
            slotId={`${situation.slug}-group-buy`}
            slotLabel={`${situation.slug}-group-buy`}
            imageSide="right"
            tone="deep"
          >
            <span class="br-eyebrow br-reveal">단지 공동구매</span>
            <h2 class="br-h br-reveal">{groupBuy.title}</h2>
            <p class="br-body br-reveal">{groupBuy.body}</p>
            {groupBuy.ctaLabel && (
              <p class="sit-group__cta br-reveal">
                <button type="button" class="bd-cta bd-cta--deep" data-chat-tree="install">{groupBuy.ctaLabel}</button>
              </p>
            )}
          </StoryRow>
        </div>
      )}

      {related.length > 0 && (
        <div class="sit-related">
          <span class="br-eyebrow br-reveal">함께 보기</span>
          <ul class="sit-related__list br-reveal">
            {related.map((r) => (
              <li><a href={r.href}>{r.label} <span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <CtaBand chatTree="install" buttonLabel="설치 상담 시작">
    <em>견적</em>은 방문 전에<br />나옵니다
    <Fragment slot="sub">기종과 대수만 알려주시면 됩니다.</Fragment>
  </CtaBand>
</Base>

<style>
  /* 진행 순서 — 회색 섹션 위 기본색 카드 (/install/ /care/ 와 같은 패턴) */
  .sit-journey__list { margin-top: 48px; list-style: none; display: grid; gap: 16px; }
  .sit-journey__card {
    background: var(--br-base);
    border-radius: var(--radius);
    padding: 28px 24px;
    border: 1px solid rgba(0, 78, 100, 0.06);
  }
  .sit-journey__no {
    display: block; font-size: 13px; font-weight: 700;
    letter-spacing: 0.14em; color: var(--br-teal); opacity: 0.55;
  }
  .sit-journey__stage { margin-top: 6px; color: var(--br-teal); font-size: clamp(20px, 2.4vw, 26px); }
  @media (min-width: 768px) {
    .sit-journey__list { gap: 20px; grid-template-columns: repeat(2, 1fr); }
    .sit-journey__card { padding: 36px 32px; }
  }

  .sit-journey__story--base { background: var(--br-base); }
  .sit-journey__story--mist { background: var(--br-mist); }
  .sit-journey__story--deep { background: var(--br-teal-deep); }
  .sit-journey__story--deep .sit-journey__details {
    border-top-color: var(--br-ice);
    border-bottom-color: var(--br-ice);
  }
  .sit-journey__story--deep .sit-journey__details summary { color: var(--br-ice); }
  .sit-journey__story--deep .sit-journey__todo li::before { background: var(--br-ice); }
  .sit-journey__story--deep :global(.br-story-row__copy) p.sit-journey__caution { color: var(--br-ink); }
  .sit-journey__stage { margin-top: 28px; color: var(--br-teal); font-size: 18px; }
  .sit-journey__details {
    margin-top: 22px;
    border-top: 1px solid var(--br-teal);
    border-bottom: 1px solid var(--br-teal);
  }
  .sit-journey__details summary {
    min-height: 44px;
    padding: 12px 0;
    cursor: pointer;
    color: var(--br-teal);
    font-size: 14px;
    font-weight: 700;
  }
  .sit-journey__details :global(.br-body) { margin-top: 14px; color: var(--br-ink); font-size: 14px; }
  .sit-journey__todo { margin-top: 22px; list-style: none; display: grid; gap: 8px; }
  .sit-journey__details .sit-journey__todo { margin-bottom: 16px; }
  .sit-journey__todo li { position: relative; padding-left: 16px; color: var(--br-ink); font-size: 14px; line-height: 1.6; }
  .sit-journey__todo li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 8px;
    height: 1px;
    background: var(--br-teal);
  }
  .sit-journey__caution {
    margin-top: 18px;
    padding: 14px 16px;
    border-left: 3px solid var(--br-teal);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--br-ice);
    color: var(--br-ink);
    font-size: 14px;
    line-height: 1.65;
  }

  .sit-close { background: var(--br-teal-deep); }
  .sit-close :global(.br-h) { color: var(--br-base); }
  .sit-faq__list { margin-top: 48px; display: grid; gap: 10px; }
  .sit-faq__item { border-radius: var(--radius); background: var(--br-base); color: var(--br-ink); }
  .sit-faq__q {
    cursor: pointer;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.6;
    padding: 18px 4px;
    color: var(--br-ink);
  }
  .sit-faq__a { padding: 2px 18px 24px; font-size: 15px; line-height: 1.85; color: var(--br-ink); }
  .sit-faq__a :global(p) { margin-bottom: 14px; }
  .sit-faq__a :global(p:last-child) { margin-bottom: 0; }
  .sit-faq__a :global(h3) { font-size: 16px; color: var(--br-ink); margin: 22px 0 10px; }
  .sit-faq__a :global(ul) { margin: 0 0 14px 4px; list-style: none; display: grid; gap: 8px; }
  .sit-faq__a :global(li) { padding-left: 16px; position: relative; }
  .sit-faq__a :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 8px;
    height: 1px;
    background: var(--br-teal);
  }
  .sit-faq__a :global(table) { width: 100%; border-collapse: collapse; font-size: 14.5px; margin: 16px 0; }
  .sit-faq__a :global(strong) { color: var(--br-ink); }
  .sit-faq__more { margin-top: 24px; }
  .sit-faq__link {
    display: inline-block;
    font-size: 16px;
    font-weight: 700;
    color: var(--br-ice);
    border-bottom: 2px solid var(--br-ice);
    padding-bottom: 2px;
    transition: color var(--dur-color) ease, border-color var(--dur-color) ease;
  }
  .sit-faq__link:hover { color: var(--br-base); border-color: var(--br-base); }

  .sit-group { margin-top: 120px; }
  .sit-group__cta { margin-top: 32px; }

  .sit-related { margin-top: 120px; }
  .sit-related__list {
    margin-top: 24px;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .sit-related__list a {
    display: inline-block;
    padding: 8px 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--br-ice);
  }
  .sit-related__list a:hover { color: var(--br-base); }
  :global(.v2-cta .bd-container .v2-cta__sub) { color: var(--br-base); }

  @media (max-width: 767px) {
    .sit-group,
    .sit-related { margin-top: 72px; }
  }
</style>
