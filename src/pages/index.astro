---
// 홈 v2 — 스크롤 스토리텔링 (1뷰포트 1메시지). 구 홈은 src/legacy/index-v1.astro.txt 보존.
// 순서: S1 히어로 → S2 다크 스크럽 → S3~S5 서비스 2트랙 → S5b 상황별 안내 → S6 마퀴 → S7 지표 → S8 절차 → (S9 후기 — 실후기 확보 전 미노출) → S10 CTA → 푸터
// 섹션 문구는 전부 src/content/site/home.json (하드코딩 금지). 히어로·다크구간은 각자 다른 소스.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/v2/Hero.astro';
import DarkScrub from '../components/v2/DarkScrub.astro';
// import Problem from '../components/v2/Problem.astro'; // 구 S2 — DarkScrub이 동일 메시지를 대체 (비포 사진 확보 후 재검토)
import ServiceSplit from '../components/v2/ServiceSplit.astro';
import Marquee from '../components/v2/Marquee.astro';
import Stats from '../components/v2/Stats.astro';
import Process from '../components/v2/Process.astro';
// import Reviews from '../components/v2/Reviews.astro'; // S9 — [실후기교체] 확보 후 주석 해제
import CtaBand from '../components/v2/CtaBand.astro';
import SituationCards from '../components/v2/SituationCards.astro';
import { loadTrust } from '../lib/trust.ts';
import { loadSituations } from '../lib/situations.ts';
import { loadHome } from '../lib/home.ts';

// 홈 섹션 문구 — home.json 단일 소스
const home = loadHome();

// 신뢰 지표 — trust.json 단일 소스 (하드코딩 금지)
const trust = loadTrust();

// 상황별 안내 — situations.json에 준비된 페이지만 카드로 (없으면 섹션 자체가 미노출)
const situations = loadSituations();

// 마퀴 카드 — cases 컬렉션 최신순
const cases = (await getCollection('cases'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* 서비스 카드의 앵커 id와 지그재그 방향은 문구가 아니라 레이아웃이라 여기 둔다.
   home.json의 services 순서와 짝지어 쓰며, 카드가 더 늘면 id 없이 렌더된다. */
const SERVICE_LAYOUT = [
  { id: 'clean', flip: false },
  { id: 'care', flip: true },
  { id: 'install', flip: false },
];

/** CTA 헤드라인에서 강조 단어만 <em>으로 감싼다 (색 강조는 .br-h em이 처리) */
const splitEmphasis = (line: string, word: string) => {
  if (!word || !line.includes(word)) return [line];
  const [before, ...rest] = line.split(word);
  return [before, word, rest.join(word)];
};
const cta = home.ctaBand;
---
<Base headerVariant="overlay">
  <Hero />

  <DarkScrub />

  {/* 서비스 2트랙 (IA v3) — 세척·관리 트랙(정돈→기록) / 설치 트랙(설계).
      리드 문장이 다크 구간의 착지점을 받아 3카드로 나눈다 */}
  {home.services.leadHeading.length > 0 && (
    <section class="bd-section v2-svc-lead">
      <div class="bd-container">
        <h2 class="br-h br-reveal">
          {home.services.leadHeading.map((line, i) => (
            <Fragment>{i > 0 && <br />}{line}</Fragment>
          ))}
        </h2>
      </div>
    </section>
  )}

  {home.services.cards.map((svc, i) => (
    <ServiceSplit
      id={SERVICE_LAYOUT[i]?.id}
      eyebrow={svc.eyebrow}
      link={svc.cta?.href}
      linkLabel={svc.cta?.label ?? ''}
      flip={SERVICE_LAYOUT[i]?.flip ?? false}
    >
      <Fragment slot="headline">
        {svc.heading.map((line, j) => (
          <Fragment>{j > 0 && <br />}{line}</Fragment>
        ))}
      </Fragment>
      <Fragment slot="body">
        {svc.lines.map((line, j) => (
          <Fragment>{j > 0 && <br />}{line}</Fragment>
        ))}
      </Fragment>
    </ServiceSplit>
  ))}

  <SituationCards
    situations={situations}
    eyebrow={home.situations?.eyebrow}
    title={home.situations?.heading.join('\n')}
  />

  <Marquee entries={cases} />

  <Stats stats={trust.stats} />

  {home.process && (
    <Process eyebrow={home.process.eyebrow} heading={home.process.heading} steps={home.process.steps} />
  )}

  {/* <Reviews /> — S9 후기: 실후기(동의 확보분) 교체 전 미노출 */}

  {cta && (
    <CtaBand buttonLabel={cta.buttonLabel} ring>
      {cta.heading.map((line, i) => (
        <Fragment>
          {i > 0 && <br />}
          {splitEmphasis(line, cta.headingEmphasis).map((part, j) => (
            j === 1 ? <em>{part}</em> : <Fragment>{part}</Fragment>
          ))}
        </Fragment>
      ))}
      {cta.body && <Fragment slot="sub">{cta.body}</Fragment>}
    </CtaBand>
  )}
</Base>

<style>
  /* 리드 문장은 바로 아래 첫 서비스 카드와 한 덩어리로 읽혀야 해서 아래 여백만 줄인다.
     섹션 상단 여백(.bd-section)은 그대로 두어 다크 구간과의 간격은 유지된다. */
  .v2-svc-lead { background: var(--br-base); padding-bottom: 0; }
</style>
