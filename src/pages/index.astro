---
// 홈 v2 — 스크롤 스토리텔링 (1뷰포트 1메시지). 구 홈은 src/legacy/index-v1.astro.txt 보존.
// 순서: S1 히어로 → S2 문제 → S3~S5 서비스 → S6 마퀴 → S7 지표 → S8 절차 → (S9 후기 — 실후기 확보 전 미노출) → S10 CTA → 푸터
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/v2/Hero.astro';
import Problem from '../components/v2/Problem.astro';
import ServiceSplit from '../components/v2/ServiceSplit.astro';
import Marquee from '../components/v2/Marquee.astro';
import Stats from '../components/v2/Stats.astro';
import Process from '../components/v2/Process.astro';
// import Reviews from '../components/v2/Reviews.astro'; // S9 — [실후기교체] 확보 후 주석 해제
import CtaBand from '../components/v2/CtaBand.astro';
import { loadTrust } from '../lib/trust.ts';

// 신뢰 지표 — trust.json 단일 소스 (하드코딩 금지)
const trust = loadTrust();

// 마퀴 카드 — cases 컬렉션 최신순
const cases = (await getCollection('cases'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base headerVariant="overlay">
  <Hero />

  <Problem />

  {/* 서비스 2트랙 (IA v3) — 세척·관리 트랙(분해세척→정기관리) / 설치 트랙(신규 설치→관리 연결) */}
  <ServiceSplit id="clean" eyebrow="세척·관리 — 분해 세척" link="/care/" linkLabel="세척 기준가 보기">
    <Fragment slot="headline">오늘 들이마시는 공기가<br />달라집니다</Fragment>
    <Fragment slot="body">커버와 송풍팬, 열교환기를 분해해 고압으로 세척합니다.<br />겉면 닦기가 아니라 오염이 쌓이는 부품 자체를 씻어냅니다.<br />세척 전후 상태는 사진으로 남겨 직접 확인시켜 드립니다.</Fragment>
  </ServiceSplit>

  <ServiceSplit id="care" eyebrow="세척·관리 — 정기 관리" link="/care/" linkLabel="관리 안내 보기" flip>
    <Fragment slot="headline">당신은 켜기만 하세요.<br />관리는 바람대로가 합니다</Fragment>
    <Fragment slot="body">정기 방문으로 필터·배수·냉매 상태를 점검합니다.<br />이상 신호를 먼저 찾아 고장으로 커지기 전에 조치합니다.<br />점검 내역은 방문 때마다 기록으로 남깁니다.</Fragment>
  </ServiceSplit>

  <ServiceSplit id="install" eyebrow="설치 — 신규 설치" link="/install/" linkLabel="설치 안내 보기">
    <Fragment slot="headline">에어컨은 사라지고<br />공간만 남습니다</Fragment>
    <Fragment slot="body">천장 매립 설계로 벽걸이와 스탠드가 차지하던 자리를 돌려드립니다.<br />도면 검토부터 배관 경로, 실외기 위치까지 실측 후에 확정합니다.<br />설치한 팀이 이후의 세척·정기관리까지 이어서 맡습니다.</Fragment>
  </ServiceSplit>

  <Marquee entries={cases} />

  <Stats stats={trust.stats} />

  <Process />

  {/* <Reviews /> — S9 후기: 실후기(동의 확보분) 교체 전 미노출 */}

  <CtaBand>
    지금, 우리 집 <em>공기</em>부터<br />확인해 보세요
    <Fragment slot="sub">사진 몇 장이면 견적 상담이 시작됩니다.</Fragment>
  </CtaBand>
</Base>
