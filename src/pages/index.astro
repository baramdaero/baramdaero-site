---
// 홈 — 풀스크린 영상 히어로 + 하단 글래스 패널 + 최신 시공사례 3건
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { SITE_CONFIG } from '../config.js';

const cases = (await getCollection('cases'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// 하단 패널 3행 — 클릭 시 해당 챗봇 트리 직접 오픈 (플로팅 버튼과 동일 컴포넌트, 진입점만 2개)
const rows = [
  { no: '01', label: '설치', desc: '신규·이전 설치 견적', tree: 'install' },
  { no: '02', label: '세척', desc: '분해 세척·유지관리 견적', tree: 'clean' },
  { no: '03', label: 'AS·문의', desc: '점검 접수·기타 문의', tree: 'as' },
];
---
<Base headerVariant="overlay">
  <section class="hero">
    {SITE_CONFIG.HERO_VIDEO ? (
      <video
        class="hero__media"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={SITE_CONFIG.HERO_POSTER}
        aria-hidden="true"
      >
        <source src={SITE_CONFIG.HERO_VIDEO} type="video/mp4" />
      </video>
    ) : (
      <img class="hero__media" src={SITE_CONFIG.HERO_POSTER} alt="" aria-hidden="true" />
    )}
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__copy">
      <h1 class="hero__title">에어컨 생각,<br />오늘이 마지막입니다.</h1>
      <p class="hero__sub">당신의 바람은, 당신의 바람대로 불어옵니다.</p>
    </div>

    <div class="hero__panel">
      <div class="hero__panel-head">
        <div>
          <p class="bd-microlabel">Baramdaero — Aircon Service</p>
          <h2 class="hero__panel-title">당신의 바람대로.</h2>
        </div>
        <div class="hero__panel-body">
          <p>설치와 세척, 점검을 한 팀이 맡습니다. 현장 사진과 실측 기준으로 견적을 드립니다.</p>
          <p>수도권 시공. 그 외 지역은 현장 규모에 따라 출장 시공을 협의합니다.</p>
        </div>
      </div>
      <hr class="bd-hairline" />
      <div class="hero__rows" role="list">
        {rows.map((row) => (
          <button type="button" class="hero__row" data-chat-tree={row.tree} role="listitem">
            <span class="hero__row-no">{row.no}</span>
            <span class="hero__row-label">{row.label}</span>
            <span class="hero__row-desc">{row.desc}</span>
            <span class="hero__row-arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
              </svg>
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="bd-section">
    <div class="bd-container">
      <p class="bd-microlabel">Cases</p>
      <h2 class="bd-section-title">최근 시공사례</h2>
      <div class="home-cases">
        {cases.map((entry) => <CaseCard entry={entry} />)}
      </div>
      <p class="home-cases__more">
        <a class="bd-btn-ghost" href="/cases/">시공사례 전체 보기</a>
      </p>
    </div>
  </section>
</Base>

<script>
  // prefers-reduced-motion — 히어로 영상 루프 정지, 포스터 프레임 유지
  const video = document.querySelector<HTMLVideoElement>('.hero__media');
  if (video?.tagName === 'VIDEO' && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 96px 24px 28px;
    color: #fff;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  /* 가독성 스크림 — 장식 그라디언트 아님 (DESIGN.md §6 예외) */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(20, 16, 12, 0.35), rgba(20, 16, 12, 0.15) 40%, rgba(20, 16, 12, 0.4));
  }
  .hero__copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-bottom: 24px;
  }
  .hero__title {
    font-size: clamp(30px, 5.4vw, 56px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.25);
  }
  .hero__sub {
    margin-top: 18px;
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.6;
    opacity: 0.92;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
  }

  .hero__panel {
    width: min(var(--maxw), 100%);
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 14px;
    padding: 28px 28px 10px;
    color: var(--ink);
  }
  .hero__panel-head {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 24px;
    padding-bottom: 22px;
  }
  .hero__panel-title {
    font-size: clamp(20px, 2.4vw, 26px);
    margin-top: 8px;
  }
  .hero__panel-body {
    columns: 2;
    column-gap: 28px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .hero__panel-body p { margin-bottom: 10px; break-inside: avoid; }

  .hero__rows { display: grid; }
  .hero__row {
    display: grid;
    grid-template-columns: 44px 96px 1fr 24px;
    align-items: center;
    gap: 14px;
    padding: 16px 6px;
    min-height: 56px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    border-radius: 6px;
    transition: background-color var(--dur-color) ease;
  }
  .hero__row:last-child { border-bottom: 0; }
  .hero__row-no {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--silver);
  }
  .hero__row-label {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 17px;
  }
  .hero__row-desc { font-size: 13.5px; color: var(--ink-soft); }
  .hero__row-arrow {
    color: var(--ink-soft);
    display: inline-flex;
    transition: transform var(--dur-color) var(--ease-out), color var(--dur-color) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero__row:hover { background: rgba(244, 239, 231, 0.85); }
    .hero__row:hover .hero__row-arrow { transform: translateX(4px); color: var(--ink); }
  }
  .hero__row:active { background: rgba(244, 239, 231, 1); }

  .home-cases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .home-cases__more { margin-top: 36px; }

  @media (max-width: 800px) {
    /* 하단 여백 88px — 고정 문의 버튼과 패널 3행(AS·문의) 히트영역 겹침 방지 */
    .hero { padding: 76px 12px 88px; }
    .hero__panel { padding: 22px 18px 6px; }
    .hero__panel-head { grid-template-columns: 1fr; gap: 14px; }
    .hero__panel-body { columns: 1; }
    .hero__row { grid-template-columns: 34px 76px 1fr 22px; gap: 10px; padding: 14px 4px; }
    .home-cases { grid-template-columns: 1fr; }
  }
</style>
