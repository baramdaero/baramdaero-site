---
// 홈 v2 — 스크롤 스토리텔링 (1뷰포트 1메시지). 구 홈은 src/legacy/index-v1.astro.txt 보존.
// 순서(2026-10-01): 히어로 3D → 회사소개(약속 셋 + 시공사례 링크) → 서비스 머리 → 설치·세척·상업용 → 내부 구조(분해 3D) → 절차 → 문의 → 바람대로와 함께한 공간(로고 띠)
// 섹션 문구는 전부 src/content/site/home.json (하드코딩 금지). 히어로·다크구간은 각자 다른 소스.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero3D from '../components/v2/Hero3D.astro';   // 2026-09-18 3D 구성도 히어로 (영상 히어로는 Hero.astro 에 보존)
import Exploded from '../components/v2/Exploded.astro';   // 2026-09-21 히어로 다음 분해 3D
// import DarkScrub from '../components/v2/DarkScrub.astro'; // 위 미노출 주석 참조
// import Problem from '../components/v2/Problem.astro'; // 구 S2 — DarkScrub이 동일 메시지를 대체 (비포 사진 확보 후 재검토)
import ServiceSplit from '../components/v2/ServiceSplit.astro';
import BrandBand from '../components/v2/BrandBand.astro';
import Process from '../components/v2/Process.astro';
// import Reviews from '../components/v2/Reviews.astro'; // S9 — [실후기교체] 확보 후 주석 해제
import CtaBand from '../components/v2/CtaBand.astro';
import StandardsStory from '../components/v2/StandardsStory.astro';
import ArrowLink from '../components/v2/ArrowLink.astro';
import BrandLine from '../components/v2/BrandLine.astro';
import homeRaw from '../content/site/home.json';
import { loadHome } from '../lib/home.ts';
import { loadTrust } from '../lib/trust.ts';

// 홈 섹션 문구 — home.json 단일 소스
const home = loadHome();
// 실적 숫자 — trust.json stats 단일 소스(샘플은 로더가 거른다). 2개 미만이면 숫자 줄째 뺀다
const { stats, statsNote, statsLead, statsTotal } = loadTrust();



// 공개 사례 — 회사소개 아래 '시공사례 보러가기' 링크를 낼지 정한다
const cases = await getCollection('cases');

/* 서비스 카드의 앵커 id와 지그재그 방향은 문구가 아니라 레이아웃이라 여기 둔다.
   home.json의 services 순서와 짝지어 쓰며, 카드가 더 늘면 id 없이 렌더된다. */
const SERVICE_LAYOUT = [
  { id: 'install', slotId: 'home-service-install', flip: true, tone: 'base' as const },
  { id: 'clean', slotId: 'home-service-clean', flip: false, tone: 'mist' as const },
  { id: 'commercial', slotId: 'commercial-building', flip: true, tone: 'base' as const },
];

/** CTA 헤드라인에서 강조 단어만 <em>으로 감싼다 (색 강조는 .br-h em이 처리) */
const splitEmphasis = (line: string, word: string) => {
  if (!word || !line.includes(word)) return [line];
  const [before, ...rest] = line.split(word);
  return [before, word, rest.join(word)];
};
const cta = home.ctaBand;
---
<Base headerVariant="solid">
  <Hero3D />


  {/* about 블록 — 2026-10-01 문장은 아래 약속 제목으로 합쳐 비었다. 협력사 로고가 들어오면 다시 나타난다 */}
  {(homeRaw.brand?.lines?.length || homeRaw.brand?.partners?.length) ? <BrandLine lines={homeRaw.brand.lines} partners={homeRaw.brand.partners} /> : null}

  {/* 왜 바람대로 — 약속 셋. 스토리 페이지를 합쳤다(2026-09-30). 문구 home.json(why), 사진은 설치 기준 사진 재사용 */}
  {homeRaw.why && (
    <StandardsStory
      promise={{ heading: homeRaw.why.heading, sub: homeRaw.why.sub, items: homeRaw.why.items, eyebrow: homeRaw.why.eyebrow, lead: homeRaw.why.lead }}
      slotPrefix="install"
      startSide="left"
      startTone="base"
      itemPhotos
    >
      {/* 제목 묶음 아래 실적 숫자(2026-10-01 대표) — 보일 때 한 번 세고(2026-10-05, motion.ts) 최종값에 멎는다. 기준 한 줄 */}
      {stats.length >= 2 && (
        <div slot="head" class="home-stats br-reveal">
          {statsLead && <p class="home-stats__lead">{statsLead.split('\n').map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</p>}
          {/* 누적 — 문장 대신 큰 숫자 하나(2026-10-05 대표) */}
          {statsTotal && (
            <dl class="home-stats__total">
              <div>
                <dt>{statsTotal.label}</dt>
                <dd>{statsTotal.prefix && <span class="home-stats__pre">{statsTotal.prefix} </span>}<span data-countup={statsTotal.value}>{statsTotal.value.toLocaleString('ko-KR')}</span><span class="home-stats__suf">{statsTotal.suffix}</span></dd>
              </div>
            </dl>
          )}
          <dl>
            {stats.map((s) => (
              <div>
                <dt>{s.label.split('\n').map((l, i) => <Fragment>{i > 0 && <Fragment>{' '}<br class="home-stats__br" /></Fragment>}{l}</Fragment>)}</dt>
                <dd>{s.prefix && <span class="home-stats__pre">{s.prefix} </span>}<span data-countup={s.value}>{s.value.toLocaleString('ko-KR')}</span><span class="home-stats__suf">{s.suffix}</span></dd>
              </div>
            ))}
          </dl>
          {/* 기준 줄(좁은 화면) — 가운뎃점은 앞 줄 끝에 두고 날짜 조각만 한 덩어리로(둘째 줄이 '·'로 시작하지 않게) */}
          {statsNote && <p class="home-stats__note">{statsNote.split(' · ').map((t, i) => i === 0 ? t : <Fragment> · <span class="home-stats__nb">{t}</span></Fragment>)}</p>}
        </div>
      )}
      {/* 기준 줄(넓은 화면) — 제목 줄 오른쪽 끝, 글자 아래 끝을 제목과 맞춘다(2026-10-06 대표, 맞춤은 StandardsStory). 좁은 화면에는 자리가 없어 위의 숫자 아래 줄이 대신 나온다 */}
      {stats.length >= 2 && statsNote && <p slot="title-aside" class="home-stats__asof">{statsNote}</p>}
      {/* 회사소개 판 아래 — 공개된 사례가 한 건이라도 있을 때만(빈 목록으로 보내지 않는다) */}
      {cases.some((e) => !e.data.sample) && (
        <div slot="after" class="home-cases-link"><ArrowLink href="/cases/" label="시공사례 보러가기" /></div>
      )}
    </StandardsStory>
  )}

  {/* 세척 — 분해 3D. 회사소개(시공 실적) 바로 아래(2026-10-06 대표: 위가 시공이니 바로 아래에 세척을 —
      시공한 팀이 시공 기록을 갖고 세척까지 맡는다. 그 다음에 '어떤 일로 오셨나요'가 온다).
      전에는 서비스 카드 세 장 다음에 '내부 구조'로 있었다(2026-10-01). 문구 home.json(exploded) */}
  {home.exploded && (
    <Exploded
          id="home-exploded"
          tone="clear"
          eyebrow={home.exploded.eyebrow}
          title={home.exploded.heading}
          body={home.exploded.body.join(' ') || undefined}
          photoNote="제품 사진: 삼성전자·LG전자 공식 제품 이미지"
          photoSwitch
          card
          items={[
            // 2026-10-01 대표: 삼성·LG 사진을 눌러 각 제품의 분해도로 바꾼다(사진 각도·배치는 그대로)
            { label: '삼성 1Way', file: 'samsung-1way-AJ072BN1PBC1.html',
              photos: [{ src: 'ac-1way-samsung-front.webp', alt: '삼성 무풍 1Way 판넬 정면', caption: '삼성 무풍 1Way' }],
              caption: '삼성전자 무풍 1Way · AJ072BN1PBC1 · 냉방 7.2kW · 부품 19개' },   // 거실 대형(2026-10-02 대표: 거실 대형으로)
            { label: 'LG 1Way', file: 'lg-1way-RNQ0231C2SP.html',
              photos: [{ src: 'ac-1way-lg-angle.webp', alt: 'LG 휘센 1Way 실내기 입체', caption: 'LG 휘센 1Way' }],
              caption: 'LG전자 1Way · RNQ0231C2SP · 냉방 2.3kW · 부품 16개' },
          ]}
      />
  )}


  {/* 다크 스크럽 미노출 (2026-08-27) — 이 카피는 히어로 영상 자막으로 들어간다.
      화면에 큰 글자로 또 쓰면 같은 말을 두 번 하는 셈이라 뺐다.
      원본 카피는 src/content/site/hero-worldview.json 에 그대로 있고,
      컴포넌트도 남아 있다. 영상이 준비되면 자막으로 옮기고, 되살리려면 아래 한 줄만 켜면 된다.
      부수 효과: 프레임 에셋이 없어 비어 있던 420vh 스크롤 구간과 /scrub/ 404 2건이 함께 사라진다. */}
  {/* <DarkScrub /> */}

  {/* 서비스 2트랙 (IA v3) — 세척·관리 트랙(정돈→기록) / 설치 트랙(설계).
      리드 문장이 다크 구간의 착지점을 받아 3카드로 나눈다 */}

  {home.services.leadHeading.length > 0 && (
    <section class="bd-section v2-svc-lead">
      <div class="bd-container">
        {/* 회사소개와 같은 머리 구조(2026-10-01 대표) — 라벨 · 제목 · 짧은 설명 */}
        {home.services.eyebrow && <p class="br-sec-label">{home.services.eyebrow}</p>}
        <h2 class="br-h br-reveal">
          {home.services.leadHeading.map((line, i) => (
            <Fragment>{i > 0 && <br />}{line}</Fragment>
          ))}
        </h2>
        {home.services.lead.length > 0 && <p class="br-sec-lead br-reveal">{home.services.lead.map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</p>}
      </div>
    </section>
  )}

  {home.services.cards.map((svc, i) => (
    <Fragment>
    <ServiceSplit
      id={SERVICE_LAYOUT[i]?.id}
      eyebrow={svc.eyebrow}
      link={svc.cta?.href}
      linkLabel={svc.cta?.label ?? ''}
      flip={SERVICE_LAYOUT[i]?.flip ?? false}
      slotId={SERVICE_LAYOUT[i]?.slotId}
      tone={SERVICE_LAYOUT[i]?.tone ?? 'base'}
    >
      <Fragment slot="headline">
        {svc.heading.map((line, j) => (
          <Fragment>{j > 0 && <br />}{line}</Fragment>
        ))}
      </Fragment>
      <Fragment slot="body">
        {/* lines 한 칸 = 한 문장. 카드 안에서는 <br>을 숨기고 문장을 흘리므로(ServiceSplit) 문장 사이 공백을 함께 넣는다.
            <br>이 보이는 환경(CSS 미적용)에서는 줄머리 공백이 접혀 사라진다. */}
        {svc.lines.map((line, j) => (
          <Fragment>{j > 0 && <br />}{j > 0 && ' '}{line}</Fragment>
        ))}
      </Fragment>
    </ServiceSplit>
    </Fragment>
  ))}


  {/* '어떤 일로 오셨나요'(NeedTriage)는 서비스 카드 제목으로 합쳤다(2026-09-30). 증상 상담은 채팅 위젯에 그대로 있다 */}


  {/* 숫자(Stats)는 전부 샘플이라 뺐다(2026-09-30). 실적이 확인되면 trust.json 을 채우고 되살린다 */}

  {home.process && (
    <Process eyebrow={home.process.eyebrow} lead={home.process.lead} heading={home.process.heading} steps={home.process.steps} />
  )}

  {/* <Reviews /> — S9 후기: 실후기(동의 확보분) 교체 전 미노출 */}

  {/* ring(링 스윕)은 뺐다(2026-08-28). 밴드가 단색 teal일 땐 광택이었지만 Dark 유리 위에서는
      ice 버튼과 회청 밴드 사이에 teal 반쪽이 정지 스트로크로 읽힌다. 컴포넌트 기능은 남겨 둔다. */}
  {cta && (
    <CtaBand label={cta.label} buttonLabel={cta.buttonLabel} priceLink>
      {cta.heading.map((line, i) => (
        <Fragment>
          {i > 0 && <br />}
          {splitEmphasis(line, cta.headingEmphasis).map((part, j) => (
            j === 1 ? <em>{part}</em> : <Fragment>{part}</Fragment>
          ))}
        </Fragment>
      ))}
      {cta.body && <Fragment slot="sub">{cta.body}</Fragment>}
    </CtaBand>
  )}

  {/* 바람대로와 함께한 공간 — 홈 맨 아래(2026-10-01 대표). 로고 목록 src/content/site/brands.json */}
  {home.brands && <BrandBand label={home.brands.label} heading={home.brands.heading} lead={home.brands.lead} />}
</Base>

<style>
  /* 리드 제목과 첫 카드를 묶는다 — 아래 여백은 카드 사이 간격(ServiceSplit --svc-gap 24/40)과 같은 값.
     카드 사이 간격과 마지막 카드 뒤 섹션 간격은 ServiceSplit 이 갖는다. */
  .home-cases-link { display: flex; justify-content: flex-end; margin-top: 28px; }
  /* 실적 숫자 — 숫자가 위, 이름이 아래(dt 를 먼저 읽게 두고 보이는 순서만 뒤집는다) */
  .home-stats { margin-top: 24px; }
  /* 누적 한 줄 — 숫자 묶음의 머리(2026-10-02 대표: 글자 키우고 굵게) */
  .home-stats__lead { margin-bottom: 14px; font-size: clamp(20px, 1rem + 0.9vw, 26px); font-weight: 700; line-height: 1.35; letter-spacing: -0.02em; color: var(--br-ink); text-wrap: balance; }
  /* 숫자 셋을 한 줄에(최근 1년 합계 둘 + 하루 평균) — 좁으면 라벨만 두 줄로 접힌다. 숫자는 꺾지 않는다 */
  .home-stats dl { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, max-content); gap: 12px clamp(20px, 4vw, 40px); }
  .home-stats dl > div { display: flex; flex-direction: column-reverse; gap: 2px; }
  .home-stats dt { font-size: 14px; color: var(--br-ink-sub); }
  .home-stats__nb { white-space: nowrap; }
  .home-stats dd { white-space: nowrap; font-size: clamp(26px, 1.1rem + 1.8vw, 40px); font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; color: var(--br-teal); font-variant-numeric: tabular-nums; }
  .home-stats__pre, .home-stats__suf { font-size: 0.5em; font-weight: 700; }
  .home-stats__suf { margin-left: 3px; }
  /* 누적 큰 숫자 — 아래 숫자 셋보다 한 단 크게, 라벨도 한 단 크게 */
  .home-stats .home-stats__total { margin-bottom: 18px; }
  .home-stats .home-stats__total dd { font-size: clamp(40px, 1.6rem + 3vw, 64px); line-height: 1.05; }
  .home-stats .home-stats__total dt { font-size: 15px; font-weight: 600; color: var(--br-ink); }
  .home-stats dl + p { margin-top: 8px; font-size: 13px; color: var(--br-ink-sub); }
  /* 기준 줄은 화면 폭에 따라 한 곳에만 — 넓으면 제목 줄 오른쪽 끝(글씨는 숫자 아래 줄과 같다), 좁으면 숫자 아래 */
  .home-stats__asof { display: none; font-size: 13px; color: var(--br-ink-sub); white-space: nowrap; }
  @media (min-width: 768px) {
    .home-stats__asof { display: block; }
    .home-stats__note { display: none; }
  }
  @media (min-width: 768px) { .home-stats__br { display: none; } } /* 라벨 줄바꿈 자리(trust.json \n)는 좁은 화면에서만 */
  @media (max-width: 359px) { .home-stats dd { font-size: 22px; } } /* 320~359px 에서 숫자가 칸을 넘지 않게 */
  .v2-svc-lead { background: transparent; padding-bottom: var(--head-gap); } /* 장 제목 → 첫 카드 = 제목 묶음 → 본 블록 */
  .v2-svc-lead + :global(.v2-svc) { padding-top: 0; }
</style>
