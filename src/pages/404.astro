---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다">
  <section class="bd-section nf">
    <div class="bd-container">
      <p class="bd-microlabel">404</p>
      <h1 class="bd-section-title">페이지를 찾을 수 없습니다.</h1>
      <p class="nf__desc">주소가 바뀌었거나 삭제된 페이지입니다.</p>
      <p><a class="bd-btn-ghost" href="/">홈으로</a></p>
    </div>
  </section>
</Base>

<style>
  .nf__desc { color: var(--ink-soft); margin-bottom: 28px; }
</style>
