---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/v2/PageHero.astro';
import StoryRow from '../../components/v2/StoryRow.astro';
import CtaBand from '../../components/v2/CtaBand.astro';

const spaces = [
  { title: '카페', detail: '좌석과 주방 배치, 공간을 사용하는 시간' },
  { title: '매장·상가', detail: '출입구와 진열 공간, 실외기 설치 위치' },
  { title: '사무실', detail: '좌석과 회의실 구획, 건물 운영 시간' },
  { title: '학원·교육시설', detail: '강의실 구성과 수업 시간, 공간별 사용 방식' },
  { title: '관공서·공공시설', detail: '담당 부서와 협의 창구, 출입·작업 조건' },
  { title: '대형빌딩', detail: '층별 공간 구성과 기존 설비, 건물 관리 조건' },
];
const services = [
  { title: '신규·교체 설치', body: '새로 설치하거나 기존 에어컨을 교체하는 상담입니다. 공간 용도와 설치 조건부터 확인합니다.', tree: 'install', label: '설치 상담 시작' },
  { title: '세척·관리', body: '기종과 대수, 현재 상태를 바탕으로 상담합니다. 운영 중인 공간은 작업 가능한 시간도 함께 이야기합니다.', tree: 'clean', label: '세척 상담 시작' },
  { title: '고장·증상 확인', body: '바람대로에서 시공·관리를 받은 고객의 AS 안내입니다. 현재 증상과 기존 작업 이력을 확인합니다.', tree: 'as', label: '기존 고객 AS 안내' },
];
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://baramdaero.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '상업용·공공시설', item: `${siteUrl}/commercial/` },
  ],
};
---
<Base title="상업용·공공시설 에어컨 설치·세척" description="카페·매장·사무실·학원부터 관공서·대형빌딩까지. 공간과 운영 조건에 맞는 에어컨 신규·교체 설치, 세척 상담을 시작하세요." jsonLd={jsonLd}>
  <PageHero eyebrow="상업용·공공시설">
    카페부터 대형빌딩까지<br />공간에 맞춰 시작합니다
    <Fragment slot="sub">사람이 일하고, 머물고, 오가는 공간.<br />용도와 운영 조건을 바탕으로 설치·세척을 이야기합니다.</Fragment>
    <Fragment slot="extra"><a class="bd-cta bd-cta--deep" href="#services">상담 종류 선택</a></Fragment>
  </PageHero>

  <section class="bd-section commercial-intro">
    <div class="bd-container">
      <StoryRow slotId="commercial-building" imageSide="right">
        <h2 class="br-h br-reveal">공간의 크기보다<br />쓰임부터 봅니다</h2>
        <p class="br-body br-reveal">하나의 매장부터 여러 층을 사용하는 건물까지 다룹니다. 신규 설치와 교체 설치, 사용 중인 에어컨의 세척·관리를 상담합니다.</p>
        <p class="br-body br-reveal">운영 중인 곳과 개업·입주를 준비하는 곳은 조건이 다릅니다. 현재 상태와 필요한 작업부터 확인합니다.</p>
      </StoryRow>
    </div>
  </section>

  <section class="bd-section commercial-spaces" id="spaces" aria-labelledby="spaces-title">
    <div class="bd-container">
      <h2 class="br-h br-reveal" id="spaces-title">어떤 공간이든<br />조건부터 함께</h2>
      <p class="br-body br-reveal">공간별로 상담에서 살펴볼 내용입니다.</p>
      <dl class="commercial-spaces__list">
        {spaces.map((space) => (
          <div class="commercial-spaces__item br-reveal">
            <dt>{space.title}</dt>
            <dd>{space.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="bd-section commercial-operating">
    <div class="bd-container">
      <StoryRow slotId="commercial-cafe" imageSide="left">
        <h2 class="br-h br-reveal">영업 중인 공간도<br />준비 중인 공간도</h2>
        <p class="br-body br-reveal">현재 운영 상태와 희망 일정을 바탕으로 상담합니다. 여러 공간을 함께 관리한다면 층별 구성과 필요한 작업을 함께 이야기합니다.</p>
        <p class="br-body br-reveal">사전에 말씀드리지 않은 추가금 없이, 작업 사진과 단일 연락 창구를 통해 기록을 이어갑니다.</p>
      </StoryRow>
    </div>
  </section>

  <section class="bd-section commercial-services" id="services" aria-labelledby="services-title">
    <div class="bd-container">
      <h2 class="br-h br-reveal" id="services-title">필요한 일부터<br />시작하세요</h2>
      <div class="commercial-services__list">
        {services.map((service) => (
          <article class="commercial-services__item br-reveal">
            <h3>{service.title}</h3>
            <p>{service.body}</p>
            <button type="button" class="bd-cta bd-cta--deep" disabled aria-describedby="chat-unavailable" data-chat-tree={service.tree}>{service.label}</button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand chatTree="install" buttonLabel="상업용 설치 상담">
    공간을 알려주세요<br />함께 시작하겠습니다
    <Fragment slot="sub">카페·매장·사무실·학원·관공서·대형빌딩</Fragment>
  </CtaBand>
</Base>

<style>
  .commercial-intro, .commercial-operating { background: var(--br-base); }
  .commercial-intro :global(.br-body), .commercial-operating :global(.br-body) { margin-top: 24px; }
  .commercial-spaces { background: var(--br-mist); }
  .commercial-spaces > .bd-container > .br-body { margin-top: 24px; }
  .commercial-spaces__list { display: grid; gap: 0 48px; margin-top: 48px; }
  .commercial-spaces__item { border-top: 1px solid var(--br-ink-sub); padding: 24px 0; }
  .commercial-spaces__item dt { font-size: 22px; font-weight: 700; color: var(--br-teal); }
  .commercial-spaces__item dd { margin: 10px 0 0; line-height: 1.7; color: var(--br-ink-sub); }
  .commercial-services { background: var(--br-teal-deep); color: var(--br-base); scroll-margin-top: 24px; }
  .commercial-services :global(.br-h) { color: var(--br-base); }
  .commercial-services__list { display: grid; gap: 40px; margin-top: 48px; }
  .commercial-services__item { display: flex; flex-direction: column; align-items: flex-start; border-top: 1px solid var(--br-ice); padding-top: 24px; }
  .commercial-services__item h3 { font-size: 24px; }
  .commercial-services__item p { margin: 16px 0 28px; line-height: 1.7; }
  .commercial-services__item .bd-cta { margin-top: auto; }
  @media (min-width: 768px) {
    .commercial-spaces__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .commercial-services__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
