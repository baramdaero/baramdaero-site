---
// 세척·유지관리 랜딩 v2 — 가격·문구는 전부 src/content/site/pricing.json (하드코딩 금지).
// 빈 값이면 해당 섹션 미렌더. 구 버전은 src/legacy/care-index-v1.astro.txt 보존.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import ImageSlot from '../../components/v2/ImageSlot.astro';
import StandardsStory from '../../components/v2/StandardsStory.astro';
import StoryRow from '../../components/v2/StoryRow.astro';
import Exploded from '../../components/v2/Exploded.astro';   // 2026-09-21 기종별 분해 3D
import { SITE_CONFIG } from '../../config.js';
import { loadPricing } from '../../lib/pricing.ts';
import { loadFaq } from '../../lib/faq.ts';
import { loadStandards } from '../../lib/standards.ts';
import { isImageSlotVisible } from '../../lib/image-slots.ts';

const pricing = loadPricing();
const standards = loadStandards();
const { process, processIntro, processSource, symptoms, seasons } = pricing;
const visibleSymptoms = symptoms.filter((s) => !s.hidden);
const visibleSeasons = seasons
  .map((season, index) => ({ ...season, slotId: `care-season-${String(index + 1).padStart(2, '0')}` }))
  .filter((season) => !season.hidden);
const processPairs = Array.from({ length: Math.ceil(process.length / 2) }, (_, i) => process.slice(i * 2, i * 2 + 2));
const processImageCount = (pair: typeof process) => pair.filter((step) => (
  isImageSlotVisible(`care-process-${String(step.step).padStart(2, '0')}`, step.image)
)).length;

const headline = pricing.headline || '세척·유지관리';
const intro = pricing.intro;

// faq_ref=true → faq.json에서 '세척' 관련 항목만 이 페이지에 노출 + FAQPage 마크업
const careFaq = pricing.faqRef
  ? loadFaq().filter((f) => f.q.includes('세척') || f.a.includes('세척'))
  : [];

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';

const symptomSlot = (icon: string, index: number) => ({
  smell: 'care-symptom-smell',
  wind: 'care-symptom-airflow',
  stain: 'care-symptom-outlet',
  drip: 'care-symptom-drip',
}[icon] ?? `care-symptom-${String(index + 1).padStart(2, '0')}`);

/* ---------- JSON-LD ---------- */
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: '에어컨 분해세척·유지관리',
  provider: { '@type': 'HVACBusiness', name: SITE_CONFIG.SITE_NAME, url: siteUrl },
  areaServed: { '@type': 'AdministrativeArea', name: '수도권' },
  // 가격(offers)은 /price/ 가 낸다 — 기준가는 가격 페이지 한 곳에서만 말한다(2026-09-24)
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '세척·관리', item: `${siteUrl}/care/` },
  ],
};

const jsonLd: object[] = [serviceJsonLd, breadcrumbJsonLd];
if (careFaq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: careFaq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<Base title={SITE_CONFIG.CARE_SEO_TITLE} description={SITE_CONFIG.CARE_SEO_DESCRIPTION} jsonLd={jsonLd}>
  <PageHero eyebrow="분해 세척" lead>
    {headline}
    {intro && <Fragment slot="sub">{intro}</Fragment>}
  </PageHero>

  {/* 분해 세척 페이지의 첫 설명: 말로 적기 전에 기종별로 어디까지 열리는지 보여준다 */}
  <Exploded
    id="care-exploded"
    tone="mist"
    eyebrow=""
    title={['기종마다 열리는', '깊이가 다릅니다']}
    items={[
      // 기종 단위다. 부품 구성·분해 순서는 브랜드가 아니라 기종이 정하고, 3D 도 그렇게 만들었다.
      // 기종마다 근거 문서가 가장 분명한 모델 하나를 치수 기준으로 쓴다.
      { label: '1Way', file: 'samsung-1way-AC023CN1PBH1.html',
        caption: '부품 14개 · 3D 분해 8단계 · 치수는 AC023CN1PBH1 기준' },
      { label: '2Way', file: 'lg-2way-RNW0721G2S.html',
        caption: '부품 14개 · 3D 분해 9단계 · 열교환기가 좌·우 두 조, 송풍팬은 관류팬 1본 · 치수는 LG RNW0721G2S 기준' },
      { label: '4Way', file: 'samsung-4way-AC060CN4PBH1.html',
        caption: '부품 15개 · 3D 분해 8단계 · 치수는 AC060CN4PBH1 기준' },
      { label: '360', file: 'samsung-360-AC110CN6PBH1.html',
        caption: '부품 16개 · 원형 토출 프레임에 부스터팬 3개가 들어간다 · 치수는 AC110CN6PBH1 기준' },
      { label: '벽걸이', file: 'samsung-wall-AR06T9170HNQ.html',
        caption: '부품 13개 · 배관은 분해하지 않고 세척한다 · 치수는 AR06T9170HNQ 기준' },
      { label: '스탠드', file: 'samsung-stand-AF25DX934WAN.html',
        caption: '부품 13개 · 치수는 AF25DX934WAN 기준' },
    ]}
  />

  {visibleSymptoms.length > 0 && (
    <section class="bd-section care-symptoms" data-layout-section="care-symptoms">
      <div class="bd-container">
        <span class="br-eyebrow br-reveal">기존 에어컨 관리</span>
        <h2 class="br-h br-reveal">이런 증상이 있다면<br />세척 시점입니다</h2>
        <div class="care-symptoms__grid">
          {visibleSymptoms.map((s, i) => {
            const slotId = symptomSlot(s.icon, i);
            return (
              <article class="care-symptoms__card br-glass br-glass--medium br-reveal" data-glow>
                <ImageSlot id={slotId} label={slotId} ratio="card" />
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </article>
            );
          })}
        </div>
        {/* 같은 접수가 카드마다 반복되던 버튼 4개를 하나로 (한 화면 한 동작, 2026-09-23) */}
        <p class="care-symptoms__more br-reveal">
          <button disabled aria-describedby="chat-unavailable" type="button" class="br-pill" data-chat-tree="clean">
            세척 견적 받기 <span aria-hidden="true">→</span>
          </button>
        </p>
      </div>
    </section>
  )}

  {/* 6단계를 한 섹션에 둔다 — 페어로 쪼개면 눈썹이 3번 반복되고
      pair[0]의 제목이 h2로 올라가 6단계가 3개 섹션으로 읽힌다(08-27 실측). */}
  {process.length > 0 && (
    <section class="bd-section care-process care-process--mist" data-layout-section="care-process">
      <div class="bd-container">
        <h2 class="br-h br-reveal">분해세척 {process.length}단계</h2>
        {processIntro.length > 0 && (
          <p class="br-body br-reveal">
            {processIntro.map((line, j) => <Fragment>{j > 0 && <br />}{line}</Fragment>)}
          </p>
        )}
        <ol class="care-process__list">
          {process.map((st) => {
            const slotId = `care-process-${String(st.step).padStart(2, '0')}`;
            return (
              <li class="care-process__card br-glass br-glass--medium br-reveal">
                {isImageSlotVisible(slotId, st.image) && (
                  <ImageSlot id={slotId} src={st.image} alt={`${st.title} 단계 이미지`} label={slotId} ratio="square" />
                )}
                <span class="care-process__no">{String(st.step).padStart(2, '0')}</span>
                <h3 class="care-process__title">{st.title}</h3>
                <p class="br-body">{st.body}</p>
              </li>
            );
          })}
        </ol>
        {processSource.length > 0 && (
          <p class="care-process__source br-reveal">
            {processSource.map((line, j) => <Fragment>{j > 0 && <br />}{line}</Fragment>)}
          </p>
        )}
      </div>
    </section>
  )}

  <StandardsStory
    promise={standards.promiseCare}
    slotPrefix="care"
    startSide="right"
    startTone="base"
  />

  {visibleSeasons.length > 0 && (
  <section class="bd-section care-close">
    <div class="bd-container">
        <div class="care-seasons" data-layout-section="care-seasons">
          <h2 class="br-h br-reveal">세척 시기</h2>
          <div class="care-seasons__grid">
            {visibleSeasons.map((s) => (
              <article class="care-seasons__card br-glass br-glass--heavy br-reveal">
                <div class="care-seasons__heading">
                  {s.months && <span class="care-seasons__months">{s.months}</span>}
                  <h3>{s.season}</h3>
                </div>
                <ImageSlot id={s.slotId} label={s.slotId} ratio="card" />
                <p>{s.body}</p>
              </article>
            ))}
          </div>
        </div>
    </div>
  </section>
  )}

  {/* 자주 묻는 질문 — 세척 시기와 한 섹션이던 것을 나눴다(섹션 하나에 제목 하나). 전부 닫아 둔다 */}
  {careFaq.length > 0 && (
    <section class="bd-section care-faq" data-layout-section="care-faq">
      <div class="bd-container">
        <h2 class="br-h br-reveal">자주 묻는 질문</h2>
        <div class="care-faq__list br-reveal">
          {careFaq.map((f) => (
            <details class="care-faq__item br-glass br-glass--medium">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand chatTree="clean" buttonLabel="견적 문의" priceLink>
    <em>견적</em>은 방문 전에<br />나옵니다
    <Fragment slot="sub">기종과 대수만 알려주시면 됩니다.</Fragment>
  </CtaBand>
</Base>

<style>
  /* 절차 — 회색 섹션 위 기본색 카드 (/install/ 과 같은 패턴) */
  .care-process--mist { background: transparent; } /* 유리 카드 호스트 — 투명해야 앰비언트가 비친다 */
  .care-process__list { margin-top: var(--head-gap); list-style: none; display: grid; gap: 16px; }
  .care-process__card {
    padding: 28px 24px;
    /* 배경·테두리·radius·그림자는 .br-glass--medium 이 맡는다 */
  }
  .care-process__no {
    display: block; font-size: 13px; font-weight: 700;
    letter-spacing: 0.14em; color: var(--br-ink-sub);
  }
  .care-process__title { margin-top: 6px; color: var(--br-ink); font-size: clamp(20px, 2.4vw, 26px); }
  .care-process__card .br-body { margin-top: 10px; }
  .care-process__card :global(.br-image-slot) { margin-bottom: 20px; max-width: 100%; }
  /* 모바일 — 사진은 왼쪽 썸네일, 글은 오른쪽 (설치 4단계와 같은 행) */
  @media (max-width: 767px) {
    .care-process__card { display: grid; grid-template-columns: 104px minmax(0, 1fr); column-gap: 16px; align-content: start; padding: 12px 16px 12px 12px; }
    .care-process__card :global(.br-image-slot) { grid-row: 1 / span 3; margin-bottom: 0; }
    .care-process__card .br-body { font-size: 14px; }
  }
  @media (min-width: 768px) {
    .care-process__list { gap: 20px; grid-template-columns: repeat(2, 1fr); }
    .care-process__card { padding: 28px; }
  }
  /* 6단계를 3×2 한 판으로 — 한 화면에 절차 전체가 들어온다 */
  @media (min-width: 1024px) {
    .care-process__list { grid-template-columns: repeat(3, 1fr); }
    .care-process__card { padding: 24px; }
  }

  .care-symptoms { background: transparent; } /* 유리 카드 호스트 */
  .care-symptoms__grid,
  .care-seasons__grid {
    margin-top: var(--head-gap);
    display: grid;
    gap: 16px;
  }

  .care-symptoms__card,
  .care-seasons__card {
    display: flex;
    flex-direction: column;
    padding: 16px;
    /* 증상(Medium, 밝은 호스트) / 세척시기(Heavy, 딥 호스트) — 면은 .br-glass 등급이 맡는다 */
  }

  .care-symptoms__card :global(.br-image-slot) { max-width: none; margin-bottom: 20px; }
  .care-seasons__card { display: grid; grid-template-columns: minmax(0, 1fr) 176px; gap: 16px; align-content: start; padding: 24px; }
  .care-seasons__card :global(.br-image-slot) { width: 176px; align-self: start; margin: 0; }
  .care-seasons__card p { grid-column: 1 / -1; }
  /* 증상 카드 제목 — 카드 안에서 가장 강한 글자(본문 14px ink 위) */
  .care-symptoms__card h3 { font-size: 16px; font-weight: 700; line-height: 1.4; color: var(--br-ink); }
  /* 월 범위 — 제목 위 작은 표기. 비면 이 줄만 빠진다.
     ink: 딥 섹션 위 유리 카드(≈#b7c8d0)에서 ink-sub 는 3.9:1 로 미달(2026-09-23 실측) */
  .care-seasons__months {
    display: block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--br-ink);
  }
  .care-seasons__card h3 { margin-top: 8px; color: var(--br-ink); font-size: 20px; line-height: 1.45; }
  .care-symptoms__card p,
  .care-seasons__card p { margin-top: 8px; color: var(--br-ink); font-size: 14px; line-height: 1.65; }

  .care-symptoms__more { margin-top: 32px; }

  .care-process__story--base { background: var(--br-base); }
  .care-process__story--mist { background: var(--br-mist); }
  .care-process__story--deep { background: var(--br-teal-deep); }
  .care-process__story--deep .care-process__steps h3 { color: #fff; }
  .care-process__visual-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .care-process__visual-grid--single { grid-template-columns: minmax(0, 1fr); }
  .care-process__visual-grid :global(.br-image-slot) { max-width: none; }
  .care-process__steps { margin-top: 28px; list-style: none; display: grid; gap: 18px; }
  .care-process__steps li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; }
  .care-process__steps li > span {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--br-ice);
    color: var(--br-ink-sub);
    font-size: 13px;
    font-weight: 700;
  }
  .care-process__steps h3 { color: var(--br-ink); font-size: 17px; }
  .care-process__steps p { margin-top: 6px; color: var(--br-ink); font-size: 14px; line-height: 1.65; }
  .care-process__source { margin-top: 24px; color: var(--br-ink); font-size: 13px; line-height: 1.75; }

  .care-close { background: var(--br-teal-deep); }
  .care-close :global(.br-h) { color: var(--br-base); }
  .care-seasons__grid { grid-template-columns: 1fr; }
  .care-faq { background: transparent; } /* 유리 카드 호스트 */
  .care-faq__list { margin-top: var(--head-gap); display: grid; gap: 10px; }
  .care-faq__item { color: var(--br-ink); } /* 면은 .br-glass--medium */
  .care-faq__item summary { min-height: 44px; padding: 16px 18px; cursor: pointer; color: var(--br-ink); font-weight: 700; }
  .care-faq__item p { padding: 0 18px 18px; color: var(--br-ink); font-size: 15px; line-height: 1.75; }

  @media (min-width: 768px) {
    .care-symptoms__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .care-seasons__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .care-symptoms__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (max-width: 520px) {
    .care-seasons__card { grid-template-columns: minmax(0, 1fr) 128px; padding: 20px; gap: 12px; }
    .care-seasons__card :global(.br-image-slot) { width: 128px; }
    .care-seasons__card h3 { font-size: 18px; }
    .care-process__visual-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
