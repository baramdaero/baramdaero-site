---
// 세척·유지관리 랜딩 v2 — 가격·문구는 전부 src/content/site/pricing.json (하드코딩 금지).
// 빈 값이면 해당 섹션 미렌더. 구 버전은 src/legacy/care-index-v1.astro.txt 보존.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import ImageSlot from '../../components/v2/ImageSlot.astro';
import StandardsStory from '../../components/v2/StandardsStory.astro';
import StoryRow from '../../components/v2/StoryRow.astro';
import { SITE_CONFIG } from '../../config.js';
import { loadPricing } from '../../lib/pricing.ts';
import { loadFaq } from '../../lib/faq.ts';
import { loadStandards } from '../../lib/standards.ts';
import { isImageSlotVisible } from '../../lib/image-slots.ts';

const pricing = loadPricing();
const standards = loadStandards();
const { prices, conditions, process, processIntro, processSource, symptoms, seasons } = pricing;
const visibleSymptoms = symptoms.filter((s) => !s.hidden);
const visibleSeasons = seasons
  .map((season, index) => ({ ...season, slotId: `care-season-${String(index + 1).padStart(2, '0')}` }))
  .filter((season) => !season.hidden);
const processPairs = Array.from({ length: Math.ceil(process.length / 2) }, (_, i) => process.slice(i * 2, i * 2 + 2));
const processImageCount = (pair: typeof process) => pair.filter((step) => (
  isImageSlotVisible(`care-process-${String(step.step).padStart(2, '0')}`, step.image)
)).length;

const headline = pricing.headline || '세척·유지관리';
const intro = pricing.intro;

// faq_ref=true → faq.json에서 '세척' 관련 항목만 이 페이지에 노출 + FAQPage 마크업
const careFaq = pricing.faqRef
  ? loadFaq().filter((f) => f.q.includes('세척') || f.a.includes('세척'))
  : [];

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';

const symptomSlot = (icon: string, index: number) => ({
  smell: 'care-symptom-smell',
  wind: 'care-symptom-airflow',
  stain: 'care-symptom-outlet',
  drip: 'care-symptom-drip',
}[icon] ?? `care-symptom-${String(index + 1).padStart(2, '0')}`);

/* ---------- JSON-LD (v1과 동일 유지) ---------- */
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: '에어컨 분해세척·유지관리',
  provider: { '@type': 'HVACBusiness', name: SITE_CONFIG.SITE_NAME, url: siteUrl },
  areaServed: { '@type': 'AdministrativeArea', name: '수도권' },
  ...(prices.length
    ? {
        offers: prices.map((p) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: `${p.type} 분해세척` },
          ...(p.unit.includes('만원')
            ? {
                priceSpecification: {
                  '@type': 'UnitPriceSpecification',
                  minPrice: p.base * 10000,
                  priceCurrency: 'KRW',
                },
              }
            : {}),
        })),
      }
    : {}),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '세척·관리', item: `${siteUrl}/care/` },
  ],
};

const jsonLd: object[] = [serviceJsonLd, breadcrumbJsonLd];
if (careFaq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: careFaq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<Base title={SITE_CONFIG.CARE_SEO_TITLE} description={SITE_CONFIG.CARE_SEO_DESCRIPTION} jsonLd={jsonLd}>
  <PageHero eyebrow="분해 세척" lead>
    {headline}
    {intro && <Fragment slot="sub">{intro}</Fragment>}
  </PageHero>

  {visibleSymptoms.length > 0 && (
    <section class="bd-section care-symptoms" data-layout-section="care-symptoms">
      <div class="bd-container">
        <span class="br-eyebrow br-reveal">기존 에어컨 관리</span>
        <h2 class="br-h br-reveal">이런 증상이 있다면<br />세척 시점입니다</h2>
        <div class="care-symptoms__grid">
          {visibleSymptoms.map((s, i) => {
            const slotId = symptomSlot(s.icon, i);
            return (
              <article class="care-symptoms__card br-reveal">
                <ImageSlot id={slotId} label={slotId} ratio="card" />
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <button type="button" class="care-symptoms__cta" data-chat-tree="clean">
                  세척 견적 받기 <span aria-hidden="true">→</span>
                </button>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* 6단계를 한 섹션에 둔다 — 페어로 쪼개면 눈썹이 3번 반복되고
      pair[0]의 제목이 h2로 올라가 6단계가 3개 섹션으로 읽힌다(08-27 실측). */}
  {process.length > 0 && (
    <section class="bd-section care-process care-process--mist" data-layout-section="care-process">
      <div class="bd-container">
        <span class="br-eyebrow br-reveal">분해세척 절차</span>
        <h2 class="br-h br-reveal">뜯고, 씻고,<br />기록으로 남깁니다</h2>
        {processIntro.length > 0 && (
          <p class="br-body br-reveal">
            {processIntro.map((line, j) => <Fragment>{j > 0 && <br />}{line}</Fragment>)}
          </p>
        )}
        <ol class="care-process__list">
          {process.map((st) => {
            const slotId = `care-process-${String(st.step).padStart(2, '0')}`;
            return (
              <li class="care-process__card br-reveal">
                {isImageSlotVisible(slotId, st.image) && (
                  <ImageSlot id={slotId} src={st.image} alt={`${st.title} 작업 사진`} label={slotId} ratio="square" />
                )}
                <span class="care-process__no">{String(st.step).padStart(2, '0')}</span>
                <h3 class="care-process__title">{st.title}</h3>
                <p class="br-body">{st.body}</p>
              </li>
            );
          })}
        </ol>
        {processSource.length > 0 && (
          <p class="care-process__source br-reveal">
            {processSource.map((line, j) => <Fragment>{j > 0 && <br />}{line}</Fragment>)}
          </p>
        )}
      </div>
    </section>
  )}

  <StandardsStory
    promise={standards.promiseCare}
    baseline={standards.baselineCare}
    noExtra={standards.noExtra}
    slotPrefix="care"
    startSide="right"
    startTone="base"
    pricingEyebrow="기준가"
    pricingHeading="견적서에 없는 돈은 현장에서도 없습니다"
  >
    <Fragment slot="pricing">
      {prices.length > 0 ? (
        <Fragment>
          <div class="care-prices__wrap br-reveal">
            <table class="care-prices__table">
              <thead><tr><th scope="col">기종</th><th scope="col">기준가</th><th scope="col">비고</th></tr></thead>
              <tbody>
                {prices.map((p) => (
                  <tr>
                    <th scope="row">{p.type}</th>
                    <td class="care-prices__value">{p.base.toLocaleString('ko-KR')}<span>{p.unit}</span></td>
                    <td>{p.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {conditions.length > 0 && <ul class="care-prices__conditions br-reveal">{conditions.map((c) => <li>{c}</li>)}</ul>}
        </Fragment>
      ) : (
        <div class="care-prices__pending br-reveal">
          <p class="care-prices__pending-title">기준가는 챗봇 상담으로 안내합니다.</p>
          <p>기종과 대수만 알려주시면 바로 확인하실 수 있습니다.</p>
          <button type="button" class="bd-cta" data-chat-tree="clean">세척 견적 받기</button>
        </div>
      )}
    </Fragment>
  </StandardsStory>

  <section class="bd-section care-close">
    <div class="bd-container">
      {visibleSeasons.length > 0 && (
        <div class="care-seasons" data-layout-section="care-seasons">
          <span class="br-eyebrow br-reveal">정기 관리</span>
          <h2 class="br-h br-reveal">언제 하는 게 좋은가</h2>
          <div class="care-seasons__grid">
            {visibleSeasons.map((s) => (
              <article class="care-seasons__card br-reveal">
                <ImageSlot id={s.slotId} label={s.slotId} ratio="card" />
                <h3>{s.season}</h3>
                <p>{s.body}</p>
              </article>
            ))}
          </div>
        </div>
      )}

      {careFaq.length > 0 && (
        <div class="care-faq" data-layout-section="care-faq">
          <span class="br-eyebrow br-reveal">자주 묻는 질문</span>
          <h2 class="br-h br-reveal">묻기 전에<br />먼저 답해 둡니다</h2>
          <div class="care-faq__list br-reveal">
            {careFaq.map((f, i) => (
              <details class="care-faq__item" open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <CtaBand chatTree="clean" buttonLabel="견적 문의">
    <em>견적</em>은 방문 전에<br />나옵니다
    <Fragment slot="sub">기종과 대수만 알려주시면 됩니다.</Fragment>
  </CtaBand>
</Base>

<style>
  /* 절차 — 회색 섹션 위 기본색 카드 (/install/ 과 같은 패턴) */
  .care-process--mist { background: var(--br-mist); }
  .care-process__list { margin-top: 48px; list-style: none; display: grid; gap: 16px; }
  .care-process__card {
    background: var(--br-base);
    border-radius: var(--radius);
    padding: 28px 24px;
    border: 1px solid rgba(0, 78, 100, 0.06);
  }
  .care-process__no {
    display: block; font-size: 13px; font-weight: 700;
    letter-spacing: 0.14em; color: var(--br-teal); opacity: 0.55;
  }
  .care-process__title { margin-top: 6px; color: var(--br-teal); font-size: clamp(20px, 2.4vw, 26px); }
  .care-process__card .br-body { margin-top: 10px; }
  .care-process__card :global(.br-image-slot) { margin-bottom: 20px; max-width: 100%; }
  @media (min-width: 768px) {
    .care-process__list { gap: 20px; grid-template-columns: repeat(2, 1fr); }
    .care-process__card { padding: 36px 32px; }
  }

  .care-symptoms { background: var(--br-base); }
  .care-symptoms__grid,
  .care-seasons__grid {
    margin-top: 48px;
    display: grid;
    gap: 16px;
  }

  .care-symptoms__card,
  .care-seasons__card {
    display: flex;
    flex-direction: column;
    padding: 16px;
    border: 1px solid var(--br-mist);
    border-radius: var(--radius);
    background: var(--br-base);
  }

  .care-symptoms__card :global(.br-image-slot),
  .care-seasons__card :global(.br-image-slot) { max-width: none; margin-bottom: 20px; }
  .care-symptoms__card h3,
  .care-seasons__card h3 { color: var(--br-teal); font-size: 17px; }
  .care-symptoms__card p,
  .care-seasons__card p { margin-top: 8px; color: var(--br-ink); font-size: 14px; line-height: 1.65; }

  .care-symptoms__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    min-height: 44px;
    color: var(--br-teal);
    font-size: 14px;
    font-weight: 700;
    transition: color var(--dur-color) ease, gap var(--dur-color) var(--ease-out);
  }
  .care-symptoms__cta:hover { color: var(--br-teal-deep); }
  .care-symptoms__cta:active { transform: scale(0.98); }

  .care-process__story--base { background: var(--br-base); }
  .care-process__story--mist { background: var(--br-mist); }
  .care-process__story--deep { background: var(--br-teal-deep); }
  .care-process__story--deep .care-process__steps h3 { color: var(--br-ice); }
  .care-process__visual-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .care-process__visual-grid--single { grid-template-columns: minmax(0, 1fr); }
  .care-process__visual-grid :global(.br-image-slot) { max-width: none; }
  .care-process__steps { margin-top: 28px; list-style: none; display: grid; gap: 18px; }
  .care-process__steps li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; }
  .care-process__steps li > span {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--br-ice);
    color: var(--br-teal);
    font-size: 13px;
    font-weight: 700;
  }
  .care-process__steps h3 { color: var(--br-teal); font-size: 17px; }
  .care-process__steps p { margin-top: 6px; color: var(--br-ink); font-size: 14px; line-height: 1.65; }
  .care-process__source { margin-top: 24px; color: var(--br-ink); font-size: 13px; line-height: 1.75; }

  .care-prices__wrap { margin-top: 32px; overflow-x: auto; border: 1px solid var(--br-teal); border-radius: var(--radius); }
  .care-prices__table { width: 100%; min-width: 480px; border-collapse: collapse; font-size: 14px; }
  .care-prices__table th,
  .care-prices__table td { padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--br-mist); }
  .care-prices__table tr:last-child th,
  .care-prices__table tr:last-child td { border-bottom: 0; }
  .care-prices__table thead th { color: var(--br-teal); }
  .care-prices__value { color: var(--br-teal); font-size: 18px; font-weight: 700; white-space: nowrap; }
  .care-prices__value span { margin-left: 2px; font-size: 13px; }
  .care-prices__conditions { margin-top: 16px; padding-left: 18px; color: var(--br-ink); font-size: 13px; }
  .care-prices__pending { margin-top: 32px; padding: 24px; border: 1px solid var(--br-teal); border-radius: var(--radius); }
  .care-prices__pending-title { color: var(--br-teal); font-size: 18px; font-weight: 800; }
  .care-prices__pending p + p { margin-top: 10px; color: var(--br-ink); font-size: 14px; }
  .care-prices__pending :global(.bd-cta) { margin-top: 22px; }

  .care-close { background: var(--br-teal-deep); }
  .care-close :global(.br-h) { color: var(--br-base); }
  .care-seasons__grid { grid-template-columns: 1fr; }
  .care-faq { margin-top: 120px; }
  .care-faq__list { margin-top: 48px; display: grid; gap: 10px; }
  .care-faq__item { border-radius: var(--radius); background: var(--br-base); color: var(--br-ink); }
  .care-faq__item summary { min-height: 44px; padding: 16px 18px; cursor: pointer; color: var(--br-ink); font-weight: 700; }
  .care-faq__item p { padding: 0 18px 18px; color: var(--br-ink); font-size: 15px; line-height: 1.75; }
  :global(.v2-cta .bd-container .v2-cta__sub) { color: var(--br-base); }

  @media (min-width: 768px) {
    .care-symptoms__grid,
    .care-seasons__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 520px) {
    .care-process__visual-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .care-faq { margin-top: 72px; }
  }
</style>
