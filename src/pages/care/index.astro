---
// 세척·유지관리 랜딩 v2 — 가격·문구는 전부 src/content/site/pricing.json (하드코딩 금지).
// 빈 값이면 해당 섹션 미렌더. 구 버전은 src/legacy/care-index-v1.astro.txt 보존.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import { SITE_CONFIG } from '../../config.js';
import { loadPricing } from '../../lib/pricing.ts';
import { loadFaq } from '../../lib/faq.ts';

const pricing = loadPricing();
const { prices, conditions, process, symptoms, seasons } = pricing;

const headline = pricing.headline || '세척·유지관리';
const intro = pricing.intro;

// faq_ref=true → faq.json에서 '세척' 관련 항목만 이 페이지에 노출 + FAQPage 마크업
const careFaq = pricing.faqRef
  ? loadFaq().filter((f) => f.q.includes('세척') || f.a.includes('세척'))
  : [];

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';

// 증상 카드 아이콘 — currentColor 라인 SVG (DESIGN.md: 이모지 금지)
const ICON_PATHS: Record<string, string> = {
  smell: 'M7 17c0-2 1.5-2.5 1.5-4.5S7 10 7 8s1.5-2.5 1.5-4.5 M12.5 17c0-2 1.5-2.5 1.5-4.5s-1.5-2.5-1.5-4.5 1.5-2.5 1.5-4.5 M18 17c0-2 1.5-2.5 1.5-4.5S18 10 18 8s1.5-2.5 1.5-4.5',
  wind: 'M3 8h11a3 3 0 1 0-3-3 M3 13h15a3 3 0 1 1-3 3 M3 18h7',
  stain: 'M4 14h16l-2 4H6l-2-4Z M8 11v.01 M12 10v.01 M16 11v.01 M12 6v.01',
  drip: 'M12 4c3 4 5 6.5 5 9a5 5 0 0 1-10 0c0-2.5 2-5 5-9Z',
};

/* ---------- JSON-LD (v1과 동일 유지) ---------- */
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: '에어컨 분해세척·유지관리',
  provider: { '@type': 'HVACBusiness', name: SITE_CONFIG.SITE_NAME, url: siteUrl },
  areaServed: { '@type': 'AdministrativeArea', name: '수도권' },
  ...(prices.length
    ? {
        offers: prices.map((p) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: `${p.type} 분해세척` },
          ...(p.unit.includes('만원')
            ? {
                priceSpecification: {
                  '@type': 'UnitPriceSpecification',
                  minPrice: p.base * 10000,
                  priceCurrency: 'KRW',
                },
              }
            : {}),
        })),
      }
    : {}),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '세척·관리', item: `${siteUrl}/care/` },
  ],
};

const jsonLd: object[] = [serviceJsonLd, breadcrumbJsonLd];
if (careFaq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: careFaq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<Base title={SITE_CONFIG.CARE_SEO_TITLE} description={SITE_CONFIG.CARE_SEO_DESCRIPTION} jsonLd={jsonLd}>
  <PageHero eyebrow="분해 세척">
    {headline}
    {intro && <Fragment slot="sub">{intro}</Fragment>}
  </PageHero>

  {/* 세척·관리 트랙 v3 — 기존 에어컨 관리(증상) → 분해세척(절차→기준가) → 정기관리(시기) 순서 */}
  {symptoms.length > 0 && (
    <section class="bd-section care-symptoms">
      <div class="bd-container">
        <span class="br-eyebrow br-reveal">기존 에어컨 관리</span>
        <h2 class="br-h br-reveal">이런 증상이 있다면<br />세척 시점입니다</h2>
        <div class="care-symptoms__grid">
          {symptoms.map((s) => (
            <div class="care-symptoms__card br-reveal">
              {s.icon && (
                <svg class="care-symptoms__icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={ICON_PATHS[s.icon]} />
                </svg>
              )}
              <h3 class="care-symptoms__title">{s.title}</h3>
              <p class="care-symptoms__body">{s.body}</p>
              <button type="button" class="care-symptoms__cta" data-chat-tree="clean">
                세척 견적 받기
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
              </button>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {process.length > 0 && (
    <section class="bd-section care-process">
      <div class="bd-container">
        <span class="br-eyebrow br-reveal">분해세척 절차</span>
        <h2 class="br-h br-reveal">뜯고, 씻고,<br />기록으로 남깁니다</h2>
        <ol class="care-process__list">
          {process.map((st) => (
            <li class="care-process__item br-reveal">
              <span class="care-process__no">{String(st.step).padStart(2, '0')}</span>
              <div class="care-process__body">
                <h3>{st.title}</h3>
                <p>{st.body}</p>
                {st.image && <img src={st.image} alt={`${st.title} 작업 사진`} loading="lazy" />}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="bd-section care-prices">
    <div class="bd-container">
      <span class="br-eyebrow br-reveal">기준가</span>
      <h2 class="br-h br-reveal">견적서에 없는 돈은<br />현장에서도 없습니다</h2>
      {prices.length > 0 ? (
        <Fragment>
          <div class="care-prices__wrap br-reveal">
            <table class="care-prices__table">
              <thead>
                <tr><th scope="col">기종</th><th scope="col">기준가</th><th scope="col">비고</th></tr>
              </thead>
              <tbody>
                {prices.map((p) => (
                  <tr>
                    <th scope="row">{p.type}</th>
                    <td class="care-prices__value">{p.base.toLocaleString('ko-KR')}<span class="care-prices__unit">{p.unit}</span></td>
                    <td class="care-prices__note">{p.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {conditions.length > 0 && (
            <ul class="care-prices__conditions br-reveal">
              {conditions.map((c) => <li>{c}</li>)}
            </ul>
          )}
        </Fragment>
      ) : (
        /* 확정가 미입력(전부 sample) — 근거 없는 숫자를 띄우는 대신 상담으로 연결 */
        <div class="care-prices__pending br-reveal">
          <p class="care-prices__pending-title">기준가는 챗봇 상담으로 안내합니다.</p>
          <p class="care-prices__pending-body">기종과 대수, 사진 몇 장이면 확정 견적을 드립니다.<br />방문해서 금액이 올라가는 일은 없습니다.</p>
          <button type="button" class="bd-cta care-prices__pending-cta" data-chat-tree="clean">세척 견적 받기</button>
        </div>
      )}
    </div>
  </section>

  {seasons.length > 0 && (
    <section class="bd-section care-seasons">
      <div class="bd-container">
        <span class="br-eyebrow br-reveal">정기 관리</span>
        <h2 class="br-h br-reveal">미룰수록<br />오염은 깊어집니다</h2>
        <div class="care-seasons__grid">
          {seasons.map((s) => (
            <div class="care-seasons__card br-reveal">
              <h3>{s.season}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {careFaq.length > 0 && (
    <section class="bd-section care-faq">
      <div class="bd-container">
        <span class="br-eyebrow br-reveal">자주 묻는 질문</span>
        <h2 class="br-h br-reveal">묻기 전에<br />먼저 답해 둡니다</h2>
        <dl class="care-faq__list br-reveal">
          {careFaq.map((f) => (
            <div class="care-faq__item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <CtaBand chatTree="clean" buttonLabel="사진 보내고 확정 견적 받기">
    전면·측면 <em>사진</em>이면<br />충분합니다
    <Fragment slot="sub">기종과 대수를 선택하고 사진을 보내주시면 확정 견적을 드립니다.</Fragment>
  </CtaBand>
</Base>

<style>
  /* 증상 카드 — 화이트 섹션 */
  .care-symptoms { background: var(--br-base); }
  .care-symptoms__grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .care-symptoms__card {
    border: 1px solid var(--br-line);
    border-radius: var(--radius);
    background: #fff;
    padding: 22px 20px 16px;
    display: flex;
    flex-direction: column;
  }
  .care-symptoms__icon { color: var(--br-teal); margin-bottom: 12px; }
  .care-symptoms__title { font-size: 17px; margin-bottom: 8px; color: var(--br-teal); }
  .care-symptoms__body { font-size: 14px; color: var(--br-ink-sub); flex: 1; }
  .care-symptoms__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 700;
    color: var(--br-teal);
    transition: color var(--dur-color) ease, gap var(--dur-color) var(--ease-out);
  }
  .care-symptoms__cta:hover { color: var(--br-teal-deep); }
  .care-symptoms__cta:active { transform: scale(0.98); }

  /* 기준가 표 — bg-alt 섹션 */
  .care-prices { background: var(--br-base); }
  .care-prices__wrap {
    margin-top: 48px;
    background: #fff;
    border: 1px solid var(--br-line);
    border-radius: 16px;
    overflow-x: auto;
  }
  .care-prices__table { width: 100%; min-width: 480px; border-collapse: collapse; font-size: 15px; }
  .care-prices__table th,
  .care-prices__table td {
    text-align: left;
    padding: 14px 20px;
    border-bottom: 1px solid var(--br-line);
  }
  .care-prices__table tr:last-child th,
  .care-prices__table tr:last-child td { border-bottom: 0; }
  .care-prices__table thead th {
    font-size: 13px;
    font-weight: 700;
    color: var(--br-teal);
    border-bottom: 2px solid var(--br-line);
  }
  .care-prices__table tbody th { font-weight: 600; }
  .care-prices__value {
    font-weight: 700;
    font-size: 19px;
    color: var(--br-teal);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .care-prices__unit { font-size: 14px; margin-left: 1px; }
  .care-prices__note { font-size: 13.5px; color: var(--br-ink-sub); }
  .care-prices__conditions {
    margin-top: 16px;
    list-style: none;
    display: grid;
    gap: 6px;
  }
  .care-prices__conditions li {
    font-size: 13px;
    color: var(--br-ink-sub);
    padding-left: 14px;
    position: relative;
  }
  /* 확정가 미입력 폴백 */
  .care-prices__pending {
    margin-top: 48px;
    background: #fff;
    border: 1px solid var(--br-line);
    border-radius: 16px;
    padding: 40px 24px;
    text-align: center;
  }
  .care-prices__pending-title { font-size: 20px; font-weight: 800; color: var(--br-teal); }
  .care-prices__pending-body { margin-top: 12px; font-size: 15px; line-height: 1.7; color: var(--br-ink-sub); }
  .care-prices__pending-cta { margin-top: 28px; }

  .care-prices__conditions li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 6px;
    height: 1px;
    background: var(--br-ink-sub);
  }

  /* 절차 — mist 섹션 */
  .care-process { background: var(--br-mist); }
  .care-process__list { margin-top: 48px; list-style: none; display: grid; max-width: 760px; }
  .care-process__item {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 14px;
    padding: 20px 0;
    border-bottom: 1px solid var(--br-line);
  }
  .care-process__item:last-child { border-bottom: 0; }
  .care-process__no {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--br-ice);
    color: var(--br-teal);
    font-size: 13px;
    font-weight: 700;
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .care-process__body h3 { font-size: 17px; margin-bottom: 6px; color: var(--br-teal); }
  .care-process__body p { font-size: 15px; color: var(--br-ink-sub); }
  .care-process__body img { margin-top: 12px; border-radius: var(--radius); }

  /* 계절 카드 — bg-alt 섹션 */
  .care-seasons { background: var(--br-mist); }
  .care-seasons__grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .care-seasons__card {
    background: #fff;
    border: 1px solid var(--br-line);
    border-radius: var(--radius);
    padding: 20px 18px;
  }
  .care-seasons__card h3 { font-size: 16px; margin-bottom: 8px; color: var(--br-teal); }
  .care-seasons__card p { font-size: 14px; color: var(--br-ink-sub); }

  /* FAQ — 화이트 섹션 */
  .care-faq { background: var(--br-base); }
  .care-faq__list { margin-top: 48px; display: grid; gap: 0; max-width: 760px; border-top: 2px solid var(--br-teal); }
  .care-faq__item { padding: 18px 4px; border-bottom: 1px solid var(--br-line); }
  .care-faq__item dt { font-weight: 700; font-size: 16px; margin-bottom: 6px; color: var(--br-ink); }
  .care-faq__item dd { font-size: 15px; color: var(--br-ink-sub); }

  @media (max-width: 900px) {
    .care-symptoms__grid, .care-seasons__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .care-symptoms__grid, .care-seasons__grid { grid-template-columns: 1fr; }
  }
</style>
