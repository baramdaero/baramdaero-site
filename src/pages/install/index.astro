---
// 설치 트랙 랜딩 — 신규 설치 안내 + 이후 세척·정기관리 연결 (IA v3).
// 수치·가격 하드코딩 금지 (DESIGN.md §7) — 절차·연결 설명만 다룬다.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/v2/PageHero.astro';
import CtaBand from '../../components/v2/CtaBand.astro';
import StandardsStory from '../../components/v2/StandardsStory.astro';
import StoryRow from '../../components/v2/StoryRow.astro';
import { loadStandards } from '../../lib/standards.ts';
import { loadSituations } from '../../lib/situations.ts';

const standards = loadStandards();

// 상황별 안내 — situations.json에 준비된 페이지만 (없으면 링크 목록 미노출)
const situations = loadSituations();

// 순서는 견적(방문 없이) → 설계(시공 전) → 시공 → 시운전·기록.
// "실측"은 견적 단계로 읽혀 CTA·히어로의 "방문 전 견적"과 부딪히므로 쓰지 않는다.
// 제품 영상 — 삼성전자 공식 채널 임베드. 자사 시공 영상이 아니므로 출처 줄을 반드시 함께 둔다.
// 자동재생은 조건 없이 항상(무음). 모션 최소화 예외는 뺐다 — 그 설정에서 재생이 안 되는 게 문제였다.
// 비우면 블록째 사라진다(사이트 공통 「빈 값 = 미노출」).
const PRODUCT_VIDEOS = [
  { id: 'GXf1uFLc4xE', title: '삼성전자 무풍 1Way 카세트 — Frame' },
  { id: 'BUnSZkdcpms', title: '삼성전자 무풍 1Way 카세트 — Pet' },
];
const VIDEO_SOURCE = '출처: 삼성전자 공식 채널';

const STEPS = [
  { title: '상담·견적', body: '기종과 대수, 설치 위치를 확인해 견적을 확정합니다. 방문 없이 진행합니다.' },
  { title: '설계', body: '도면과 현장 조건을 확인해 배관 경로와 실외기 위치를 정합니다. 시공 전에 확정하고, 정해진 대로만 진행합니다.' },
  { title: '시공', body: '천장 매립 설계로 벽걸이와 스탠드가 차지하던 자리를 돌려드립니다.' },
  { title: '시운전·기록', body: '냉방과 배수 상태를 확인하고 사용 방법을 안내합니다. 작업 사진을 남겨 전달합니다.' },
];

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: '설치', item: `${siteUrl}/install/` },
  ],
};
---
<Base
  title="시스템에어컨 설치"
  description="시스템에어컨 신규 설치. 견적은 방문 전에 나옵니다. 설치한 기록이 세척·정기관리로 그대로 이어집니다."
  jsonLd={breadcrumbJsonLd}
>
  <PageHero eyebrow="시스템에어컨 설치" lead>
    에어컨은 사라지고<br />공간만 남습니다
    <Fragment slot="sub">
      견적은 방문 전에 나옵니다.<br />
      도면과 배관 경로, 실외기 위치는 시공 전에 함께 정합니다.
    </Fragment>
    {PRODUCT_VIDEOS.length > 0 && (
      <Fragment slot="extra">
        <div class="install-video__grid">
          {PRODUCT_VIDEOS.map((v) => (
            <div class="install-video__frame">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${v.id}?autoplay=1&mute=1&loop=1&playlist=${v.id}&playsinline=1&controls=1&rel=0&modestbranding=1`}
                title={v.title}
                loading="lazy"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          ))}
        </div>
        <p class="install-video__source">{VIDEO_SOURCE}</p>
      </Fragment>
    )}
  </PageHero>

  {/* 절차 4단계를 한 섹션에 둔다 — 스텝마다 섹션을 쪼개면 「설치 절차」 눈썹이 네 번 반복된다.
      리듬은 배경 줄무늬 대신 이미지 좌우 교차(지그재그)가 맡는다. */}
  <section class="bd-section install-step install-step--mist" data-layout-section="install-process">
    <div class="bd-container">
      <h2 class="br-h br-reveal">설치 4단계</h2>
      <div class="install-steps__list">
        {STEPS.map((st, i) => (
          <article class="install-step__card br-glass br-glass--medium br-reveal">
            <StoryRow
              slotId={`install-process-${String(i + 1).padStart(2, '0')}`}
              slotLabel={`install-process-${String(i + 1).padStart(2, '0')}`}
              ratio="square"
              imageSide={i % 2 === 0 ? 'left' : 'right'}
              tone="light"
            >
              <span class="install-step__no">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="install-step__title">{st.title}</h3>
              <p class="br-body">{st.body}</p>
            </StoryRow>
          </article>
        ))}
      </div>
    </div>
  </section>

  <StandardsStory
    promise={standards.promiseInstall}
    baseline={standards.baselineInstall}
    noExtra={standards.noExtra}
    slotPrefix="install"
    startSide="left"
    startTone="base"
  />

  <section class="bd-section install-after" data-layout-section="install-after">
    <div class="bd-container">
      <StoryRow slotId="install-aftercare" slotLabel="install-aftercare" imageSide="left">
        <span class="br-eyebrow br-reveal">설치 이후</span>
        <h2 class="br-h br-reveal">설치로 끝나지 않습니다</h2>
        <p class="br-body br-reveal">설치할 때 남긴 기록이 그대로 이어집니다.<br />배관 경로와 시공 이력이 남아 있어, 분해세척과 정기 점검 때 어디를 어떻게 다뤄야 하는지 알고 갑니다.</p>
        <p class="install-after__more br-reveal">
          <a class="install-after__link" href="/care/">세척·정기관리 안내 보기 <span aria-hidden="true">→</span></a>
        </p>
        {situations.length > 0 && (
          <ul class="install-situations br-reveal">
            {situations.map((s) => (
              <li><a href={`/situation/${s.slug}/`}>{s.meta.title} <span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        )}
      </StoryRow>
    </div>
  </section>

  <CtaBand chatTree="install" buttonLabel="설치 상담 시작">
    <em>견적</em>은 방문 전에<br />나옵니다
    <Fragment slot="sub">기종과 대수만 알려주시면 됩니다.</Fragment>
  </CtaBand>
</Base>


<style>
  /* 제품 영상 — 히어로와 같은 섹션(extra 슬롯) 안. 16:9 고정, 768px+ 나란히 */
  .install-video__grid { display: grid; gap: 16px; }
  .install-video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--br-ink);
  }
  .install-video__frame iframe { width: 100%; height: 100%; border: 0; display: block; }
  .install-video__fallback {
    display: grid; place-items: center; width: 100%; height: 100%;
    color: var(--br-ice); font-weight: 700; text-align: center; padding: 20px;
  }
  /* 다크 히어로 위 — ink-sub는 배경에 묻힌다 */
  .install-video__source { margin-top: 14px; font-size: 13px; color: rgba(255, 255, 255, 0.7); }
  @media (min-width: 768px) {
    .install-video__grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }

  /* 유리 카드 호스트 — 투명해야 앰비언트가 비친다 */
  .install-step--base { background: transparent; }
  .install-step--mist { background: transparent; }
  .install-step--deep { background: var(--br-teal-deep); }
  /* 회색 섹션 위에 기본색 카드 — 단계 경계를 여백이 아니라 면으로 만든다 */
  .install-steps__list { margin-top: 48px; display: grid; gap: 16px; }
  .install-step__card {
    padding: 28px 24px;
    /* 배경·테두리·radius·그림자는 .br-glass--medium 이 맡는다 */
  }
  .install-step__no {
    display: block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--br-teal);
    opacity: 0.55;
  }
  .install-step__title { margin-top: 6px; color: var(--br-teal); font-size: clamp(20px, 2.4vw, 26px); }
  .install-step__card .br-body { margin-top: 10px; }
  @media (min-width: 768px) {
    .install-steps__list { gap: 20px; }
    .install-step__card { padding: 36px 32px; }
  }

  .install-after { background: var(--br-base); }
  .install-after__more { margin-top: 24px; }
  .install-after__link {
    display: inline-block;
    font-size: 16px;
    font-weight: 700;
    color: var(--br-teal);
    border-bottom: 2px solid var(--br-teal);
    padding-bottom: 2px;
    transition: color var(--dur-color) ease, border-color var(--dur-color) ease;
  }
  .install-after__link:hover { color: var(--br-teal-deep); border-color: var(--br-ice); }

  .install-situations { margin-top: 20px; list-style: none; display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .install-situations a {
    display: inline-block;
    padding: 8px 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--br-teal);
  }
  .install-situations a:hover { color: var(--br-teal-deep); }
  :global(.v2-cta .bd-container .v2-cta__sub) { color: var(--br-base); }
</style>
