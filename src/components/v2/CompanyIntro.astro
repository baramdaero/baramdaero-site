---
// 홈 회사소개 — 히어로 바로 다음, 약속 셋 앞(2026-10-01 대표 지정 레이아웃: 라벨 · 큰 제목 · 위 선 있는 두 칸).
// 문구는 home.json intro. 배경은 투명 — 히어로에서 페이지 앰비언트가 끊기지 않고 이어진다.
interface Col { label: string; lines: string[] }
interface Props { eyebrow: string; heading: string; cols: Col[] }
const { eyebrow, heading, cols } = Astro.props;
---
<section class="bd-section intro" aria-labelledby="intro-h">
  <div class="bd-container">
    <p class="intro__eyebrow">{eyebrow}</p>
    <h2 class="intro__h br-reveal" id="intro-h">{heading}</h2>
    <div class="intro__cols">
      {cols.map((c) => (
        <div class="intro__col br-reveal">
          <p class="intro__label">{c.label}</p>
          <p class="intro__text">{c.lines.map((l) => <span>{l}</span>)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .intro { background: transparent; }
  .intro__eyebrow { font-size: 14px; font-weight: 700; color: var(--br-ink-sub); }
  .intro__h {
    margin-top: 12px; color: var(--br-ink); font-weight: 800; letter-spacing: -0.02em;
    font-size: clamp(26px, 3.2vw, 40px); line-height: 1.3; text-wrap: balance;
  }
  .intro__cols { margin-top: clamp(40px, 6vw, 64px); display: grid; grid-template-columns: 1fr 1fr; gap: 32px 20px; }
  .intro__col { border-top: 2px solid var(--br-ink); padding-top: 24px; }
  .intro__label { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--br-teal); }
  .intro__text { margin-top: 28px; display: grid; gap: 4px; font-size: 16px; line-height: 1.7; color: var(--br-ink); }
  @media (max-width: 720px) {
    .intro__cols { grid-template-columns: 1fr; }
    .intro__text { margin-top: 16px; font-size: 15px; }
  }
</style>
