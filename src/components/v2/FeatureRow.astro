---
// 토스 레퍼런스 ② 문법 — 다크 시각물 카드 N장 가로 배열(모바일 스냅 스크롤) + 아래 제목 2줄·본문·화살표.
// 데이터는 home.json services 그대로(카피 변경 없음). 시각물은 ImageSlot(16:10, 딥 면) — 사진이 오면 채워진다.
// 유리는 쓰지 않는다: 카드가 딥 단색 면이고 안에 유리를 얹으면 중첩이 되기 쉽다. 밝은 섹션 위 딥 카드 = 명암 리듬.
import ImageSlot from './ImageSlot.astro';
interface Card { eyebrow: string; heading: string[]; lines: string[]; cta?: { label?: string; href?: string }; chatTree?: string; slotId: string }
interface Props { cards: Card[]; id?: string }
const { cards, id = 'feature-row' } = Astro.props;
---
<section class="bd-section v2-frow" id={id} data-layout-section="home-feature-row">
  <div class="bd-container">
    <ul class="v2-frow__track" aria-label="서비스">
      {cards.map((c) => (
        <li class="v2-frow__card br-reveal">
          <div class="v2-frow__visual">
            <ImageSlot id={c.slotId} label={c.slotId} ratio="wide" />
            {c.cta?.href ? (
              <a class="v2-frow__arrow" href={c.cta.href} aria-label={c.cta.label ?? '자세히'}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </a>
            ) : (
              <button type="button" class="v2-frow__arrow" data-chat-tree={c.chatTree} aria-label={c.cta?.label ?? '문의'}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </button>
            )}
          </div>
          <span class="br-eyebrow v2-frow__eyebrow">{c.eyebrow}</span>
          <h3 class="v2-frow__title">{c.heading.map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</h3>
          <p class="v2-frow__body">{c.lines.map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .v2-frow { background: transparent; padding-top: 24px; }
  .v2-frow__track {
    list-style: none; margin: 0; padding: 0 0 8px;
    display: grid; grid-auto-flow: column; grid-auto-columns: min(82vw, 360px); gap: 16px;
    overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .v2-frow__track::-webkit-scrollbar { display: none; }
  .v2-frow__card { scroll-snap-align: start; min-width: 0; }
  /* 시각물 — 딥 면. 슬롯은 안에서 자기 색을 갖는다(딥 섹션 변수 오버라이드가 먹도록 클래스 등록) */
  .v2-frow__visual {
    position: relative; border-radius: var(--radius); overflow: hidden;
    background: var(--br-teal-deep);
    --br-slot-line: rgba(255,255,255,.14); --br-slot-bg: rgba(255,255,255,.04); --br-slot-fg: rgba(255,255,255,.55);
    --br-eyebrow-fg: var(--br-ice);
  }
  .v2-frow__visual :global(.br-image-slot) { border: 0; border-radius: 0; background: transparent; }
  .v2-frow__arrow {
    position: absolute; right: 14px; bottom: 14px; width: 40px; height: 40px;
    display: grid; place-items: center; border-radius: 999px; border: 0;
    background: rgba(255,255,255,.14); color: #fff; cursor: pointer;
    transition: background-color var(--dur-color) ease, transform 160ms var(--ease-out);
  }
  .v2-frow__arrow:hover { background: var(--br-ice); color: var(--br-teal); }
  .v2-frow__arrow:active { transform: scale(.94); }
  .v2-frow__eyebrow { margin-top: 22px; border-bottom: 0; padding-bottom: 6px; font-size: 13px; }
  .v2-frow__title { margin-top: 6px; font-size: 20px; line-height: 1.35; color: var(--br-ink); }
  .v2-frow__body { margin-top: 10px; font-size: 14.5px; line-height: 1.75; color: var(--br-ink-sub); }
  @media (min-width: 900px) {
    .v2-frow__track { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); grid-auto-columns: auto; gap: 24px; overflow: visible; }
    .v2-frow__title { font-size: 21px; }
  }
</style>
