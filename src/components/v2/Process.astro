---
// S8 진행 절차 (bg-alt) — 텍스트와 이미지 슬롯을 나누고, 스텝은 세로 목록으로 표시한다.
// 문구는 전부 프롭으로 받는다 — 출처는 src/content/site/home.json (하드코딩 금지).
import type { HomeProcessStep } from '../../lib/home.ts';
import ImageSlot from './ImageSlot.astro';
import { isImageSlotVisible } from '../../lib/image-slots.ts';

interface Props {
  eyebrow: string;
  heading: string[];
  steps: HomeProcessStep[];
  slotId?: string;
}
const { eyebrow, heading, steps, slotId = 'home-process-overview' } = Astro.props;
const hasVisual = isImageSlotVisible(slotId);
---
<section class="bd-section v2-process" data-layout-section="home-process" data-image-side={hasVisual ? 'right' : undefined}>
  <div class:list={['bd-container', 'v2-process__grid', { 'v2-process__grid--copy-only': !hasVisual }]}>
    <div class="v2-process__copy br-glass br-glass--medium">
      {eyebrow && <span class="br-eyebrow br-reveal">{eyebrow}</span>}
      <h2 class="br-h br-reveal">
        {heading.map((line, i) => (
          <Fragment>{i > 0 && <br />}{line}</Fragment>
        ))}
      </h2>
      <ol class="v2-process__steps">
        {steps.map((s) => (
          <li class="v2-process__step br-reveal">
            <span class="v2-process__no">{s.no}</span>
            <div>
              <h3 class="v2-process__title">{s.title}</h3>
              <p class="v2-process__body">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    {hasVisual && (
      <div class="v2-process__visual br-reveal">
        <ImageSlot id={slotId} label={slotId} ratio="wide" />
      </div>
    )}
  </div>
</section>

<style>
  .v2-process { background: transparent; } /* 유리 카드 호스트 — 투명해야 앰비언트가 비친다 */
  .v2-process__copy { padding: 32px 28px; }
  .v2-process__grid { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
  .v2-process__visual { order: -1; }
  .v2-process__grid--copy-only .v2-process__copy { max-width: 760px; }
  .v2-process__steps {
    margin-top: 36px;
    list-style: none;
    display: grid;
    gap: 20px;
  }
  .v2-process__step { display: grid; grid-template-columns: 40px 1fr; gap: 14px; }
  .v2-process__no {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--br-ice);
    color: var(--br-teal);
    font-size: 14px;
    font-weight: 700;
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .v2-process__title { padding-top: 2px; font-size: 18px; color: var(--br-teal); }
  .v2-process__body { margin-top: 5px; font-size: 14px; line-height: 1.65; color: var(--br-ink); }
  @media (min-width: 768px) {
    .v2-process__grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 64px; }
    .v2-process__visual { order: 2; }
    .v2-process__copy { padding: 40px 36px; }
    .v2-process__grid--copy-only { grid-template-columns: minmax(0, 1fr); }
  }
</style>
