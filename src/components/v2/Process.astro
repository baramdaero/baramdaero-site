---
// S8 진행 절차 — 머리(라벨·제목·한 줄, 사진은 옆) 아래 단계 카드 줄(2026-10-02 대표 참고 이미지).
// 문구는 전부 프롭으로 받는다 — 출처는 src/content/site/home.json (하드코딩 금지).
import type { HomeProcessStep } from '../../lib/home.ts';
import ImageSlot from './ImageSlot.astro';
import { isImageSlotVisible } from '../../lib/image-slots.ts';

interface Props {
  eyebrow: string;
  /** 제목 아래 한 줄(2026-10-01) */
  lead?: string;
  heading: string[];
  steps: HomeProcessStep[];
  slotId?: string;
}
const { eyebrow, lead = '', heading, steps, slotId = 'home-process-overview' } = Astro.props;
const hasVisual = isImageSlotVisible(slotId);
---
<section class="bd-section v2-process" data-layout-section="home-process" data-image-side={hasVisual ? 'right' : undefined}>
  <div class="bd-container">
    <div class:list={['v2-process__head', { 'v2-process__head--visual': hasVisual }]}>
      <div class="v2-process__copy">
        {eyebrow && <p class="br-sec-label">{eyebrow}</p>}
        <h2 class="br-h br-reveal">
          {heading.map((line, i) => (
            <Fragment>{i > 0 && <br />}{line}</Fragment>
          ))}
        </h2>
        {lead && <p class="br-sec-lead br-reveal">{lead}</p>}
      </div>
      {hasVisual && (
        <div class="v2-process__visual br-reveal">
          <ImageSlot id={slotId} label={slotId} ratio="wide" />
        </div>
      )}
    </div>
    {/* 2026-10-02 대표: 참고 이미지처럼 단계마다 흰 카드 한 장 — 번호·제목·한 줄. 넓은 화면은 한 줄, 좁으면 세로 */}
    <ol class="v2-process__steps">
      {steps.map((s) => (
        <li class="v2-process__step br-glass br-glass--heavy br-reveal">
          <span class="v2-process__no">{s.no}</span>
          <h3 class="v2-process__title">{s.title}</h3>
          <p class="v2-process__body">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .v2-process { background: transparent; } /* 유리 카드 호스트 — 투명해야 앰비언트가 비친다 */

  /* 머리: 라벨·제목·한 줄, 사진이 있으면 넓은 화면에서 오른쪽에 */
  .v2-process__head { display: grid; gap: 24px; }
  .v2-process__copy :global(.br-sec-label + .br-h) { margin-top: 10px; } /* 다른 섹션 머리와 같은 간격 */
  .v2-process__visual :global(.br-image-slot) { --slot-radius: var(--radius); }

  /* 단계 카드 — 모바일은 번호 왼쪽·제목/설명 오른쪽 한 줄씩, 1024px+ 는 다섯 장 한 줄 */
  .v2-process__steps {
    margin-top: var(--head-gap);
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .v2-process__step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 16px;
    padding: 20px 20px 22px;
  }
  .v2-process__no {
    grid-row: span 2;
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--br-ink-sub);
    font-variant-numeric: tabular-nums;
  }
  .v2-process__title { font-size: 19px; line-height: 1.3; color: var(--br-ink); }
  .v2-process__body { margin-top: 6px; font-size: 15px; line-height: 1.6; color: var(--br-ink-sub); text-wrap: pretty; }

  @media (min-width: 768px) {
    .v2-process__head--visual { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--panel-gap); align-items: end; }
  }
  @media (min-width: 1024px) {
    .v2-process__steps { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 16px; } /* 단계 수만큼 한 줄 — 늘거나 줄어도 맞춰진다 */
    .v2-process__step { display: flex; flex-direction: column; padding: 28px 22px 30px; }
    .v2-process__no { font-size: 32px; }
    .v2-process__title { margin-top: 20px; font-size: 20px; }
    .v2-process__body { margin-top: 8px; }
  }
</style>
