---
// S8 진행 절차 (bg-alt) — 스텝 타임라인. 데스크톱 가로 4열, 모바일 세로. 스텝별 stagger 리빌.
// 문구는 전부 프롭으로 받는다 — 출처는 src/content/site/home.json (하드코딩 금지).
import type { HomeProcessStep } from '../../lib/home.ts';

interface Props {
  eyebrow: string;
  heading: string[];
  steps: HomeProcessStep[];
}
const { eyebrow, heading, steps } = Astro.props;
---
<section class="bd-section v2-process">
  <div class="bd-container">
    {eyebrow && <span class="br-eyebrow br-reveal">{eyebrow}</span>}
    <h2 class="br-h br-reveal">
      {heading.map((line, i) => (
        <Fragment>{i > 0 && <br />}{line}</Fragment>
      ))}
    </h2>
    <ol class="v2-process__steps">
      {steps.map((s) => (
        <li class="v2-process__step br-reveal">
          <span class="v2-process__no">{s.no}</span>
          <h3 class="v2-process__title">{s.title}</h3>
          <p class="v2-process__body">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .v2-process { background: var(--br-mist); }
  .v2-process__steps {
    margin-top: 48px;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .v2-process__step { position: relative; padding-left: 56px; }
  .v2-process__step::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 44px;
    bottom: -28px;
    width: 2px;
    background: var(--br-line);
  }
  .v2-process__step:last-child::before { display: none; }
  .v2-process__no {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--br-ice);
    color: var(--br-teal);
    font-size: 14px;
    font-weight: 700;
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .v2-process__title { font-size: 20px; color: var(--br-teal); padding-top: 6px; }
  .v2-process__body { margin-top: 8px; font-size: 15px; line-height: 1.7; color: var(--br-ink-sub); }
  @media (min-width: 768px) {
    .v2-process__steps { grid-template-columns: repeat(4, 1fr); gap: 32px; }
    .v2-process__step { padding-left: 0; padding-top: 60px; }
    .v2-process__step::before {
      left: 52px;
      right: -32px;
      top: 19px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .v2-process__title { padding-top: 0; }
  }
</style>
