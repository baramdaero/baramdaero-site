---
// S8 진행 절차 (bg-alt) — 텍스트와 이미지 슬롯을 나누고, 스텝은 세로 목록으로 표시한다.
// 문구는 전부 프롭으로 받는다 — 출처는 src/content/site/home.json (하드코딩 금지).
import type { HomeProcessStep } from '../../lib/home.ts';
import ImageSlot from './ImageSlot.astro';
import { isImageSlotVisible } from '../../lib/image-slots.ts';

interface Props {
  eyebrow: string;
  heading: string[];
  steps: HomeProcessStep[];
  slotId?: string;
}
const { eyebrow, heading, steps, slotId = 'home-process-overview' } = Astro.props;
const hasVisual = isImageSlotVisible(slotId);
---
<section class="bd-section v2-process" data-layout-section="home-process" data-image-side={hasVisual ? 'right' : undefined}>
  <div class="bd-container">
    <div class:list={['v2-process__card', 'br-glass', 'br-glass--medium', { 'v2-process__card--copy-only': !hasVisual }]}>
      <div class="v2-process__copy">
        {eyebrow && <span class="br-eyebrow br-reveal">{eyebrow}</span>}
        <h2 class="br-h br-reveal">
          {heading.map((line, i) => (
            <Fragment>{i > 0 && <br />}{line}</Fragment>
          ))}
        </h2>
        <ol class="v2-process__steps">
          {steps.map((s) => (
            <li class="v2-process__step br-reveal">
              <span class="v2-process__no">{s.no}</span>
              <div>
                <h3 class="v2-process__title">{s.title}</h3>
                <p class="v2-process__body">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      {hasVisual && (
        <div class="v2-process__visual br-reveal">
          <ImageSlot id={slotId} label={slotId} ratio="wide" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .v2-process { background: transparent; } /* 유리 카드 호스트 — 투명해야 앰비언트가 비친다 */

  /* 2026-09-07: 서비스 카드(ServiceSplit)와 같은 '유리 한 장' 패널. 카피가 길어(제목+4단계) 사진은 카드 안에서
     세로 중앙에 두고, 단계 목록은 번호 36px·제목 17px·설명 14.5px 로 한 단 조여 카피 높이를 사진 쪽으로 당긴다.
     모바일: 사진(또는 준비 중 슬롯)이 카드 윗면, 아래에 제목과 단계. */
  .v2-process__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }
  .v2-process__copy { padding: 24px 24px 28px; }
  .v2-process__visual { order: -1; }
  .v2-process__visual :global(.br-image-slot) {
    --slot-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
    --slot-border-width: 0 0 1px;
  }
  .v2-process__card--copy-only { max-width: 760px; }
  .v2-process__copy :global(.br-h) {
    margin-top: 18px;
    font-size: clamp(26px, 0.9rem + 1.9vw, 36px);
    line-height: 1.25;
  }
  .v2-process__steps {
    margin-top: 28px;
    list-style: none;
    display: grid;
    gap: 18px;
  }
  .v2-process__step { display: grid; grid-template-columns: 36px 1fr; gap: 14px; align-items: start; }
  .v2-process__no {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--br-ice);
    color: var(--br-teal);
    font-size: 13px;
    font-weight: 700;
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .v2-process__title { padding-top: 6px; font-size: 17px; line-height: 1.3; color: var(--br-teal); }
  .v2-process__body { margin-top: 4px; font-size: 14.5px; line-height: 1.6; color: var(--br-ink); }
  @media (min-width: 768px) {
    .v2-process__card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--panel-gap);
      padding: var(--panel-pad);
    }
    .v2-process__copy { padding: 0; }
    .v2-process__visual { order: 2; }
    .v2-process__visual :global(.br-image-slot) {
      --slot-radius: calc(var(--radius) - 4px);
      --slot-border-width: 1px;
    }
    .v2-process__card--copy-only { grid-template-columns: minmax(0, 1fr); }
    .v2-process__steps { margin-top: 32px; gap: 20px; }
  }
</style>
