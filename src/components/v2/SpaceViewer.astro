---
// 공간 3D 구성도 블록 — 히어로의 아파트·상가·오피스 뷰어(public/3d/*.html?embed)를 서브페이지에 한 번 더 쓴다(2026-09-30).
// 설명하지 않고 두기만 한다(2026-09-30 대표: "3D 만들었어요 자랑하지 말고 은연중에 누르게") — 제목 없이 안내 버튼 하나.
// 안내 버튼은 홈 히어로의 '아래 도면을 눌러 보세요'와 같은 모양·같은 동작(2026-10-06 대표: '설치·상업용 페이지에도 도면 위에 눌러 보라고').
// 휴대폰 '직접 둘러보기' 잠금은 걷었다(2026-10-02 대표: 첫 탭이 안 먹고 켜지면 스크롤이 갇힘). 뷰어가 세로 스와이프는 페이지로,
// 가로 드래그만 회전으로 받는다(house·office·commercial.html embed 의 touch-action: pan-y).
// 탭이 둘 이상이면 같은 iframe 의 src 만 바꾼다 — 뷰어를 여러 개 동시에 띄우지 않는다(WebGL 컨텍스트).
interface View { label: string; src: string; title: string }
interface Props {
  id: string;
  /** 도면 위 안내 버튼 — [굵은 한 줄, 이유 한 줄]. 누르면 첫 공간(아파트 거실 · 건물 1층)으로 들어간다 */
  invite?: [string, string];
  views: View[];
  tone?: 'base' | 'mist';
}
const { id, invite, views, tone = 'base' } = Astro.props;
// 공간 3D 공통 주석 — 잠금 문구(2026-09-22 대표 확정). 바꾸지 않는다
const NOTE = '실제 시공사례를 기반으로 제작한 3D 예시입니다.';
---
<section class:list={['bd-section', 'space3d', `space3d--${tone}`]} id={id} data-space3d>
  <div class="bd-container">
    <div class="space3d__bar">
        {views.length > 1 && (
          <div class="space3d__tabs" role="tablist" aria-label="공간 선택">
            {views.map((v, i) => (
              <button type="button" role="tab" class="space3d__tab" aria-selected={i === 0 ? 'true' : 'false'} data-src={v.src} data-title={v.title}>{v.label}</button>
            ))}
          </div>
        )}
        {/* 안내 버튼과 그 층 방 목록이 한 칸을 번갈아 쓴다 — 칸 높이는 안내 버튼이 잡고 있어 목록이 떠도 도면이 밀리지 않는다 */}
        <div class="space3d__slot">
        {/* 뷰어가 준비됐다고 알려 온 뒤에만 보인다(data-on) — 3D 가 안 뜨면 누를 것도 없다. 자리는 미리 잡아 둬 도면이 밀리지 않는다 */}
        {invite && (
          <button type="button" class="space3d__invite br-glass br-glass--heavy" data-glow="off">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 3l14 8-6.2 1.8L10.4 19 5 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            </svg>
            <span class="space3d__invite-t"><strong>{invite[0]}</strong><span>{invite[1]}</span></span>
          </button>
        )}
          {/* 층·방 안에서만 뜨는 그 층 방 목록(아파트는 방 목록, 2026-10-06 대표 '방 이동이 안 된다'의 근본 해법).
              창·벽 쪽으로 당겨 잡은 시점은 화면에 누를 곳이 없다 — 목록이 있어야 어디서든 옮겨 간다.
              칸은 뷰어가 준 목록(entries)으로 스크립트가 채운다. 한 줄에 다 안 들어가면 '목록' 으로 펼친다 */}
          <div class="space3d__go">
            <div class="space3d__spots" role="group" aria-label="공간 목록"></div>
            <button type="button" class="space3d__all" aria-expanded="false" aria-controls={`${id}-all`} hidden>
              <span class="space3d__all-open">목록</span><span class="space3d__all-close">닫기</span>
            </button>
          </div>
        </div>
        <div class="space3d__spots space3d__spots--all" id={`${id}-all`} role="group" aria-label="공간 목록"></div>
    </div>
    <div class="space3d__stage br-glass br-glass--medium" data-glow="off">
      <iframe src={views[0].src} title={views[0].title} loading="lazy"></iframe>
      {/* 방·층 안에 들어가면 나올 길 — 히어로와 같은 자리(3D 왼쪽 위)·같은 말·같은 화살표(2026-10-01, 갇힘 제보).
          건물(상업공간·오피스)은 '건물 전체' + 지금 층 이름, 아파트는 '전체 보기' */}
      <div class="space3d__here">
        <button type="button" class="space3d__back">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>전체 보기</span>
        </button>
        <p class="space3d__lv"></p>
      </div>
    </div>
    <p class="space3d__note">{NOTE}</p>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-space3d]')) {
    const stage = root.querySelector<HTMLElement>('.space3d__stage')!;
    const frame = stage.querySelector('iframe')!;
    // 방(아파트)·층(건물) 안이면 되돌아가기 판을 띄운다. 뷰어가 알려 주는 bd3d 메시지로만 판단한다
    const back = stage.querySelector<HTMLButtonElement>('.space3d__back')!;
    const backT = back.querySelector('span')!, lv = stage.querySelector<HTMLElement>('.space3d__lv')!;
    const invite = root.querySelector<HTMLButtonElement>('.space3d__invite');
    // 그 층 방 목록: 한 줄 띠(strip) + 한 줄에 다 안 들어갈 때 '목록'으로 펼치는 판(all). 칸은 둘에 똑같이 넣는다
    const bar = root.querySelector<HTMLElement>('.space3d__bar')!, go = bar.querySelector<HTMLElement>('.space3d__go')!;
    const strip = go.querySelector<HTMLElement>('.space3d__spots')!, all = bar.querySelector<HTMLElement>('.space3d__spots--all')!;
    const allBtn = go.querySelector<HTMLButtonElement>('.space3d__all')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const post = (m: object) => frame.contentWindow?.postMessage({ ns: 'bd3d', ...m }, '*');
    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    let list: { id: string; name: string }[] = [], cur = '';   // list: 지금 층(아파트는 집)의 칸, cur: 지금 있는 칸 id
    let inRoom = false, level = '', room = '', bld = false;   // room: 지금 방·실내기 이름, bld: 건물 뷰어인가
    let first: { type: string; id: string } | null = null;   // 안내 버튼이 들어갈 첫 공간
    // 무대가 화면 아래 고정 문의 버튼(76px) 위로 올라온 뒤에만 안내를 켠다 — 첫 화면 접힘선에서 버튼이 문의 버튼 밑에 깔렸다(10-06 검증)
    let seen = !('IntersectionObserver' in window);
    let shownAt = 0;   // 목록이 켜진 시각 — 뜨는 동안(안 보이는 동안)의 누름을 막는 데 쓴다
    const openAll = (on: boolean) => {
      if (on === bar.hasAttribute('data-open')) return;
      bar.toggleAttribute('data-open', on); allBtn.setAttribute('aria-expanded', String(on)); strip.inert = on;   // 펼친 동안 띠는 쉰다(같은 칸이 두 벌)
      // 펼친 판이 화면 아래로 잘리거나 고정 문의 버튼(아래 76px) 밑에 깔리면 그만큼만 페이지를 올린다 — 96px 은 아래 안내 버튼 기준(rootMargin)과 같은 값.
      // 판은 여는 동안 변형(scale)돼 있어 getBoundingClientRect 대신 배치 높이(offsetHeight)로 잰다
      const over = on ? bar.getBoundingClientRect().bottom + 8 + all.offsetHeight - (innerHeight - 96) : 0;
      if (over > 0) scrollBy({ top: over, behavior: reduced.matches ? 'auto' : 'smooth' });
    };
    // 옆으로 더 있으면 끝을 흐린다(히어로 도크 syncMore 와 같다)
    const edges = () => {
      strip.toggleAttribute('data-more', strip.scrollWidth - strip.scrollLeft - strip.clientWidth > 4);
      strip.toggleAttribute('data-less', strip.scrollLeft > 4);
    };
    // 한 줄에 다 안 들어갈 때만 '목록' 버튼을 켠다
    const fit = () => {
      allBtn.hidden = true;   // 버튼을 뺀 폭으로 잰다 — 버튼 폭만큼 모자란 경계에서 켜졌다 꺼졌다 하지 않게
      const wide = strip.scrollWidth > strip.clientWidth + 1;
      allBtn.hidden = !wide;
      if (!wide) openAll(false);
      edges();
    };
    const mark = () => {
      for (const b of bar.querySelectorAll<HTMLElement>('.space3d__spot')) { if (b.dataset.id === cur) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); }
      const c = strip.querySelector<HTMLElement>('[aria-current]');
      // 띠 안에서만 민다 — scrollIntoView 는 띠가 화면 밖일 때 페이지까지 움직인다
      if (c) strip.scrollTo({ left: c.offsetLeft - (strip.clientWidth - c.offsetWidth) / 2, behavior: reduced.matches ? 'auto' : 'smooth' });
    };
    const render = () => {
      strip.innerHTML = all.innerHTML = list.map((e, i) => `<button type="button" class="space3d__spot" data-id="${esc(e.id)}" style="--i:${i}">${esc(e.name)}</button>`).join('');
      strip.scrollLeft = 0;
      fit(); mark();
    };
    const sync = () => {
      const inLevel = !!level && level !== '건물 정면';   // 뷰어가 알려 주는 건물 전경의 이름
      if (inRoom || inLevel) stage.dataset.deep = ''; else delete stage.dataset.deep;
      // 안내는 전체가 보일 때만 — 방·층 안에서는 히어로처럼 비운다(도면 위에 그대로 떠 있지 않게)
      const deep = inRoom || inLevel;
      // 목록은 층·방 안에서만(안내 버튼과 같은 칸). 옥상처럼 고를 칸이 없으면 띄우지 않는다
      const listOn = deep && list.length > 0;
      if (!listOn) { openAll(false); if (go.contains(document.activeElement) || all.contains(document.activeElement)) back.focus({ preventScroll: true }); }   // 숨는 칸에 포커스가 남지 않게
      if (listOn && !go.hasAttribute('data-on')) shownAt = performance.now();
      go.toggleAttribute('data-on', listOn);
      if (deep && invite && document.activeElement === invite) back.focus({ preventScroll: true });   // 누른 버튼이 숨으면 포커스가 body 로 빠진다
      const fromBack = document.activeElement === back;
      invite?.toggleAttribute('data-on', !!first && !deep && seen);
      if (!deep && fromBack && first && seen) invite?.focus({ preventScroll: true });   // 나올 때도 — 되돌아가기 버튼이 숨으면 포커스가 body 로 빠진다
      // 건물은 한 단계씩 나온다: 방·실내기 안에서는 '층 전체'(그 층 입구로), 층 입구에서는 '건물 전체'.
      // 층 안에서 방을 눌러 옮겨 다니다가 층 전체를 다시 볼 길이 없었다(2026-10-06 대표: '방 이동이 안 된다')
      if (bld && deep) backT.textContent = inRoom ? '층 전체' : '건물 전체';
      if (bld && deep) lv.textContent = inRoom && room ? room : level;   // 나갈 때는 지우지 않는다 — 사라지는 동안 글자가 먼저 비지 않게
    };
    addEventListener('message', (e) => {
      const m = e.data;
      if (!m || m.ns !== 'bd3d' || e.source !== frame.contentWindow) return;
      if (m.type === 'ready') {
        try { frame.contentWindow!.addEventListener('pointerdown', () => openAll(false), true); } catch { /* 다른 출처 */ }
        inRoom = false; level = ''; room = ''; bld = m.viewer !== 'house'; lv.textContent = ''; backT.textContent = bld ? '건물 전체' : '전체 보기';
        // 아파트 = 첫 방(거실), 건물 = 1층(히어로가 건물을 고르면 1층부터 보여 주는 것과 같다)
        const es: { id: string; name: string }[] = m.entries || [];
        const e = m.viewer === 'house' ? es[0] : es.find((x) => /^floor:/.test(x.id) && x.name === '1층') || es.find((x) => /^floor:/.test(x.id));
        first = e ? { type: m.viewer === 'house' ? 'goRoom' : 'goUnit', id: e.id } : null;
        list = bld ? [] : es; cur = ''; if (list.length) render();   // 아파트는 방 목록이 ready 에 온다. 건물은 층에 들어갈 때(space)
      }
      else if (m.type === 'enter') {
        inRoom = true; room = m.title || '';
        // 3D 에서 묶음의 둘째 실내기를 누르면 id 가 칸 id(묶음 첫 실내기)와 다르다 — 이름으로 찾는다(뷰어가 칸 이름과 같은 title 을 보낸다).
        // 실내기 없이 구역 바닥으로 들어온 경우(여러 대 구역)는 제목이 구역 이름이다('강의실 B' ↔ 칸 '강의실 B 1·2').
        // 그 이름으로 시작하는 칸이 하나뿐이면 그 칸을 표시하고, 여럿이면('강의실 A 1'·'강의실 A 2') 표시 없이 둔다
        const t = m.title || '', pre = t ? list.filter((x) => x.name.startsWith(t + ' ')) : [];
        cur = (list.find((x) => x.id === m.id) || list.find((x) => x.name === t) || (pre.length === 1 ? pre[0] : undefined))?.id || ''; mark();
      }
      else if (m.type === 'home') { inRoom = false; cur = ''; mark(); }   // 건물: 실내기 → 그 층 입구(층 안은 그대로)
      else if (m.type === 'space') {
        level = m.title || ''; inRoom = false; cur = '';
        // 층 안이면 그 층 칸(id '층key/실내기')이 온다. 건물 전경(층·옥상)·옥상('building' 하나)이면 비운다 — 사라지는 동안 칸은 지우지 않는다
        list = ((m.entries || []) as typeof list).filter((x) => String(x.id).includes('/')); if (list.length) render(); else mark();
      }
      sync();
    });
    if (!seen) {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { seen = true; io.disconnect(); sync(); } }, { rootMargin: '0px 0px -96px 0px' });
      io.observe(stage);
    }
    invite?.addEventListener('click', () => { if (first) frame.contentWindow?.postMessage({ ns: 'bd3d', ...first }, '*'); });
    back.addEventListener('click', () => {
      // 아파트: 방 → 전체. 건물: 방·실내기 → 그 층 입구(home), 층 입구 → 건물 전체
      frame.contentWindow?.postMessage(!bld || inRoom ? { ns: 'bd3d', type: 'home' } : { ns: 'bd3d', type: 'goUnit', id: 'building' }, '*');
    });
    // 칸을 누르면 그 방으로(띠·펼친 판 공통). 펼친 판에서 골랐으면 닫고, 포커스는 띠의 같은 칸으로
    bar.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('.space3d__spot');
      // 목록은 안내 버튼과 같은 자리에 0.35초 늦게 뜬다 — 안내 버튼을 두 번 누르면 아직 안 보이는 칸이 눌려 엉뚱한 방으로 들어갔다(10-07 검증).
      // 입력 시각 기준 0.7초 + 실제로 보이는지(불투명도) 둘 다 본다: 입력이 늦게 처리되는 경우와 등장이 밀리는 경우가 따로 있었다
      if (!b || e.timeStamp - shownAt < 700 || +getComputedStyle(go).opacity < 0.9) return;
      post({ type: bld ? 'goUnit' : 'goRoom', id: b.dataset.id });
      cur = b.dataset.id!; mark();   // 들어가는 돌리 중에는 뷰어가 도착 뒤로 미뤄 enter 가 늦게 온다 — 누른 칸은 바로 표시
      if (bar.hasAttribute('data-open')) { openAll(false); strip.querySelector<HTMLElement>(`[data-id="${CSS.escape(b.dataset.id!)}"]`)?.focus({ preventScroll: true }); }
    });
    allBtn.addEventListener('click', (e) => { if (e.timeStamp - shownAt >= 700) openAll(!bar.hasAttribute('data-open')); });   // 칸과 같은 0.7초
    bar.addEventListener('keydown', (e) => { if (e.key === 'Escape' && bar.hasAttribute('data-open')) { openAll(false); allBtn.focus({ preventScroll: true }); } });
    document.addEventListener('pointerdown', (e) => { if (!bar.contains(e.target as Node)) openAll(false); });
    bar.addEventListener('focusout', (e) => { const t = e.relatedTarget as Node | null; if (t && !go.contains(t) && !all.contains(t)) openAll(false); });
    addEventListener('blur', () => setTimeout(() => { if (document.activeElement === frame) openAll(false); }));   // 3D 를 누른 경우 — iframe 안 누름은 부모로 안 올라온다
    // 칸에 올리면 3D 에서 그 자리를 짚어 준다(히어로 도크와 같다)
    for (const ev of ['pointerover', 'focusin']) bar.addEventListener(ev, (e) => post({ type: 'hover', id: (e.target as Element).closest?.<HTMLElement>('.space3d__spot')?.dataset.id ?? null }));
    for (const ev of ['pointerleave', 'focusout']) bar.addEventListener(ev, () => post({ type: 'hover', id: null }));
    strip.addEventListener('scroll', edges, { passive: true });
    new ResizeObserver(fit).observe(bar);
    root.querySelectorAll<HTMLButtonElement>('.space3d__tab').forEach((tab, _, tabs) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        // 탭 전환이 뒤로가기 기록을 쌓지 않게(뒤로가기 한 번에 iframe 만 바뀌던 것) — Exploded 와 같다
        try { frame.contentWindow!.location.replace(tab.dataset.src!); } catch { frame.src = tab.dataset.src!; }
        frame.title = tab.dataset.title!;
        inRoom = false; level = ''; first = null; list = []; cur = ''; sync();   // 새 뷰어가 준비될 때까지 안내 버튼도 쉰다. 층 이름은 지우지 않는다 — 판이 사라지는 동안 글자가 먼저 비면 판이 줄었다 사라진다. 새 뷰어의 ready 가 비운다
      });
    });
  }
</script>

<style>
  .space3d { background: transparent; }
  .space3d--mist { background: var(--br-mist); }
  /* 도면 위 한 줄: 탭(있으면) 왼쪽, 안내 버튼 오른쪽. 높이를 미리 잡아 버튼이 뜰 때 도면이 밀리지 않는다 */
  .space3d__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; min-height: 56px; }
  .space3d__tabs { margin-top: 0; display: flex; gap: 8px; flex-wrap: wrap; }
  /* 안내 버튼 — 홈 히어로 .h3-invite 와 같은 모양(유리 판 + 화살표 + 굵은 한 줄·이유 한 줄) */
  .space3d__invite {
    display: flex; align-items: center; gap: 10px; margin-left: auto; min-height: 56px; padding: 10px 16px;
    font: inherit; text-align: left; font-size: 13px; line-height: 1.35; color: var(--br-ink-sub); cursor: pointer;
