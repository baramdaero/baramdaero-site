---
// S1 히어로(3D) — 아파트·상업공간·오피스 3D 구성도(탭 이름 2026-10-01 대표). 2026-09-18 영상 히어로(Hero.astro)에서 교체.
// 뷰어는 public/3d/ 의 공개 사본(근거·가정 문구를 비운 것)이다.
// 클래스는 h3- 접두사로 다른 섹션과 분리한다(도크 목록을 JS 가 만들어서 전역 스타일로 둔다).
---
<script is:inline>document.documentElement.classList.add('h3js');</script>
<noscript><style>.h3-stage iframe { display: none !important; }</style></noscript>
  <section class="h3-hero" id="hero" aria-labelledby="hero-title">
    <div class="h3-stage" id="stage">
      <picture class="h3-poster" aria-hidden="true">
        <source media="(max-width: 600px)" srcset="/3d/poster-house-portrait.webp">
        <img src="/3d/poster-house-wide.webp" alt="" decoding="async">
      </picture>
      <iframe id="f-house" src="/3d/house.html?embed" title="3D 구성도 · 아파트" tabindex="-1"></iframe>
    </div>

    <p class="h3-kicker h3-wrap"><span class="nb">시스템에어컨 설치</span> · <span class="nb">분해세척</span> · <span class="nb">관리</span></p>

    <div class="h3-head h3-wrap">
      <div class="h3-head__in" id="headIn">
        <h1 id="hero-title">에어컨 생각,<br>오늘이 마지막입니다.</h1>
        <p>당신의 바람은, 당신의 바람대로 불어옵니다.</p>
      </div>
    </div>

    {/* 층·옥상 안에서 건물 전체로 나가는 길 — 3D 왼쪽 위(서브페이지 공간 3D 의 '전체 보기'와 같은 자리).
        2026-09-22 대표: '다시 전체를 볼 수 있는 건 제대로 돌아갈 수 있게 … 그냥 왼쪽 밑에 건물 정면, 이게 아니라' */}
    <div class="h3-up h3-glass" id="up">
      <button class="h3-back" id="upBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        건물 전체
      </button>
      <p class="h3-here__t" id="upT"></p>
    </div>

    <button class="h3-invite h3-glass" id="invite" type="button">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 3l14 8-6.2 1.8L10.4 19 5 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      </svg>
      <span class="h3-invite__t"><strong>아래 도면을 눌러 보세요</strong>
      <span id="inviteWhy">방마다 에어컨 자리와 천장 속 배관 경로를 확인할 수 있습니다</span></span>
    </button>

    <div class="h3-spacer" aria-hidden="true"></div>

    <div class="h3-dock-wrap h3-wrap" id="dockWrap">

      <div class="h3-dock h3-glass" id="dock">
        <div class="h3-dock__row h3-dock__row--top">
          <div class="h3-spaces" role="group" aria-label="공간 선택" id="spaces"></div>
          <p class="h3-disclaimer">실제 시공사례를 기반으로 제작한 3D 예시입니다.</p>
        </div>
        <div class="h3-dock__row h3-dock__row--go">
          <div class="h3-spots" id="spots" role="group" aria-label="공간 목록"></div>
          <div class="h3-here" id="here" hidden>
            <button class="h3-back" id="back" type="button">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span id="backT">전체 보기</span>
            </button>
            <p class="h3-here__t" id="hereT"></p>
          </div>
        </div>
      </div>
      <p class="h3-note" id="hint" role="status">구성도에서 공간이나 에어컨을 누르면 그 시점으로 이동합니다</p>
    </div>
    <p class="h3-sr-only" id="live" aria-live="polite"></p>
  </section>

<script is:inline>
(() => {
  const SPACES = [{"key": "house", "viewer": "house", "name": "아파트"}, {"key": "building", "viewer": "commercial", "name": "상업공간"}, {"key": "ob", "viewer": "office", "name": "오피스"}]; // [{ key, viewer, name }] — 빌드 때 채운다
  const $ = id => document.getElementById(id);
  const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const hero = $('hero'), headIn = $('headIn'), dock = $('dock'), stage = $('stage');
  const wide = matchMedia('(min-width: 1024px)'), reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const frames = { house: $('f-house') };
  const VIEWERS = [...new Set(SPACES.map(s => s.viewer))];   // house · commercial(상가) · office(오피스)
  const st = { space: 'house', viewer: 'house', ready: {}, failed: {}, entries: {}, bldKey: {}, pendingKey: null, dipTimer: 0, room: null, notice: '', pick: {}, level: {}, roofSub: {} };
  const FAIL_MSG = '3D 구성도를 불러오지 못했습니다. 잠시 뒤 새로고침해 주세요.';
  const RETRY_MSG = '구성도를 불러오지 못했습니다. 탭을 다시 누르면 다시 불러옵니다.';

  const spaceOf = key => SPACES.find(s => s.key === key);
  const send = (viewer, msg) => { const f = frames[viewer]; if (f && st.ready[viewer]) f.contentWindow.postMessage({ ns: 'bd3d', ...msg }, '*'); };

  // 3D 가 문구·도크·헤더를 피해서 자리 잡도록 가려지는 픽셀을 알린다 (전체 보기 l,r,t,b / 방 시점 rt,rb)
  // 안내 칩은 도크 바로 위(도크와 같은 왼쪽 선)에 둔다. 위 띠를 비워 둘 필요가 없어
  // 3D 가 헤더 아래 전부를 쓴다. 칩이 차지하는 높이는 아래 b(도크 위 여백)에 포함된다.
  const TIP_BAND = 218; // 안내 버튼 위치를 못 잴 때만 쓰는 값 — 평소엔 버튼 아래 16px 부터 도면을 그린다
  // 상업공간·오피스(뷰어 commercial·office)는 문구를 숨기고 건물을 크게 — 헤더 아래 전부를 쓴다(2026-10-01 대표: '상가·오피스는 글씨 없애고 건물 크게').
  // 아파트(house)만 문구 옆에 그린다. 뷰어마다 따로 계산해 보내므로 공간을 바꿔도 집 카메라는 다시 잡히지 않는다.
  function insetMsg(viewer = 'house') {
    const hr = hero.getBoundingClientRect(), hi = headIn.getBoundingClientRect();
    // PC: 안내 버튼 세로 가운데를 업종 줄(시스템에어컨 설치 · 분해세척 · 관리) 가운데에 맞춘다(2026-10-01 대표)
    const kr = document.querySelector('.h3-kicker')?.getBoundingClientRect();
    if (kr && kr.height) hero.style.setProperty('--kick-c', Math.round(kr.top + kr.height / 2 - hr.top) + 'px');
    const hdr = (document.querySelector('.bd-header')?.offsetHeight || 64), b = Math.round(hr.bottom - dock.getBoundingClientRect().top + 16);
    const m = viewer !== 'house'
      ? { l: 0, r: 0, t: hdr + 8, b }                      // 건물 — 문구·안내 판이 없으니 헤더 아래 전부
      : wide.matches
      ? { l: Math.round(hi.right - hr.left + 32), r: 0, t: Math.max(hdr, Math.round($('invite').getBoundingClientRect().bottom - hr.top + 16) || TIP_BAND), b } // 오른쪽은 뷰어가 빈 영역 폭의 8%를 여백으로 둔다
      : { l: 0, r: 0, t: Math.round(Math.max(hi.bottom, $('invite').getBoundingClientRect().bottom) - hr.top + 12), b }; // 좁은 화면: 안내 버튼 아래부터
    return { type: 'inset', ...m, rt: hdr, rb: b };
  }
  const lastInset = {};
  function sendInset(force) {
    const cur = insetMsg(st.viewer);
    for (const [k, v] of Object.entries({ l: cur.l, t: cur.t, r: cur.r, b: cur.b })) stage.style.setProperty('--free-' + k, v + 'px');
    for (const v of VIEWERS) {
      const m = insetMsg(v), key = JSON.stringify(m);
      if (!st.ready[v] || (!force && lastInset[v] === key)) continue; // 같은 값을 또 보내면 뷰어가 카메라를 다시 잡는다(인트로가 깨진다)
      lastInset[v] = key; send(v, m);
    }
  }
  const ro = new ResizeObserver(() => sendInset());
  for (const el of [hero, headIn, dock, $('invite'), document.querySelector('.h3-kicker')].filter(Boolean)) ro.observe(el);

  function ensureFrame(viewer) {
    if (frames[viewer]) return frames[viewer];
    const f = document.createElement('iframe');
    f.id = 'f-' + viewer; f.tabIndex = -1;
    f.title = '3D 구성도 · ' + (SPACES.find(s => s.viewer === viewer)?.name || '');
    f.src = '/3d/' + viewer + '.html?embed#' + st.space; // 처음 누른 공간으로 바로 연다
    stage.appendChild(f);
    frames[viewer] = f;
    armTimeout(viewer);
    return f;
  }
  // 대상이 준비될 때까지 이전 화면을 그대로 둔다 (빈 화면으로 끊기지 않게)
  function showFrame(viewer) {
    const ready = st.ready[viewer];
    for (const [v, f] of Object.entries(frames)) {
      if (!f) continue;
      if (ready) { f.classList.toggle('on', v === viewer); f.classList.remove('hold'); }
      else f.classList.toggle('hold', v !== viewer && f.classList.contains('on'));
    }
  }

  function syncMore() {
    const el = $('spots'), last = el.lastElementChild;
    // 칩만으로 줄이 넘치는가(끝 빈 자리는 빼고 잰다) — 넘칠 때만 CSS 가 문의 버튼 자리를 비운다.
    // data-more/less 에 걸면 처음 → 끝으로 한 번에 뛸 때 둘 다 꺼진 순간 빈 자리가 사라져 스크롤이 덜 간다
    el.toggleAttribute('data-wide', !!last && last.getBoundingClientRect().right - el.getBoundingClientRect().left + el.scrollLeft > el.clientWidth);
    el.toggleAttribute('data-more', el.scrollWidth - el.scrollLeft - el.clientWidth > 4);
    el.toggleAttribute('data-less', el.scrollLeft > 4);
  }
  $('spots').addEventListener('scroll', syncMore, { passive: true });
  new ResizeObserver(syncMore).observe($('spots'));

  function renderSpaces() {
    $('spaces').innerHTML = SPACES.map(s => `<button type="button" data-space="${s.key}" aria-pressed="${s.key === st.space}">${esc(s.name)}</button>`).join('');
  }
  function renderDock() {
    const inRoom = !!st.room;
    // 층·옥상 안(뷰어가 '건물로' 항목을 주는 상태)은 도면이 화면을 가득 채운다 — 헤드라인과 겹친다
    const inBld = !!st.entries[st.space]?.some(e => e.id === 'building');
    const deep = inRoom || inBld;
    // 건물로 나가는 길은 3D 왼쪽 위에 따로 — 지금 층 이름과 함께. 실내기 시점에서도 그대로 둔다(건물까지 한 번에)
    $('up').toggleAttribute('data-on', inBld);
    if (inBld) $('upT').textContent = st.level[st.space] || '';
    hero.toggleAttribute('data-room', inRoom);
    hero.toggleAttribute('data-deep', deep);
    if (hero.dataset.space !== st.space) { hero.dataset.space = st.space; requestAnimationFrame(() => sendInset()); } // 문구가 숨거나 나타난 뒤 자리를 다시 잰다
    $('spots').hidden = inRoom;
    $('here').hidden = !inRoom;
    for (const b of $('spaces').children) b.setAttribute('aria-pressed', String(b.dataset.space === st.space));
    if (inRoom) {
      $('backT').textContent = st.viewer === 'house' ? '전체 보기' : '층 전체';   // 건물에서 이 버튼은 실내기 → 그 층까지. 건물로는 위 '건물 전체'
      $('hereT').innerHTML = `${esc(st.room.title)} <small>${esc(st.room.sub || '')}</small>`;
    } else {
      const list = st.entries[st.space];
      // 목록은 지금 층에서 고를 것만 — 건물로 나가는 길('building')은 위 '건물 전체'가 맡는다
      const rest = list?.filter(e => e.id !== 'building') ?? [];
      $('spots').innerHTML = list && !rest.length
        ? `<span class="h3-spots__load">${esc(st.roofSub[st.space] || st.level[st.space] || '')}</span>`   // 옥상: 고를 칸이 없다
        : list
        ? rest.map((e, i) => {
              // 고른 칸 하나만 흰 판(세그먼트) — 처음엔 첫 칸, 들어갔다 나오면 마지막으로 본 칸. 안내 버튼은 이 칸으로 들어간다
              const sel = (st.pick[st.space] ?? rest[0]?.id) === e.id;
              return `<button type="button" class="h3-spot${sel ? ' is-sel' : ''}" aria-pressed="${sel}" data-id="${esc(e.id)}">${esc(e.name)} <small>${esc(e.sub || '')}</small></button>`;
          }).join('')
        : `<span class="h3-spots__load" role="status">구성도를 불러오는 중입니다</span>`;
      syncMore();
    }
    $('invite').hidden = inRoom;
    $('inviteWhy').textContent = deep
      ? '에어컨을 누르면 그 자리에서 봅니다'
      : st.space === 'house'
        ? '방마다 에어컨 자리와 천장 속 배관 경로를 확인할 수 있습니다'
        : '층을 누르면 안으로 들어갑니다';   // 한 줄 — 휴대폰에서 두 줄째에 '보입니다'만 떨어지던 문장(2026-10-01 대표)
    const failed = st.failed.house && !st.ready.house;
    hero.toggleAttribute('data-fail', !!failed);
    $('hint').classList.toggle('fail', !!(failed || st.notice));
    // 평상시엔 비워 둔다(:empty 로 숨는다). 우상단 칩이 같은 말을 하고 있어 두 번 적을 이유가 없다.
    $('hint').textContent = failed ? FAIL_MSG : st.notice || '';
  }

  // 3D 를 처음 만진 순간(프레임 클릭·드래그 포함). iframe 클릭은 부모로 안 올라와서 blur 로 잡는다.
  // 문구(제목·안내)는 실제로 방·층에 들어갔을 때만 비운다(아래 'enter') — 아무 일도 없는 탭에 문구만 사라지던 것(10-02 검토)
  function engage(on3d) {
    if (on3d) hero.setAttribute('data-touch3d', '');
    if (hero.hasAttribute('data-engaged')) return;
    hero.setAttribute('data-engaged', '');
    stopTour();
  }

  // ── 처음 온 사람에게 '눌리는 것'이라는 걸 보여 준다 ──
  // 방 칩 세 개를 차례로 짚고, 3D 에서도 그 방을 밝힌다(setHover — 카메라는 안 움직인다).
  // 한 번만. 만지거나 공간을 바꾸거나 화면을 벗어나면 멈춘다. 모션 감소 설정이면 하지 않는다.
  // ⚠️ 반복하지 말 것 — 무한 루프 모션은 DESIGN.md §4 금지.
  let tourTimer = 0, tourDone = false;
  function stopTour() {
    if (tourDone) return;
    tourDone = true; clearTimeout(tourTimer);
    $('spots').querySelectorAll('.is-demo').forEach(b => b.classList.remove('is-demo'));
    send('house', { type: 'hover', id: null });
  }
  function startTour() {
    if (tourDone || reduced.matches) return;
    // 집 인트로 카메라(실측 약 6.5초)가 끝난 뒤에 — 도는 동안에는 뷰어가 hover 를 무시한다
    tourTimer = setTimeout(() => {
      if (st.viewer !== 'house' || st.room || hero.hasAttribute('data-engaged')) return stopTour();
      if (hero.getBoundingClientRect().bottom < innerHeight * 0.5) return stopTour();
      const chips = [...$('spots').querySelectorAll('.h3-spot')].slice(0, 3);
      let i = 0;
      const step = () => {
        if (tourDone) return;
        chips.forEach(b => b.classList.remove('is-demo'));
        const b = chips[i++];
        if (!b || !b.isConnected) return stopTour();   // 끝까지 갔거나 목록이 다시 그려졌다
        b.classList.add('is-demo');
        send('house', { type: 'hover', id: b.dataset.id });
        tourTimer = setTimeout(step, 1300);
      };
      step();
    }, 7000);
  }
  addEventListener('blur', () => setTimeout(() => {
    const el = document.activeElement;
    if (el && el.tagName === 'IFRAME' && stage.contains(el)) engage(false);
  }, 0));
  stage.addEventListener('pointerdown', () => { cancelGround(); engage(false); });
  for (const el of [dock, $('up')]) el.addEventListener('pointerdown', () => { cancelGround(); engage(false); });

  // 빌딩 탭: 건물을 한 번 보여 준 다음 1층으로 내려간다. 거기서 왼쪽 위 '건물 전체'를 누르면 전체 구성도로 올라간다
  let groundTimer = 0;
  const cancelGround = () => { clearTimeout(groundTimer); st.wantGround = false; };
  function groundFirst(v) {
    if (!st.wantGround || st.viewer !== v || st.room) return;
    const g = (st.entries[st.bldKey[v]] || []).find(e => /^floor:/.test(e.id) && e.name === '1층');
    if (!g) { st.wantGround = false; return; }   // 1층이 목록에 없다 = 1층 없는 건물이거나 이미 층 안(보던 층 유지) — 깃발을 내린다.
                                          // 남겨 두면 나중에 키보드·Esc 로 건물 전체에 나간 순간 1층으로 다시 끌려 들어간다(10-05 검증)
    st.wantGround = false;
    clearTimeout(groundTimer);
    groundTimer = setTimeout(() => {
      if (st.viewer === v && !st.room) send(v, { type: 'goUnit', id: g.id });
    }, reduced.matches ? 300 : 1000);
  }

  function selectSpace(key) {
    const sp = spaceOf(key);
    if (!sp || (key === st.space && !st.room)) return;
    stopTour();
    let reground = false;                 // 메시지를 하나도 안 보내는 경로인가 (아래 참조)
    const from = st.viewer;
    if (st.ready[from]) send(from, { type: 'home' }); // 떠나는 뷰어는 늘 전체 보기로 — 돌아왔을 때 방 안에 남지 않게
    const vw = sp.viewer;
    clearTimeout(groundTimer); st.wantGround = vw !== 'house';
    clearTimeout(st.dipTimer); frames[vw]?.classList.remove('dip');
    st.space = key; st.room = null; st.notice = '';
    if (vw !== 'house') {
      if (st.failed[vw] && !st.ready[vw]) { frames[vw]?.remove(); frames[vw] = null; st.failed[vw] = false; } // 다시 불러오기
      const f = ensureFrame(vw);
      if (st.ready[vw] && key === st.bldKey[vw]) { st.pendingKey = null; reground = true; } // 이미 그 공간이다 — 다시 보내지 않는다. 대신 아래에서 1층 진입만 다시 건다
      else if (st.ready[vw] && st.pendingKey !== key) { // pendingKey = 실제로 보내고 응답을 기다리는 공간
        delete st.entries[key]; // 응답 전까지 이전에 받은 목록(다른 층)을 누르지 못하게 '불러오는 중'으로
        if (from === vw && !reduced.matches) {
          f.classList.add('dip');
          // 딥이 끝날 때 그 시점에 고른 공간을 보낸다 (그 사이 원래 공간으로 돌아왔으면 딥만 푼다)
          st.dipTimer = setTimeout(() => {
            if (st.viewer !== vw || st.space === st.bldKey[vw]) { f.classList.remove('dip'); return; }
            if (st.pendingKey === st.space) return;
            st.pendingKey = st.space; send(vw, { type: 'space', key: st.space });
          }, 240);
        } else { st.pendingKey = key; send(vw, { type: 'space', key }); }
      }
    }
    st.viewer = sp.viewer;
    showFrame(st.viewer);
    renderDock();
    // 이미 준비된 건물로 돌아오면 ready·space 응답이 하나도 안 온다. groundFirst 는 그 두 핸들러에서만
    // 불리므로 여기서 직접 걸어야 '건물을 고르면 1층부터' 규칙이 2회차 이후에도 지켜진다.
    // (떠날 때 보내는 home 은 뷰어 안에서 '유닛 → 층 입구'까지만 되돌린다 — 건물 전경으로는 안 돌아간다)
    if (reground) groundFirst(vw);
  }

  $('invite').addEventListener('click', () => ($('spots').querySelector('.h3-spot.is-sel') || $('spots').querySelector('.h3-spot'))?.click());
  $('spaces').addEventListener('click', e => { const b = e.target.closest('[data-space]'); if (b) selectSpace(b.dataset.space); });
  $('spots').addEventListener('click', e => {
    const b = e.target.closest('[data-id]');
    if (b) { st.pick[st.space] = b.dataset.id; for (const x of $('spots').querySelectorAll('.h3-spot')) { x.classList.toggle('is-sel', x === b); x.setAttribute('aria-pressed', String(x === b)); } }   // 들어가는 돌리 중에는 뷰어의 enter 가 도착 뒤에 온다 — 누른 칸은 바로 표시
    if (b) send(st.viewer, st.viewer === 'house' ? { type: 'goRoom', id: b.dataset.id } : { type: 'goUnit', id: b.dataset.id });
  });
  // 목록에 올리면 3D 에서 그 자리를 짚어 준다 (라벨이 없는 화면이라 '창가 1'이 어디인지 알게)
  const hoverSpot = e => { stopTour(); const b = e.target.closest?.('[data-id]'); send(st.viewer, { type: 'hover', id: b ? b.dataset.id : null }); };
  for (const ev of ['pointerover', 'focusin']) $('spots').addEventListener(ev, hoverSpot);
  for (const ev of ['pointerleave', 'focusout']) $('spots').addEventListener(ev, () => send(st.viewer, { type: 'hover', id: null }));
  $('back').addEventListener('click', () => send(st.viewer, { type: 'home' }));
  const goBuilding = () => { cancelGround(); send(st.viewer, { type: 'goUnit', id: 'building' }); };   // 직접 나간 건물에는 머문다
  $('upBtn').addEventListener('click', goBuilding);
  // Esc 는 한 단계씩: 실내기 → 층 입구 → 건물 전체
  addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    const a = document.activeElement;
    if (a && a !== document.body && !hero.contains(a)) return;   // 챗봇·메뉴를 Esc 로 닫을 때 3D 까지 같이 나가지 않게(body 는 통과 — 사파리는 버튼 클릭에 포커스를 안 준다)
    if (st.room) send(st.viewer, { type: 'home' }); else if ($('up').hasAttribute('data-on')) goBuilding();
  });

  // 터치 기기 '3D 직접 돌리기' 잠금은 걷었다(2026-10-02 대표: 휴대폰에서 '아래 도면을 눌러 보세요'인데 도면이 안 눌림).
  // 뷰어가 세로 스와이프는 페이지로, 가로 드래그만 회전으로 받는다(house·office·commercial.html embed, touch-action: pan-y)

  let posterShown = false;
  const showPoster = () => { posterShown = true; hero.dataset.poster = ''; };

  // 옥상 안에서 도크에 보여 줄 '실외기 N대' — 건물 목록(ready·space)에 실려 올 때 적어 둔다
  const keepRoof = m => { const roof = m.entries?.find(e => e.id === 'roof'); if (roof) st.roofSub[m.key] = roof.sub; };
  addEventListener('message', e => {
    const m = e.data;
    if (!m || m.ns !== 'bd3d' || !frames[m.viewer] || e.source !== frames[m.viewer].contentWindow) return;
    const v = m.viewer;
    if (m.type === 'ready') {
      st.ready[v] = true; st.failed[v] = false;
      if (v !== 'house') st.notice = '';
      if (v === 'house') st.entries.house = m.entries; else { st.bldKey[v] = m.key; st.entries[m.key] = m.entries; keepRoof(m); }
      sendInset(true);
      if (v === 'house') {
        // 대체 이미지를 이미 보여 줬으면 인트로 없이 바로 겹쳐 바꾼다 (집을 이미 본 사람에게 다시 방에서 시작하지 않는다)
        if (posterShown) setTimeout(() => hero.removeAttribute('data-poster'), 300); else send(v, { type: 'intro' });
        startTour();
      }
      if (v !== 'house' && spaceOf(st.space).viewer === v && st.space !== m.key) send(v, { type: 'space', key: st.space });
      showFrame(st.viewer);
      renderDock();
      if (v !== 'house') groundFirst(v);
    } else if (m.type === 'space') {
      const fromDock = dock.contains(document.activeElement) || $('up').contains(document.activeElement);
      st.bldKey[v] = m.key; st.entries[m.key] = m.entries; st.pendingKey = null;
      st.level[m.key] = m.title || '';
      keepRoof(m);

      // 응답이 오는 사이 다른 공간을 골랐으면 그 공간으로 다시 맞춘다
      if (st.viewer === v && st.space !== m.key) { st.pendingKey = st.space; send(v, { type: 'space', key: st.space }); return; }
      requestAnimationFrame(() => frames[v]?.classList.remove('dip'));
      if (st.viewer === v) {
        st.room = null; renderDock();
        groundFirst(v);
        if (m.title) $('live').textContent = m.title === '건물 정면' ? '건물 전체' : m.title; // 건물 전체 · 3층 학원 · 옥상 실외기실(뷰어는 전경을 '건물 정면'이라 부른다)
        // 누른 칩이 목록째 바뀌거나 '건물 전체'가 숨으면 포커스가 body 로 빠진다. 옥상은 고를 칸이 없어 '건물 전체'가 받는다
        if (fromDock && !dock.contains(document.activeElement)) ($('spots').querySelector('.h3-spot') || $('upBtn')).focus({ preventScroll: true });
      }
    } else if (m.type === 'enter' && v === st.viewer) {
      const fromDock = dock.contains(document.activeElement);
      if (!fromDock) engage(true);   // 도면을 눌러 들어왔을 때 문구를 비운다(칩으로 들어온 건 그대로)
      st.room = { id: m.id, title: m.title, sub: m.sub };
      renderDock();
      $('live').textContent = `${m.title}, ${m.sub || ''}`;
      if (fromDock) $('back').focus({ preventScroll: true }); // 누른 버튼이 숨으면 포커스가 body 로 빠진다
    } else if (m.type === 'home' && v === st.viewer) {
      const fromBack = document.activeElement === $('back'), was = st.room?.id;
      st.room = null;
      renderDock();
      $('live').textContent = v === 'house' ? '전체 보기' : '층 전체';
      if (fromBack) ($('spots').querySelector(`[data-id="${CSS.escape(was || '')}"]`) || $('spaces').querySelector('[aria-pressed="true"]')).focus({ preventScroll: true });
    }
  });

  // three.js(CDN)를 못 받으면 ready 가 오지 않는다. 화면이 보이는 동안만 센다(백그라운드 탭에서 열어도 지우지 않게)
  function armTimeout(viewer) {
    let waited = 0;
    const step = () => {
      if (st.ready[viewer] || !frames[viewer] || st.failed[viewer]) return;
      if (document.visibilityState === 'visible') waited += 500;
      if (viewer === 'house' && waited >= 2500 && !posterShown) showPoster(); // 느린 망: 집 그림부터
      if (waited >= 15000) return fail(viewer);
      setTimeout(step, 500);
    };
    setTimeout(step, 500);
  }
  function fail(viewer) {
    st.failed[viewer] = true; // iframe 은 남겨 둔다 — 늦게라도 ready 가 오면 그때 회복한다
    if (viewer === 'house') showPoster();
    else if (st.viewer !== 'house') { // 살아 있는 아파트로 되돌리고 이유를 알린다 — 탭을 다시 누르면 새로 불러온다
      st.space = 'house'; st.viewer = 'house'; st.room = null; st.notice = RETRY_MSG;
      if (st.ready.house) showFrame('house');
    }
    renderDock();
  }

  renderSpaces();
  renderDock();
  armTimeout('house');
})();
</script>

