---
// 홈 맨 아래 '바람대로와 함께한 공간' — 삼성·LG와 시공한 아파트 브랜드 로고를 한 줄로 천천히 흘린다(2026-10-01 대표).
// 로고 원본은 대표 로고 폴더(백운공조 사이트와 같은 세트) → 배경 제거·여백 자르기·보이는 면적 맞춤 후 public/media/brands/*.webp (2배 해상도).
// 목록·순서는 src/content/site/brands.json (제품 → 현장 기록에 많이 나온 브랜드 순).
// 마퀴 규칙(DESIGN.md §4): 같은 세트 2벌 → translateX(-50%) 무한 루프, 한 방향 한 줄, hover 정지 + '멈춤' 버튼(키보드·터치, WCAG 2.2.2),
// 모션 감소면 멈춘 채 줄바꿈 격자. 속도는 로고 수에 맞춰 같게 유지(로고 1개당 3초).
import brands from '../../content/site/brands.json';
interface Props { label?: string; heading: string; lead?: string }
const { label = '', heading, lead = '' } = Astro.props;
---
{brands.length > 0 && (
  <section class="bd-section bb" aria-labelledby="bb-h">
    <div class="bd-container bb__head">
      <div>
        {label && <p class="br-sec-label">{label}</p>}
        <h2 class="br-h br-reveal" id="bb-h">{heading}</h2>
        {lead && <p class="br-sec-lead br-reveal">{lead}</p>}
      </div>
      <button type="button" class="bb__pause" aria-pressed="false" data-bb-pause>멈춤</button>
    </div>
    <div class="bb__row">
      <div class="bb__track" style={`--bb-dur:${brands.length * 3}s`}>
        {[0, 1].map((dup) => (
          <ul class="bb__set" aria-hidden={dup === 1 ? 'true' : undefined} role="list">
            {brands.map((b) => (
              <li><img src={b.src} width={b.w} height={b.h} alt={dup === 1 ? '' : b.name} loading="eager" fetchpriority="low" decoding="async" /></li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  // 흐름 멈춤/다시 — hover 가 없는 키보드·터치 사용자용
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-bb-pause]')) {
    const sec = b.closest('.bb');
    b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(on));
      b.textContent = on ? '다시 흐르기' : '멈춤';
      sec?.classList.toggle('is-paused', on);
    });
  }
</script>

<style>
  .bb { background: transparent; overflow: hidden; }
  .bb__row {
    margin-top: var(--head-gap, 40px); overflow: hidden;
    /* 양 끝을 흐리게 — 로고가 화면 끝에서 칼같이 잘려 들어오지 않게 */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .bb__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .bb__pause {
    flex: none; min-height: 44px; padding: 0 16px; border-radius: 999px; cursor: pointer; /* 누르는 높이 44px(DESIGN.md §5) */
    border: 1px solid var(--br-line); background: transparent; color: var(--br-ink-sub);
    font: inherit; font-size: 13px; font-weight: 600;
  }
  .bb__pause:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 2px; }
  @media (hover: hover) { .bb__pause:hover { color: var(--br-ink); border-color: var(--br-ink-sub); } }
  .bb__track { display: flex; width: max-content; animation: bb-flow var(--bb-dur, 120s) linear infinite; }
  .bb__row:hover .bb__track, .bb.is-paused .bb__track { animation-play-state: paused; }
  @keyframes bb-flow { to { transform: translateX(-50%); } }
  .bb__set { display: flex; align-items: center; gap: 64px; padding-right: 64px; margin: 0; list-style: none; }
  .bb__set li { flex: none; display: grid; place-items: center; height: 64px; }
  .bb__set img { display: block; max-width: none; }
  @media (max-width: 760px) {
    .bb__set { gap: 40px; padding-right: 40px; }
    .bb__set img { zoom: .8; } /* 휴대폰은 로고를 80%로 */
  }
  @media (prefers-reduced-motion: reduce) {
    .bb__row { -webkit-mask-image: none; mask-image: none; }
    .bb__track { animation: none; width: auto; }
    .bb__set { flex-wrap: wrap; justify-content: center; column-gap: 28px; row-gap: 24px; padding: 0 20px; max-width: var(--maxw, 1200px); margin-inline: auto; }
    .bb__pause { display: none; } /* 이미 멈춰 있다 */
    .bb__set[aria-hidden] { display: none; }
  }
</style>
