---
// S10 CTA 밴드 (teal 풀폭) — CTA는 챗봇 호출 단일 (문의 폼 신설 금지).
// PHONE이 비어 있으면 전화 보조 CTA는 렌더하지 않는다 (임의 기입 금지).
import { SITE_CONFIG } from '../../config.js';

interface Props {
  chatTree?: string;
  buttonLabel?: string;
  /** 링 스윕 모션 — 홈 1곳 전용. 기본 꺼짐 (모든 CTA가 돌면 포인트가 아니다) */
  ring?: boolean;
}
const { chatTree = 'menu', buttonLabel = '견적 문의', ring = false } = Astro.props;
// 슬롯을 안 넘기고 부르는 페이지(/story/, 블로그 글)가 있다. 빈 <h2>·<p> 를 내보내면
// 스크린리더가 'empty heading' 으로 읽고 화면엔 빈 면만 남는다 — 있을 때만 그린다.
const hasTitle = Astro.slots.has('default');
const hasSub = Astro.slots.has('sub');
---
<section class="bd-section v2-cta">
  <div class="bd-container">
    {hasTitle && <h2 class="br-h v2-cta__title br-reveal"><slot /></h2>}
    {hasSub && <p class="v2-cta__sub br-reveal"><slot name="sub" /></p>}
    <div class="v2-cta__row br-reveal">
      <button disabled aria-describedby="chat-unavailable"
        type="button"
        class:list={['bd-cta', 'v2-cta__btn', 'br-specular', { 'v2-cta__btn--ring': ring }]}
        data-chat-tree={chatTree}
        data-specular
      >{buttonLabel}</button>
      {SITE_CONFIG.PHONE && (
        <a class="v2-cta__phone" href={`tel:${SITE_CONFIG.PHONE}`}>{SITE_CONFIG.PHONE}</a>
      )}
    </div>
  </div>
</section>

<style>
  /* 유리 Dark (글래스 1차). 풀폭 밴드라 radius·그림자 없이 등급 값만 소비 */
  .v2-cta {
    background: var(--glass-dark-bg);
    -webkit-backdrop-filter: var(--glass-dark-fx);
    backdrop-filter: var(--glass-dark-fx);
    border-top: 1px solid var(--glass-line-on-dark);
    text-align: center;
  }
  .v2-cta__title { color: #fff; margin-top: 0; }
  /* 밴드는 반투명 유리라 실제 합성색이 #4F6C78 이다. 알파 82% 흰색은 그 위에서 4.40:1 로
     AA(4.5) 미달이었다 — 불투명 base 로 5.32:1. 페이지별 :global 패치 4개를 이걸로 대체. */
  .v2-cta__sub { margin-top: 18px; font-size: 16px; line-height: 1.7; color: var(--br-base); }
  .v2-cta__row {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    align-items: center;
  }
  /* 밴드 CTA — DESIGN.md §1 '다크 구간 CTA = ice 채움 + teal 글자, hover 흰 채움'으로 복귀(2026-09-22).
     2026-09-04 에 투명 고스트(흰 22% 테두리)로 바꿨는데, 사이트의 유일한 접수 진입점이
     밴드 위에서 버튼으로 읽히지 않았다. ice/teal 대비 7.10:1 (DESIGN.md 대비표). */
  .v2-cta__btn {
    --sb-line: var(--br-teal);
    position: relative; /* specular 링 기준 */
    font-size: 18.4px; font-weight: 700; letter-spacing: 0.01em;
    padding: 18px 40px; border-radius: 18px;
    background: var(--br-ice); color: var(--br-teal);
    border: 1px solid transparent;
    box-shadow: 0 8px 24px rgba(0, 41, 58, 0.25);
  }
  .v2-cta__btn:hover { background: #fff; color: var(--br-teal-deep); }
  /* 전역 포커스 링은 라이트 구간용(teal)이라 ice 면 위에서 1.65:1 로 묻힌다.
     면 안쪽에 그려 teal/ice 7.10:1 을 쓴다 (DESIGN.md §1 대비표). */
  .v2-cta__btn:focus-visible { outline-offset: -5px; outline-color: var(--br-teal); }
  .v2-cta__phone { font-weight: 700; color: var(--br-ice); }
  @media (min-width: 768px) { .v2-cta__sub { font-size: 17px; } }

  /* ---------- 링 스윕 (홈 전용, ring prop) ----------
     버튼 테두리만 도는 conic 그라디언트. 본체·글자·크기·패딩은 손대지 않으므로
     대비(teal 글자 / ice 바탕)는 그대로다.
     ice 구간은 teal 밴드를 배경으로, teal 구간은 ice 버튼을 배경으로 읽혀
     어느 각도에서도 1.5px 띠가 보인다.
     가운데는 mask로 도려내 글자를 덮지 않는다 — z-index 다툼 없음. */
  @property --br-ring-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .v2-cta__btn--ring { --ring-w: 1.5px; position: relative; }

  /* mask-composite 미지원 브라우저에선 링 자체를 렌더하지 않는다
     (마스크가 안 먹으면 conic이 버튼을 통째로 덮는다) */
  @supports ((mask-composite: exclude) or (-webkit-mask-composite: xor)) {
    .v2-cta__btn--ring::before {
      content: '';
      position: absolute;
      inset: calc(-1 * var(--ring-w));
      border-radius: calc(12px + var(--ring-w));
      padding: var(--ring-w);
      background: conic-gradient(
        from var(--br-ring-angle),
        var(--br-ice),
        var(--br-teal) 50%,
        var(--br-ice)
      );
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      mask-composite: exclude;
      animation: br-ring-spin 10s linear infinite;
      pointer-events: none;
    }
  }

  @keyframes br-ring-spin {
    to { --br-ring-angle: 360deg; }
  }

  /* 모션 끔 = 정지한 링. 링 자체는 남긴다 */
  @media (prefers-reduced-motion: reduce) {
    .v2-cta__btn--ring::before { animation: none; }
  }
</style>
