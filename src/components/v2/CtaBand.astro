---
// S10 CTA 밴드 (teal 풀폭) — CTA는 챗봇 호출 단일 (문의 폼 신설 금지).
// PHONE이 비어 있으면 전화 보조 CTA는 렌더하지 않는다 (임의 기입 금지).
import { SITE_CONFIG } from '../../config.js';

interface Props {
  chatTree?: string;
  buttonLabel?: string;
  /** 문의 버튼 옆 보조 알약 '가격 안내 보기' — 금액 이야기는 /price/ 한 곳에만 있어서, 금액을 떼어 낸 페이지에서 그리로 가는 길 */
  priceLink?: boolean;
  /** 제목 위 라벨(2026-10-01 대표: 섹션마다 소제목) */
  label?: string;
}
const { chatTree = 'menu', buttonLabel = '견적 문의', priceLink = false, label = '' } = Astro.props;
// 슬롯을 안 넘기고 부르는 페이지(/story/, 블로그 글)가 있다. 빈 <h2>·<p> 를 내보내면
// 스크린리더가 'empty heading' 으로 읽고 화면엔 빈 면만 남는다 — 있을 때만 그린다.
const hasTitle = Astro.slots.has('default');
const hasSub = Astro.slots.has('sub');
---
<section class="bd-section v2-cta">
  <div class="bd-container">
    {label && <p class="br-sec-label v2-cta__label">{label}</p>}
    {hasTitle && <h2 class="br-h v2-cta__title br-reveal"><slot /></h2>}
    {hasSub && <p class="v2-cta__sub br-reveal"><slot name="sub" /></p>}
    {/* 버튼 두 개는 같은 높이로 한 줄, 전화번호는 그 아래 한 줄(2026-10-05 대표: 셋의 크기가 제각각이라 어색) */}
    <div class="v2-cta__row br-reveal">
      <div class="v2-cta__btns">
      <button disabled aria-describedby="chat-unavailable"
        type="button"
        class="bd-cta bd-cta--ondark v2-cta__btn"
        data-chat-tree={chatTree}
      >{buttonLabel}<svg class="br-cta-arrow" aria-hidden="true" viewBox="0 0 10 10" width="10" height="10" fill="none"><path d="M0 5h7" /><path d="M1 1l4 4-4 4" /></svg></button>
      {priceLink && <a class="br-pill" href="/price/">가격 안내 보기 <span aria-hidden="true">→</span></a>}
      </div>
      {SITE_CONFIG.PHONE && (
        <a class="v2-cta__phone" href={`tel:${SITE_CONFIG.PHONE}`}><span class="v2-cta__phone-label">전화</span>{SITE_CONFIG.PHONE}</a>
      )}
    </div>
  </div>
</section>

<style>
  /* 유리 Dark (글래스 1차). 풀폭 밴드라 radius·그림자 없이 등급 값만 소비 */
  .v2-cta {
    background: var(--glass-dark-bg);
    -webkit-backdrop-filter: var(--glass-dark-fx);
    backdrop-filter: var(--glass-dark-fx);
    border-top: 1px solid var(--glass-line-on-dark);
    text-align: center;
  }
  .v2-cta__title { color: #fff; margin-top: 0; }
  /* 반투명 유리 위 합성색(#4F6C78)에서 흰 75% 는 대비가 모자라 sub 와 같은 base 를 쓴다 */
  .v2-cta__label { color: var(--br-base); }
  .v2-cta__label + .v2-cta__title { margin-top: 10px; }
  /* 밴드는 반투명 유리라 실제 합성색이 #4F6C78 이다. 알파 82% 흰색은 그 위에서 4.40:1 로
     AA(4.5) 미달이었다 — 불투명 base 로 5.32:1. 페이지별 :global 패치 4개를 이걸로 대체. */
  .v2-cta__sub { margin-top: 18px; font-size: 16px; line-height: 1.7; color: var(--br-base); }
  .v2-cta__row {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }
  .v2-cta__btns { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; align-items: stretch; }
  /* 밴드 CTA — 흰 면 사각 문의 버튼(global.css .bd-cta--ondark + 화살표, 2026-10-02 대표 참고 버튼). 여기서는 크기만.
     문의·가격 안내 두 버튼은 높이 56·글자 17·모서리 12 로 맞춘다 — 차이는 면 색(흰 면 / 틴트)으로만 낸다 */
  .v2-cta__btn,
  .v2-cta__btns .br-pill {
    min-height: 56px; padding: 0 28px; font-size: 17px; font-weight: 700; letter-spacing: -0.01em;
    border-radius: var(--radius-btn); justify-content: center;
  }
  /* 전화 — 버튼 아래 한 줄. 누르는 자리는 44px */
  .v2-cta__phone {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 8px;
    font-size: 22px; font-weight: 700; letter-spacing: 0.01em; color: var(--br-ice);
  }
  .v2-cta__phone-label { font-size: 15px; font-weight: 600; letter-spacing: 0; color: var(--br-base); }
  .v2-cta__phone:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 6px; }
  /* 좁은 화면 — 두 버튼을 같은 폭으로 세로로 */
  @media (max-width: 479px) {
    .v2-cta__btns { flex-direction: column; width: min(100%, 320px); }
  }
  /* 보조 알약 — 밴드 합성색(#4F6C78) 위에서 ice 글자는 3.6:1 로 미달. 흰 글자·흰 틴트로 4.5 이상 */
  .v2-cta { --pill-fg: #fff; --pill-fg-hover: #fff; --pill-bg: rgba(255, 255, 255, 0.08); --pill-bg-hover: rgba(0, 41, 58, 0.2); --pill-dot: rgba(255, 255, 255, 0.14); } /* hover 는 밝히지 않고 어둡게 — 밝히면 4.4:1 */
  @media (min-width: 768px) { .v2-cta__sub { font-size: 17px; } }

</style>
