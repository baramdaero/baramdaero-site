---
// S3~S5 서비스 지그재그 — 좌텍스트/우비주얼, flip 시 반전.
// link(페이지 이동) 또는 chatTree(챗봇 트리 호출) 중 하나로 CTA를 배선한다.
import ImageSlot from './ImageSlot.astro';
import { isImageSlotVisible } from '../../lib/image-slots.ts';

interface Props {
  id: string;
  eyebrow: string;
  /** 직접 넣는 이미지 경로 — 비면 레지스트리를 쓰고, 둘 다 비면 프로덕션에서 이미지 열을 접는다. */
  image?: string;
  imageAlt?: string;
  slotId?: string;
  linkLabel: string;
  link?: string;
  chatTree?: string;
  flip?: boolean;
  tone?: 'base' | 'mist';
}
const {
  id,
  eyebrow,
  image = '',
  imageAlt = '',
  slotId = `home-service-${id}`,
  linkLabel,
  link,
  chatTree,
  flip = false,
  tone = 'base',
} = Astro.props;
const hasVisual = isImageSlotVisible(slotId, image);
---
<section
  class:list={['bd-section', 'v2-svc', `v2-svc--${tone}`]}
  id={id}
  data-layout-section="home-service"
  data-image-side={hasVisual ? (flip ? 'left' : 'right') : undefined}
>
  <div class:list={['bd-container', 'v2-svc__grid', { 'v2-svc__grid--flip': flip, 'v2-svc__grid--copy-only': !hasVisual }]}>
    <div class="v2-svc__txt br-glass br-glass--medium">
      <span class="br-eyebrow br-reveal">{eyebrow}</span>
      <h2 class="br-h br-reveal"><slot name="headline" /></h2>
      <p class="br-body br-reveal"><slot name="body" /></p>
      <p class="v2-svc__more br-reveal">
        {link ? (
          <a class="v2-svc__link" href={link}>{linkLabel} <span aria-hidden="true">→</span></a>
        ) : (
          <button type="button" class="v2-svc__link" data-chat-tree={chatTree}>{linkLabel} <span aria-hidden="true">→</span></button>
        )}
      </p>
    </div>
    {hasVisual && (
      <div class="v2-svc__vis br-reveal">
        <ImageSlot id={slotId} src={image} alt={imageAlt} label={slotId} ratio="wide" />
      </div>
    )}
  </div>
</section>

<style>
  /* 글래스 1차: 섹션은 투명 — 앰비언트가 비쳐야 유리가 유리로 보인다.
     면(카드 역할)은 .v2-svc__txt 의 Medium 패널이 맡는다. tone 클래스는 유지(확장 대비) */
  .v2-svc--base { background: transparent; }
  .v2-svc--mist { background: transparent; }
  .v2-svc__txt { padding: 32px 28px; }
  @media (min-width: 768px) { .v2-svc__txt { padding: 40px 36px; } }
  .v2-svc__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  .v2-svc__more { margin-top: 24px; }
  .v2-svc__link {
    display: inline-block;
    font-size: 16px;
    font-weight: 700;
    color: var(--br-teal);
    border-bottom: 2px solid var(--br-teal);
    padding-bottom: 2px;
    transition: color var(--dur-color) ease, border-color var(--dur-color) ease;
  }
  .v2-svc__link:hover { color: var(--br-teal-deep); border-color: var(--br-ice); }
  .v2-svc__txt :global(.br-body) { color: var(--br-ink); }
  .v2-svc__grid--copy-only .v2-svc__txt { max-width: 760px; }
  .v2-svc__vis { order: -1; }
  @media (min-width: 768px) {
    .v2-svc__grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 64px; }
    .v2-svc__vis { order: 2; }
    .v2-svc__grid--flip { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
    .v2-svc__grid--flip .v2-svc__txt { order: 2; }
    .v2-svc__grid--flip .v2-svc__vis { order: 1; }
    .v2-svc__grid--copy-only { grid-template-columns: minmax(0, 1fr); }
    .v2-svc__grid--copy-only .v2-svc__txt { order: 1; }
  }
</style>
