---
// 밑줄 링크 — 글자 왼쪽, ↘ 오른쪽, 아래 가는 선(2026-10-01 대표 지정 형식). 홈 회사소개 판 아래 '시공사례 보러가기'.
// 화살표는 글자(↘) — 사이트의 다른 링크도 → 글자를 쓴다(아이콘 파일 아님)
interface Props { href: string; label: string }
const { href, label } = Astro.props;
---
<a class="arrow-link" href={href}>
  <span class="arrow-link__t">{label}</span>
  <span class="arrow-link__a" aria-hidden="true">↘</span>
</a>

<style>
  .arrow-link {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    width: min(100%, 340px); min-height: 48px; padding: 10px 2px 12px;
    border-bottom: 1px solid var(--br-ink);
    color: var(--br-ink); font-size: 17px; font-weight: 700; letter-spacing: -0.01em; text-decoration: none;
    transition: color var(--dur-color) var(--ease-out), border-color var(--dur-color) var(--ease-out);
  }
  .arrow-link__a { font-size: 20px; line-height: 1; color: var(--br-teal); transition: transform 160ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .arrow-link:hover { color: var(--br-teal); border-color: var(--br-teal); }
    .arrow-link:hover .arrow-link__a { transform: translate(2px, 2px); }
  }
  @media (max-width: 600px) { .arrow-link { width: 100%; } } /* 휴대폰: 위 박스 폭과 맞춘다 */
  .arrow-link:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .arrow-link__a { transition: none; } }
</style>
