---
// 기준가 도입부 — 콘텐츠는 standards.json 단일 소스.
// baseline은 페이지별(baseline_install / baseline_care)로 받는다.
// baseline 없으면 통째로 미렌더, updated 비면 갱신일 줄만 미노출 (빈 값 = 미노출 규칙).
import type { StandardsData } from '../../lib/standards.ts';

interface Props {
  baseline: StandardsData['baselineCare'];
  /** 섹션 배경. 앞뒤 섹션과 base↔mist가 교차하도록 페이지가 정한다 (신규 색 금지) */
  tone?: 'base' | 'mist';
}
const { baseline, tone = 'base' } = Astro.props;
---
{baseline && (
  <section class:list={['bd-section', 'v2-baseline', tone === 'mist' && 'v2-baseline--mist']}>
    <div class="bd-container">
      <h2 class="br-h br-reveal">{baseline.title}</h2>
      <p class="br-body br-reveal">
        {baseline.bodyLines.map((line, i) => (
          <Fragment>{i > 0 && <br />}{line}</Fragment>
        ))}
      </p>

      {baseline.formulaLine && (
        <p class="v2-baseline__formula br-reveal">{baseline.formulaLine}</p>
      )}

      {baseline.policyLines.length > 0 && (
        <ul class="v2-baseline__policy br-reveal">
          {baseline.policyLines.map((line) => <li>{line}</li>)}
        </ul>
      )}

      {baseline.updated && (
        <p class="v2-baseline__updated br-reveal">기준가 최종 갱신: {baseline.updated}</p>
      )}
    </div>
  </section>
)}

<style>
  .v2-baseline { background: var(--br-base); }
  .v2-baseline--mist { background: var(--br-mist); }

  /* 산출 공식 — teal 라인 위 강조 한 줄 */
  .v2-baseline__formula {
    margin-top: 28px;
    padding: 16px 20px;
    border-left: 3px solid var(--br-teal);
    background: var(--br-mist);
    font-size: 15px;
    font-weight: 600;
    color: var(--br-ink);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 760px;
  }

  .v2-baseline__policy {
    margin-top: 24px;
    list-style: none;
    display: grid;
    gap: 8px;
    max-width: 760px;
  }
  .v2-baseline__policy li {
    font-size: 15px;
    color: var(--br-ink-sub);
    padding-left: 16px;
    position: relative;
  }
  .v2-baseline__policy li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 8px;
    height: 1px;
    background: var(--br-teal);
  }


  .v2-baseline__updated {
    margin-top: 24px;
    font-size: 13px;
    color: var(--br-ink-sub);
    font-variant-numeric: tabular-nums;
  }
</style>
