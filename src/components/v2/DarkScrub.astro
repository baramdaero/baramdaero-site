---
// S2 다크 구간 (teal-deep 풀블리드) — 히어로 바로 아래 세계관 자리.
// 스크롤 진행도에 따라 카피가 단계별로 전환되고, 마지막 정의에 착지한 뒤 다음 섹션(서비스)으로 넘어간다.
// 카피는 src/content/site/hero-worldview.json 단일 소스 (하드코딩 금지).
// 배경 프레임 시퀀스는 /public/scrub/ (별도 생성 예정 — 현재 폴백). 없으면 poster 1장,
// poster도 없으면 teal-deep 단색 위 카피만 동작한다. 전부 바닐라 (DESIGN.md §4).
import { loadHeroWorldview } from '../../lib/heroWorldview.ts';

const { steps, source } = loadHeroWorldview();
---
{steps.length > 0 && (
  <section class="v2-scrub" data-scrub>
    <div class="v2-scrub__sticky">
      <img class="v2-scrub__poster" src="/scrub/poster.jpg" alt="" aria-hidden="true" data-scrub-poster />
      <canvas class="v2-scrub__cv" data-scrub-canvas aria-hidden="true"></canvas>
      <div class="bd-container v2-scrub__copy">
        {steps.map((step, i) => (
          <p
            class:list={['v2-scrub__line', { 'v2-scrub__line--end': step.emphasis }]}
            data-scrub-copy={i}
          >
            {step.lines.map((line, j) => (
              <Fragment>{j > 0 && <br />}{line}</Fragment>
            ))}
          </p>
        ))}
      </div>
      {source && <p class="v2-scrub__source bd-container">{source}</p>}
    </div>
  </section>
)}

<script>
  // 스크럽 로더 — 프레임 시퀀스가 없으면 poster 폴백, reduced-motion이면 정지 상태 (CSS가 처리).
  const FRAME_COUNT = 120;                 // 에셋 확정 시 실제 장수로 교체
  const frameSrc = (i: number) => `/scrub/frame_${String(i).padStart(4, '0')}.jpg`;

  const root = document.querySelector<HTMLElement>('[data-scrub]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-scrub-canvas]');
  const poster = root?.querySelector<HTMLImageElement>('[data-scrub-poster]');
  const copies = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-scrub-copy]')) : [];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // poster 미존재 시 깨진 이미지 아이콘 방지 — teal-deep 단색만 남긴다.
  // 스크립트 실행 전에 error가 이미 발화했을 수 있어 complete 상태도 함께 본다 (레이스 방지)
  if (poster) {
    if (poster.complete && poster.naturalWidth === 0) poster.remove();
    else poster.addEventListener('error', () => poster.remove());
  }

  if (root && canvas && copies.length && !reduced) {
    root.classList.add('br-scrub'); // 이 시점부터만 런웨이·전환 레이아웃 (no-JS·reduced = 세로 나열)
    const ctx = canvas.getContext('2d');
    // 모바일은 프레임 절반만 로드 (초기 로드 시 1회 판정)
    const step = window.matchMedia('(max-width: 767px)').matches ? 2 : 1;
    const frames: (HTMLImageElement | null)[] = [];
    let framesUsable = false;
    let lastDrawn = -1;

    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

    const progress = () => {
      const rect = root.getBoundingClientRect();
      return clamp01(-rect.top / (rect.height - window.innerHeight));
    };

    const fitCanvas = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = canvas.clientWidth * dpr;
      canvas.height = canvas.clientHeight * dpr;
      lastDrawn = -1; // 리사이즈 후 강제 재드로잉
    };

    const drawCover = (img: HTMLImageElement) => {
      if (!ctx) return;
      const { width: cw, height: ch } = canvas;
      const scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * scale;
      const h = img.naturalHeight * scale;
      ctx.clearRect(0, 0, cw, ch);
      ctx.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
    };

    /* 카피 전환 — 진행률을 단계 수로 등분하고 각 구간 안에서 페이드 인/아웃.
       단계가 늘거나 줄면 구간 폭이 자동으로 다시 나뉜다 (개수 하드코딩 없음).
       첫 단계는 진입 전에도, 마지막 단계는 끝까지 남긴다 — 빈 화면과 착지점 소실 방지. */
    const renderCopy = (p: number) => {
      const n = copies.length;
      const span = 1 / n;
      const fade = span * 0.28;
      copies.forEach((el, i) => {
        const start = i * span;
        const end = start + span;
        let o = 0;
        if (p >= start && p <= end) {
          if (p < start + fade) o = (p - start) / fade;
          else if (p > end - fade) o = (end - p) / fade;
          else o = 1;
        }
        // 첫 단계는 페이드인 없이 시작한다 — 없으면 런웨이 진입 직후 화면이 비어 보인다(실측 0.36)
        if (i === 0 && p <= start + fade) o = 1;
        // 마지막 단계는 끝까지 남긴다 — 착지점이 사라지면 안 된다
        if (i === n - 1 && p >= end - fade) o = 1;
        el.style.opacity = String(clamp01(o));
      });
    };

    const render = () => {
      const p = progress();
      renderCopy(p);

      if (!framesUsable) return;
      const idx = Math.round(p * (frames.length - 1));
      if (idx === lastDrawn) return;
      // 아직 안 실린 프레임이면 가장 가까운 로드 완료 프레임으로 대체
      for (let i = idx; i >= 0; i--) {
        const f = frames[i];
        if (f?.complete && f.naturalWidth > 0) {
          drawCover(f);
          lastDrawn = idx;
          break;
        }
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { render(); ticking = false; });
    };

    // 첫 프레임 로드 성공 시에만 시퀀스 프리로드 — 실패하면 poster 폴백 (카피 전환은 유지)
    const probe = new Image();
    probe.src = frameSrc(1);
    probe.onload = () => {
      framesUsable = true;
      poster?.remove();
      for (let i = 1; i <= FRAME_COUNT; i += step) {
        const img = new Image();
        img.src = frameSrc(i);
        img.onload = () => { lastDrawn = -1; render(); };
        frames.push(img);
      }
      fitCanvas();
      render();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => { fitCanvas(); render(); }, { passive: true });
    fitCanvas();
    render();
  }
</script>

<style>
  /* 기본(no-JS·reduced-motion 공통) = 정지 상태: 단계를 세로로 전부 나열.
     런웨이·겹침·초기 숨김은 전부 .br-scrub 게이트 하위에서만 (DESIGN.md §4). */
  .v2-scrub {
    background: var(--br-teal-deep);
  }
  .v2-scrub__sticky {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 60vh;
    padding: 120px 0;
  }
  .v2-scrub__poster,
  .v2-scrub__cv {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .v2-scrub__cv { display: none; }
  .v2-scrub__copy { position: relative; width: 100%; }

  .v2-scrub__line {
    font-size: clamp(23px, 3.4vw, 38px);
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
    word-break: keep-all;
  }
  .v2-scrub__line + .v2-scrub__line { margin-top: 28px; }

  /* 착지점 — 이 구간이 도달하는 정의. 다른 단계보다 크고 무겁게 */
  .v2-scrub__line--end {
    font-size: clamp(34px, 6vw, 64px);
    font-weight: 800;
    line-height: 1.2;
    color: var(--br-ice);
  }

  /* 1단계 통계 출처 — 구간 최하단 고정, 스크롤 단계와 무관하게 항상 노출.
     .v2-scrub__sticky가 display:flex라 형제로 두면 가로 배치가 되므로
     position:absolute로 플렉스 흐름에서 완전히 뺀다 (sticky는 두 상태 모두 position:relative). */
  .v2-scrub__source {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.5);
  }

  /* 스크립트 초기화 시(.br-scrub)에만 — 런웨이 + sticky 1뷰포트, 단계 전환.
     reduced-motion이면 스크립트가 스킵돼 이 블록은 영영 적용되지 않는다 (= 세로 나열 유지). */
  .v2-scrub.br-scrub { height: 420vh; }
  .v2-scrub.br-scrub .v2-scrub__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 0;
    padding: 0;
  }
  .v2-scrub.br-scrub .v2-scrub__cv { display: block; }
  /* 단계를 같은 칸에 겹쳐 두고 opacity로 전환 */
  .v2-scrub.br-scrub .v2-scrub__copy { display: grid; }
  .v2-scrub.br-scrub .v2-scrub__line {
    grid-area: 1 / 1;
    margin-top: 0;
    align-self: center;
    transition: opacity 320ms var(--ease-out);
  }
</style>
