---
// 분해 3D 섹션 — 기종을 탭으로 고르고 한 대를 크게 본다.
// 뷰어는 public/3d/parts/ 의 공개 사본(내부 근거·출처 문구를 비운 빌드)이다.
// 한 화면에 한 대만 두는 이유: 두 대를 나란히 놓으면 부품 이름표가 겹쳐 읽히지 않는다.
// 클래스는 ex- 접두사로 다른 섹션과 분리한다.
interface Item {
  /** 탭에 쓰는 짧은 이름 (예: "삼성 1Way") */
  label: string;
  /** public/3d/parts/ 안의 파일명 */
  file: string;
  /** 탭 아래 한 줄 설명 (모델명·용량 등) */
  caption?: string;
  /** public/media/ 안의 제품 사진. 있으면 사진 칸 + 3D 2단으로 나온다.
   *  caption 은 사진 아래 보이는 라벨 — 제조사를 여기서 밝힌다(삼성만 한다는 오해 방지) */
  photos?: { src: string; alt: string; caption?: string }[];
}
interface Props {
  eyebrow: string;
  /** 배열이면 한 칸이 한 줄 — 제목은 2줄·줄당 12자 안팎 (DESIGN.md §2) */
  title: string | string[];
  body?: string;
  items: Item[];
  /** 섹션 배경. 앞뒤 섹션과 base↔mist가 교차하도록 페이지가 정한다 */
  /** clear = 배경 없음(페이지 앰비언트가 이어진다 — 홈, 2026-10-01 '구간이 딱 나뉘어 보기 싫다') */
  tone?: 'base' | 'mist' | 'clear';
  /** 같은 페이지에 두 번 들어갈 때 구분 */
  id?: string;
}
interface Props2 {
  photoNote?: string;
  /** 제조사 전환(2026-10-01 대표): 기종마다 사진 한 장 — 사진 칸이 토글이 되어 누르면 그 제품의 분해도로 바뀐다. 탭 줄은 안 그린다 */
  photoSwitch?: boolean;
}
const { eyebrow, title, body, items, tone = 'base', id = 'exploded' } = Astro.props;
const { photoNote, photoSwitch = false } = Astro.props as Props2;
const tabMode = items.length > 1 && !photoSwitch;
const titleLines = Array.isArray(title) ? title : [title];
const hasPhoto = items.some((it) => (it.photos?.length ?? 0) > 0);
const photoCount = Math.max(...items.map((it) => it.photos?.length ?? 0), 0);
---
{items.length > 0 && (
  <section class:list={['bd-section', 'ex-sec', tone === 'mist' && 'ex-sec--mist', tone === 'clear' && 'ex-sec--clear']} id={id}>
    <div class="bd-container">
      {/* 머리 — 라벨 · 제목 · 한 줄(홈 회사소개와 같은 .br-sec-* , 2026-10-01) */}
      {eyebrow && <p class="br-sec-label">{eyebrow}</p>}
      {/* 제목이 비면 h2 를 내지 않는다(제목을 둘지는 페이지가 정한다) */}
      {titleLines.join('') && <h2 class="br-h br-reveal">{titleLines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</h2>}
      {/* 제목과 3D 안내 사이 — /install/ 은 제품 영상을 여기 둔다 */}
      {Astro.slots.has('lead') && <div class="ex-lead br-reveal"><slot name="lead" /></div>}
      {body && <p class="br-sec-lead br-reveal">{body}</p>}

      {tabMode && (
      <div class="ex-tabs br-reveal" role="tablist" aria-label="기종 선택">
        {items.map((it, i) => (
          <button
            type="button" role="tab" class="ex-tab"
            id={`${id}-tab-${i}`} data-ex-tab={i} aria-controls={`${id}-panel`}
            aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
          >{it.label}</button>
        ))}
      </div>
      )}

      <div class:list={['ex-row', 'br-reveal', hasPhoto && 'ex-row--split']}>
        {hasPhoto && photoSwitch && (
          <div class="ex-photos" role="radiogroup" aria-label="제조사 선택">
            {/* 토글은 photos[0] 이 있는 항목만 — 버튼의 data-ex-pick 이 items 순번이다 */}
            {items.map((it, k) => it.photos?.[0] && (
              <button type="button" class="ex-photo ex-switch" role="radio" data-ex-pick={k}
                aria-checked={k === 0 ? 'true' : 'false'} tabindex={k === 0 ? 0 : -1}>
                <img src={`/media/${it.photos[0].src}`} loading="lazy" decoding="async" alt="" />{/* 버튼 이름은 아래 제품명이 맡는다 */}
                <span class="ex-switch__cap">{it.photos[0].caption ?? it.label}</span>
              </button>
            ))}
          </div>
        )}
        {hasPhoto && !photoSwitch && (
          <div class="ex-photos">
            {Array.from({ length: photoCount }, (_, k) => (
              <figure class="ex-photo" id={`${id}-fig-${k}`} hidden={!items[0].photos?.[k]}>
                {items[0].photos?.[k] && (
                  <Fragment>
                    <img id={`${id}-photo-${k}`} src={`/media/${items[0].photos[k].src}`}
                         loading="lazy" decoding="async" alt={items[0].photos[k].alt} />
                    <figcaption id={`${id}-cap-${k}`}>{items[0].photos[k].caption ?? ''}</figcaption>
                  </Fragment>
                )}
              </figure>
            ))}
          </div>
        )}
        <div
          class="ex-stage" id={`${id}-panel`}
          role={tabMode ? 'tabpanel' : 'group'}
          aria-labelledby={tabMode ? `${id}-tab-0` : undefined}
          aria-label={tabMode ? undefined : `분해 3D · ${items[0].label}`}
        >
          <iframe tabindex="-1"
            id={`${id}-frame`} src={`/3d/parts/${items[0].file}?embed&theme=light&assembled`} loading="lazy"
            title={`분해 3D · ${items[0].label}`}></iframe>
          <p class="ex-fail" id={`${id}-fail`} role="status">3D 도면을 불러오지 못했습니다. 잠시 뒤 새로고침해 주세요.</p>
        </div>
      </div>

      {/* 토글 모드에선 뷰어 머리글이 같은 모델·용량을 이미 보여 준다 — 캡션은 화면에서 숨기고 값만 갱신한다 */}
      <p class:list={['ex-cap', photoSwitch && 'ex-cap--hidden']} id={`${id}-cap`}>{items[0].caption ?? ''}</p>
      <p class="ex-note">
        {photoNote && <Fragment>{photoNote}<br /></Fragment>}
        {photoSwitch
          ? '우리가 설치하는 모델을 제조사 문서와 시공 현장 기준으로 따로 그렸습니다. 내부 부품의 크기·위치는 일부 추정입니다.'
          : '모델마다 제조사 문서 기준으로 그렸습니다. 내부 부품의 크기·위치는 일부 추정입니다.'}
      </p>
    </div>
  </section>
)}

<script is:inline define:vars={{ id, items }}>
  (() => {
    const frame = document.getElementById(`${id}-frame`);
    const cap = document.getElementById(`${id}-cap`);
    const stage = document.getElementById(`${id}-panel`);
    const photos = [...document.querySelectorAll(`[id^="${id}-photo-"]`)];
    const figs = [...document.querySelectorAll(`[id^="${id}-fig-"]`)];
    const tabs = [...document.querySelectorAll(`[data-ex-tab][aria-controls="${id}-panel"]`)];
    const switches = [...(stage?.closest('section')?.querySelectorAll('[data-ex-pick]') ?? [])];   // 제조사 토글(사진 칸)
    // ⚠️ tabs.length 를 가드에 넣지 말 것 — 기종이 1개인 페이지(홈·설치)는 탭 줄을 안 그린다.
    // 여기서 반환하면 자동 재생(IntersectionObserver)·로드 실패 안내(armFail)까지 같이 죽는다.
    // tabs.forEach 는 빈 배열에서 no-op 이고 pick() 은 탭 핸들러에서만 불린다.
    if (!frame) return;
    const FAIL_MS = 15000;                 // three.js CDN 이 막히면 뷰어 스크립트 자체가 실행되지 않는다
    let ready = false, seen = false, played = false, failTimer = 0;

    // 뷰어가 준비됐다고 알려 올 때 재생한다. 타이머로 찍으면 느린 망에서 신호가 버려진다
    const play = () => {
      if (played || !ready || !seen || !frame.contentWindow) return;
      played = true;
      frame.contentWindow.postMessage({ ns: 'ac3d', type: 'play' }, '*');
    };
    const armFail = () => {
      clearTimeout(failTimer);
      failTimer = setTimeout(() => { if (!ready) stage?.setAttribute('data-fail', ''); }, FAIL_MS);
    };
    addEventListener('message', (e) => {
      const m = e.data;
      if (!m || m.ns !== 'ac3d' || e.source !== frame.contentWindow) return;
      if (m.type !== 'ready') return;
      ready = true;
      clearTimeout(failTimer);
      stage?.removeAttribute('data-fail');
      play();
    });

    const pick = (i) => {
      const it = items[i];
      if (!it) return;
      const url = `/3d/parts/${it.file}?embed&theme=light&assembled`;
      try { frame.contentWindow.location.replace(url); } catch { frame.src = url; }   // src 재할당은 히스토리를 쌓는다
      ready = false; played = false;       // 탭을 바꾸면 그 기종도 한 번 재생한다
      if (seen) armFail();
      frame.title = `분해 3D · ${it.label}`;
      if (cap) cap.textContent = it.caption ?? '';
      if (tabs.length) stage?.setAttribute('aria-labelledby', `${id}-tab-${i}`);
      else stage?.setAttribute('aria-label', `분해 3D · ${it.label}`);
      switches.forEach((b) => { const on = Number(b.dataset.exPick) === i; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; });
      figs.forEach((fig, k) => {           // 사진 수가 다른 기종으로 바꿀 때 이전 사진이 남지 않게
        const ph = it.photos?.[k], img = photos.find((x) => x.id === `${id}-photo-${k}`);
        fig.hidden = !ph;
        if (ph && img) { img.src = `/media/${ph.src}`; img.alt = ph.alt; }
        const cap = fig.querySelector('figcaption');
        if (cap) cap.textContent = ph?.caption ?? '';
      });
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
    };

    // 휴대폰 '한 번 눌러 켜기' 잠금은 걷었다(2026-10-02 대표: 첫 탭이 안 먹고, 켜지면 3D 위에서 스크롤이 안 내려감).
    // 뷰어가 세로 스와이프는 페이지로, 가로 드래그만 회전으로 받는다(parts3d src.html EMBED, touch-action: pan-y)

    // 스크롤해서 눈에 들어오면 그때부터 센다(백그라운드 탭에서 실패로 찍지 않게)
    if (stage && 'IntersectionObserver' in window) {
      new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { seen = true; armFail(); play(); } });
      }, { threshold: 0.35, rootMargin: '0px 0px -8% 0px' }).observe(stage);
    } else {
      seen = true; armFail(); play();
    }

    switches.forEach((b, i) => {
      b.addEventListener('click', () => pick(Number(b.dataset.exPick)));   // 순번이 아니라 data 값 — 사진 없는 항목이 끼어도 밀리지 않게
      b.addEventListener('keydown', (e) => {                     // 라디오 묶음 — 방향키로 옮기며 고른다
        const d = ['ArrowRight', 'ArrowDown'].includes(e.key) ? 1 : ['ArrowLeft', 'ArrowUp'].includes(e.key) ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = (i + d + switches.length) % switches.length;
        switches[n].focus(); pick(Number(switches[n].dataset.exPick));
      });
    });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {                     // 좌우 키로 탭 이동
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = (i + d + tabs.length) % tabs.length;
        tabs[n].focus(); pick(n);
      });
    });
  })();
</script>

<style>
  .ex-sec { background: var(--br-base); }
  .ex-sec--mist { background: var(--br-mist); }
  .ex-sec--clear { background: transparent; }

  /* 제목 묶음 → 본 블록은 --head-gap 하나로 (영상·탭·3D 중 먼저 오는 것) */
  .ex-lead { margin-top: var(--head-gap); }
  .ex-lead:empty { display: none; }   /* 부모가 조건부로 비운 슬롯도 has('lead') 는 true 다 */
  .ex-lead:not(:empty) + .br-sec-lead { margin-top: 32px; }
  /* 탭 — 홈 3D 도크(.h3-spaces)와 같은 밑줄 탭. 채움 알약은 문의 버튼(.bd-cta) 모양이라 쓰지 않는다 */
  /* 한 줄 고정 — 밑줄 탭은 두 줄로 꺾이면 선택 밑줄이 기준선에서 뜬다. 넘치면 가로로 민다(390px /care/ 6개).
     기준선은 inset 그림자: overflow 안에서 탭 밑줄(-1px 겹침)이 잘리지 않게. mist 섹션 위에서 보이도록 ink 12% */
  .ex-tabs {
    display: flex; gap: 4px; margin-top: var(--head-gap);
    overflow-x: auto; scrollbar-width: none;
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--br-ink) 12%, transparent);
  }
  .ex-tabs::-webkit-scrollbar { display: none; }
  .ex-tab {
    font: inherit; font-size: 15px; font-weight: 600; line-height: 1; cursor: pointer;
    /* 터치 히트영역 44px (DESIGN.md §5) */
    display: inline-flex; align-items: center; min-height: 44px;
    flex: none; padding: 0 14px;
    border: 0; border-bottom: 2px solid transparent; border-radius: 6px 6px 0 0;
    background: transparent; color: var(--br-ink-sub);
    transition: color var(--dur-color) var(--ease-out), border-color var(--dur-color) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .ex-tab[aria-selected='false']:hover { color: var(--br-ink); } }
  .ex-tab[aria-selected='true'] { color: var(--br-ink); border-bottom-color: var(--br-teal); }
  .ex-tab:focus-visible { outline: 2px solid var(--br-teal); outline-offset: -2px; } /* 스크롤 영역 안이라 안쪽에 그린다 */

  .ex-row { margin-top: var(--head-gap); display: grid; gap: 16px; }
  .ex-tabs + .ex-row { margin-top: 16px; }
  .ex-row--split { grid-template-columns: minmax(0, 260px) minmax(0, 1fr); align-items: stretch; }
  .ex-photos { display: grid; grid-auto-rows: 1fr; gap: 12px; min-width: 0; }
  /* 제품 사진은 흰 실내기다 — 흰 카드에 두면 형태가 안 보인다.
     배경을 투명하게 잘라낸 뒤 3D 스테이지와 같은 판 위에 올린다 */
  .ex-photo {
    position: relative;
    margin: 0; border-radius: 12px; overflow: hidden;
    background: color-mix(in srgb, var(--br-teal) 12%, var(--br-mist));
    display: grid; grid-template-rows: 1fr auto; justify-items: center;
    padding: 10px; min-height: 0;
  }
  .ex-photo img { width: 100%; height: 100%; max-width: 100%; object-fit: contain; min-height: 0; }
  /* 유리 테두리 — 히어로 도크와 같은 링·그림자(global.css --glass-ring / --glass-shadow).
     면(배경)은 그대로 둔다: 흰 제품 사진·흰 3D 부품이 흰 면 위에서 안 보이던 문제로 틴트를 깐 자리다.
     overflow:hidden 이 iframe 을 둥글게 자르느라 바깥(inset:-1px)에 그린 링은 잘린다 — 안쪽에 그린다 */
  .ex-stage, .ex-photo { box-shadow: var(--glass-shadow); }
  .ex-stage::before, .ex-photo::before {
    content: ""; position: absolute; inset: 0; z-index: 2;
    border-radius: inherit; padding: 1px;
    background: var(--glass-ring);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  /* 제조사 라벨 — 두 브랜드를 다 한다는 게 사진에서 바로 읽혀야 한다 */
  .ex-photo figcaption {
    font-size: 12.5px; font-weight: 600; color: var(--br-ink-sub);
    padding-top: 6px; text-align: center;
  }
  .ex-photo figcaption:empty { display: none; }

  /* 제조사 토글 — 사진 칸이 스위치다. 고른 칸은 teal 테두리·진한 이름, 안 고른 칸은 사진을 흐리게(2026-10-01) */
  .ex-switch { width: 100%; border: 0; font: inherit; cursor: pointer; text-align: center; color: inherit; }
  .ex-switch img { transition: opacity var(--dur-color) var(--ease-out); }
  .ex-switch__cap { padding-top: 6px; font-size: 13px; font-weight: 600; color: var(--br-ink-sub); }
  .ex-switch[aria-checked='false'] img { opacity: .55; }
  @media (hover: hover) and (pointer: fine) { .ex-switch[aria-checked='false']:hover img { opacity: .85; } }
  .ex-switch[aria-checked='true'] .ex-switch__cap { color: var(--br-ink); font-weight: 700; }
  .ex-switch::after {
    content: ""; position: absolute; inset: 0; z-index: 3; border-radius: inherit; pointer-events: none;
    box-shadow: inset 0 0 0 2px transparent; transition: box-shadow var(--dur-color) var(--ease-out);
  }
  .ex-switch[aria-checked='true']::after { box-shadow: inset 0 0 0 2px var(--br-teal); }
  .ex-switch:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 3px; }
  @media (forced-colors: active) { .ex-switch[aria-checked='true'] { outline: 3px solid Highlight; outline-offset: -3px; } } /* 고대비에선 box-shadow 가 지워진다 */

  .ex-fail { display: none; position: absolute; inset: 0; margin: 0; place-content: center;
    padding: 24px; text-align: center; font-size: 14px; color: var(--br-ink-sub); }
  .ex-stage[data-fail] .ex-fail { display: grid; }
  .ex-stage[data-fail] iframe { visibility: hidden; }
  .ex-stage { position: relative; border-radius: 16px; overflow: hidden;
    background: var(--br-mist); aspect-ratio: 16 / 9; width: 100%;
  }
  .ex-stage iframe { display: block; width: 100%; height: 100%; border: 0; }

  .ex-cap { margin: 12px 0 0; color: var(--br-ink-sub); font-size: 14px; }
  .ex-cap:empty, .ex-cap--hidden { display: none; }
  .ex-note { margin: 6px 0 0; color: var(--br-ink-sub); font-size: 12.5px; }

  /* 세로로 긴 화면에서는 부품 줄이 잘리지 않게 세로 비율을 키운다 */
  @media (max-width: 860px) {
    .ex-row--split { grid-template-columns: 1fr; }
    .ex-photos { grid-auto-rows: auto; grid-template-columns: 1fr 1fr; }
    .ex-photo { padding: 10px; aspect-ratio: 4 / 3; }
  }
  @media (max-width: 760px) {
    .ex-stage { aspect-ratio: 3 / 4.4; }   /* 3/4 + 아래 부품 이름 띠 한 줄(약 44px) — 띠가 생겨도 도면 크기는 그대로(2026-10-05) */
    .ex-tabs { gap: 0; }
    .ex-tab { padding: 0 11px; font-size: 14px; } /* 390px 에서 6개가 한 줄에 든다(더 좁으면 가로로 민다) */
  }
</style>
