---
// 홈 about 블록 — "우리가 어떤 곳인지"(2026-09-30, 에어디자이너 about 참고). 문장은 옛 스토리 페이지 그대로(home.json brand).
// 모션: 스크롤로 들어오면 한 줄씩 떠오른다. 기본 상태는 보이는 채로 두고(JS 없음·모션 최소화 = 그냥 보임),
// JS 가 돌 때만 숨겼다가 올린다. 반짝임 없이 투명도·위치만.
// 협력사 로고는 파일이 들어오면(home.json brand.partners: [{name, src}]) 아래 한 줄로 흐른다. 비면 안 보인다.
interface Partner { name: string; src: string }
interface Props { lines: string[]; partners?: Partner[] }
const { lines, partners = [] } = Astro.props;
---
<section class="bd-section brandline" data-brandline>
  <div class="bd-container">
    <p class="brandline__text">
      {lines.map((l, i) => <span class="brandline__line" style={`--i:${i}`}>{l}</span>)}
    </p>
    {partners.length > 0 && (
      <ul class="brandline__partners" aria-label="함께한 곳">
        {partners.map((p) => <li><img src={p.src} alt={p.name} loading="lazy" /></li>)}
      </ul>
    )}
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-brandline]');
  if (root && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    root.classList.add('is-armed');
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { root.classList.add('is-in'); io.disconnect(); }
    }, { threshold: 0.35 });
    io.observe(root);
  }
</script>

<style>
  .brandline { background: transparent; }
  .brandline__text { display: grid; gap: 14px; max-width: 760px; }
  .brandline__line {
    display: block; color: var(--br-ink); font-weight: 700; letter-spacing: -0.02em;
    font-size: clamp(22px, 3.4vw, 36px); line-height: 1.4;
  }
  .brandline__line:last-child { color: var(--br-teal); }
  .brandline.is-armed .brandline__line { opacity: 0; transform: translateY(14px); }
  .brandline.is-armed.is-in .brandline__line {
    opacity: 1; transform: none;
    transition: opacity 700ms var(--ease-out, ease-out), transform 700ms var(--ease-out, ease-out);
    transition-delay: calc(var(--i) * 260ms);
  }
  .brandline__partners {
    margin-top: 48px; list-style: none; display: flex; flex-wrap: wrap; gap: 20px 36px; align-items: center;
  }
  .brandline__partners img { height: 28px; width: auto; opacity: 0.75; filter: grayscale(1); }
</style>
