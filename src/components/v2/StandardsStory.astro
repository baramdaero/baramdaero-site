---
// 작업 기준(약속 3항목) 섹션 — /install/ · /care/ · /situation/* 공용.
// 기준가·가격표는 /price/ 로 옮겼다(2026-09-24). 이 컴포넌트는 금액 이야기를 하지 않는다.
import type { PromiseBlock } from '../../lib/standards.ts';
import StoryRow from './StoryRow.astro';
import ImageSlot from './ImageSlot.astro';

interface Props {
  promise: PromiseBlock | null;
  slotPrefix: string;
  startSide?: 'left' | 'right';
  startTone?: 'base' | 'mist';
  /** 기준 항목마다 사진 한 장(슬롯 `${slotPrefix}-standards-01` …). 끄면 큰 사진 한 장 + 목록.
   *  /install/ 이 켠다 — 사진 한 장으로는 세 기준이 무슨 뜻인지 안 읽혔다(2026-09-23 대표 지적) */
  itemPhotos?: boolean;
}

const {
  promise,
  slotPrefix,
  startSide = 'left',
  startTone = 'base',
  itemPhotos = false,
} = Astro.props;
// 회사소개 설명 — 문자열이든 배열이든 한 칸 = 한 줄, 빈 칸은 버린다(home.ts 서비스 리드와 같은 규칙)
const lead = ([] as string[]).concat(promise?.lead ?? []).map((l) => String(l).trim()).filter(Boolean);
---
{promise && (
  <section class="v2-standards-story" aria-label={promise.heading}>
    {promise && itemPhotos && (
      <article
        class:list={['bd-section', 'v2-standards-story__message', `v2-standards-story__message--${startTone}`]}
        data-layout-section="standard"
      >
        <div class="bd-container">
          <div class="v2-standards-story__card br-glass br-glass--medium">
            {promise.eyebrow && <p class="br-sec-label">{promise.eyebrow}</p>}
            {/* 제목 줄 — 제목 오른쪽 끝에 작은 글 한 줄이 붙는 자리(홈: 실적 기준일, 2026-10-06).
                리빌은 줄 전체에 건다 — 제목에 걸면 줄 안 형제끼리만 차례가 매겨져 아래 부제·숫자의 60ms 차례가 한 칸씩 당겨진다.
                큰 제목은 이동 없이 페이드만(DESIGN.md §4)이라 --fade */}
            <div class="v2-standards-story__title br-reveal br-reveal--fade">
              <h2 class="br-h">{promise.heading}</h2>
              <slot name="title-aside" />
            </div>
            {promise.sub && <p class="v2-standards-story__sub br-reveal">{promise.sub}</p>}
            {lead.length > 0 && <p class="br-sec-lead br-reveal">{lead.map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</p>}
            {/* 제목 묶음 아래 자리(홈: 실적 숫자, 2026-10-01) */}
            <slot name="head" />
            <ol class="v2-standards-story__steps br-reveal">
              {promise.items.map((item) => (
                <li>
                  <ImageSlot id={`${slotPrefix}-standards-${item.no}`} ratio="card" />
                  <div>
                    <span>{item.no}</span>
                    <h3>{item.title}</h3>
                    {item.lines.length > 0 && (
                      <p>{item.lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
          {/* 판 아래 링크 자리(홈: 시공사례 보러가기, 2026-10-01) */}
          <slot name="after" />
        </div>
      </article>
    )}

    {promise && !itemPhotos && (
      <article
        class:list={['bd-section', 'v2-standards-story__message', `v2-standards-story__message--${startTone}`]}
        data-layout-section="standard"
      >
        <div class="bd-container">
          <StoryRow
            slotId={`${slotPrefix}-standards-scope`}
            slotLabel={`${slotPrefix}-standards-scope`}
            imageSide={startSide}
            glass
          >
            <h2 class="br-h br-reveal">{promise.heading}</h2>
            <ol class="v2-standards-story__promise br-reveal">
              {promise.items.map((item) => (
                <li>
                  <span>{item.no}</span>
                  <div>
                    <h3>{item.title}</h3>
                    {item.lines.length > 0 && (
                      <p>{item.lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </StoryRow>
        </div>
      </article>
    )}
  </section>
)}

<style>
  /* 홈 회사소개(2026-10-01) — 라벨 · 제목 · 짧은 설명(global.css .br-sec-label/.br-sec-lead) 다음에 사진 세 장 */
  /* 유리 카드 호스트 — 투명해야 앰비언트가 비친다 (tone 교차는 카드 도입 전 유산, 클래스만 유지) */
  .v2-standards-story__message--base { background: transparent; }
  .v2-standards-story__message--mist { background: transparent; }

  .v2-standards-story__promise {
    margin-top: 32px;
    list-style: none;
    display: grid;
    gap: 18px;
  }

  .v2-standards-story__promise > li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
  }

  .v2-standards-story__promise > li > span {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--br-ice);
    color: var(--br-ink-sub);
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .v2-standards-story__promise h3 { color: var(--br-ink); font-size: 17px; }

  /* 항목별 사진 — 사진 위, 번호·제목·설명 아래. 좁은 화면은 한 줄에 하나 */
  .v2-standards-story__card { padding: 24px 20px 28px; }
  .v2-standards-story__card .br-h { font-size: var(--title-fs); line-height: 1.25; text-wrap: balance; }
  /* 제목 줄 — 제목과 오른쪽 끝의 작은 글(slot title-aside)을 한 줄에. --title-fs = 제목 글자 크기(아래 맞춤 계산에도 쓴다).
     제목이 상자로 감싸져 global.css 의 '.br-sec-label + .br-h' 간격이 닿지 않으므로 같은 값(10px)을 줄에 준다 */
  .v2-standards-story__title { --title-fs: clamp(26px, 0.9rem + 1.9vw, 36px); display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .v2-standards-story__title > .br-h { min-width: 0; }
  .br-sec-label + .v2-standards-story__title { margin-top: 10px; }
  /* 작은 글은 글자 아래 끝을 제목과 맞춘다(2026-10-06 대표: '높이 딱 맞추고'). 밑선(baseline)만 맞추면 2~3px 뜬다 —
     제목 글꼴(G마켓 산스)의 한글은 밑선 아래로 글자 크기의 10.26% 내려오고 본문 글꼴은 7% 내려온다(실측). 그 차이만큼 내린다 */
  .v2-standards-story__title > :global(:not(.br-h)) { flex: none; transform: translateY(calc(var(--title-fs) * 0.1026 - 0.07em)); }
  /* 부제 — 제목(장점) 다음 회사 한 문장. 리드보다 한 단 크고 진하게 */
  .v2-standards-story__sub { margin-top: 12px; font-size: clamp(17px, 0.85rem + 0.5vw, 20px); font-weight: 600; line-height: 1.5; color: var(--br-ink); text-wrap: balance; }
  .v2-standards-story__sub + :global(.br-sec-lead) { margin-top: 8px; }
  .v2-standards-story__steps { margin-top: var(--head-gap); list-style: none; display: grid; gap: 28px; }
  .v2-standards-story__steps > li { display: grid; gap: 16px; align-content: start; }
  .v2-standards-story__steps > li :global(.br-image-slot) { --slot-radius: calc(var(--radius) - 4px); }
  .v2-standards-story__steps > li > div > span {
    font-size: 13px; font-weight: 700; letter-spacing: 0.14em; color: var(--br-ink-sub);
    font-variant-numeric: tabular-nums;
  }
  .v2-standards-story__steps h3 { margin-top: 4px; color: var(--br-ink); font-size: 19px; }
  .v2-standards-story__steps p { margin-top: 8px; font-size: 14px; line-height: 1.65; color: var(--br-ink-sub); text-wrap: balance; }
  @media (min-width: 768px) {
    .v2-standards-story__card { padding: var(--panel-pad); }
    .v2-standards-story__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  }
  .v2-standards-story__promise p { margin-top: 6px; font-size: 14px; line-height: 1.65; }
</style>
