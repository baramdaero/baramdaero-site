---
// 작업 기준(약속 3항목) 섹션 — /install/ · /care/ · /situation/* 공용.
// 기준가·가격표는 /price/ 로 옮겼다(2026-09-24). 이 컴포넌트는 금액 이야기를 하지 않는다.
import type { PromiseBlock } from '../../lib/standards.ts';
import StoryRow from './StoryRow.astro';
import ImageSlot from './ImageSlot.astro';

interface Props {
  promise: PromiseBlock | null;
  slotPrefix: string;
  startSide?: 'left' | 'right';
  startTone?: 'base' | 'mist';
  /** 기준 항목마다 사진 한 장(슬롯 `${slotPrefix}-standards-01` …). 끄면 큰 사진 한 장 + 목록.
   *  /install/ 이 켠다 — 사진 한 장으로는 세 기준이 무슨 뜻인지 안 읽혔다(2026-09-23 대표 지적) */
  itemPhotos?: boolean;
}

const {
  promise,
  slotPrefix,
  startSide = 'left',
  startTone = 'base',
  itemPhotos = false,
} = Astro.props;
---
{promise && (
  <section class="v2-standards-story" aria-label={promise.heading}>
    {promise && itemPhotos && (
      <article
        class:list={['bd-section', 'v2-standards-story__message', `v2-standards-story__message--${startTone}`]}
        data-layout-section="standard"
      >
        <div class="bd-container">
          <div class="v2-standards-story__card br-glass br-glass--medium">
            <h2 class="br-h br-reveal">{promise.heading}</h2>
            <ol class="v2-standards-story__steps br-reveal">
              {promise.items.map((item) => (
                <li>
                  <ImageSlot id={`${slotPrefix}-standards-${item.no}`} ratio="card" />
                  <div>
                    <span>{item.no}</span>
                    <h3>{item.title}</h3>
                    {item.lines.length > 0 && (
                      <p>{item.lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </article>
    )}

    {promise && !itemPhotos && (
      <article
        class:list={['bd-section', 'v2-standards-story__message', `v2-standards-story__message--${startTone}`]}
        data-layout-section="standard"
      >
        <div class="bd-container">
          <StoryRow
            slotId={`${slotPrefix}-standards-scope`}
            slotLabel={`${slotPrefix}-standards-scope`}
            imageSide={startSide}
            glass
          >
            <h2 class="br-h br-reveal">{promise.heading}</h2>
            <ol class="v2-standards-story__promise br-reveal">
              {promise.items.map((item) => (
                <li>
                  <span>{item.no}</span>
                  <div>
                    <h3>{item.title}</h3>
                    {item.lines.length > 0 && (
                      <p>{item.lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </StoryRow>
        </div>
      </article>
    )}
  </section>
)}

<style>
  /* 유리 카드 호스트 — 투명해야 앰비언트가 비친다 (tone 교차는 카드 도입 전 유산, 클래스만 유지) */
  .v2-standards-story__message--base { background: transparent; }
  .v2-standards-story__message--mist { background: transparent; }

  .v2-standards-story__promise {
    margin-top: 32px;
    list-style: none;
    display: grid;
    gap: 18px;
  }

  .v2-standards-story__promise > li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
  }

  .v2-standards-story__promise > li > span {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--br-ice);
    color: var(--br-ink-sub);
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .v2-standards-story__promise h3 { color: var(--br-ink); font-size: 17px; }

  /* 항목별 사진 — 사진 위, 번호·제목·설명 아래. 좁은 화면은 한 줄에 하나 */
  .v2-standards-story__card { padding: 24px 20px 28px; }
  .v2-standards-story__card .br-h { font-size: clamp(26px, 0.9rem + 1.9vw, 36px); line-height: 1.25; }
  .v2-standards-story__steps { margin-top: var(--head-gap); list-style: none; display: grid; gap: 28px; }
  .v2-standards-story__steps > li { display: grid; gap: 16px; align-content: start; }
  .v2-standards-story__steps > li :global(.br-image-slot) { --slot-radius: calc(var(--radius) - 4px); }
  .v2-standards-story__steps > li > div > span {
    font-size: 13px; font-weight: 700; letter-spacing: 0.14em; color: var(--br-ink-sub);
    font-variant-numeric: tabular-nums;
  }
  .v2-standards-story__steps h3 { margin-top: 4px; color: var(--br-ink); font-size: 19px; }
  .v2-standards-story__steps p { margin-top: 8px; font-size: 14px; line-height: 1.65; color: var(--br-ink-sub); }
  @media (min-width: 768px) {
    .v2-standards-story__card { padding: var(--panel-pad); }
    .v2-standards-story__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  }
  .v2-standards-story__promise p { margin-top: 6px; font-size: 14px; line-height: 1.65; }
</style>
