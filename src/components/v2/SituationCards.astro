---
// 상황별 안내 카드 — situations.json에 준비된 페이지만 노출 (없는 슬러그는 자동 미노출).
import type { Situation } from '../../lib/situations.ts';

interface Props {
  situations: Situation[];
  eyebrow?: string;
  title?: string;
}
const { situations, eyebrow = '상황별 안내', title = '지금 상황부터\n고르세요' } = Astro.props;
const titleLines = title.split('\n');
---
{situations.length > 0 && (
  <section class="bd-section v2-sit">
    <div class="bd-container">
      <span class="br-eyebrow br-reveal">{eyebrow}</span>
      <h2 class="br-h br-reveal">
        {titleLines.map((line, i) => (
          <Fragment>{i > 0 && <br />}{line}</Fragment>
        ))}
      </h2>
      <ul class="v2-sit__grid">
        {situations.map((s) => (
          <li class="br-reveal">
            <a class="v2-sit__card" href={`/situation/${s.slug}/`}>
              <h3>{s.meta.title}</h3>
              {s.meta.cardLine && <p>{s.meta.cardLine}</p>}
              <span class="v2-sit__more" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  /* base 유지 — 뒤따르는 절차 섹션(mist)과 배경이 붙지 않게 (DESIGN.md §3 교차 리듬) */
  .v2-sit { background: var(--br-base); }
  .v2-sit__grid {
    margin-top: 48px;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .v2-sit__grid { grid-template-columns: repeat(2, 1fr); }
  }

  .v2-sit__card {
    display: block;
    position: relative;
    height: 100%;
    padding: 22px 44px 22px 22px;
    background: var(--br-base);
    border: 1px solid var(--br-line);
    border-radius: var(--radius);
    transition: border-color var(--dur-color) ease;
  }
  .v2-sit__card h3 { font-size: 17px; color: var(--br-teal); }
  .v2-sit__card p { margin-top: 6px; font-size: 15px; color: var(--br-ink-sub); }
  .v2-sit__more {
    position: absolute;
    right: 20px;
    top: 22px;
    color: var(--br-teal);
    font-weight: 700;
    transition: transform var(--dur-color) ease;
  }
  @media (hover: hover) {
    .v2-sit__card:hover { border-color: var(--br-teal); }
    .v2-sit__card:hover .v2-sit__more { transform: translateX(3px); }
  }
</style>
