---
// 고객 유형 3분기 — 버튼이 챗봇 흐름을 연다 (data-chat-tree, Chatbot.astro TREE_START).
// 카드 골격·색은 기존 v2-sit 계열과 동일 값. 신규 색·장식 없음 (DESIGN.md §1·§5).
import type { HomeTriageCard } from '../../lib/home.ts';
import ImageSlot from './ImageSlot.astro';

interface Props {
  heading: string[];
  cards: HomeTriageCard[];
  tone?: 'light' | 'deep';
}
const { heading, cards, tone = 'deep' } = Astro.props;
---
{cards.length > 0 && (
  <section class:list={['bd-section', 'v2-triage', `v2-triage--${tone}`]} data-layout-section="home-triage">
    <div class="bd-container">
      <h2 class="br-h br-reveal">
        {heading.map((line, i) => (
          <Fragment>{i > 0 && <br />}{line}</Fragment>
        ))}
      </h2>
      <ul class="v2-triage__grid">
        {cards.map((c) => (
          <li class="v2-triage__cell br-reveal">
            <div class="v2-triage__card br-glass br-glass--heavy" data-glow>
              <ImageSlot
                id={`home-triage-${c.chatTree}`}
                label={`home-triage-${c.chatTree}`}
                ratio="card"
              />
              <h3>{c.title}</h3>
              {c.body.length > 0 && (
                <p>{c.body.map((line, j) => (
                  <Fragment>{j > 0 && <br />}{line}</Fragment>
                ))}</p>
              )}
              {/* 셋이 동등한 선택지라 보조 알약 — 채움(주) 버튼은 맨 아래 CTA 밴드 하나 (DESIGN.md §5) */}
              <button disabled aria-describedby="chat-unavailable" type="button" class="br-pill v2-triage__cta" data-chat-tree={c.chatTree}>
                {c.buttonLabel} <span aria-hidden="true">→</span>
              </button>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .v2-triage--light { background: transparent; } /* 앰비언트가 비치도록 */
  .v2-triage--deep { background: var(--br-teal-deep); }
  .v2-triage--deep :global(.br-h) { color: var(--br-base); }

  .v2-triage__grid {
    margin-top: var(--head-gap);
    list-style: none;
    display: grid;
    gap: 16px;
  }
  /* 모바일 세로 스택 → 데스크톱 가로 3열 */
  @media (min-width: 768px) {
    .v2-triage__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .v2-triage__cell { display: flex; }

  .v2-triage__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 16px;
    /* 배경·테두리·radius는 .br-glass--heavy 가 맡는다 — 이 섹션은 딥틸(deep) 위라 Heavy가 기본 (global.css 규칙) */
  }

  .v2-triage__card :global(.br-image-slot) { max-width: none; margin-bottom: 20px; }

  .v2-triage__card h3 {
    font-size: 17px;
    color: var(--br-ink);
  }
  .v2-triage__card p {
    margin: 8px 0 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--br-ink);
    word-break: keep-all;
  }

  .v2-triage__cta {
    margin-top: auto; /* 세 카드의 버튼을 바닥에 맞춘다 */
    align-self: flex-start;
  }
  .v2-triage__card h3 + .v2-triage__cta { margin-top: 20px; } /* 본문 없는 카드 */
</style>
