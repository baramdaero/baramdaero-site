---
// 고객 유형 3분기 — 버튼이 챗봇 흐름을 연다 (data-chat-tree, Chatbot.astro TREE_START).
// 카드 골격·색은 기존 v2-sit 계열과 동일 값. 신규 색·장식 없음 (DESIGN.md §1·§5).
import type { HomeTriageCard } from '../../lib/home.ts';
import ImageSlot from './ImageSlot.astro';

interface Props {
  heading: string[];
  cards: HomeTriageCard[];
  tone?: 'light' | 'deep';
}
const { heading, cards, tone = 'deep' } = Astro.props;
---
{cards.length > 0 && (
  <section class:list={['bd-section', 'v2-triage', `v2-triage--${tone}`]} data-layout-section="home-triage">
    <div class="bd-container">
      <h2 class="br-h br-reveal">
        {heading.map((line, i) => (
          <Fragment>{i > 0 && <br />}{line}</Fragment>
        ))}
      </h2>
      <ul class="v2-triage__grid">
        {cards.map((c) => (
          <li class="v2-triage__cell br-reveal">
            <div class="v2-triage__card br-glass br-glass--medium">
              <ImageSlot
                id={`home-triage-${c.chatTree}`}
                label={`home-triage-${c.chatTree}`}
                ratio="card"
              />
              <h3>{c.title}</h3>
              {c.body.length > 0 && (
                <p>{c.body.map((line, j) => (
                  <Fragment>{j > 0 && <br />}{line}</Fragment>
                ))}</p>
              )}
              <button type="button" class="bd-cta v2-triage__cta" data-chat-tree={c.chatTree}>
                {c.buttonLabel}
              </button>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .v2-triage--light { background: transparent; } /* 앰비언트가 비치도록 */
  .v2-triage--deep { background: var(--br-teal-deep); }
  .v2-triage--deep :global(.br-h) { color: var(--br-base); }

  .v2-triage__grid {
    margin-top: 48px;
    list-style: none;
    display: grid;
    gap: 16px;
  }
  /* 모바일 세로 스택 → 데스크톱 가로 3열 */
  @media (min-width: 768px) {
    .v2-triage__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .v2-triage__cell { display: flex; }

  .v2-triage__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 16px;
    /* 배경·테두리·radius는 .br-glass--medium 이 맡는다 (글래스 1차) */
  }

  .v2-triage__card :global(.br-image-slot) { max-width: none; margin-bottom: 20px; }

  .v2-triage__card h3 {
    font-size: 17px;
    color: var(--br-teal);
  }
  .v2-triage__card p {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--br-ink);
    word-break: keep-all;
  }

  .v2-triage__cta {
    margin-top: 20px;
    align-self: flex-start;
  }
  /* 카드 폭이 좁아지는 모바일에서는 버튼을 폭에 맞춘다 */
  @media (max-width: 767px) {
    .v2-triage__cta { align-self: stretch; text-align: center; }
  }
</style>
