---
// 모든 페이지 맨 위(헤더 위) 혜택 띠 — 혜택 슬라이드가 약 6초마다 넘어가고, 누르면 쇼핑몰 쿠폰 페이지로 간다. Base.astro 에서 한 번만 그린다.
// config 의 COUPON_PATH 가 비면 그리지 않는다(죽은 링크 금지). 슬라이드는 config 의 COUPON_SLIDES.
// 크기·간격은 아임웹 홈 맨 위 띠 실측(2026-11-25)에 맞췄다 — PC 띠 100px(카드 84·모서리 20·윗줄 16/24·굵은 줄 20/28·그림 칸 왼쪽),
// 휴대폰 82px(카드 74·모서리 8·안쪽 10/52/10/16·윗줄 12/16·굵은 줄 16/24·그림 오른쪽·점 표시). 생김새(유리·틸 토큰)는 우리 것.
// 누른 횟수는 Base.astro 의 GA 클릭 수집이 data-coupon(topbar-번호)을 보고 coupon_click 으로 센다(검사 npm run test:conv).
import { SITE_CONFIG, shopHref } from '../config.js';

// 그림 — koboyo 아이콘 고르기의 Lucide 선 아이콘(ISC)을 그대로 옮겼다. 새 그림을 그리지 않는다
const ICONS: Record<string, string> = {
  gift: '<path d="M12 7v14"/><path d="M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"/><path d="M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5"/><rect x="3" y="7" width="18" height="4" rx="1"/>',
  'ticket-percent': '<path d="M2 9a3 3 0 1 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 1 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M9 9h.01"/><path d="m15 9-6 6"/><path d="M15 15h.01"/>',
};

const href = shopHref(SITE_CONFIG.COUPON_PATH);
const slides = SITE_CONFIG.COUPON_SLIDES.map(({ label, text, amount, icon }) => {
  const [before, after = ''] = text.split('{amount}');
  return { label, before, amount: text.includes('{amount}') ? amount : '', after, icon: ICONS[icon] || '', full: text.replace('{amount}', amount) };
});
// 닫은 상태는 슬라이드 문구 전체로 기억한다 — 문구가 바뀌면 닫았던 사람에게도 다시 보인다
const key = slides.map((s) => s.full).join('|');
const many = slides.length > 1;
---
{href && slides.length > 0 && (
  <div class="bd-coupon" data-coupon-bar={key}>
    <div class="bd-coupon__card">
      {many && (
        <button type="button" class="bd-coupon__nav" data-dir="prev" aria-label="이전 혜택">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      )}
      <a class="bd-coupon__link" href={href} data-coupon="topbar-1">
        {slides.map((s, i) => (
          <span class:list={['bd-coupon__slide', { 'is-on': i === 0 }]} aria-hidden={i ? 'true' : undefined}>
            {s.icon && (
              <span class="bd-coupon__pic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
              </span>
            )}
            <span class="bd-coupon__words">
              <span class="bd-coupon__label">{s.label}</span>
              <span class="bd-coupon__text">{s.before}{s.amount && <strong class="bd-coupon__amount">{s.amount}</strong>}{s.after}</span>
            </span>
          </span>
        ))}
      </a>
      {many && (
        <button type="button" class="bd-coupon__nav" data-dir="next" aria-label="다음 혜택">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      )}
      {/* 휴대폰 점 표시 — 지금 몇 번째인지(화살표가 없는 대신). 장식이라 화면 읽기에서 뺀다 */}
      {many && (
        <span class="bd-coupon__dots" aria-hidden="true">
          {slides.map((_, i) => <i class:list={[{ 'is-on': i === 0 }]}></i>)}
        </span>
      )}
      <button type="button" class="bd-coupon__close" aria-label="쿠폰 안내 닫기">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </div>
    {/* 화면 읽기 알림 — 화살표·스와이프로 넘길 때만 채운다(자동 넘김은 알리지 않는다) */}
    <span class="visually-hidden" aria-live="polite" data-coupon-live></span>
  </div>
)}
{href && slides.length > 0 && (
  /* 바로 뒤에서 동기로 돈다 — 닫았던 사람에게 띠가 한 번 그려졌다 사라지며 화면이 밀리지 않게. 저장소가 막혀도(사생활 보호 창 등) 띠만 보이고 깨지지 않는다 */
  <script is:inline>
    (function () {
      var bar = document.currentScript.previousElementSibling;
      var KEY = 'bd_coupon_closed';
      var key = bar.getAttribute('data-coupon-bar');
      try { if (localStorage.getItem(KEY) === key) bar.hidden = true; } catch (e) {}
      bar.querySelector('.bd-coupon__close').addEventListener('click', function () {
        bar.hidden = true;
        try { localStorage.setItem(KEY, key); } catch (e) {}
        var next = document.querySelector('.bd-header a');
        if (next) next.focus(); // 누른 단추가 사라져 초점이 문서 처음으로 튀지 않게 — 바로 다음 자리(헤더 로고)로
      });

      var link = bar.querySelector('.bd-coupon__link');
      var slides = link.querySelectorAll('.bd-coupon__slide');
      var dots = bar.querySelectorAll('.bd-coupon__dots i');
      var live = bar.querySelector('[data-coupon-live]');
      var n = slides.length, cur = 0;
      if (n < 2) return;
      function show(k, dir, announce) {
        k = (k + n) % n;
        link.setAttribute('data-way', dir); // 화살표 단추의 data-dir 와 이름을 나눠 둔다
        for (var j = 0; j < n; j++) slides[j].classList.remove('is-out');
        void link.offsetWidth; // 방향을 바꾼 뒤 한 번 그려야 새 슬라이드가 그 방향에서 들어온다
        slides[cur].classList.replace('is-on', 'is-out');
        slides[cur].setAttribute('aria-hidden', 'true');
        slides[k].classList.add('is-on');
        slides[k].removeAttribute('aria-hidden');
        if (dots[cur]) dots[cur].classList.remove('is-on');
        if (dots[k]) dots[k].classList.add('is-on');
        link.setAttribute('data-coupon', 'topbar-' + (k + 1)); // GA cta_location
        if (announce) live.textContent = slides[k].textContent;
        cur = k;
      }
      bar.querySelectorAll('.bd-coupon__nav').forEach(function (b) {
        var d = b.getAttribute('data-dir');
        b.addEventListener('click', function () { show(cur + (d === 'next' ? 1 : -1), d, true); });
      });
      // 휴대폰은 화살표를 숨긴다 — 좌우로 밀어 넘긴다(세로 스크롤은 그대로)
      var x0 = null;
      link.addEventListener('pointerdown', function (e) { x0 = e.pointerType === 'mouse' ? null : e.clientX; });
      link.addEventListener('pointerup', function (e) {
        if (x0 === null) return;
        var dx = e.clientX - x0; x0 = null;
        if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1), dx < 0 ? 'next' : 'prev', true);
      });
      // 자동 넘김 — 마우스가 올라가 있거나 초점이 띠 안에 있으면 멈춘다. 모션 줄이기면 돌리지 않는다(화살표·스와이프만)
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var hover = false;
      bar.addEventListener('mouseenter', function () { hover = true; });
      bar.addEventListener('mouseleave', function () { hover = false; });
      setInterval(function () {
        if (!hover && !bar.contains(document.activeElement) && !document.hidden && !bar.hidden) show(cur + 1, 'next', false);
      }, 6000);
    })();
  </script>
)}

<style>
  /* 바깥 띠 — 카드 둘레 여백만(위 8 · 좌우 12 · 아래 8). 카드가 헤더와 다른 층으로 떠 보인다 */
  .bd-coupon {
    position: relative;
    z-index: 41; /* 헤더(40)의 메뉴 그림자 위 */
    padding: 8px 12px;
    color: var(--br-ink);
  }
  .bd-coupon[hidden] { display: none; }
  /* 카드 — 헤더와 같은 무거운 유리 + teal 12% 틴트(--tint-strong). 미지원·투명도 최소화 환경은 토큰이 불투명 base 로 바뀐다 */
  .bd-coupon__card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 84px;
    padding: 0 56px; /* 오른쪽 닫기 자리 — 왼쪽도 같이 비워 가운데 */
    border-radius: 20px;
    background: linear-gradient(var(--tint-strong), var(--tint-strong)), var(--glass-heavy-bg);
    -webkit-backdrop-filter: var(--glass-heavy-fx);
    backdrop-filter: var(--glass-heavy-fx);
    overflow: hidden;
  }
  /* 슬라이드 창 — 슬라이드는 겹쳐 두고 지금 것만 보인다. 폭을 고정해 슬라이드가 바뀌어도 화살표가 움직이지 않는다 */
  .bd-coupon__link {
    position: relative;
    flex: 0 1 460px;
    height: 100%;
    margin: 0 24px;
    color: inherit;
    text-decoration: none;
    touch-action: pan-y;
  }
  .bd-coupon__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    white-space: nowrap;
    opacity: 0;
    /* 나가는 것과 들어오는 것이 같은 시간에 겹쳐 바뀐다(크로스페이드 + 약한 세로 이동). 대표 '너무 휙휙' → 가장 느린 토큰 */
    transform: translateY(35%);
    transition: transform var(--dur-reveal) var(--ease-in-out), opacity var(--dur-reveal) var(--ease-in-out);
  }
  .bd-coupon__slide.is-on { opacity: 1; transform: none; }
  .bd-coupon__slide.is-out { transform: translateY(-35%); }
  /* 이전으로 갈 때는 반대로 — 위에서 들어오고 아래로 나간다 */
  .bd-coupon__link[data-way='prev'] .bd-coupon__slide:not(.is-on):not(.is-out) { transform: translateY(-35%); }
  .bd-coupon__link[data-way='prev'] .bd-coupon__slide.is-out { transform: translateY(35%); }
  /* 그림 칸 — 밝은 면 위 teal 선 아이콘 */
  .bd-coupon__pic {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: var(--br-base);
    color: var(--br-teal);
  }
  .bd-coupon__pic svg { width: 28px; height: 28px; }
  .bd-coupon__words { display: flex; flex-direction: column; gap: 4px; text-align: left; }
  .bd-coupon__label { font-size: 16px; font-weight: 500; line-height: 24px; color: var(--br-ink-sub); }
  .bd-coupon__text { font-size: 20px; font-weight: 700; line-height: 28px; }
  /* 금액만 teal·더 굵게 — teal 글자는 핵심 숫자 자리(DESIGN.md §1), 틴트 바탕 위 약 7:1 */
  .bd-coupon__amount { color: var(--br-teal); font-weight: 800; }
  .bd-coupon__nav,
  .bd-coupon__close {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--br-ink-sub);
    cursor: pointer;
  }
  .bd-coupon__nav { border-radius: 50%; background: var(--tint-fill); }
  .bd-coupon__close { position: absolute; top: 50%; right: 12px; transform: translateY(-50%); }
  .bd-coupon__dots { display: none; }
  .bd-coupon :focus-visible { outline-offset: -2px; } /* 색은 전역 teal 테두리 그대로 — 카드 밖으로 잘리지 않게 안쪽에 */
  @media (hover: hover) and (pointer: fine) {
    .bd-coupon__link:hover .bd-coupon__text { text-decoration: underline; text-underline-offset: 4px; }
    .bd-coupon__nav:hover { background: var(--tint-strong); color: var(--br-ink); }
    .bd-coupon__close:hover { color: var(--br-ink); }
  }
  /* 휴대폰 — 아임웹 휴대폰 띠와 같은 치수. 화살표 대신 스와이프·점 표시, 그림은 오른쪽 */
  @media (max-width: 560px) {
    .bd-coupon { padding: 8px 8px 0; }
    .bd-coupon__card { height: 74px; padding: 10px 52px 10px 16px; border-radius: 8px; justify-content: flex-start; }
    .bd-coupon__nav { display: none; }
    .bd-coupon__link { flex: 1 1 auto; margin: 0; }
    .bd-coupon__slide { flex-direction: row-reverse; justify-content: space-between; align-items: flex-start; gap: 8px; }
    .bd-coupon__pic { width: 54px; height: 54px; border-radius: 12px; }
    .bd-coupon__pic svg { width: 26px; height: 26px; }
    .bd-coupon__words { gap: 0; }
    .bd-coupon__label { font-size: 12px; line-height: 16px; }
    .bd-coupon__text { font-size: 15.5px; line-height: 24px; }
    .bd-coupon__dots { position: absolute; left: 16px; bottom: 10px; display: flex; gap: 4px; }
    .bd-coupon__dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--br-line); transition: background-color var(--dur-reveal) var(--ease-in-out); }
    .bd-coupon__dots i.is-on { background: var(--br-ink-sub); }
    .bd-coupon__close { top: 2px; right: 2px; transform: none; }
  }
  /* 좁은 휴대폰(374px 이하)은 그림 칸을 빼고 글에 자리를 준다 */
  @media (max-width: 374px) {
    .bd-coupon__pic { display: none; }
    .bd-coupon__card { padding-right: 48px; }
  }
  /* 헤더는 sticky(solid) 라 띠를 지나 내리면 맨 위에 붙는다. 오버레이 헤더(fixed)는 띠를 덮으니 다시 쓰게 되면 그때 맞춘다 */
</style>
