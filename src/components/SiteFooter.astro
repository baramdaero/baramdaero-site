---
// 푸터 v2 — teal-deep. 구 버전은 src/legacy/SiteFooter-v1.astro.txt 보존.
// 배경이 다크라 로고는 reverse 고정 (톤 전환 없음).
import { SITE_CONFIG } from '../config.js';
import { getCollection } from 'astro:content';
const realCases = (await getCollection('cases')).filter((e) => !e.data.sample).length;
import wideReverseUrl from '../assets/logo/baramdaero-wide-reverse.svg?url';
const year = new Date().getFullYear();
---
<footer class="bd-footer">
  <div class="bd-container bd-footer__inner">
    <div class="bd-footer__brand">
      <img class="bd-footer__logo" src={wideReverseUrl} alt="바람대로" width="1472" height="341" />
      <p class="bd-footer__slogan">{SITE_CONFIG.SLOGAN}</p>
    </div>
    <nav class="bd-footer__nav" aria-label="푸터 메뉴">
      <a href="/install/">설치</a>
      <a href="/care/">세척</a>
      <a href="/commercial/">상업용</a>
      {realCases >= 3 && <a href="/cases/">시공사례</a>}
      <a href="/price/">가격</a>
      <a href="/faq/">자주 묻는 질문</a>
      <a href="/blog/">블로그</a>
      {/* SHOP_URL이 비면 미렌더 — 죽은 링크 차단 (헤더와 동일 규칙) */}
      {SITE_CONFIG.SHOP_URL && <a href={SITE_CONFIG.SHOP_URL} rel="noopener">예약·구매</a>}
    </nav>
    <p class="bd-footer__cta">
      <button disabled aria-describedby="chat-unavailable" type="button" class="bd-footer__ask" data-chat-tree="menu">문의하기</button>
    </p>
    <hr class="bd-footer__hairline" />
    <p class="bd-footer__legal">
      <!-- 사업자 정보 확정 후 기입: 상호·대표·사업자등록번호·주소·연락처 -->
      © {year} 바람대로
    </p>
  </div>
</footer>

<style>
  .bd-footer {
    background: var(--br-teal-deep);
    color: rgba(255, 255, 255, 0.75);
    padding: 56px 0 40px;
    margin-top: 0;
  }
  .bd-footer__inner { display: grid; gap: 24px; }
  /* 36px — 28px면 워드마크가 11.3px로 14px 하한을 깬다 (락업 높이 x 0.405) */
  .bd-footer__logo { height: 36px; width: auto; }
  .bd-footer__slogan { color: rgba(255, 255, 255, 0.75); font-size: 14px; font-weight: 600; margin-top: 4px; }
  .bd-footer__nav {
    display: flex;
    flex-wrap: wrap;
    /* 줄 간격 0 — 링크가 이미 위아래 8px(터치 높이)라, 넘친 항목이 따로 떨어져 보이지 않게 */
    gap: 0 clamp(12px, 3.2vw, 18px);
    font-size: 14px;
  }
  .bd-footer__nav a { padding: 8px 0; transition: color var(--dur-color) ease; }
  /* 연락처(PHONE·KAKAO)는 확정 전까지 빈 값이라(AGENTS.md 절대 규칙 2) 푸터에 연락 수단이 없었다.
     접수 진입점은 챗봇 단일이므로(DESIGN.md §6) 같은 챗봇을 부르는 버튼 하나를 둔다 */
  .bd-footer__cta { margin-top: 20px; }
  .bd-footer__ask {
    display: inline-flex; align-items: center; min-height: 44px;
    padding: 0 20px; border-radius: 999px;
    background: var(--br-ice); color: var(--br-teal);
    font: inherit; font-size: 15px; font-weight: 700; cursor: pointer; border: 0;
    transition: background-color var(--dur-color) ease;
  }
  @media (hover: hover) { .bd-footer__ask:hover { background: #fff; } }
  .bd-footer__ask:active { transform: scale(0.96); }
  .bd-footer__nav a:hover { color: var(--br-ice); }
  .bd-footer__nav--sub { font-size: 13px; align-items: center; }
  .bd-footer__navlabel { color: rgba(255, 255, 255, 0.5); }
  .bd-footer__hairline { border: 0; border-top: 1px solid rgba(255, 255, 255, 0.15); }
  .bd-footer__legal { font-size: 12px; color: rgba(255, 255, 255, 0.5); }
</style>
