---
// 푸터 v2 — teal-deep. 구 버전은 src/legacy/SiteFooter-v1.astro.txt 보존.
// 배경이 다크라 로고는 reverse 고정 (톤 전환 없음).
import { SITE_CONFIG, shopHref } from '../config.js';
import { getCollection } from 'astro:content';
const realCases = (await getCollection('cases')).filter((e) => !e.data.sample).length;
// 블로그 링크는 공개 글이 3편 이상일 때만 — 글 1편짜리 목록이 '준비 중'으로 보이지 않게 (2026-10-13)
const realPosts = (await getCollection('blog')).filter((e) => !e.data.sample).length;
import wideReverseUrl from '../assets/logo/baramdaero-wide-reverse.svg?url';
const year = new Date().getFullYear();
const loginHref = shopHref(SITE_CONFIG.SHOP_LOGIN_PATH);
const biz = SITE_CONFIG.BUSINESS;
---
<footer class="bd-footer">
  <div class="bd-container bd-footer__inner">
    <div class="bd-footer__brand">
      <img class="bd-footer__logo" src={wideReverseUrl} alt="바람대로" width="555" height="85" />
      <p class="bd-footer__slogan">{SITE_CONFIG.SLOGAN}</p>
    </div>
    <nav class="bd-footer__nav" aria-label="푸터 메뉴">
      <a href="/install/">설치</a>
      <a href="/care/">세척</a>
      <a href="/commercial/">상업용</a>
      {realCases >= 3 && <a href="/cases/">시공사례</a>}
      {/* 쇼핑몰 주소가 있으면 '가격'은 쇼핑몰로, 비면 자주 묻는 질문의 '비용' 묶음으로 — 헤더 메뉴와 같은 규칙 */}
      <a href={SITE_CONFIG.SHOP_URL || '/faq/#cat-비용'} rel={SITE_CONFIG.SHOP_URL ? 'noopener' : undefined}>{SITE_CONFIG.SHOP_URL ? '예약·구매' : '가격'}</a>
      <a href="/faq/">자주 묻는 질문</a>
      {realPosts >= 3 && <a href="/blog/">블로그</a>}
      {/* 쇼핑몰 주소나 경로가 비면 미렌더 — 죽은 링크 차단 */}
      {loginHref && <a href={loginHref} rel="noopener">로그인</a>}
    </nav>
    <p class="bd-footer__cta">
      <button disabled aria-describedby="chat-unavailable" type="button" class="bd-cta bd-cta--ondark bd-footer__ask" data-chat-tree="menu">문의하기<svg class="br-cta-arrow" aria-hidden="true" viewBox="0 0 10 10" width="10" height="10" fill="none"><path d="M0 5h7" /><path d="M1 1l4 4-4 4" /></svg></button>
    </p>
    <hr class="bd-footer__hairline" />
    <p class="bd-footer__legal">
      <span>{biz.NAME}</span>&nbsp;· <span>대표 {biz.REPRESENTATIVE}</span>&nbsp;· <span>사업자등록번호 {biz.REG_NO}</span><br />
      {biz.ADDRESS}{SITE_CONFIG.PHONE && <>&nbsp;· <span>전화 {SITE_CONFIG.PHONE}</span></>}<br />
      © {year} 바람대로<br />
      <a class="bd-footer__policy" href="/privacy/">개인정보 처리방침</a>
    </p>
  </div>
</footer>

<style>
  .bd-footer {
    background: var(--br-teal-deep);
    color: rgba(255, 255, 255, 0.75);
    padding: 56px 0 40px;
    margin-top: 0;
  }
  .bd-footer__inner { display: grid; gap: 24px; }
  /* 36px — 락업 높이. 워드마크 글자 높이는 그 0.88배(약 31px) */
  .bd-footer__logo { height: 36px; width: auto; }
  .bd-footer__slogan { color: rgba(255, 255, 255, 0.75); font-size: 14px; font-weight: 600; margin-top: 4px; }
  .bd-footer__nav {
    display: flex;
    flex-wrap: wrap;
    /* 줄 간격 0 — 링크가 이미 위아래 8px(터치 높이)라, 넘친 항목이 따로 떨어져 보이지 않게 */
    gap: 0 clamp(12px, 3.2vw, 18px);
    font-size: 14px;
  }
  .bd-footer__nav a { padding: 8px 0; transition: color var(--dur-color) ease; }
  /* 연락처(PHONE·KAKAO)는 확정 전까지 빈 값이라(AGENTS.md 절대 규칙 2) 푸터에 연락 수단이 없었다.
     접수 진입점은 챗봇 단일이므로(DESIGN.md §6) 같은 챗봇을 부르는 버튼 하나를 둔다 */
  .bd-footer__cta { margin-top: 20px; }
  /* 색·모양·떠오름은 문의 버튼(.bd-cta--ondark) — 여기서는 작은 크기만 */
  .bd-footer__ask { min-height: 44px; padding: 0 18px; font-size: 15px; cursor: pointer; }
  .bd-footer__nav a:hover { color: var(--br-ice); }
  .bd-footer__nav--sub { font-size: 13px; align-items: center; }
  .bd-footer__navlabel { color: rgba(255, 255, 255, 0.5); }
  .bd-footer__hairline { border: 0; border-top: 1px solid rgba(255, 255, 255, 0.15); }
  /* 사업자 정보는 읽혀야 하므로 보조 글자색 흰 75%(DESIGN.md §1). 항목 단위로만 줄을 바꾼다 */
  .bd-footer__legal { font-size: 12px; line-height: 1.7; color: rgba(255, 255, 255, 0.75); }
  .bd-footer__legal span { white-space: nowrap; }
  /* 개인정보 처리방침 링크는 다른 고지와 구분되게 흰색 700 (개인정보 보호법 표준 지침). 터치 높이 44 */
  .bd-footer__policy {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--dur-color) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .bd-footer__policy:hover { color: var(--br-ice); }
  }
</style>
