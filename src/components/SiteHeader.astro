---
// 전역 헤더. overlay = 홈 히어로 위 투명 고정 / solid = 서브페이지 상단.
// 로고 톤은 상태 클래스(.bd-header--overlay / .is-ready / .is-scrolled)에만 물린다 — 스크롤 리스너 추가 없음.
// 오버레이의 기본값은 솔리드다. 투명(백색 텍스트)은 하단 스크립트가 .is-ready를 붙인 뒤에만 켜진다 (no-JS/초기화 실패 안전).
// 락업은 인라인 SVG 한 벌(2026-10-05): 색은 CSS 변수로, 협소 폭(≤389px)은 워드마크를 숨겨 마크만 남긴다.
// 인라인인 이유는 꼬불 모션 — <img> 안의 SVG 는 밖에서 움직일 수 없다.
// 390px+는 락업 전체(마크 + 워드마크). 높이(24 / 26.667px)는 08-24 에 "커 보인다"는 판단으로 줄인 값을 그대로 쓴다
// (그때 지시는 "락업 유지, 크기만 축소").
// 메뉴는 800px 이하에서 '메뉴' 버튼으로 접는다(2026-10-06): 새 락업이 넓어(115→174px) 한 줄 메뉴 + 견적 문의가
// 795px 미만에서 화면 밖으로 넘쳤다(641~794px 실측. 그 전에도 641~735px 는 넘치고 있었다).
import { SITE_CONFIG } from '../config.js';
import { getCollection } from 'astro:content';
import lockupSvg from '../assets/logo/baramdaero-lockup-anim.svg?raw';

interface Props {
  variant?: 'overlay' | 'solid';
}
const { variant = 'solid' } = Astro.props;

// IA v3 — 세척/설치 2트랙 분리. 브랜드이야기는 푸터로 이동.
// label = 640px 이하 축약형(협소 폭에서 가로형 로고 자리를 벌기 위해).
// full  = 641px+ 전체 명칭. 데스크톱은 폭이 충분해 줄여 쓸 이유가 없다.
// name  = 보조기기용 접근성 이름 — 폭과 무관하게 전 구간 동일하다.
// name을 생략하면 label이 그대로 접근성 이름이 된다 (설치처럼 축약이 없는 항목).
// FAQ만 full("자주 묻는 질문")과 name("자주 묻는 질문(FAQ)")이 다르다 — 음성 제어가
// 좁은 폭에서 화면에 보이는 "FAQ"로도 잡혀야 하기 때문 (WCAG 2.5.3 Label in Name).
// 두 라벨은 CSS display로만 전환한다: 숨은 쪽은 접근성 트리에서도 빠져 중복 낭독이 없고,
// 링크에 aria-label이 있어 낭독은 어차피 name 한 번뿐이다.
const realCases = (await getCollection('cases')).filter((e) => !e.data.sample).length;
const nav = [
  // 2026-09-30 구조: 설치 · 세척 · 상업용 · 가격 · FAQ. 시공사례는 실사례가 들어올 때까지 메뉴에서 뺀다
  { href: '/install/', label: '설치', full: '설치' },
  { href: '/care/', label: '세척', full: '세척' },
  { href: '/commercial/', label: '상업용', full: '상업용' },
  // 시공사례 — 실제(sample 아닌) 사례 3건부터 메뉴에 나타난다(홈 '말보다 현장으로.'와 같은 기준)
  ...(realCases >= 3 ? [{ href: '/cases/', label: '사례', full: '시공사례', name: '시공사례' }] : []),
  // wide: JS 가 안 도는 모바일(한 줄 메뉴 폴백)에서만 숨는다 — 6칸이면 390px 에서 54px 넘친다(2026-09-24 실측).
  // JS 가 돌면 640px 이하는 '메뉴' 버튼 펼침 목록이라 가격도 들어간다
  { href: '/price/', label: '가격', full: '가격', wide: true },
  { href: '/faq/', label: 'FAQ', full: '자주 묻는 질문', name: '자주 묻는 질문(FAQ)' },
];
const path = Astro.url.pathname;

/** 현재 페이지 판정. href가 '/'이면 startsWith가 모든 경로에 참이 되어 항상 현재로 표시된다
 *  — 정확 일치로 분기해 둔다. 지금 메뉴엔 '/'가 없지만 홈 항목이 추가되면 바로 걸리는 자리다.
 *  로고(`<a href="/">`)에는 aria-current를 주지 않는다 — 한 페이지에 두 개면 보조기기가
 *  현재 위치를 두 번 읽는다. */
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class:list={['bd-header', `bd-header--${variant}`]}>
  <div class="bd-header__inner">
    <a href="/" class="bd-header__brand" aria-label="바람대로 홈">
      {/* SVG 는 aria-hidden — 링크의 aria-label이 이름을 이미 읽는다 (중복 읽기 방지) */}
      <span class="bd-header__logo" set:html={lockupSvg} />
    </a>
    {/* 주 메뉴 랜드마크는 늘 남는다 — 640px 이하 + JS 에서는 안의 '메뉴' 버튼이 링크 묶음(#site-nav)을 펼침 목록으로 연다.
        버튼은 글자('메뉴'↔'닫기'): 아이콘은 koboyo 에서만 가져오는데 이 레포 세션에 연결이 없다. hidden 은 스크립트가 푼다 */}
    <nav class="bd-header__nav" aria-label="주 메뉴">
      <button type="button" class="bd-header__menu-btn" aria-expanded="false" aria-controls="site-nav" hidden>
        <span class="bd-header__menu-open">메뉴</span><span class="bd-header__menu-close">닫기</span>
      </button>
      <div class="bd-header__links" id="site-nav">
        {nav.map((item, i) => (
          <a
            href={item.href}
            style={`--i:${i}`}
            class:list={['bd-header__link', item.wide && 'bd-header__link--wide']}
            aria-label={item.name}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          ><span class="bd-header__label bd-header__label--short">{item.label}</span
          ><span class="bd-header__label bd-header__label--full">{item.full}</span></a>
        ))}
      </div>
    </nav>
    {/* 우측 액션 슬롯 — 대표번호·CTA가 들어올 자리.
        SHOP_URL이 비면 슬롯째 미렌더한다: 빈 요소를 남기면 inner의 gap이 그대로 붙어
        메뉴가 이유 없이 왼쪽으로 밀린다. 슬롯이 생기면 메뉴는 gap만큼 밀릴 뿐이고,
        폭은 flex가 알아서 나눈다 (고정값 재조정 불요). */}
    {/* 견적 문의 — 모든 페이지 오른쪽 위에 고정(2026-09-30 대표: "시공문의·견적문의로 잘 유도되게").
        채팅창 첫 메뉴(설치 견적·세척 견적·A/S)를 연다 → 채널톡 상담. 채팅 스크립트가 켜기 전까지는 비활성 */}
    <div class="bd-header__actions">
      <button type="button" class="bd-header__quote" data-chat-tree="menu" disabled aria-describedby="chat-unavailable">견적 문의</button>
      {SITE_CONFIG.SHOP_URL && <a href={SITE_CONFIG.SHOP_URL} class="bd-header__cta" rel="noopener">예약·구매</a>}
    </div>
  </div>
</header>

<style>
  .bd-header {
    width: 100%;
    z-index: 40;
  }
  /* 오버레이 기본값 = 솔리드(안전 상태). JS 초기화 전·실패 시에도 흰 바탕 위 백색 텍스트가 생기지 않는다. */
  .bd-header--overlay {
    position: fixed;
    top: 0;
    left: 0;
    background: var(--glass-heavy-bg);
    -webkit-backdrop-filter: var(--glass-heavy-fx);
    backdrop-filter: var(--glass-heavy-fx);
    border-bottom: 1px solid var(--glass-line);
    color: var(--br-ink);
    transition: background-color var(--dur-color) ease, color var(--dur-color) ease;
  }
  /* JS 초기화 완료(.is-ready) + 히어로 구간(:not(.is-scrolled))에서만 투명 오버레이.
     히어로를 지나면 .is-scrolled가 붙어 위 기본 솔리드로 복귀한다. */
  .bd-header--overlay.is-ready:not(.is-scrolled):not(.is-menu-open) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
    color: #fff;
  }
  .bd-header--solid {
    position: sticky;
    top: 0;
    background: var(--glass-heavy-bg);
    -webkit-backdrop-filter: var(--glass-heavy-fx);
    backdrop-filter: var(--glass-heavy-fx);
    border-bottom: 1px solid var(--glass-line);
    color: var(--ink);
  }
  /* 로고와 메뉴 사이의 남는 폭은 auto로 배분한다. 메뉴가 늘어도 화면 밖으로 밀지 않는다. */
  .bd-header__inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  /* flex 축소 금지 — 축소는 flex '아이템'에서 일어난다. svg 에만 걸면 부모(span·brand)가
     대신 눌려 로고 비율이 깨진다 (옛 img 락업으로 360px에서 155→123px 실측). 사슬 전체에 건다.
     min-height 44px = 로고 링크의 누르는 높이(로고 자체는 24~32px) */
  .bd-header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-height: 44px;
  }
  /* 우측 액션 슬롯 — 내용이 생겨도 줄어들지 않는다 */
  .bd-header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  /* 767px 이하에서는 슬롯을 접는다. 폭 예산이 물리적으로 부족하기 때문이다 —
     더미(대표번호+버튼 177px)로 실측하면 390px에서 177px, 641px에서 16px 넘쳤다
     (641px 필요폭 633 = 로고 115 + gap 28 + 메뉴 285 + gap 28 + 슬롯 177 > 가용 593).
     겹침이 아니라 자리 부족이라 간격 조정으로는 못 푼다.
     ⚠️ 슬롯에 실제 내용이 들어갈 때 이 구간 정책(축약 CTA만 노출 / 햄버거 등)을
     다시 정할 것 — 지금은 SHOP_URL이 비어 슬롯 자체가 미렌더라 영향이 없다. */
  @media (max-width: 767px) {
    .bd-header__actions { display: none; }
  }

  /* 로고 — 높이 고정·width auto (비율 무변경). 톤 전환은 기존 상태 클래스만 사용.
     08-24 축소: 기존 36/40px의 2/3 — "커 보인다"는 실물 판단을 워드마크 14px
     하한보다 우선했다(의도적으로 하한 이하로 내려간다). */
  /* 라이트 구간(서브페이지 솔리드 · 오버레이 스크롤 후) = ink 글자 + teal 포인트 */
  .bd-header__logo { display: block; flex-shrink: 0; color: var(--br-ink); --logo-accent: var(--br-teal); }
  .bd-header__logo :global(svg) {
    display: block;
    height: 24px;
    width: auto;
    aspect-ratio: 555 / 85; /* 기울인 바람 락업 비율 */
    flex-shrink: 0;
    overflow: visible; /* 꼬불할 때 선이 상자 밖으로 1px 쯤 나간다 */
  }
  /* 다크 구간(JS 초기화 후 히어로 위 투명 오버레이) = 흰 글자 + ice 포인트 */
  .bd-header--overlay.is-ready:not(.is-scrolled):not(.is-menu-open) .bd-header__logo { color: #fff; --logo-accent: var(--br-ice); }
  .bd-header__nav { display: flex; align-items: center; }
  .bd-header__links {
    display: flex;
    gap: 22px;
  }
  .bd-header__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    opacity: 0.85;
    transition: opacity var(--dur-color) ease;
    /* 44px 히트영역 확보 */
    padding: 12px 2px;
  }
  .bd-header__link:hover,
  .bd-header__link[aria-current='page'] { opacity: 1; }
  /* 라벨 전환 — display:none은 접근성 트리에서도 제외되므로 한 링크가 두 번 읽히지 않는다 */
  .bd-header__label--full { display: none; }
  .bd-header__cta {
    font-size: 14px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 6px;
    background: var(--copper);
    color: #fff;
    transition: background-color var(--dur-color) ease, transform var(--dur-spring) var(--ease-spring);
  }
  .bd-header__cta:hover { background: var(--copper-deep); }
  .bd-header__actions { display: flex; align-items: center; gap: 8px; margin-left: 12px; flex: none; }
  .bd-header__quote {
    min-height: 40px; padding: 0 16px; border: 0; border-radius: 10px; /* 문의 버튼 사각(2026-10-02) — 40px 높이라 한 단 작게 */
    background: var(--br-teal-deep); color: #fff; font: inherit; font-size: 14px; font-weight: 700; cursor: pointer;
    transition: background-color var(--dur-color) ease, transform var(--dur-spring) var(--ease-spring);
  }
  @media (hover: hover) and (pointer: fine) { .bd-header__quote:hover:not(:disabled) { background: var(--br-teal); } }
  /* 높이 40px(헤더 줄) — 누르는 자리는 위아래 2px 씩 넓혀 44px */
  .bd-header__quote { position: relative; }
  .bd-header__quote::before { content: ''; position: absolute; inset: -2px 0; }
  /* 누르면 빠르게 눌리고, 떼면 스프링으로 돌아온다(위 transition) */
  .bd-header__quote:active { transform: scale(0.96); transition-duration: var(--dur-color), calc(var(--dur-color) / 2); transition-timing-function: ease, ease-out; }
  .bd-header__quote:focus-visible { outline: 2px solid var(--br-teal); outline-offset: 2px; }
  .bd-header__cta:active { transform: scale(0.96); transition-duration: var(--dur-color), calc(var(--dur-color) / 2); transition-timing-function: ease, ease-out; }

  .bd-header__link,
  .bd-header__cta,
  .bd-header__brand { white-space: nowrap; }

  /* 상업용 메뉴 추가 후 390px에서 고정 여백이 넘쳐, 모바일도 남는 폭만 배분한다. */
  @media (max-width: 640px) {
    .bd-header__brand { margin-right: auto; }
  }

  /* 데스크톱 헤더(64px)는 여유가 있어 40px의 2/3 = 26.667px */
  @media (min-width: 641px) {
    .bd-header__logo :global(svg) { height: 26.667px; }

    /* 641px+는 폭이 충분하므로 전체 명칭 — 축약은 좁은 폭에서 로고 자리를 벌려던 것이다 */
    .bd-header__label--short { display: none; }
    .bd-header__label--full { display: inline; }

    /* 메뉴를 우측 슬롯 앞에 붙인다. 고정 margin(구 200px → 150px)은 제거했다 —
       폭이나 우측 요소가 바뀔 때마다 값을 다시 잡아야 했고, 오버플로를 막으려
       150px로 줄이자 메뉴가 가운데로 뭉치고 오른쪽이 비었다(08-24).
       auto는 남는 폭을 전부 왼쪽에 몰아주므로 로고↔메뉴 간격은 화면이 넓어질수록
       늘고, 메뉴 우측 끝은 컨테이너에 고정된다. */
    .bd-header__nav { margin-left: auto; }
  }

  /* 가로형이 안 들어가는 폭 — 마크 단독 강등. 워드마크를 숨기고 상자를 마크 폭으로 줄인다
     (SVG 가 xMinYMid slice 라 높이에 맞춰 왼쪽부터 그린다. 125 = 락업 안 마크 폭) */
  @media (max-width: 389px) {
    .bd-header__logo :global(svg) { height: 32px; aspect-ratio: 125 / 85; }
    .bd-header__logo :global(.bd-logo-word) { display: none; }
  }

  /* ---- 모바일 메뉴(640px 이하 + JS: .has-menu) — 한 줄 메뉴를 접고 '메뉴' 버튼으로 편다 ---- */
  .bd-header__menu-btn {
    display: none;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    background: var(--tint-fill);
    color: var(--br-ink);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    transition: background-color var(--dur-color) ease, transform var(--dur-spring) var(--ease-spring);
  }
  .bd-header__menu-btn:active { transform: scale(0.96); transition-duration: var(--dur-color), calc(var(--dur-color) / 2); transition-timing-function: ease, ease-out; }
  .bd-header__menu-close,
  .bd-header.is-menu-open .bd-header__menu-open { display: none; }
  .bd-header.is-menu-open .bd-header__menu-close { display: inline; }
  .bd-header--overlay.is-ready:not(.is-scrolled):not(.is-menu-open) .bd-header__menu-btn { color: #fff; background: rgba(255, 255, 255, 0.14); }
  /* ⚠️ 이 800 은 아래 스크립트의 matchMedia 와 같은 값이어야 한다 */
  @media (max-width: 800px) {
    .bd-header.has-menu .bd-header__menu-btn { display: inline-flex; }
    /* 펼침 목록 — 헤더 바로 아래 전체 폭. 글자는 전체 명칭, 한 줄 52px.
       닫힌 상태도 같은 모양을 갖는다(여닫는 동안 그 모양에서 오간다) — 평소에 보이고 안 보이고는 display 로 가른다 */
    .bd-header.has-menu .bd-header__links {
      display: none;
      flex-direction: column;
      gap: 0;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 4px 20px 16px;
      background: var(--br-base);
      border-bottom: 1px solid var(--glass-line);
      /* 위로 4px 덧단 — 열리며 아래로 넘는 동안(최대 4.5px) 헤더와 목록 사이로 뒤 페이지가 비치지 않게 */
      box-shadow: 0 -4px 0 var(--br-base), var(--glass-shadow);
      /* 화면 높이가 낮으면(가로 모드·확대) 목록 안에서 스크롤 — sticky 헤더에 붙어 페이지 스크롤로는 못 내린다 */
      max-height: calc(100dvh - 56px);
      overflow-y: auto;
      overscroll-behavior: contain;
      opacity: 0;
      transform: translateY(-24px) scaleY(0.94);
      transform-origin: top center;
    }
    /* 여닫는 모션은 사람이 누른 직후에만 건다 — 아래 스크립트가 .is-menu-anim 을 붙였다 뗀다.
       페이지를 열 때, 창 폭이 800px 을 넘나들 때, 뒤로 가기로 되살아날 때는 이 클래스가 없어 그냥 바뀐다
       (늘 걸어 두면 한 줄 메뉴가 접히는 순간 목록이 잠깐 비쳤다 사라진다).
       붙어 있는 동안에는 닫힌 모양으로도 그려 둔다 — 거기서 출발하고 거기로 돌아가야 해서.
       닫힘 = 여는 스프링의 짝: 아래로 살짝 부풀었다가 위로 빠지며 걷힌다(2026-10-06 대표: '닫을 때도 통통'). 투명도는 부푼 뒤에 걷힌다 */
    .bd-header.has-menu.is-menu-anim .bd-header__links {
      display: flex;
      pointer-events: none;
      transition: transform var(--dur-spring-out) var(--ease-spring-out), opacity calc(var(--dur-spring-out) * 0.55) ease-in calc(var(--dur-spring-out) * 0.45);
    }
    /* 열림 — 헤더 밑에서 내려오며 통 하고 넘었다 멎는다(2026-10-06 대표: '딱 열리지 않고 뚜~웅').
       스프링은 transform 에만, 투명도는 따로(DESIGN.md §4).
       열림도 닫힘도 transition 이라, 도중에 다시 누르면 그 자리에서 되돌아간다 */
    .bd-header.has-menu.is-menu-open .bd-header__links {
      display: flex;
      pointer-events: auto;
      opacity: 1;
      transform: none;
    }
    .bd-header.has-menu.is-menu-anim.is-menu-open .bd-header__links {
      transition: transform var(--dur-spring) var(--ease-spring), opacity var(--dur-ui) ease;
    }
    /* 항목 — 닫힌 동안은 12px 위·투명, 열리면 위에서부터 차례로 내려온다(--i = 순서, 30ms 간격).
       닫힐 때는 목록이 다 걷힌 뒤에야 그 자리로 돌아간다 — 걷히는 도중에 다시 열어도 항목은 깜빡이지 않는다 */
    .bd-header.has-menu:not(.is-menu-open) .bd-header__link { opacity: 0; transform: translateY(-12px); }
    .bd-header.has-menu.is-menu-anim .bd-header__link {
      transition: opacity 0s linear var(--dur-spring-out), transform 0s linear var(--dur-spring-out);
    }
    .bd-header.has-menu.is-menu-anim.is-menu-open .bd-header__link {
      transition: opacity var(--dur-ui) ease calc(40ms + var(--i, 0) * 30ms), transform var(--dur-spring) var(--ease-spring) calc(40ms + var(--i, 0) * 30ms);
    }
    .bd-header.has-menu .bd-header__link {
      justify-content: flex-start;
      min-height: 52px;
      padding: 0 4px;
      font-size: 17px;
      font-weight: 600;
      color: var(--br-ink);
      opacity: 1;
      border-bottom: 1px solid color-mix(in srgb, var(--br-ink) 8%, transparent);
    }
    .bd-header.has-menu .bd-header__link:last-child { border-bottom: 0; }
    .bd-header.has-menu .bd-header__link[aria-current='page'] { color: var(--br-teal); }
    .bd-header.has-menu .bd-header__label--short { display: none; }
    .bd-header.has-menu .bd-header__label--full { display: inline; }
    /* 투명 오버레이 위에서 열면 헤더도 솔리드로 — 흰 글자 버튼이 밝은 목록 위에 뜨지 않게 */
    .bd-header--overlay.is-menu-open { background: var(--br-base); color: var(--br-ink); }
  }

  @media (max-width: 640px) {
    .bd-header:not(.has-menu) .bd-header__link--wide { display: none; }
    /* 기존 로고 크기와 헤더 높이를 유지한다. */
    .bd-header__inner { gap: 10px; padding: 0 8px; height: 56px; }
    .bd-header__links { gap: 10px; }
    .bd-header__link { font-size: 12px; padding: 12px 0; }
    .bd-header__cta { padding: 8px 11px; font-size: 12px; }
  }
</style>

<script>
  // 모바일 메뉴 — 버튼이 nav 를 펼친다. JS 가 안 돌면 버튼은 hidden 그대로, 한 줄 메뉴가 남는다
  const header = document.querySelector<HTMLElement>('.bd-header');
  const menuBtn = header?.querySelector<HTMLButtonElement>('.bd-header__menu-btn');
  if (header && menuBtn) {
    const narrow = window.matchMedia('(max-width: 800px)');
    const links = header.querySelector<HTMLElement>('.bd-header__links');
    // 여닫는 모션은 사람이 누른 직후에만 건다(.is-menu-anim — 위 CSS 주석). 닫힘이 끝나면 떼서 목록의 display 를 끈다
    let animTimer: ReturnType<typeof setTimeout>;
    const settle = () => {
      clearTimeout(animTimer);
      if (links) links.inert = false;
      if (!header.classList.contains('is-menu-open')) header.classList.remove('is-menu-anim');
    };
    // animate=false 는 모션 없이 바로 닫는다(창이 넓어질 때, 뒤로 가기로 되살아날 때)
    const setOpen = (open: boolean, returnFocus = false, animate = true) => {
      const changed = open !== header.classList.contains('is-menu-open');
      if (animate && changed) {
        header.classList.add('is-menu-anim');
        void links?.offsetHeight; // 닫힌 모양을 한 번 그려 둬야 거기서부터 움직인다
      }
      header.classList.toggle('is-menu-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      if (!animate || open) settle();
      else if (changed) {
        if (links) links.inert = true; // 걷히는 동안 링크에 초점이 가지 않게
        clearTimeout(animTimer);
        animTimer = setTimeout(settle, 1000); // 끝 이벤트가 안 오는 경우(가려진 탭 등)의 마무리 — 시작이 늦어도 자르지 않게 넉넉히
      }
      if (!open && returnFocus) menuBtn.focus();
    };
    // 닫힘 모션의 끝(투명도·transform 둘 다 끝난 뒤) — 타이머로 재면 시작이 늦은 기기에서 끝이 잘린다
    links?.addEventListener('transitionend', (e) => { if (e.target === links && !links.getAnimations?.().length) settle(); });
    menuBtn.hidden = false;
    header.classList.add('has-menu');
    menuBtn.addEventListener('click', () => setOpen(!header.classList.contains('is-menu-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-menu-open')) setOpen(false, header.contains(document.activeElement));
    });
    // 바깥을 누르면 닫는다(목록 안 링크는 이동하면서 닫힌다)
    document.addEventListener('click', (e) => {
      if (header.classList.contains('is-menu-open') && !header.contains(e.target as Node)) setOpen(false);
    });
    // 3D·영상 iframe 안을 누르면 클릭이 이 문서로 오지 않는다 — 포커스가 iframe 으로 넘어가며 창 blur 가 난다
    window.addEventListener('blur', () => { if (header.classList.contains('is-menu-open')) setOpen(false); });
    // Tab 으로 헤더 밖으로 나가면 닫는다 — 열린 목록이 다음 초점 요소를 가리지 않게(WCAG 2.4.11)
    header.addEventListener('focusout', (e) => {
      if (header.classList.contains('is-menu-open') && !header.contains(e.relatedTarget as Node | null)) setOpen(false);
    });
    // 뒤로 가기로 캐시에서 되살아난 페이지가 열린 채 보이지 않게
    window.addEventListener('pageshow', (e) => { if (e.persisted) setOpen(false, false, false); });
    // 데스크톱 폭으로 넓어지면 펼침 상태를 풀어 둔다
    narrow.addEventListener('change', (e) => { if (!e.matches) setOpen(false, false, false); });
  }

  // 로고 꼬불 모션 — 페이지를 열 때 한 번, 그리고 마우스를 올리거나 키보드로 닿으면 한 번.
  // 첫 선을 시작시키면 나머지 선·글자·마침표는 SVG 안 시차로 따라온다(선 3개 꼬불 → 글자가 한 자씩 살짝 → '.' 이 통).
  // '동작 줄이기' 설정에서는 걸지 않는다
  const brand = document.querySelector<HTMLElement>('.bd-header__brand');
  const firstLine = brand?.querySelector<SVGAnimationElement>('#bdw0');
  if (brand && firstLine && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let last = -Infinity; // 0 이면 페이지를 연 직후 1.3초 안의 첫 hover 가 무시된다
    const play = () => {
      const now = performance.now();
      if (now - last < 1300) return; // 도는 중에 다시 시작하지 않는다(전체 1.1초)
      last = now;
      firstLine.beginElement();
    };
    // 터치 겸용 노트북은 hover 기기로 잡히지만 손가락 탭에도 pointerenter 가 온다 — 탭은 곧바로 이동이라 재생하지 않는다
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) brand.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') play(); });
    brand.addEventListener('focus', () => { if (brand.matches(':focus-visible')) play(); });
    // 페이지를 열 때 한 번(2026-10-06 대표: '모바일에 통통거리는 로고가 없으니 허전하다' — 터치 기기는 hover 가 없어 이때만 보인다).
    // 첫 화면이 그려지고 조금 뒤에 시작한다(rAF 는 가려진 탭에서 멈춰 있어, 뒤에서 열린 탭은 처음 보일 때 돈다). 뒤로 가기로 되살아났을 때도 한 번
    const greet = () => requestAnimationFrame(() => setTimeout(play, 350));
    greet();
    window.addEventListener('pageshow', (e) => { if (e.persisted) greet(); });
  }

  // 오버레이 헤더 — 히어로 구간을 벗어나면 솔리드 전환 (rAF 스로틀)
  const overlay = document.querySelector('.bd-header--overlay');
  if (overlay) {
    let ticking = false;
    const update = () => {
      overlay.classList.toggle('is-scrolled', window.scrollY > window.innerHeight * 0.6);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
    // 첫 상태 계산까지 끝난 뒤에만 투명 오버레이 허용 — 위 어느 줄에서 실패해도 솔리드가 유지된다
    overlay.classList.add('is-ready');
  }
</script>
