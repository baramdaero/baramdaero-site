---
// 전역 헤더. overlay = 홈 히어로 위 투명 고정 / solid = 서브페이지 상단.
// 로고 톤은 기존 상태 클래스(.bd-header--overlay / .is-scrolled)에만 물린다 — 스크롤 리스너 추가 없음.
// 로고는 마크(ㅂㄷ 초성) 단독 — wide 락업은 헤더에서 쓰지 않는다.
// 워드마크 14px 하한 규칙과 "로고를 더 작게" 요구가 정면충돌해 텍스트 없는
// 마크로 전환했다 — 기호라 하한 자체가 없다. 브랜드명 전체는 히어로 카피와
// 푸터가 받친다(헤더에서 텍스트가 사라지는 페이지는 있어도, 이름이 아예
// 안 보이는 페이지는 없다). wide 락업은 푸터에서만 계속 쓴다.
import { SITE_CONFIG } from '../config.js';
import markUrl from '../assets/logo/baramdaero-mark.svg?url';
import markReverseUrl from '../assets/logo/baramdaero-mark-reverse.svg?url';

interface Props {
  variant?: 'overlay' | 'solid';
}
const { variant = 'solid' } = Astro.props;

// IA v3 — 세척/설치 2트랙 분리. 브랜드이야기는 푸터로 이동.
// 라벨은 축약형(협소 폭에서 가로형 로고 자리를 벌기 위해), name은 보조기기용 전체 명칭.
// name을 생략하면 label이 그대로 접근성 이름이 된다 (설치처럼 축약이 없는 항목).
// FAQ만 축약형이 전체 명칭의 부분문자열이 아니라 괄호로 함께 읽는다
// — 음성 제어가 화면에 보이는 "FAQ"로도 잡히게 (WCAG 2.5.3 Label in Name).
const nav = [
  { href: '/care/', label: '세척', name: '세척·관리' },
  { href: '/install/', label: '설치' },
  { href: '/cases/', label: '사례', name: '시공사례' },
  { href: '/faq/', label: 'FAQ', name: '자주 묻는 질문(FAQ)' },
];
const path = Astro.url.pathname;

/** 현재 페이지 판정. href가 '/'이면 startsWith가 모든 경로에 참이 되어 항상 현재로 표시된다
 *  — 정확 일치로 분기해 둔다. 지금 메뉴엔 '/'가 없지만 홈 항목이 추가되면 바로 걸리는 자리다.
 *  로고(`<a href="/">`)에는 aria-current를 주지 않는다 — 한 페이지에 두 개면 보조기기가
 *  현재 위치를 두 번 읽는다. */
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class:list={['bd-header', `bd-header--${variant}`]}>
  <div class="bd-header__inner">
    <a href="/" class="bd-header__brand" aria-label="바람대로 홈">
      {/* alt는 빈 값 — 링크의 aria-label이 이름을 이미 읽는다 (중복 읽기 방지) */}
      <img class="bd-header__logo bd-header__logo--ink" src={markUrl} alt="" />
      <img class="bd-header__logo bd-header__logo--rev" src={markReverseUrl} alt="" />
    </a>
    <nav class="bd-header__nav" aria-label="주 메뉴">
      {nav.map((item) => (
        <a
          href={item.href}
          class="bd-header__link"
          aria-label={item.name}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>
    {/* SHOP_URL이 비면 미렌더 — 죽은 링크로 트래픽을 흘리지 않는다 (PHONE과 동일 패턴) */}
    {SITE_CONFIG.SHOP_URL && (
      <a href={SITE_CONFIG.SHOP_URL} class="bd-header__cta" rel="noopener">예약·구매</a>
    )}
  </div>
</header>

<style>
  .bd-header {
    width: 100%;
    z-index: 40;
  }
  .bd-header--overlay {
    position: fixed;
    top: 0;
    left: 0;
    color: #fff;
    transition: background-color var(--dur-color) ease, color var(--dur-color) ease;
  }
  /* 히어로를 지나면 흰 바탕 위 백색 텍스트가 사라지는 문제 — 스크롤 시 솔리드 전환 */
  .bd-header--overlay.is-scrolled {
    background: color-mix(in srgb, var(--br-base) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--br-line);
    color: var(--br-ink);
  }
  .bd-header--solid {
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .bd-header__inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  /* flex 축소 금지 — 축소는 flex '아이템'에서 일어난다. img에만 걸면 부모 brand가
     대신 눌려 로고 비율이 깨진다 (기존 wide 락업에서 360px 155→123px 실측 — 마크는
     정사각이라 체감은 작지만 사슬은 그대로 건다). */
  .bd-header__brand {
    display: flex;
    align-items: center;
    margin-right: auto;
    flex-shrink: 0;
  }

  /* 로고 — 마크(1:1) 단독, 폭 구간별 3단 크기. 톤 전환은 기존 상태 클래스만 사용.
     텍스트가 없어 워드마크 하한 자체가 없다 — wide 시절의 aspect-ratio 1472/341,
     35px 미만 강등 로직은 전부 소거됐다. */
  .bd-header__logo {
    display: none;
    height: 32px;
    width: auto;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
  }
  /* 라이트 구간(서브페이지 솔리드 · 오버레이 스크롤 후) = teal 잉크 */
  .bd-header--solid .bd-header__logo--ink,
  .bd-header--overlay.is-scrolled .bd-header__logo--ink { display: block; }
  /* 다크 구간(히어로 위 오버레이) = 리버스 */
  .bd-header--overlay:not(.is-scrolled) .bd-header__logo--rev { display: block; }
  .bd-header__nav {
    display: flex;
    gap: 22px;
  }
  .bd-header__link {
    font-size: 14px;
    font-weight: 500;
    opacity: 0.85;
    transition: opacity var(--dur-color) ease;
    /* 44px 히트영역 확보 */
    padding: 12px 2px;
  }
  .bd-header__link:hover,
  .bd-header__link[aria-current='page'] { opacity: 1; }
  .bd-header__cta {
    font-size: 14px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 6px;
    background: var(--copper);
    color: #fff;
    transition: background-color var(--dur-color) ease, transform 160ms var(--ease-out);
  }
  .bd-header__cta:hover { background: var(--copper-deep); }
  .bd-header__cta:active { transform: scale(0.96); }

  .bd-header__link,
  .bd-header__cta,
  .bd-header__brand { white-space: nowrap; }

  /* 폭 구간별 3단 크기 — 형태(마크 1:1)는 고정, 크기만 단계적으로 커진다.
     기존 wide 시절의 높이(36·40px)에 시각적 무게를 맞췄다. */
  @media (min-width: 390px) {
    .bd-header__logo { height: 36px; }
  }
  @media (min-width: 641px) {
    .bd-header__logo { height: 40px; }
  }

  @media (max-width: 640px) {
    /* 값은 wide 락업 시절 그대로 유지 — 마크 전환으로 로고가 훨씬 좁아져
       실제로는 더 넉넉하다. 임의 조정 금지, 휑해 보이면 캡처로 보고 후 승인받고 고칠 것 */
    .bd-header__inner { gap: 10px; padding: 0 8px; height: 56px; }
    .bd-header__nav { gap: 10px; }
    .bd-header__link { font-size: 12px; padding: 12px 0; }
    .bd-header__cta { padding: 8px 11px; font-size: 12px; }
  }
</style>

<script>
  // 오버레이 헤더 — 히어로 구간을 벗어나면 솔리드 전환 (rAF 스로틀)
  const overlay = document.querySelector('.bd-header--overlay');
  if (overlay) {
    let ticking = false;
    const update = () => {
      overlay.classList.toggle('is-scrolled', window.scrollY > window.innerHeight * 0.6);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }
</script>
