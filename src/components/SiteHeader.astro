---
// 전역 헤더. overlay = 홈 히어로 위 투명 고정 / solid = 서브페이지 상단.
// 로고 톤은 기존 상태 클래스(.bd-header--overlay / .is-scrolled)에만 물린다 — 스크롤 리스너 추가 없음.
// 락업은 <picture> media로 전환: 협소 폭에서 wide → mark 강등 (해당 파일 1개만 내려받는다).
import { SITE_CONFIG } from '../config.js';
import wideUrl from '../assets/logo/baramdaero-wide.svg?url';
import wideReverseUrl from '../assets/logo/baramdaero-wide-reverse.svg?url';
import markUrl from '../assets/logo/baramdaero-mark.svg?url';
import markReverseUrl from '../assets/logo/baramdaero-mark-reverse.svg?url';

/** 이 폭 이하는 마크 단독 강등 — 가로형을 28px로 낮춰도 4개 메뉴와 부딪히는 구간.
 *  가로형 소요폭: 높이 36px일 때 147px(≥400px 구간), 28px일 때 114px(360~399px 구간).
 *  실측 근거는 screenshots/VERIFY.md */
const MARK_MAX = 359;

interface Props {
  variant?: 'overlay' | 'solid';
}
const { variant = 'solid' } = Astro.props;

// IA v3 — 세척/설치 2트랙 분리. 브랜드이야기는 푸터로 이동.
const nav = [
  { href: '/care/', label: '세척·관리' },
  { href: '/install/', label: '설치' },
  { href: '/cases/', label: '시공사례' },
  { href: '/faq/', label: '자주 묻는 질문' },
];
const path = Astro.url.pathname;
---
<header class:list={['bd-header', `bd-header--${variant}`]}>
  <div class="bd-header__inner">
    <a href="/" class="bd-header__brand" aria-label="바람대로 홈">
      {/* alt는 빈 값 — 링크의 aria-label이 이름을 이미 읽는다 (중복 읽기 방지) */}
      <picture class="bd-header__logo bd-header__logo--ink">
        <source media={`(max-width: ${MARK_MAX}px)`} srcset={markUrl} />
        <img src={wideUrl} alt="" />
      </picture>
      <picture class="bd-header__logo bd-header__logo--rev">
        <source media={`(max-width: ${MARK_MAX}px)`} srcset={markReverseUrl} />
        <img src={wideReverseUrl} alt="" />
      </picture>
    </a>
    <nav class="bd-header__nav" aria-label="주 메뉴">
      {nav.map((item) => (
        <a
          href={item.href}
          class="bd-header__link"
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>
    {/* SHOP_URL이 비면 미렌더 — 죽은 링크로 트래픽을 흘리지 않는다 (PHONE과 동일 패턴) */}
    {SITE_CONFIG.SHOP_URL && (
      <a href={SITE_CONFIG.SHOP_URL} class="bd-header__cta" rel="noopener">예약·구매</a>
    )}
  </div>
</header>

<style>
  .bd-header {
    width: 100%;
    z-index: 40;
  }
  .bd-header--overlay {
    position: fixed;
    top: 0;
    left: 0;
    color: #fff;
    transition: background-color var(--dur-color) ease, color var(--dur-color) ease;
  }
  /* 히어로를 지나면 흰 바탕 위 백색 텍스트가 사라지는 문제 — 스크롤 시 솔리드 전환 */
  .bd-header--overlay.is-scrolled {
    background: color-mix(in srgb, var(--br-base) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--br-line);
    color: var(--br-ink);
  }
  .bd-header--solid {
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
  .bd-header__inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .bd-header__brand {
    display: flex;
    align-items: center;
    margin-right: auto;
  }

  /* 로고 — 높이 고정·width auto (비율 무변경). 톤 전환은 기존 상태 클래스만 사용 */
  .bd-header__logo { display: none; }
  .bd-header__logo img {
    display: block;
    height: 36px;
    width: auto;
    aspect-ratio: 1389.3 / 341; /* 로드 전 레이아웃 밀림 방지 */
    /* flex 축소 금지 — 없으면 협소 폭에서 로고가 가로로 눌려 비율이 깨진다 (320px에서 114→83px 실측) */
    flex-shrink: 0;
  }
  /* 라이트 구간(서브페이지 솔리드 · 오버레이 스크롤 후) = teal 잉크 */
  .bd-header--solid .bd-header__logo--ink,
  .bd-header--overlay.is-scrolled .bd-header__logo--ink { display: block; }
  /* 다크 구간(히어로 위 오버레이) = 리버스 */
  .bd-header--overlay:not(.is-scrolled) .bd-header__logo--rev { display: block; }
  .bd-header__nav {
    display: flex;
    gap: 22px;
  }
  .bd-header__link {
    font-size: 14px;
    font-weight: 500;
    opacity: 0.85;
    transition: opacity var(--dur-color) ease;
    /* 44px 히트영역 확보 */
    padding: 12px 2px;
  }
  .bd-header__link:hover,
  .bd-header__link[aria-current='page'] { opacity: 1; }
  .bd-header__cta {
    font-size: 14px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 6px;
    background: var(--copper);
    color: #fff;
    transition: background-color var(--dur-color) ease, transform 160ms var(--ease-out);
  }
  .bd-header__cta:hover { background: var(--copper-deep); }
  .bd-header__cta:active { transform: scale(0.96); }

  .bd-header__link,
  .bd-header__cta,
  .bd-header__brand { white-space: nowrap; }

  /* 소형 화면 — 가로형을 28px(폭 114px)로 낮춰 워드마크를 유지한다.
     아이폰 14·15(390~393px)가 이 구간이라 브랜드명 노출을 우선한다 */
  @media (max-width: 399px) {
    .bd-header__logo img { height: 28px; }
  }
  /* 그보다 좁으면 28px로도 안 들어감 — 마크 단독 강등 (파일 교체는 <picture> media가) */
  @media (max-width: 359px) {
    .bd-header__logo img { height: 32px; aspect-ratio: 1 / 1; }
  }

  @media (max-width: 640px) {
    .bd-header__inner { gap: 10px; padding: 0 12px; height: 56px; }
    .bd-header__nav { gap: 10px; }
    .bd-header__link { font-size: 12px; padding: 12px 0; }
    .bd-header__cta { padding: 8px 11px; font-size: 12px; }
  }
</style>

<script>
  // 오버레이 헤더 — 히어로 구간을 벗어나면 솔리드 전환 (rAF 스로틀)
  const overlay = document.querySelector('.bd-header--overlay');
  if (overlay) {
    let ticking = false;
    const update = () => {
      overlay.classList.toggle('is-scrolled', window.scrollY > window.innerHeight * 0.6);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }
</script>
