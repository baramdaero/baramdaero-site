---
// 전역 헤더. overlay = 홈 히어로 위 투명 고정 / solid = 서브페이지 상단.
// 로고 톤은 상태 클래스(.bd-header--overlay / .is-ready / .is-scrolled)에만 물린다 — 스크롤 리스너 추가 없음.
// 오버레이의 기본값은 솔리드다. 투명(백색 텍스트)은 하단 스크립트가 .is-ready를 붙인 뒤에만 켜진다 (no-JS/초기화 실패 안전).
// 락업은 <picture> media로 전환: 협소 폭(≤389px)에서 wide → mark 강등.
// 390px+는 wide(마크+"바람대로" 워드마크) — 단, 실물 크기가 커 보인다는 판단에
// 따라 08-24 축소했다. 워드마크 14px 하한 규칙을 이번엔 의도적으로 깼다
// (한 차례 마크 단독 전환 시도 후 되돌림 — 오독이었다. 지시는 "락업 유지, 크기만 축소").
import { SITE_CONFIG } from '../config.js';
import wideUrl from '../assets/logo/baramdaero-wide.svg?url';
import wideReverseUrl from '../assets/logo/baramdaero-wide-reverse.svg?url';
import markUrl from '../assets/logo/baramdaero-mark.svg?url';
import markReverseUrl from '../assets/logo/baramdaero-mark-reverse.svg?url';

/** 이 폭 이하는 마크 단독 강등 (변경 없음 — 320~389px는 이번 축소 대상 아님). */
const MARK_MAX = 389;

interface Props {
  variant?: 'overlay' | 'solid';
}
const { variant = 'solid' } = Astro.props;

// IA v3 — 세척/설치 2트랙 분리. 브랜드이야기는 푸터로 이동.
// label = 640px 이하 축약형(협소 폭에서 가로형 로고 자리를 벌기 위해).
// full  = 641px+ 전체 명칭. 데스크톱은 폭이 충분해 줄여 쓸 이유가 없다.
// name  = 보조기기용 접근성 이름 — 폭과 무관하게 전 구간 동일하다.
// name을 생략하면 label이 그대로 접근성 이름이 된다 (설치처럼 축약이 없는 항목).
// FAQ만 full("자주 묻는 질문")과 name("자주 묻는 질문(FAQ)")이 다르다 — 음성 제어가
// 좁은 폭에서 화면에 보이는 "FAQ"로도 잡혀야 하기 때문 (WCAG 2.5.3 Label in Name).
// 두 라벨은 CSS display로만 전환한다: 숨은 쪽은 접근성 트리에서도 빠져 중복 낭독이 없고,
// 링크에 aria-label이 있어 낭독은 어차피 name 한 번뿐이다.
const nav = [
  { href: '/install/', label: '가정용', full: '가정용' },
  { href: '/commercial/', label: '상업용', full: '상업용' },
  { href: '/care/', label: '세척', full: '세척·관리', name: '세척·관리' },
  { href: '/cases/', label: '사례', full: '시공사례', name: '시공사례' },
  // wide: JS 가 안 도는 모바일(한 줄 메뉴 폴백)에서만 숨는다 — 6칸이면 390px 에서 54px 넘친다(2026-09-24 실측).
  // JS 가 돌면 640px 이하는 '메뉴' 버튼 펼침 목록이라 가격도 들어간다
  { href: '/price/', label: '가격', full: '가격', wide: true },
  { href: '/faq/', label: 'FAQ', full: '자주 묻는 질문', name: '자주 묻는 질문(FAQ)' },
];
const path = Astro.url.pathname;

/** 현재 페이지 판정. href가 '/'이면 startsWith가 모든 경로에 참이 되어 항상 현재로 표시된다
 *  — 정확 일치로 분기해 둔다. 지금 메뉴엔 '/'가 없지만 홈 항목이 추가되면 바로 걸리는 자리다.
 *  로고(`<a href="/">`)에는 aria-current를 주지 않는다 — 한 페이지에 두 개면 보조기기가
 *  현재 위치를 두 번 읽는다. */
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class:list={['bd-header', `bd-header--${variant}`]}>
  <div class="bd-header__inner">
    <a href="/" class="bd-header__brand" aria-label="바람대로 홈">
      {/* alt는 빈 값 — 링크의 aria-label이 이름을 이미 읽는다 (중복 읽기 방지) */}
      <picture class="bd-header__logo bd-header__logo--ink">
        <source media={`(max-width: ${MARK_MAX}px)`} srcset={markUrl} />
        <img src={wideUrl} alt="" />
      </picture>
      <picture class="bd-header__logo bd-header__logo--rev">
        <source media={`(max-width: ${MARK_MAX}px)`} srcset={markReverseUrl} />
        <img src={wideReverseUrl} alt="" />
      </picture>
    </a>
    {/* 주 메뉴 랜드마크는 늘 남는다 — 640px 이하 + JS 에서는 안의 '메뉴' 버튼이 링크 묶음(#site-nav)을 펼침 목록으로 연다.
        버튼은 글자('메뉴'↔'닫기'): 아이콘은 koboyo 에서만 가져오는데 이 레포 세션에 연결이 없다. hidden 은 스크립트가 푼다 */}
    <nav class="bd-header__nav" aria-label="주 메뉴">
      <button type="button" class="bd-header__menu-btn" aria-expanded="false" aria-controls="site-nav" hidden>
        <span class="bd-header__menu-open">메뉴</span><span class="bd-header__menu-close">닫기</span>
      </button>
      <div class="bd-header__links" id="site-nav">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={['bd-header__link', item.wide && 'bd-header__link--wide']}
            aria-label={item.name}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          ><span class="bd-header__label bd-header__label--short">{item.label}</span
          ><span class="bd-header__label bd-header__label--full">{item.full}</span></a>
        ))}
      </div>
    </nav>
    {/* 우측 액션 슬롯 — 대표번호·CTA가 들어올 자리.
        SHOP_URL이 비면 슬롯째 미렌더한다: 빈 요소를 남기면 inner의 gap이 그대로 붙어
        메뉴가 이유 없이 왼쪽으로 밀린다. 슬롯이 생기면 메뉴는 gap만큼 밀릴 뿐이고,
        폭은 flex가 알아서 나눈다 (고정값 재조정 불요). */}
    {SITE_CONFIG.SHOP_URL && (
      <div class="bd-header__actions">
        <a href={SITE_CONFIG.SHOP_URL} class="bd-header__cta" rel="noopener">예약·구매</a>
      </div>
    )}
  </div>
</header>

<style>
  .bd-header {
    width: 100%;
    z-index: 40;
  }
  /* 오버레이 기본값 = 솔리드(안전 상태). JS 초기화 전·실패 시에도 흰 바탕 위 백색 텍스트가 생기지 않는다. */
  .bd-header--overlay {
    position: fixed;
    top: 0;
    left: 0;
    background: var(--glass-heavy-bg);
    -webkit-backdrop-filter: var(--glass-heavy-fx);
    backdrop-filter: var(--glass-heavy-fx);
    border-bottom: 1px solid var(--glass-line);
    color: var(--br-ink);
    transition: background-color var(--dur-color) ease, color var(--dur-color) ease;
  }
  /* JS 초기화 완료(.is-ready) + 히어로 구간(:not(.is-scrolled))에서만 투명 오버레이.
     히어로를 지나면 .is-scrolled가 붙어 위 기본 솔리드로 복귀한다. */
  .bd-header--overlay.is-ready:not(.is-scrolled):not(.is-menu-open) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
    color: #fff;
  }
  .bd-header--solid {
    position: sticky;
    top: 0;
    background: var(--glass-heavy-bg);
    -webkit-backdrop-filter: var(--glass-heavy-fx);
    backdrop-filter: var(--glass-heavy-fx);
    border-bottom: 1px solid var(--glass-line);
    color: var(--ink);
  }
  /* 로고와 메뉴 사이의 남는 폭은 auto로 배분한다. 메뉴가 늘어도 화면 밖으로 밀지 않는다. */
  .bd-header__inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  /* flex 축소 금지 — 축소는 flex '아이템'에서 일어난다. img에만 걸면 부모 picture/brand가
     대신 눌려 로고 비율이 깨진다 (360px에서 155→123px 실측). 사슬 전체에 건다 */
  .bd-header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  /* 우측 액션 슬롯 — 내용이 생겨도 줄어들지 않는다 */
  .bd-header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  /* 767px 이하에서는 슬롯을 접는다. 폭 예산이 물리적으로 부족하기 때문이다 —
     더미(대표번호+버튼 177px)로 실측하면 390px에서 177px, 641px에서 16px 넘쳤다
     (641px 필요폭 633 = 로고 115 + gap 28 + 메뉴 285 + gap 28 + 슬롯 177 > 가용 593).
     겹침이 아니라 자리 부족이라 간격 조정으로는 못 푼다.
     ⚠️ 슬롯에 실제 내용이 들어갈 때 이 구간 정책(축약 CTA만 노출 / 햄버거 등)을
     다시 정할 것 — 지금은 SHOP_URL이 비어 슬롯 자체가 미렌더라 영향이 없다. */
  @media (max-width: 767px) {
    .bd-header__actions { display: none; }
  }

  /* 로고 — 높이 고정·width auto (비율 무변경). 톤 전환은 기존 상태 클래스만 사용.
     08-24 축소: 기존 36/40px의 2/3 — "커 보인다"는 실물 판단을 워드마크 14px
     하한보다 우선했다(의도적으로 하한 이하로 내려간다). */
  .bd-header__logo { display: none; flex-shrink: 0; }
  .bd-header__logo img {
    display: block;
    height: 24px;
    width: auto;
    aspect-ratio: 1472 / 341; /* v3 락업 비율 — 로드 전 레이아웃 밀림 방지 */
    flex-shrink: 0;
  }
  /* 라이트 구간(서브페이지 솔리드 · 오버레이 스크롤 후) = teal 잉크 */
  .bd-header--solid .bd-header__logo--ink,
  .bd-header--overlay:not(.is-ready) .bd-header__logo--ink,
  .bd-header--overlay.is-scrolled .bd-header__logo--ink,
  .bd-header--overlay.is-menu-open .bd-header__logo--ink { display: block; }
  /* 다크 구간(JS 초기화 후 히어로 위 투명 오버레이) = 리버스 */
  .bd-header--overlay.is-ready:not(.is-scrolled):not(.is-menu-open) .bd-header__logo--rev { display: block; }
  .bd-header__nav { display: flex; align-items: center; }
  .bd-header__links {
    display: flex;
    gap: 22px;
  }
  .bd-header__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    opacity: 0.85;
    transition: opacity var(--dur-color) ease;
    /* 44px 히트영역 확보 */
    padding: 12px 2px;
  }
  .bd-header__link:hover,
  .bd-header__link[aria-current='page'] { opacity: 1; }
  /* 라벨 전환 — display:none은 접근성 트리에서도 제외되므로 한 링크가 두 번 읽히지 않는다 */
  .bd-header__label--full { display: none; }
  .bd-header__cta {
    font-size: 14px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 6px;
    background: var(--copper);
    color: #fff;
    transition: background-color var(--dur-color) ease, transform 160ms var(--ease-out);
  }
  .bd-header__cta:hover { background: var(--copper-deep); }
  .bd-header__cta:active { transform: scale(0.96); }

  .bd-header__link,
  .bd-header__cta,
  .bd-header__brand { white-space: nowrap; }

  /* 상업용 메뉴 추가 후 390px에서 고정 여백이 넘쳐, 모바일도 남는 폭만 배분한다. */
  @media (max-width: 640px) {
    .bd-header__brand { margin-right: auto; }
  }

  /* 데스크톱 헤더(64px)는 여유가 있어 40px의 2/3 = 26.667px */
  @media (min-width: 641px) {
    .bd-header__logo img { height: 26.667px; }

    /* 641px+는 폭이 충분하므로 전체 명칭 — 축약은 좁은 폭에서 로고 자리를 벌려던 것이다 */
    .bd-header__label--short { display: none; }
    .bd-header__label--full { display: inline; }

    /* 메뉴를 우측 슬롯 앞에 붙인다. 고정 margin(구 200px → 150px)은 제거했다 —
       폭이나 우측 요소가 바뀔 때마다 값을 다시 잡아야 했고, 오버플로를 막으려
       150px로 줄이자 메뉴가 가운데로 뭉치고 오른쪽이 비었다(08-24).
       auto는 남는 폭을 전부 왼쪽에 몰아주므로 로고↔메뉴 간격은 화면이 넓어질수록
       늘고, 메뉴 우측 끝은 컨테이너에 고정된다. */
    .bd-header__nav { margin-left: auto; }
  }

  /* 가로형이 안 들어가는 폭 — 마크 단독 강등 (파일 교체는 <picture> media가).
     ⚠️ 이 389는 위 MARK_MAX와 같은 값이어야 한다. 미디어 쿼리는 CSS 변수를 못 읽어
     define:vars로 묶을 수 없다 — 한쪽만 고치면 파일은 마크인데 크기는 가로형이 된다 */
  @media (max-width: 389px) {
    .bd-header__logo img { height: 32px; aspect-ratio: 1 / 1; }
  }

  /* ---- 모바일 메뉴(640px 이하 + JS: .has-menu) — 한 줄 메뉴를 접고 '메뉴' 버튼으로 편다 ---- */
  .bd-header__menu-btn {
    display: none;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    background: var(--tint-fill);
    color: var(--br-ink);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    transition: background-color var(--dur-color) ease, transform 160ms var(--ease-out);
  }
  .bd-header__menu-btn:active { transform: scale(0.96); }
  .bd-header__menu-close,
  .bd-header.is-menu-open .bd-header__menu-open { display: none; }
  .bd-header.is-menu-open .bd-header__menu-close { display: inline; }
  .bd-header--overlay.is-ready:not(.is-scrolled):not(.is-menu-open) .bd-header__menu-btn { color: #fff; background: rgba(255, 255, 255, 0.14); }
  @media (max-width: 640px) {
    .bd-header.has-menu .bd-header__menu-btn { display: inline-flex; }
    .bd-header.has-menu .bd-header__links { display: none; }
    /* 펼침 목록 — 헤더 바로 아래 전체 폭. 글자는 전체 명칭, 한 줄 52px */
    .bd-header.has-menu.is-menu-open .bd-header__links {
      display: flex;
      flex-direction: column;
      gap: 0;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 4px 20px 16px;
      background: var(--br-base);
      border-bottom: 1px solid var(--glass-line);
      box-shadow: var(--glass-shadow);
      /* 화면 높이가 낮으면(가로 모드·확대) 목록 안에서 스크롤 — sticky 헤더에 붙어 페이지 스크롤로는 못 내린다 */
      max-height: calc(100dvh - 56px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .bd-header.has-menu.is-menu-open .bd-header__link {
      justify-content: flex-start;
      min-height: 52px;
      padding: 0 4px;
      font-size: 17px;
      font-weight: 600;
      color: var(--br-ink);
      opacity: 1;
      border-bottom: 1px solid color-mix(in srgb, var(--br-ink) 8%, transparent);
    }
    .bd-header.has-menu.is-menu-open .bd-header__link:last-child { border-bottom: 0; }
    .bd-header.has-menu.is-menu-open .bd-header__link[aria-current='page'] { color: var(--br-teal); }
    .bd-header.has-menu.is-menu-open .bd-header__label--short { display: none; }
    .bd-header.has-menu.is-menu-open .bd-header__label--full { display: inline; }
    /* 투명 오버레이 위에서 열면 헤더도 솔리드로 — 흰 글자 버튼이 밝은 목록 위에 뜨지 않게 */
    .bd-header--overlay.is-menu-open { background: var(--br-base); color: var(--br-ink); }
  }

  @media (max-width: 640px) {
    .bd-header:not(.has-menu) .bd-header__link--wide { display: none; }
    /* 기존 로고 크기와 헤더 높이를 유지한다. */
    .bd-header__inner { gap: 10px; padding: 0 8px; height: 56px; }
    .bd-header__links { gap: 10px; }
    .bd-header__link { font-size: 12px; padding: 12px 0; }
    .bd-header__cta { padding: 8px 11px; font-size: 12px; }
  }
</style>

<script>
  // 모바일 메뉴 — 버튼이 nav 를 펼친다. JS 가 안 돌면 버튼은 hidden 그대로, 한 줄 메뉴가 남는다
  const header = document.querySelector<HTMLElement>('.bd-header');
  const menuBtn = header?.querySelector<HTMLButtonElement>('.bd-header__menu-btn');
  if (header && menuBtn) {
    const narrow = window.matchMedia('(max-width: 640px)');
    const setOpen = (open: boolean, returnFocus = false) => {
      header.classList.toggle('is-menu-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      if (!open && returnFocus) menuBtn.focus();
    };
    menuBtn.hidden = false;
    header.classList.add('has-menu');
    menuBtn.addEventListener('click', () => setOpen(!header.classList.contains('is-menu-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-menu-open')) setOpen(false, header.contains(document.activeElement));
    });
    // 바깥을 누르면 닫는다(목록 안 링크는 이동하면서 닫힌다)
    document.addEventListener('click', (e) => {
      if (header.classList.contains('is-menu-open') && !header.contains(e.target as Node)) setOpen(false);
    });
    // 3D·영상 iframe 안을 누르면 클릭이 이 문서로 오지 않는다 — 포커스가 iframe 으로 넘어가며 창 blur 가 난다
    window.addEventListener('blur', () => { if (header.classList.contains('is-menu-open')) setOpen(false); });
    // Tab 으로 헤더 밖으로 나가면 닫는다 — 열린 목록이 다음 초점 요소를 가리지 않게(WCAG 2.4.11)
    header.addEventListener('focusout', (e) => {
      if (header.classList.contains('is-menu-open') && !header.contains(e.relatedTarget as Node | null)) setOpen(false);
    });
    // 뒤로 가기로 캐시에서 되살아난 페이지가 열린 채 보이지 않게
    window.addEventListener('pageshow', (e) => { if (e.persisted) setOpen(false); });
    // 데스크톱 폭으로 넓어지면 펼침 상태를 풀어 둔다
    narrow.addEventListener('change', (e) => { if (!e.matches) setOpen(false); });
  }

  // 오버레이 헤더 — 히어로 구간을 벗어나면 솔리드 전환 (rAF 스로틀)
  const overlay = document.querySelector('.bd-header--overlay');
  if (overlay) {
    let ticking = false;
    const update = () => {
      overlay.classList.toggle('is-scrolled', window.scrollY > window.innerHeight * 0.6);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
    // 첫 상태 계산까지 끝난 뒤에만 투명 오버레이 허용 — 위 어느 줄에서 실패해도 솔리드가 유지된다
    overlay.classList.add('is-ready');
  }
</script>
