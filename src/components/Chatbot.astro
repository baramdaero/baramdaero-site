  /* ---------- 렌더 프리미티브 ---------- */
  const delay = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const scrollDown = () => { log.scrollTop = log.scrollHeight; };

  let renderToken = 0;

  function bubble(text: string, who: 'bot' | 'user' = 'bot'): HTMLElement {
    const el = document.createElement('p');
    el.className = `chat__msg chat__msg--${who}`;
    el.textContent = text;
    log.appendChild(el);
    scrollDown();
    return el;
  }

  /** 봇 말풍선 앞 타이핑 인디케이터 800ms — reduced-motion 시 생략 */
  async function typing(token: number) {
    if (reducedMotion.matches) return;
    // 개발 전용 검증 훅 — 헤드리스 팬은 백그라운드 타이머 스로틀링으로 200ms가 수 초로 늘어난다.
    // 프로드 빌드에서는 이 분기가 제거된다.
    if (import.meta.env.DEV && sessionStorage.getItem('BD_FAST')) return;
    const el = document.createElement('div');
    el.className = 'chat__msg chat__msg--bot chat__typing';
    el.setAttribute('aria-hidden', 'true');
    el.innerHTML = '<span></span>';
    log.appendChild(el);
    scrollDown();
    await delay(800); /* 2026-09-03: 스퀘어 펄스가 한 번 수축·복귀하는 길이(200ms는 보이기 전에 사라짐) */
    el.remove();
    if (token !== renderToken) throw new Error('stale');
  }

  function chip(label: string, kind: 'default' | 'sub' | 'tel' | 'primary' = 'default'): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = `chat__chip chat__chip--${kind}`;
    btn.textContent = label;
    return btn;
  }

  function telChip(label: string, tel: string, primary = false): HTMLAnchorElement {
    const a = document.createElement('a');
    a.className = primary ? 'chat__chip chat__chip--primary' : 'chat__chip chat__chip--tel';
    a.href = `tel:${tel}`;
    a.textContent = label;
    return a;
  }

  /** FAQ 앵커 링크 칩 — 같은 탭 이동 (챗봇을 닫고 본문을 읽는 흐름) */
  function linkChip(label: string, href: string): HTMLAnchorElement {
    const a = document.createElement('a');
    a.className = 'chat__chip chat__chip--link';
    a.href = href;
    a.textContent = label;
    return a;
  }

  /** 칩 그룹 — 선택 시 그룹 전체 비활성 보존, 선택 칩 표시. 좌우/상하 키보드 탐색 지원 */
  function chipGroup(): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'chat__chips';
    wrap.setAttribute('role', 'group');
    wrap.addEventListener('keydown', (e) => {
      if (!['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(e.key)) return;
      const chips = [...wrap.querySelectorAll<HTMLElement>('.chat__chip:not(:disabled)')];
      const idx = chips.indexOf(document.activeElement as HTMLElement);
      if (idx === -1) return;
      e.preventDefault();
      const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : -1;
      chips[(idx + dir + chips.length) % chips.length]?.focus();
    });
    log.appendChild(wrap);
    return wrap;
  }

  function settleGroup(wrap: HTMLElement, chosen?: HTMLElement) {
    wrap.querySelectorAll('button').forEach((b) => { b.disabled = true; });
    wrap.classList.add('is-settled');
    chosen?.classList.add('is-chosen');
  }

  /* ---------- 입력바 ----------
     숫자 입력(대수)과 자유 입력(아파트명·층수) 두 모드. 검증은 모드별로 갈린다. */
  let inputHandler: ((value: string) => void) | null = null;
  let inputMode: 'number' | 'text' = 'number';

  function armInput(placeholder: string, mode: 'number' | 'text', max: number, onSubmit: (v: string) => void) {
    inputHandler = onSubmit;
    inputMode = mode;
    input.disabled = false;
    sendBtn.disabled = false;
    input.placeholder = placeholder;
    input.inputMode = mode === 'number' ? 'numeric' : 'text';
    input.maxLength = max;
    input.value = '';
    input.focus();
  }

  function disarmInput() {
    inputHandler = null;
    input.disabled = true;
    sendBtn.disabled = true;
    input.placeholder = '선택지를 눌러 주세요';
    input.inputMode = 'numeric';
    input.value = '';
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!inputHandler) return;
    const raw = input.value.trim();
    let value: string;
    if (inputMode === 'number') {
      const n = parseInt(raw, 10);
      if (!n || n < 1) { input.focus(); return; }
      value = String(n);
    } else {
      if (!raw) { input.focus(); return; }
      value = raw;
    }
    const handler = inputHandler;
    disarmInput();
    handler(value);
  });

  /* ---------- 히스토리 (← 이전) ---------- */
  type Checkpoint = { nodeId: string; logLen: number; data: Data };
  let stack: Checkpoint[] = [];

  function updateNav() {
    backBtn.disabled = stack.length <= 1;
  }

  function goBack() {
    if (stack.length <= 1) return;
    renderToken += 1;
    stack.pop(); // 현재 스텝 버림
    const prev = stack.pop()!; // 이전 스텝 — goto가 다시 push
    while (log.children.length > prev.logLen) log.lastElementChild?.remove();
    data = { ...prev.data };
    disarmInput();
    void goto(prev.nodeId);
  }

  /* ---------- 노드 렌더 ---------- */
  async function goto(id: string) {
    const node = NODES[id];
    if (!node) return;
    const token = ++renderToken;
    stack.push({ nodeId: id, logLen: log.children.length, data: { ...data } });
    updateNav();
    disarmInput();

    try {
      if (node.text) {
        const bubbles = Array.isArray(node.text) ? node.text : [node.text];
        for (const t of bubbles) {
          await typing(token);
          bubble(typeof t === 'function' ? t(data) : t);
          if (token !== renderToken) return;
        }
      }

      if (node.link) {
        const group = chipGroup();
        group.appendChild(linkChip(node.link.label, node.link.href));
      }

      if (node.options) {
        const group = chipGroup();
        node.options.forEach((opt) => {
          if (opt.tel) {
            group.appendChild(telChip(opt.label, opt.tel));
            return;
          }
          if (opt.consult) {
            // 상담 연결 칩 — 채널톡 열기 (키 없으면 미노출, 기존 폴백 경로 유지)
            if (!channelEnabled()) return;
            const btn = chip(opt.label, 'primary');
            btn.addEventListener('click', async () => {
              btn.disabled = true;
              const ok = (await ensureChannel()) && openConsult();
              btn.disabled = false;
              if (ok) close();
              else toast('상담 연결에 실패했습니다. 잠시 후 다시 시도해 주세요.');
            });
            group.appendChild(btn);
            return;
          }
          const btn = chip(opt.label, opt.sub ? 'sub' : 'default');
          btn.addEventListener('click', async () => {
            const t = ++renderToken;
            settleGroup(group, btn);
            bubble(opt.label, 'user');
            if (opt.set) Object.assign(data, opt.set);
            try {
              if (opt.say) {
                await typing(t);
                bubble(opt.say);
              }
            } catch { return; }
            if (opt.next) void goto(opt.next);
          });
          group.appendChild(btn);
        });
        scrollDown();
      }

      if (node.input) {
        const spec = node.input;
        const hint = typeof spec.placeholder === 'function' ? spec.placeholder(data) : spec.placeholder;
        armInput(hint, spec.type ?? 'number', spec.max ?? 20, async (v) => {
          const shown = `${v}${spec.suffix ?? ''}`;
          data[spec.key] = shown;
          bubble(shown, 'user');
          if (spec.say) {
            const t = ++renderToken;
            try { await typing(t); } catch { return; }
            bubble(spec.say);
          }
          void goto(spec.next);
        });
      }

      if (node.card) renderCard();
      if (node.etc) renderEtc();
      if (node.home) renderHome();
    } catch {
      /* stale render — 무시 */
    }
  }

  /* ---------- 홈 화면 (갈래 4칩) ----------
     pinned FAQ 칩은 뺐다(08-25). 4갈래 위에 다섯 번째 입구가 생겨 분기 의미가 흐려지고,
     답이 결국 갈래 진입으로 되돌아가는 우회 경로였다. 견적 방법은 어느 갈래로 들어가도
     첫 질문에서 바로 안내된다. renderFaqChips 자체는 'etc' 트리가 계속 쓴다. */
  const HOME_MENU: Array<{ label: string; next: string }> = [
    { label: '세척 견적', next: 'clean.start' },
    { label: '설치 상담', next: 'install.start' },
    { label: 'A/S 문의', next: 'as.q1' },
    { label: '기타 문의', next: 'etc' },
  ];

  function renderHome() {
    const group = chipGroup();
    HOME_MENU.forEach((m) => {
      const btn = chip(m.label);
      btn.addEventListener('click', () => {
        settleGroup(group, btn);
        bubble(m.label, 'user');
        void goto(m.next);
      });
      group.appendChild(btn);
    });
    scrollDown();
  }

  /* ---------- FAQ 즉답 ---------- */
  function renderFaqChips(items: FaqItem[], label?: string) {
    if (!items.length) return;
    if (label) {
      const p = document.createElement('p');
      p.className = 'chat__faq-label';
      p.textContent = label;
      log.appendChild(p);
    }
    const group = chipGroup();
    items.forEach((f) => {
      const btn = chip(f.q);
      btn.addEventListener('click', () => {
        settleGroup(group, btn);
        void runFaq(f);
      });
      group.appendChild(btn);
    });
  }

  async function runFaq(f: FaqItem) {
    const t = ++renderToken;
    bubble(f.q, 'user');
    try {
      await typing(t);
    } catch { return; }
    bubble(f.a);
    // 막다른 답변 금지 — next 유도 칩 또는 홈 메뉴가 반드시 따른다
    if (f.next && TREE_START[f.next.tree]) {
      const group = chipGroup();
      const btn = chip(f.next.label, 'primary');
      btn.addEventListener('click', () => {
        settleGroup(group, btn);
        bubble(f.next!.label, 'user');
        void goto(TREE_START[f.next!.tree]);
      });
      group.appendChild(btn);
      const homeBtn = chip('홈 메뉴', 'sub');
      homeBtn.addEventListener('click', () => {
        settleGroup(group, homeBtn);
        renderHome();
      });
      group.appendChild(homeBtn);
    } else {
      renderHome();
    }
    scrollDown();
  }

  /* ---------- 접수카드 (텍스트 생성 스펙 v1 그대로) ---------- */
  function buildCard(): string {
    const lines = ['[바람대로 접수]'];
    const push = (k: string, v?: string) => { if (v) lines.push(`${k}: ${v}`); };
    push('분류', data.긴급 ? `${data.분류} (긴급)` : data.분류);
    // '고객구분(무상/유상)'은 as.when과 함께 삭제 — 안 물으니 늘 '확인 필요'만 찍혔다
    push('공간', data.공간);
    if (data.분류 === '설치') push('브랜드·유형', [data.브랜드, data.유형].filter(Boolean).join(' · '));
    push('기종', data.기종);
    push('대수', data.대수);
    push('위치', data.위치);
    push('거주 상태', data.거주상태);
    push('인테리어', data.인테리어);
    push('지역', data.지역);
    push('증상', data.증상);
    return lines.join('\n');
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    }
  }

  function ctaButton(label: string, kind: 'primary' | 'ghost' | 'sub' = 'primary'): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = `chat__cta chat__cta--${kind}`;
    btn.textContent = label;
    return btn;
  }

  function ctaTel(label: string, kind: 'primary' | 'ghost' = 'ghost'): HTMLAnchorElement {
    const a = document.createElement('a');
    a.className = `chat__cta chat__cta--${kind}`;
    a.href = `tel:${PHONE.replace(/[^0-9]/g, '')}`;
    a.textContent = label;
    return a;
  }

  /** 채널톡 없음·실패 시 기존 폴백 동작 그대로: 자동복사 + 토스트 + 카카오/전화/복사 안내.
      silent=true면 자동복사·토스트 생략 (호출측이 이미 복사·안내한 경우) */
  function renderFallbackCtas(text: string, wrap: HTMLElement, silent = false) {
    if (!silent) {
      copyText(text).then((ok) => {
        if (ok) toast('복사되었습니다. 상담 창에 붙여넣어 주세요.');
      });
    }
    if (KAKAO) {
      const btn = ctaButton('카톡으로 접수하기', 'primary');
      btn.addEventListener('click', async () => {
        await copyText(text);
        toast('복사되었습니다. 상담 창에 붙여넣어 주세요.');
        window.open(KAKAO, '_blank', 'noopener');
      });
      wrap.appendChild(btn);
    } else if (PHONE) {
      wrap.appendChild(ctaTel(`전화로 접수하기 ${PHONE}`, 'primary'));
    } else {
      bubble('접수 채널 준비 중입니다. 카드 내용이 복사되어 있으니 채널 오픈 후 붙여넣어 주세요.');
    }
    const again = ctaButton('카드 다시 복사', 'sub');
    again.addEventListener('click', async () => {
      const ok = await copyText(text);
      toast(ok ? '복사되었습니다. 상담 창에 붙여넣어 주세요.' : '복사에 실패했습니다. 카드를 길게 눌러 복사해 주세요.');
    });
    wrap.appendChild(again);
  }

  function renderCard() {
    const text = buildCard();
    const card = document.createElement('div');
    card.className = 'chat__card';
    const label = document.createElement('p');
    label.className = 'chat__card-label';
    label.textContent = '접수 카드';
    const pre = document.createElement('pre');
    pre.textContent = text;
    card.append(label, pre);
    log.appendChild(card);

    const wrap = document.createElement('div');
    wrap.className = 'chat__ctas';
    log.appendChild(wrap);

    const isUrgent = !!data.긴급;

    if (channelEnabled()) {
      // 상담 연결: 접수카드를 첫 메시지로 프리필 → 고객이 전송만 하면 상담 시작
      // 누수 긴급은 전화가 주 CTA — 단, 전화 미기입이면 상담 연결을 주 CTA로 승격
      const consult = ctaButton('상담 연결', isUrgent && PHONE ? 'ghost' : 'primary');
      consult.addEventListener('click', async () => {
        consult.disabled = true;
        const ok = (await ensureChannel()) && openConsult(text);
        consult.disabled = false;
        if (ok) {
          close();
        } else {
          await copyText(text);
          toast('상담 연결이 안 됩니다. 접수 내용은 복사해 두었으니 전화로 연락 주세요.');
          consult.remove();
          renderFallbackCtas(text, wrap, true);
          scrollDown();
        }
      });
      // 누수 긴급 경로는 전화가 주 CTA (기존 우선순위 유지)
      if (isUrgent && PHONE) {
        wrap.appendChild(ctaTel(`전화하기 ${PHONE}`, 'primary'));
        wrap.appendChild(consult);
      } else {
        wrap.appendChild(consult);
        if (PHONE) wrap.appendChild(ctaTel(`전화하기 ${PHONE}`, 'ghost'));
      }
    } else {
      renderFallbackCtas(text, wrap);
    }

    const home = ctaButton('처음으로', 'sub');
    home.addEventListener('click', reset);
    wrap.appendChild(home);
    scrollDown();
  }

  /* ---------- 기타 트리 — FAQ 전체 목록 + 상담 연결 + 전화 ---------- */
  function renderEtc() {
    renderFaqChips(FAQ, FAQ.length ? '자주 묻는 질문' : undefined);

    const wrap = document.createElement('div');
    wrap.className = 'chat__ctas';
    log.appendChild(wrap);

    if (channelEnabled()) {
      const consult = ctaButton('상담 연결', 'primary');
      consult.addEventListener('click', async () => {
        consult.disabled = true;
        const ok = (await ensureChannel()) && openConsult();
        consult.disabled = false;
        if (ok) close();
        else toast('상담 연결에 실패했습니다. 잠시 후 다시 시도해 주세요.');
      });
      wrap.appendChild(consult);
      if (PHONE) wrap.appendChild(ctaTel(`전화 ${PHONE}`, 'ghost'));
    } else {
      if (KAKAO) {
        const btn = ctaButton('카카오톡 채널', 'primary');
        btn.addEventListener('click', () => window.open(KAKAO, '_blank', 'noopener'));
        wrap.appendChild(btn);
      }
      if (PHONE) wrap.appendChild(ctaTel(`전화 ${PHONE}`, 'ghost'));
      if (!KAKAO && !PHONE) {
        bubble('문의 채널 준비 중입니다. 세척·설치 견적은 아래 메뉴에서 바로 접수할 수 있습니다.');
      }
    }

    const home = ctaButton('처음으로', 'sub');
    home.addEventListener('click', reset);
    wrap.appendChild(home);
    scrollDown();
  }

  /* ---------- 토스트 ---------- */
  let toastTimer: ReturnType<typeof setTimeout>;
  function toast(msg: string) {
    toastEl.textContent = msg;
    toastEl.hidden = false;
    toastEl.classList.add('is-on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toastEl.classList.remove('is-on');
      setTimeout(() => { toastEl.hidden = true; }, 250);
    }, 2600);
  }

  /* ---------- 패널 열기/닫기 · 포커스 트랩 ---------- */
  let openState = false;
  let lastFocus: HTMLElement | null = null;

  function focusables(): HTMLElement[] {
    return [...panel.querySelectorAll<HTMLElement>('button:not(:disabled), a[href], input:not(:disabled)')]
      .filter((el) => el.offsetParent !== null);
  }

  panel.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const els = focusables();
    if (!els.length) return;
    const first = els[0];
    const last = els[els.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  function open(startNode = 'home') {
    lastFocus = document.activeElement as HTMLElement;
    data = {};
    stack = [];
    renderToken += 1;
    log.innerHTML = '';
    disarmInput();
    hideTeaser();
    panel.hidden = false;
    // rAF 대신 동기 리플로우 — 백그라운드 탭(rAF 정지)에서도 열림 상태가 즉시 적용된다
    void panel.offsetHeight;
    panel.classList.add('is-open');
    root.classList.add('is-open');
    fab.setAttribute('aria-expanded', 'true');
    fab.setAttribute('aria-label', '문의 챗봇 닫기');
    openState = true;
    void ensureChannel(); // lazy boot — 카드 도달 전에 준비되도록 미리 시작 (키 없으면 즉시 no-op)
    void goto(startNode);
    (root.querySelector('[data-chat-close]') as HTMLElement)?.focus();
  }

  function close() {
    panel.classList.remove('is-open');
    root.classList.remove('is-open');
    fab.setAttribute('aria-expanded', 'false');
    fab.setAttribute('aria-label', '문의 챗봇 열기');
    openState = false;
    setTimeout(() => { panel.hidden = true; }, 220);
    lastFocus?.focus();
  }

  // 처음으로 = 챗봇 홈 화면 (트리 직진입으로 연 경우에도 홈으로)
  function reset() {
    data = {};
    stack = [];
    renderToken += 1;
    log.innerHTML = '';
    disarmInput();
    void goto('home');
  }

  fab.addEventListener('click', () => (openState ? close() : open()));

  /* ---------- Specular 림 (React Bits SpecularButton 이식) ----------
     포인터가 250px 안에 오면 빛이 켜지고(bright), 빛 방향은 포인터 쪽으로 감쇠 보간(7/s).
     버튼 위에선 대각선에 자리 잡고 커서 위치로 살짝 흔들린다(원본 그대로). 루프는 필요할 때만 돈다. */
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches
    && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine) {
    const PROX = 250, STEER = 7, FADE = 8;
    let angle = 2.4, pAngle: number | null = null, prox = 0, bright = 0, last = 0, raf = 0;
    const tick = (now: number) => {
      const dt = Math.min((now - (last || now)) / 1000, 0.05); last = now;
      if (pAngle != null) {
        const diff = ((pAngle - angle + Math.PI * 3) % (Math.PI * 2)) - Math.PI;
        angle += diff * (1 - Math.exp(-dt * STEER));
      }
      bright += (prox - bright) * (1 - Math.exp(-dt * FADE));
      fab.style.setProperty('--sb-angle', `${(90 - (angle * 180) / Math.PI).toFixed(2)}deg`);
      fab.style.setProperty('--sb-bright', bright.toFixed(3));
      raf = (prox > 0 || bright > 0.004) ? requestAnimationFrame(tick) : 0;
      if (!raf) last = 0;
    };
    window.addEventListener('pointermove', (e) => {
      const r = fab.getBoundingClientRect();
      const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
      const dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right);
      const dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
      const dist = Math.hypot(dx, dy);
      if (dist === 0) {
        const nx = (e.clientX - cx) / (r.width / 2), ny = (cy - e.clientY) / (r.height / 2);
        pAngle = Math.atan2(2 / r.height, -2 / r.width) + nx * 0.3 + ny * 0.15;
      } else {
        pAngle = Math.atan2(cy - e.clientY, e.clientX - cx);
      }
      const t = Math.max(0, 1 - dist / PROX);
      prox = t * t * (3 - 2 * t);
      if (!raf) raf = requestAnimationFrame(tick);
    }, { passive: true });
  }

  /* ---------- 티저 — 세션당 1회, 1.5s 뒤 등장 · 12s 유지 ---------- */
  const teaser = root.querySelector<HTMLElement>('[data-chat-teaser]');
  function hideTeaser() {
    if (!teaser || teaser.hidden) return;
    teaser.classList.remove('is-on');
    setTimeout(() => { teaser.hidden = true; }, 300);
  }
  let teaserSeen = true;
  try { teaserSeen = sessionStorage.getItem('bd_teaser') === '1'; } catch { /* 비공개 모드 등 — 표시 안 함 */ }
  if (teaser && !teaserSeen) {
    try { sessionStorage.setItem('bd_teaser', '1'); } catch { /* 무시 */ }
    setTimeout(() => {
      if (openState) return;
      teaser.hidden = false;
      void teaser.offsetHeight;
      teaser.classList.add('is-on');
      setTimeout(hideTeaser, 12000);
    }, 1500);
  }
  root.querySelector('[data-chat-close]')?.addEventListener('click', close);
  backBtn.addEventListener('click', goBack);
  resetBtn.addEventListener('click', reset);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && openState) close(); });

  // 진입점 2: 히어로 로우·페이지 CTA — data-chat-tree="clean|as|install|etc"
  const TREE_START: Record<string, string> = {
    clean: 'clean.start',
    as: 'as.q1',
    install: 'install.start',
    etc: 'etc',
  };
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('[data-chat-tree]');
    if (!trigger) return;
    const tree = (trigger as HTMLElement).dataset.chatTree ?? 'menu';
    // 'menu'(기본 CtaBand·Hero·FAQ·사례 CTA)는 NODES에 없는 id다 — 홈 화면으로 열어야
    // 하는데, 원래부터 있던 결함(1f1ee76, 홈 화면 도입 커밋)으로 'home' 대신 'menu'가
    // 폴백에 박혀 있었다. goto()가 존재하지 않는 id에서 조용히 return해 패널만 열리고
    // 내용이 완전히 빈 화면이 됐다 — 08-24 라이브 재현으로 확인.
    open(TREE_START[tree] ?? 'home');
  });
</script>

<!-- is:global — 말풍선·칩·카드가 JS로 동적 생성되어 스코프 속성이 붙지 않는다. chat__ 네임스페이스로 충돌 방지. -->
<style is:global>
  /* ---------- 런처 ---------- */
  /* 런처 — 라벨 있는 필 (2026-09-03). 원형 아이콘만으로는 뭘 하는 버튼인지 안 읽혔다.
     Specular 림: React Bits SpecularButton(WebGL) 을 CSS conic 링 + JS 각도 보간으로 이식.
     --sb-angle(빛 방향)·--sb-bright(포인터 근접도) 를 스크립트가 갱신, hover 기기 전용. */
  .chat__fab {
    --sb-angle: 45deg;
    --sb-bright: 0;
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 60;
    height: 52px;
    padding: 0 18px 0 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #fff 12%, transparent); /* 원본 baseColor 스트로크 */
    background: var(--br-teal-deep);
    color: #fff;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 8%, transparent), 0 2px 6px rgba(0, 41, 58, 0.18), 0 10px 26px rgba(0, 41, 58, 0.28);
    transition: background-color var(--dur-color) ease, transform 200ms var(--ease-out);
  }
  .chat__fab:active { transform: scale(0.96); }
  @media (hover: hover) and (pointer: fine) {
    .chat__fab:hover { background: var(--br-teal); transform: scale(1.04); }
    .chat__fab:hover:active { transform: scale(0.96); }
  }
  /* specular 링 — 빛 방향 양쪽(0°·180°) 모서리에 ice 줄무늬. shineSize 10° + fade 40° */
  .chat__fab-fx {
    position: absolute; inset: -1px; border-radius: inherit; padding: 1px; pointer-events: none;
    background: conic-gradient(from calc(var(--sb-angle) - 50deg),
      transparent 0deg, var(--br-ice) 50deg, transparent 100deg,
      transparent 180deg, var(--br-ice) 230deg, transparent 280deg, transparent 360deg);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: var(--sb-bright);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--br-ice) 70%, transparent));
  }
  .chat__fab-label { font-size: 15px; font-weight: 700; letter-spacing: 0.01em; white-space: nowrap; }
  .chat.is-open .chat__fab-label { display: none; }
  .chat.is-open .chat__fab { padding: 0 14px; }
  .chat__fab-ico { display: grid; width: 22px; height: 22px; }
  /* 아이콘 크로스페이드 — 열림 시 말풍선 → X */
  .chat__fab-icon {
    grid-area: 1 / 1;
    transition: opacity 200ms cubic-bezier(0.2, 0, 0, 1), transform 200ms cubic-bezier(0.2, 0, 0, 1);
  }
  /* 티저 — 런처 위 선택 문구 3개. 오른쪽에서 순차 등장, 12s 뒤 사라짐 (스크립트) */
  .chat__teaser {
    position: fixed; right: 20px; bottom: 84px; z-index: 59;
    display: grid; gap: 8px; justify-items: end;
    max-width: calc(100vw - 40px);
  }
  .chat__teaser[hidden] { display: none; } /* display:grid 가 UA [hidden] 을 덮지 않게 */
  .chat__teaser-item {
    font: inherit; font-size: 14px; font-weight: 600; color: #fff; white-space: nowrap;
    padding: 10px 14px; border-radius: 999px;
    background: color-mix(in srgb, var(--br-teal-deep) 86%, transparent);
    border: 1px solid var(--glass-line-on-dark);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 22%, transparent), 0 6px 18px color-mix(in srgb, var(--br-teal-deep) 24%, transparent);
    opacity: 0; transform: translateX(16px);
    transition: opacity 240ms ease, transform 240ms var(--ease-out);
  }
  .chat__teaser.is-on .chat__teaser-item { opacity: 1; transform: none; }
  .chat__teaser.is-on .chat__teaser-item:nth-child(2) { transition-delay: 140ms; }
  .chat__teaser.is-on .chat__teaser-item:nth-child(3) { transition-delay: 280ms; }
  @media (hover: hover) and (pointer: fine) {
    .chat__teaser-item:hover { background: var(--br-teal); }
  }
  .chat__fab-icon--close { opacity: 0; transform: scale(0.25) rotate(-45deg); }
  .chat.is-open .chat__fab-icon--bubble { opacity: 0; transform: scale(0.25); }
  .chat.is-open .chat__fab-icon--close { opacity: 1; transform: scale(1) rotate(0deg); }

  /* ---------- 패널 ---------- */
  .chat__panel {
    position: fixed;
    right: 20px;
    bottom: 88px;
    z-index: 60;
    width: 380px;
    height: min(640px, calc(100dvh - 120px));
    display: flex;
    flex-direction: column;
    /* 유리 Heavy — 콘텐츠 위에 뜨는 고정 표면이라 유리가 가장 자연스러운 자리. 내부에 유리 없음(중첩 0) */
    background: var(--glass-heavy-bg);
    -webkit-backdrop-filter: var(--glass-heavy-fx);
    backdrop-filter: var(--glass-heavy-fx);
    border: 1px solid var(--glass-line);
    box-shadow: var(--glass-shadow);
    border-radius: 16px;
    overflow: hidden;
    isolation: isolate;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .chat__panel.is-open { opacity: 1; transform: translateY(0); }
  /* display:flex 가 UA [hidden] 을 덮어 닫힌 패널(opacity 0)이 우측 380×640 클릭을 가로채던 버그 — 로컬 가드 */
  .chat__panel[hidden] { display: none; }
  /* 패널 내부 앰비언트(2026-09-03): 말풍선·칩이 반투명이어도 뒤에 형체가 없으면 유리로 안 읽힌다(모바일은 전체화면이라 특히).
     딥 섹션과 같은 방식 — ::before 에 ice/teal 블롭. blur 없음(중첩 아님). */
  .chat__panel::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 34% at 12% 22%, color-mix(in srgb, var(--br-ice) 85%, transparent) 0%, color-mix(in srgb, var(--br-ice) 40%, transparent) 46%, transparent 74%),
      radial-gradient(50% 30% at 90% 58%, color-mix(in srgb, var(--br-ice) 70%, transparent) 0%, transparent 70%),
      radial-gradient(44% 26% at 30% 92%, color-mix(in srgb, var(--br-teal) 14%, transparent) 0%, transparent 70%);
  }

  /* ---------- 헤더 ---------- */
  .chat__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line); /* 1px 실버 헤어라인 */
    flex-shrink: 0;
  }
  .chat__head-title { font-family: var(--serif); font-weight: 600; font-size: 16px; }
  .chat__head-note { font-size: 12px; color: var(--ink-soft); margin-top: 2px; }
  .chat__head-close {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    color: var(--ink-soft);
    transition: color var(--dur-color) ease, background-color var(--dur-color) ease;
  }
  .chat__head-close:hover { color: var(--ink); background: var(--bg-soft); }

  /* ---------- 대화 영역 ---------- */
  .chat__log {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .chat__msg {
    max-width: 85%;
    font-size: 14px;
    line-height: 1.55;
    /* COPY의 L(...) 줄 나눔이 화면에 그대로 나오게 — 개행 위치를 문구가 통제한다 */
    white-space: pre-wrap;
    padding: 10px 14px;
    border-radius: 12px;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
    @starting-style { opacity: 0; transform: translateY(6px); }
  }
  /* 말풍선 유리(2026-09-03): 패널이 이미 Heavy blur라 말풍선엔 backdrop-filter를 다시 걸지 않는다(유리 중첩 금지).
     반투명 면 + 백색 림 + 상단 하이라이트만으로 패널의 블러가 비쳐 유리로 읽힌다. 알파는 본문 하한 70% 준수. */
  .chat__msg--bot {
    align-self: flex-start;
    background: color-mix(in srgb, #fff 64%, transparent);
    border: 1px solid var(--glass-line);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 90%, transparent), 0 6px 18px color-mix(in srgb, var(--br-teal) 8%, transparent);
    border-bottom-left-radius: 4px;
  }
  .chat__msg--user {
    align-self: flex-end;
    /* 흰 글자 AA(4.5) 확보 위해 Dark 등급(68%)보다 진한 86% — 밝은 히어로/패널 위 최악 케이스 실측 */
    background: color-mix(in srgb, var(--br-teal-deep) 86%, transparent);
    color: #fff;
    border: 1px solid var(--glass-line-on-dark);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 22%, transparent), 0 6px 18px color-mix(in srgb, var(--br-teal-deep) 24%, transparent);
    border-bottom-right-radius: 4px;
  }

  /* 타이핑 인디케이터 — 박스 점프(bxSpin) (2026-09-03, css-loaders 계열 순수 CSS 원본을 --size 로 축소 이식)
     원본: 48px 박스가 18px 아래로 튀며 90° 구르고(0.5s), 밑에 그림자가 늘었다 준다. 총 높이 65×size.
     말풍선 한 줄 높이(22px)에 맞춰 --size: .34px (박스 16px). 색: 박스 teal, 그림자 teal-deep 25%.
