---
// 문의 챗봇 — 메신저 대화형 UI. 4트리(세척/AS/설치/기타) 로직·분기·문구·접수카드 스펙은 v1 그대로 유지,
// 표현 계층(말풍선·칩·입력바)과 종점 동작(채널톡 상담 연결 + 폴백)만 교체.
// 진입점 2개: 플로팅 런처(전 페이지) + [data-chat-tree] 요소(홈 히어로 로우, /care/ CTA 등).
// 연락처·채널 값은 config.js 플레이스홀더 — 빈 값 폴백은 스크립트가 처리 (CLAUDE.md 절대 규칙 2).
import { SITE_CONFIG } from '../config.js';
import { loadFaq } from '../lib/faq.ts';

// FAQ — 빌드 타임에 faq.json을 한글 검증·정제해 클라이언트로 주입 (아래 application/json 스크립트)
const faqItems = loadFaq();
const faqJson = JSON.stringify(faqItems).replace(/</g, '\\u003c');
---
<div class="chat" data-chat-root>
  <script type="application/json" data-chat-faq set:html={faqJson} />
  <button
    type="button"
    class="chat__fab"
    data-chat-fab
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="문의 챗봇 열기"
  >
    <svg class="chat__fab-icon chat__fab-icon--bubble" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12a8.5 8.5 0 0 1-8.5 8.5c-1.3 0-2.6-.3-3.7-.8L4 21l1.4-4.5A8.5 8.5 0 1 1 21 12Z" />
    </svg>
    <svg class="chat__fab-icon chat__fab-icon--close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>

  <section class="chat__panel" data-chat-panel role="dialog" aria-modal="true" aria-label="바람대로 문의 챗봇" hidden>
    <header class="chat__head">
      <div class="chat__head-info">
        <p class="chat__head-title">바람대로</p>
        <p class="chat__head-note">{SITE_CONFIG.RESPONSE_NOTE}</p>
      </div>
      <button type="button" class="chat__head-close" data-chat-close aria-label="문의 챗봇 닫기">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </header>

    <div class="chat__log" data-chat-log aria-live="polite"></div>

    <div class="chat__composer">
      <div class="chat__nav">
        <button type="button" class="chat__nav-btn" data-chat-back disabled>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /></svg>
          이전
        </button>
        <button type="button" class="chat__nav-btn" data-chat-reset>처음으로</button>
      </div>
      <form class="chat__inputbar" data-chat-form>
        <input
          class="chat__input"
          data-chat-input
          type="number"
          min="1"
          inputmode="numeric"
          placeholder="선택지를 눌러 주세요"
          aria-label="메시지 입력"
          disabled
        />
        <button type="submit" class="chat__send" data-chat-send disabled aria-label="보내기">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></svg>
        </button>
      </form>
    </div>
  </section>

  <div class="chat__toast" data-chat-toast role="status" hidden></div>
</div>

<script>
  import { SITE_CONFIG } from '../config.js';
  import { channelEnabled, ensureChannel, openConsult } from '../lib/channel.ts';

  const root = document.querySelector('[data-chat-root]') as HTMLElement;
  const fab = root.querySelector('[data-chat-fab]') as HTMLButtonElement;
  const panel = root.querySelector('[data-chat-panel]') as HTMLElement;
  const log = root.querySelector('[data-chat-log]') as HTMLElement;
  const backBtn = root.querySelector('[data-chat-back]') as HTMLButtonElement;
  const resetBtn = root.querySelector('[data-chat-reset]') as HTMLButtonElement;
  const form = root.querySelector('[data-chat-form]') as HTMLFormElement;
  const input = root.querySelector('[data-chat-input]') as HTMLInputElement;
  const sendBtn = root.querySelector('[data-chat-send]') as HTMLButtonElement;
  const toastEl = root.querySelector('[data-chat-toast]') as HTMLElement;

  const KAKAO = SITE_CONFIG.KAKAO_CHANNEL_URL;
  const PHONE = SITE_CONFIG.PHONE;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  type Data = Record<string, string>;
  let data: Data = {};

  // faq.json 정제본 (빌드 타임 주입) — 홈 화면 pinned 노출 + 트리4 전체 목록
  type FaqItem = { q: string; a: string; pinned: boolean; next: { label: string; tree: string } | null };
  const FAQ: FaqItem[] = JSON.parse(root.querySelector('[data-chat-faq]')?.textContent || '[]');

  /* ---------- 상태 머신 정의 (v1 그대로 — 로직·분기·문구 변경 금지) ---------- */
  type Option = { label: string; next?: string; set?: Data; say?: string; tel?: string; sub?: boolean; consult?: boolean };
  type Node = {
    text?: string | ((d: Data) => string);
    options?: Option[];
    input?: { placeholder: string; key: string; next: string };
    card?: boolean;
    etc?: boolean;
    home?: boolean;
    phoneFirst?: boolean;
  };

  const REGION_NOTICE =
    '수도권 전 지역에서 시공합니다. 지방은 현장 규모에 따라 출장 시공이 가능합니다.';

  const regionOptions = (next: string): Option[] => [
    { label: '수도권', next, set: { 지역: '수도권' } },
    { label: '그 외 지역', next, set: { 지역: '그 외 지역' }, say: REGION_NOTICE },
  ];

  const NODES: Record<string, Node> = {
    // 챗봇 홈 화면 — 런처 진입 첫 화면 (히어로 로우 등 트리 직진입은 이 화면을 건너뛴다)
    home: {
      text: SITE_CONFIG.WELCOME_MESSAGE,
      home: true,
    },

    /* 트리1 — 세척 */
    'clean.start': {
      text: '기종을 선택해 주세요.',
      options: [
        { label: '벽걸이', next: 'clean.units', set: { 분류: '세척', 기종: '벽걸이' } },
        { label: '스탠드', next: 'clean.units', set: { 분류: '세척', 기종: '스탠드' } },
        { label: '천장형', next: 'clean.units', set: { 분류: '세척', 기종: '천장형' } },
        { label: '모름 · 사진으로 확인', next: 'clean.units', set: { 분류: '세척', 기종: '모름 · 사진으로 확인' } },
      ],
    },
    'clean.units': {
      text: '몇 대인가요? 숫자로 입력해 주세요.',
      input: { placeholder: '예: 2', key: '대수', next: 'clean.region' },
    },
    'clean.region': { text: '지역이 어디신가요?', options: regionOptions('clean.end') },
    'clean.end': {
      text: '전면·측면 사진을 보내주시면 확정 견적을 드립니다.',
      card: true,
    },

    /* 트리2 — AS */
    'as.q1': {
      text: '바람대로에서 시공 또는 세척·관리를 받으셨나요?',
      options: [
        { label: '예', next: 'as.symptom', set: { 분류: 'AS' } },
        { label: '아니오 · 모르겠음', next: 'as.nonclient' },
      ],
    },
    'as.nonclient': {
      text: 'AS는 바람대로 시공·관리 고객 대상으로 운영하고 있습니다. 제품 자체 이상은 제조사 서비스센터가 가장 빠릅니다. 혹시 저희에게 받으신 것 같은데 기억이 안 나신다면, 연락처로 확인해 드립니다.',
      options: [
        { label: '상담 연결', consult: true },
        { label: '삼성 서비스센터 1588-3366', tel: '15883366' },
        { label: 'LG 서비스센터 1544-7777', tel: '15447777' },
        { label: '기타 브랜드', next: 'as.othermaker' },
        { label: '세척 견적 받기 — 브랜드 관계없이 가능합니다', next: 'clean.start', sub: true },
      ],
    },
    'as.othermaker': {
      text: '제품 본체 라벨에 적힌 제조사 고객센터로 문의해 주세요. 세척·점검은 바람대로에서 브랜드 관계없이 가능합니다.',
      options: [
        { label: '세척 견적 받기', next: 'clean.start' },
        { label: '처음으로', next: 'home', sub: true },
      ],
    },
    'as.symptom': {
      text: '어떤 증상인가요?',
      options: [
        { label: '냄새', next: 'as.smell', set: { 증상: '냄새' } },
        { label: '누수 (물이 샘)', next: 'as.leak', set: { 증상: '누수', 긴급: '긴급' } },
        { label: '소음·진동', next: 'as.when', set: { 증상: '소음·진동' }, say: '작동 영상을 함께 보내주시면 확인이 빠릅니다.' },
        { label: '에러코드·작동불량', next: 'as.when', set: { 증상: '에러코드·작동불량' } },
        { label: '냉방 약함', next: 'as.when', set: { 증상: '냉방 약함' }, say: '실내기·실외기 사진을 함께 보내주시면 확인이 빠릅니다.' },
      ],
    },
    'as.smell': {
      text: '냄새는 고장이 아니라 내부 오염입니다. 분해 세척으로 해결됩니다. 세척 견적으로 이어드릴게요.',
      options: [{ label: '세척 견적 받기', next: 'clean.start' }],
    },
    'as.leak': {
      text: '누수는 긴급 상황입니다. 감전·합선 위험이 있으니 에어컨 전원을 꺼두세요. 빠른 처리가 필요하면 전화 주세요.',
      phoneFirst: true,
      options: regionOptions('as.card'),
    },
    'as.when': {
      text: '시공·세척 받으신 지 얼마나 되셨나요?',
      options: [
        { label: '2년 이내', next: 'as.region', set: { 고객구분: '무상' }, say: '시공 후 2년 이내라 무상 점검 대상입니다.' },
        { label: '2년 넘음', next: 'as.region', set: { 고객구분: '유상' }, say: '시공 후 2년이 지나 유상 점검으로 진행됩니다. 방문 전에 예상 금액을 안내드립니다.' },
        { label: '모름', next: 'as.region', set: { 고객구분: '확인 필요' } },
      ],
    },
    'as.region': { text: '지역이 어디신가요?', options: regionOptions('as.card') },
    'as.card': {
      text: '접수 내용을 정리했습니다.',
      card: true,
    },

    /* 트리3 — 설치 */
    'install.space': {
      text: '설치 공간이 어디인가요?',
      options: [
        { label: '아파트·주택', next: 'install.brand', set: { 분류: '설치', 공간: '아파트·주택' } },
        { label: '상가·사무실', next: 'install.brand', set: { 분류: '설치', 공간: '상가·사무실' } },
        {
          label: '신축 입주 예정',
          next: 'install.brand',
          set: { 분류: '설치', 공간: '신축 입주 예정' },
          say: '신축 입주 단지는 공동구매를 진행합니다. 접수 남겨주시면 단지 일정에 맞춰 안내드립니다.',
        },
      ],
    },
    'install.brand': {
      text: '브랜드를 선택해 주세요.',
      options: [
        ...SITE_CONFIG.BRANDS_INSTALL.map((b: string) => ({ label: b, next: 'install.type', set: { 브랜드: b } })),
        { label: '상담으로 결정', next: 'install.type', set: { 브랜드: '상담으로 결정' } },
      ],
    },
    'install.type': {
      text: '설치 유형을 선택해 주세요.',
      options: [
        { label: '신규 설치', next: 'install.units', set: { 유형: '신규 설치' } },
        {
          label: '이전 설치',
          next: 'install.units',
          set: { 유형: '이전 설치' },
          say: '이전 설치는 기존 배관 상태를 봐야 해서 전화 상담이 정확합니다. 접수만 남겨주셔도 됩니다.',
        },
      ],
    },
    'install.units': {
      text: '몇 대인가요? 숫자로 입력해 주세요.',
      input: { placeholder: '예: 1', key: '대수', next: 'install.region' },
    },
    'install.region': { text: '지역이 어디신가요?', options: regionOptions('install.end') },
    'install.end': {
      text: '도면이나 설치 위치 사진이 있으면 함께 보내주세요.',
      card: true,
    },

    /* 트리4 — 기타 */
    etc: {
      text: '원하시는 채널로 문의해 주세요.',
      etc: true,
    },
  };

  /* ---------- 렌더 프리미티브 ---------- */
  const delay = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const scrollDown = () => { log.scrollTop = log.scrollHeight; };

  let renderToken = 0;

  function bubble(text: string, who: 'bot' | 'user' = 'bot'): HTMLElement {
    const el = document.createElement('p');
    el.className = `chat__msg chat__msg--${who}`;
    el.textContent = text;
    log.appendChild(el);
    scrollDown();
    return el;
  }

  /** 봇 말풍선 앞 타이핑 인디케이터 200ms — reduced-motion 시 생략 */
  async function typing(token: number) {
    if (reducedMotion.matches) return;
    // 개발 전용 검증 훅 — 헤드리스 팬은 백그라운드 타이머 스로틀링으로 200ms가 수 초로 늘어난다.
    // 프로드 빌드에서는 이 분기가 제거된다.
    if (import.meta.env.DEV && sessionStorage.getItem('BD_FAST')) return;
    const el = document.createElement('div');
    el.className = 'chat__msg chat__msg--bot chat__typing';
    el.setAttribute('aria-hidden', 'true');
    el.innerHTML = '<span></span><span></span><span></span>';
    log.appendChild(el);
    scrollDown();
    await delay(200);
    el.remove();
    if (token !== renderToken) throw new Error('stale');
  }

  function chip(label: string, kind: 'default' | 'sub' | 'tel' | 'primary' = 'default'): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = `chat__chip chat__chip--${kind}`;
    btn.textContent = label;
    return btn;
  }

  function telChip(label: string, tel: string, primary = false): HTMLAnchorElement {
    const a = document.createElement('a');
    a.className = primary ? 'chat__chip chat__chip--primary' : 'chat__chip chat__chip--tel';
    a.href = `tel:${tel}`;
    a.textContent = label;
    return a;
  }

  /** 칩 그룹 — 선택 시 그룹 전체 비활성 보존, 선택 칩 표시. 좌우/상하 키보드 탐색 지원 */
  function chipGroup(): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'chat__chips';
    wrap.setAttribute('role', 'group');
    wrap.addEventListener('keydown', (e) => {
      if (!['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(e.key)) return;
      const chips = [...wrap.querySelectorAll<HTMLElement>('.chat__chip:not(:disabled)')];
      const idx = chips.indexOf(document.activeElement as HTMLElement);
      if (idx === -1) return;
      e.preventDefault();
      const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : -1;
      chips[(idx + dir + chips.length) % chips.length]?.focus();
    });
    log.appendChild(wrap);
    return wrap;
  }

  function settleGroup(wrap: HTMLElement, chosen?: HTMLElement) {
    wrap.querySelectorAll('button').forEach((b) => { b.disabled = true; });
    wrap.classList.add('is-settled');
    chosen?.classList.add('is-chosen');
  }

  /* ---------- 입력바 ---------- */
  let inputHandler: ((value: number) => void) | null = null;

  function armInput(placeholder: string, onSubmit: (n: number) => void) {
    inputHandler = onSubmit;
    input.disabled = false;
    sendBtn.disabled = false;
    input.placeholder = placeholder;
    input.value = '';
    input.focus();
  }

  function disarmInput() {
    inputHandler = null;
    input.disabled = true;
    sendBtn.disabled = true;
    input.placeholder = '선택지를 눌러 주세요';
    input.value = '';
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!inputHandler) return;
    const n = parseInt(input.value, 10);
    if (!n || n < 1) { input.focus(); return; }
    const handler = inputHandler;
    disarmInput();
    handler(n);
  });

  /* ---------- 히스토리 (← 이전) ---------- */
  type Checkpoint = { nodeId: string; logLen: number; data: Data };
  let stack: Checkpoint[] = [];

  function updateNav() {
    backBtn.disabled = stack.length <= 1;
  }

  function goBack() {
    if (stack.length <= 1) return;
    renderToken += 1;
    stack.pop(); // 현재 스텝 버림
    const prev = stack.pop()!; // 이전 스텝 — goto가 다시 push
    while (log.children.length > prev.logLen) log.lastElementChild?.remove();
    data = { ...prev.data };
    disarmInput();
    void goto(prev.nodeId);
  }

  /* ---------- 노드 렌더 ---------- */
  async function goto(id: string) {
    const node = NODES[id];
    if (!node) return;
    const token = ++renderToken;
    stack.push({ nodeId: id, logLen: log.children.length, data: { ...data } });
    updateNav();
    disarmInput();

    try {
      if (node.text) {
        await typing(token);
        bubble(typeof node.text === 'function' ? node.text(data) : node.text);
      }
      if (token !== renderToken) return;

      if (node.options || node.phoneFirst) {
        const group = chipGroup();
        if (node.phoneFirst && PHONE) {
          group.appendChild(telChip(`지금 전화하기 ${PHONE}`, PHONE.replace(/[^0-9]/g, ''), true));
        }
        (node.options ?? []).forEach((opt) => {
          if (opt.tel) {
            group.appendChild(telChip(opt.label, opt.tel));
            return;
          }
          if (opt.consult) {
            // 상담 연결 칩 — 채널톡 열기 (키 없으면 미노출, 기존 폴백 경로 유지)
            if (!channelEnabled()) return;
            const btn = chip(opt.label, 'primary');
            btn.addEventListener('click', async () => {
              btn.disabled = true;
              const ok = (await ensureChannel()) && openConsult();
              btn.disabled = false;
              if (ok) close();
              else toast('상담 연결에 실패했습니다. 잠시 후 다시 시도해 주세요.');
            });
            group.appendChild(btn);
            return;
          }
          const btn = chip(opt.label, opt.sub ? 'sub' : 'default');
          btn.addEventListener('click', async () => {
            const t = ++renderToken;
            settleGroup(group, btn);
            bubble(opt.label, 'user');
            if (opt.set) Object.assign(data, opt.set);
            try {
              if (opt.say) {
                await typing(t);
                bubble(opt.say);
              }
            } catch { return; }
            if (opt.next) void goto(opt.next);
          });
          group.appendChild(btn);
        });
        scrollDown();
      }

      if (node.input) {
        const spec = node.input;
        armInput(spec.placeholder, (n) => {
          data[spec.key] = `${n}대`;
          bubble(`${n}대`, 'user');
          void goto(spec.next);
        });
      }

      if (node.card) renderCard();
      if (node.etc) renderEtc();
      if (node.home) renderHome();
    } catch {
      /* stale render — 무시 */
    }
  }

  /* ---------- 홈 화면 (메뉴 4칩 + pinned FAQ) ---------- */
  const HOME_MENU: Array<{ label: string; next: string }> = [
    { label: '설치 견적', next: 'install.space' },
    { label: '세척 견적', next: 'clean.start' },
    { label: 'AS 접수', next: 'as.q1' },
    { label: '기타 문의', next: 'etc' },
  ];

  function renderHome() {
    const group = chipGroup();
    HOME_MENU.forEach((m) => {
      const btn = chip(m.label);
      btn.addEventListener('click', () => {
        settleGroup(group, btn);
        bubble(m.label, 'user');
        void goto(m.next);
      });
      group.appendChild(btn);
    });
    renderFaqChips(FAQ.filter((f) => f.pinned), '자주 묻는 질문');
    scrollDown();
  }

  /* ---------- FAQ 즉답 ---------- */
  function renderFaqChips(items: FaqItem[], label?: string) {
    if (!items.length) return;
    if (label) {
      const p = document.createElement('p');
      p.className = 'chat__faq-label';
      p.textContent = label;
      log.appendChild(p);
    }
    const group = chipGroup();
    items.forEach((f) => {
      const btn = chip(f.q);
      btn.addEventListener('click', () => {
        settleGroup(group, btn);
        void runFaq(f);
      });
      group.appendChild(btn);
    });
  }

  async function runFaq(f: FaqItem) {
    const t = ++renderToken;
    bubble(f.q, 'user');
    try {
      await typing(t);
    } catch { return; }
    bubble(f.a);
    // 막다른 답변 금지 — next 유도 칩 또는 홈 메뉴가 반드시 따른다
    if (f.next && TREE_START[f.next.tree]) {
      const group = chipGroup();
      const btn = chip(f.next.label, 'primary');
      btn.addEventListener('click', () => {
        settleGroup(group, btn);
        bubble(f.next!.label, 'user');
        void goto(TREE_START[f.next!.tree]);
      });
      group.appendChild(btn);
      const homeBtn = chip('홈 메뉴', 'sub');
      homeBtn.addEventListener('click', () => {
        settleGroup(group, homeBtn);
        renderHome();
      });
      group.appendChild(homeBtn);
    } else {
      renderHome();
    }
    scrollDown();
  }

  /* ---------- 접수카드 (텍스트 생성 스펙 v1 그대로) ---------- */
  function buildCard(): string {
    const lines = ['[바람대로 접수]'];
    const push = (k: string, v?: string) => { if (v) lines.push(`${k}: ${v}`); };
    push('분류', data.긴급 ? `${data.분류} (긴급)` : data.분류);
    if (data.분류 === 'AS') push('고객구분', data.고객구분 ?? '확인 필요');
    push('공간', data.공간);
    if (data.분류 === '설치') push('브랜드·유형', [data.브랜드, data.유형].filter(Boolean).join(' · '));
    push('기종', data.기종);
    push('대수', data.대수);
    push('지역', data.지역);
    push('증상', data.증상);
    return lines.join('\n');
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    }
  }

  function ctaButton(label: string, kind: 'primary' | 'ghost' | 'sub' = 'primary'): HTMLButtonElement {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = `chat__cta chat__cta--${kind}`;
    btn.textContent = label;
    return btn;
  }

  function ctaTel(label: string, kind: 'primary' | 'ghost' = 'ghost'): HTMLAnchorElement {
    const a = document.createElement('a');
    a.className = `chat__cta chat__cta--${kind}`;
    a.href = `tel:${PHONE.replace(/[^0-9]/g, '')}`;
    a.textContent = label;
    return a;
  }

  /** 채널톡 없음·실패 시 기존 폴백 동작 그대로: 자동복사 + 토스트 + 카카오/전화/복사 안내.
      silent=true면 자동복사·토스트 생략 (호출측이 이미 복사·안내한 경우) */
  function renderFallbackCtas(text: string, wrap: HTMLElement, silent = false) {
    if (!silent) {
      copyText(text).then((ok) => {
        if (ok) toast('복사되었습니다. 상담 창에 붙여넣어 주세요.');
      });
    }
    if (KAKAO) {
      const btn = ctaButton('카톡으로 접수하기', 'primary');
      btn.addEventListener('click', async () => {
        await copyText(text);
        toast('복사되었습니다. 상담 창에 붙여넣어 주세요.');
        window.open(KAKAO, '_blank', 'noopener');
      });
      wrap.appendChild(btn);
    } else if (PHONE) {
      wrap.appendChild(ctaTel(`전화로 접수하기 ${PHONE}`, 'primary'));
    } else {
      bubble('접수 채널 준비 중입니다. 카드 내용이 복사되어 있으니 채널 오픈 후 붙여넣어 주세요.');
    }
    const again = ctaButton('카드 다시 복사', 'sub');
    again.addEventListener('click', async () => {
      const ok = await copyText(text);
      toast(ok ? '복사되었습니다. 상담 창에 붙여넣어 주세요.' : '복사에 실패했습니다. 카드를 길게 눌러 복사해 주세요.');
    });
    wrap.appendChild(again);
  }

  function renderCard() {
    const text = buildCard();
    const card = document.createElement('div');
    card.className = 'chat__card';
    const label = document.createElement('p');
    label.className = 'chat__card-label';
    label.textContent = '접수 카드';
    const pre = document.createElement('pre');
    pre.textContent = text;
    card.append(label, pre);
    log.appendChild(card);

    const wrap = document.createElement('div');
    wrap.className = 'chat__ctas';
    log.appendChild(wrap);

    const isUrgent = !!data.긴급;

    if (channelEnabled()) {
      // 상담 연결: 접수카드를 첫 메시지로 프리필 → 고객이 전송만 하면 상담 시작
      // 누수 긴급은 전화가 주 CTA — 단, 전화 미기입이면 상담 연결을 주 CTA로 승격
      const consult = ctaButton('상담 연결', isUrgent && PHONE ? 'ghost' : 'primary');
      consult.addEventListener('click', async () => {
        consult.disabled = true;
        const ok = (await ensureChannel()) && openConsult(text);
        consult.disabled = false;
        if (ok) {
          close();
        } else {
          await copyText(text);
          toast('상담 연결이 안 됩니다. 접수 내용은 복사해 두었으니 전화로 연락 주세요.');
          consult.remove();
          renderFallbackCtas(text, wrap, true);
          scrollDown();
        }
      });
      // 누수 긴급 경로는 전화가 주 CTA (기존 우선순위 유지)
      if (isUrgent && PHONE) {
        wrap.appendChild(ctaTel(`전화하기 ${PHONE}`, 'primary'));
        wrap.appendChild(consult);
      } else {
        wrap.appendChild(consult);
        if (PHONE) wrap.appendChild(ctaTel(`전화하기 ${PHONE}`, 'ghost'));
      }
    } else {
      renderFallbackCtas(text, wrap);
    }

    const home = ctaButton('처음으로', 'sub');
    home.addEventListener('click', reset);
    wrap.appendChild(home);
    scrollDown();
  }

  /* ---------- 기타 트리 — FAQ 전체 목록 + 상담 연결 + 전화 ---------- */
  function renderEtc() {
    renderFaqChips(FAQ, FAQ.length ? '자주 묻는 질문' : undefined);

    const wrap = document.createElement('div');
    wrap.className = 'chat__ctas';
    log.appendChild(wrap);

    if (channelEnabled()) {
      const consult = ctaButton('상담 연결', 'primary');
      consult.addEventListener('click', async () => {
        consult.disabled = true;
        const ok = (await ensureChannel()) && openConsult();
        consult.disabled = false;
        if (ok) close();
        else toast('상담 연결에 실패했습니다. 잠시 후 다시 시도해 주세요.');
      });
      wrap.appendChild(consult);
      if (PHONE) wrap.appendChild(ctaTel(`전화 ${PHONE}`, 'ghost'));
    } else {
      if (KAKAO) {
        const btn = ctaButton('카카오톡 채널', 'primary');
        btn.addEventListener('click', () => window.open(KAKAO, '_blank', 'noopener'));
        wrap.appendChild(btn);
      }
      if (PHONE) wrap.appendChild(ctaTel(`전화 ${PHONE}`, 'ghost'));
      if (!KAKAO && !PHONE) {
        bubble('문의 채널 준비 중입니다. 세척·설치 견적은 아래 메뉴에서 바로 접수할 수 있습니다.');
      }
    }

    const home = ctaButton('처음으로', 'sub');
    home.addEventListener('click', reset);
    wrap.appendChild(home);
    scrollDown();
  }

  /* ---------- 토스트 ---------- */
  let toastTimer: ReturnType<typeof setTimeout>;
  function toast(msg: string) {
    toastEl.textContent = msg;
    toastEl.hidden = false;
    toastEl.classList.add('is-on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toastEl.classList.remove('is-on');
      setTimeout(() => { toastEl.hidden = true; }, 250);
    }, 2600);
  }

  /* ---------- 패널 열기/닫기 · 포커스 트랩 ---------- */
  let openState = false;
  let lastFocus: HTMLElement | null = null;

  function focusables(): HTMLElement[] {
    return [...panel.querySelectorAll<HTMLElement>('button:not(:disabled), a[href], input:not(:disabled)')]
      .filter((el) => el.offsetParent !== null);
  }

  panel.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const els = focusables();
    if (!els.length) return;
    const first = els[0];
    const last = els[els.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  function open(startNode = 'home') {
    lastFocus = document.activeElement as HTMLElement;
    data = {};
    stack = [];
    renderToken += 1;
    log.innerHTML = '';
    disarmInput();
    panel.hidden = false;
    // rAF 대신 동기 리플로우 — 백그라운드 탭(rAF 정지)에서도 열림 상태가 즉시 적용된다
    void panel.offsetHeight;
    panel.classList.add('is-open');
    root.classList.add('is-open');
    fab.setAttribute('aria-expanded', 'true');
    fab.setAttribute('aria-label', '문의 챗봇 닫기');
    openState = true;
    void ensureChannel(); // lazy boot — 카드 도달 전에 준비되도록 미리 시작 (키 없으면 즉시 no-op)
    void goto(startNode);
    (root.querySelector('[data-chat-close]') as HTMLElement)?.focus();
  }

  function close() {
    panel.classList.remove('is-open');
    root.classList.remove('is-open');
    fab.setAttribute('aria-expanded', 'false');
    fab.setAttribute('aria-label', '문의 챗봇 열기');
    openState = false;
    setTimeout(() => { panel.hidden = true; }, 220);
    lastFocus?.focus();
  }

  // 처음으로 = 챗봇 홈 화면 (트리 직진입으로 연 경우에도 홈으로)
  function reset() {
    data = {};
    stack = [];
    renderToken += 1;
    log.innerHTML = '';
    disarmInput();
    void goto('home');
  }

  fab.addEventListener('click', () => (openState ? close() : open()));
  root.querySelector('[data-chat-close]')?.addEventListener('click', close);
  backBtn.addEventListener('click', goBack);
  resetBtn.addEventListener('click', reset);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && openState) close(); });

  // 진입점 2: 히어로 로우·페이지 CTA — data-chat-tree="clean|as|install|etc"
  const TREE_START: Record<string, string> = {
    clean: 'clean.start',
    as: 'as.q1',
    install: 'install.space',
    etc: 'etc',
  };
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('[data-chat-tree]');
    if (!trigger) return;
    const tree = (trigger as HTMLElement).dataset.chatTree ?? 'menu';
    open(TREE_START[tree] ?? 'menu');
  });
</script>

<!-- is:global — 말풍선·칩·카드가 JS로 동적 생성되어 스코프 속성이 붙지 않는다. chat__ 네임스페이스로 충돌 방지. -->
<style is:global>
