---
// 문의 챗봇 — 메신저 대화형 UI. 4트리(세척/AS/설치/기타) 로직·분기·문구·접수카드 스펙은 v1 그대로 유지,
// 표현 계층(말풍선·칩·입력바)과 종점 동작(채널톡 상담 연결 + 폴백)만 교체.
// 진입점 2개: 플로팅 런처(전 페이지) + [data-chat-tree] 요소(홈 히어로 로우, /care/ CTA 등).
// 연락처·채널 값은 config.js 플레이스홀더 — 빈 값 폴백은 스크립트가 처리 (CLAUDE.md 절대 규칙 2).
import { SITE_CONFIG } from '../config.js';
import { loadFaq } from '../lib/faq.ts';

// FAQ — 빌드 타임에 faq.json을 한글 검증·정제해 클라이언트로 주입 (아래 application/json 스크립트)
const faqItems = loadFaq();
const faqJson = JSON.stringify(faqItems).replace(/</g, '\\u003c');
// 런처 위 선택 문구(티저) — 세션당 1회, 1.5s 뒤 등장해 12s 유지. 누르면 해당 흐름으로 바로 진입.
// 한 줄 25자 상한(챗봇 카피 규칙). 키는 TREE_START(install/clean/as/etc)와 일치해야 한다.
const TEASER = [
  { tree: 'install', text: '설치 견적 받고 싶어요' },
  { tree: 'clean', text: '분해세척 견적 받고 싶어요' },
  { tree: 'as', text: '쓰던 에어컨에 문제가 있어요' },
];
---
<div class="chat" data-chat-root>
  <script type="application/json" data-chat-faq set:html={faqJson} />
  <button
    type="button"
    class="chat__fab"
    data-chat-fab
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="문의 챗봇 열기"
  >
    <span class="chat__fab-fx" aria-hidden="true"></span>
    <span class="chat__fab-ico" aria-hidden="true">
      <svg class="chat__fab-icon chat__fab-icon--bubble" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12a8.5 8.5 0 0 1-8.5 8.5c-1.3 0-2.6-.3-3.7-.8L4 21l1.4-4.5A8.5 8.5 0 1 1 21 12Z" />
      </svg>
      <svg class="chat__fab-icon chat__fab-icon--close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </span>
    <span class="chat__fab-label">견적 문의</span>
  </button>
  <div class="chat__teaser" data-chat-teaser hidden>
    {TEASER.map((t) => (
      <button type="button" class="chat__teaser-item" data-chat-tree={t.tree}>{t.text}</button>
    ))}
  </div>

  <section class="chat__panel" data-chat-panel role="dialog" aria-modal="true" aria-label="바람대로 문의 챗봇" hidden>
    <header class="chat__head">
      <div class="chat__head-info">
        <p class="chat__head-title">바람대로</p>
        {SITE_CONFIG.RESPONSE_NOTE && <p class="chat__head-note">{SITE_CONFIG.RESPONSE_NOTE}</p>}
      </div>
      <button type="button" class="chat__head-close" data-chat-close aria-label="문의 챗봇 닫기">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </header>

    <div class="chat__log" data-chat-log aria-live="polite"></div>

    <div class="chat__composer">
      <div class="chat__nav">
        <button type="button" class="chat__nav-btn" data-chat-back disabled>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /></svg>
          이전
        </button>
        <button type="button" class="chat__nav-btn" data-chat-reset>처음으로</button>
      </div>
      <form class="chat__inputbar" data-chat-form>
        <input
          class="chat__input"
          data-chat-input
          type="text"
          inputmode="numeric"
          placeholder="선택지를 눌러 주세요"
          aria-label="메시지 입력"
          autocomplete="off"
          disabled
        />
        <button type="submit" class="chat__send" data-chat-send disabled aria-label="보내기">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></svg>
        </button>
      </form>
    </div>
  </section>

  <div class="chat__toast" data-chat-toast role="status" hidden></div>
</div>

<script>
  import { SITE_CONFIG } from '../config.js';
  import { channelEnabled, ensureChannel, openConsult } from '../lib/channel.ts';

  const root = document.querySelector('[data-chat-root]') as HTMLElement;
  const fab = root.querySelector('[data-chat-fab]') as HTMLButtonElement;
  const panel = root.querySelector('[data-chat-panel]') as HTMLElement;
  const log = root.querySelector('[data-chat-log]') as HTMLElement;
  const backBtn = root.querySelector('[data-chat-back]') as HTMLButtonElement;
  const resetBtn = root.querySelector('[data-chat-reset]') as HTMLButtonElement;
  const form = root.querySelector('[data-chat-form]') as HTMLFormElement;
  const input = root.querySelector('[data-chat-input]') as HTMLInputElement;
  const sendBtn = root.querySelector('[data-chat-send]') as HTMLButtonElement;
  const toastEl = root.querySelector('[data-chat-toast]') as HTMLElement;

  const KAKAO = SITE_CONFIG.KAKAO_CHANNEL_URL;
  const PHONE = SITE_CONFIG.PHONE;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  type Data = Record<string, string>;
  let data: Data = {};

  // faq.json 정제본 (빌드 타임 주입) — 홈 화면 pinned 노출 + 트리4 전체 목록
  type FaqItem = { q: string; a: string; pinned: boolean; next: { label: string; tree: string } | null };
  const FAQ: FaqItem[] = JSON.parse(root.querySelector('[data-chat-faq]')?.textContent || '[]');

  /* ---------- 상태 머신 정의 (v1 그대로 — 로직·분기·문구 변경 금지) ---------- */
  type Option = { label: string; next?: string; set?: Data; say?: string; tel?: string; sub?: boolean; consult?: boolean };
  type Node = {
    /** 배열이면 순서대로 여러 말풍선으로 나뉘어 렌더된다 (말풍선 하나 = 메시지 하나) */
    text?: string | ((d: Data) => string) | string[];
    options?: Option[];
    input?: {
      placeholder: string | ((d: Data) => string);
      key: string;
      next: string;
      /** number = 숫자만 (대수), text = 자유 입력 (아파트명·층수). 기본 number */
      type?: 'number' | 'text';
      /** number 값 뒤에 붙일 단위 — 저장·말풍선 공통 */
      suffix?: string;
      /** text 최대 길이 */
      max?: number;
      /** 입력 직후 붙이는 안내 한 줄 (질문 아님 — 되묻기 1개 규칙 유지) */
      say?: string;
    };
    card?: boolean;
    etc?: boolean;
    home?: boolean;
    /** FAQ 본문으로 보내는 링크 칩 1개 — 챗봇은 짧게, 깊은 답은 FAQ가 (남발 금지) */
    link?: { label: string; href: string };
  };

  /* ═══════════════════════════════════════════════════════════════════
     문구 템플릿 (COPY) — 챗봇이 하는 말은 전부 여기 있다.
     아래 NODES는 순서·분기만 담당하므로, 말투를 고칠 때 NODES는 건드리지 않는다.

     ▸ L(...) 의 인자 한 칸 = 화면의 한 줄. 줄바꿈 위치를 그대로 통제한다.
         L('방문 전에 견적을 확정해', '알려드리겠습니다.')
           →  방문 전에 견적을 확정해
              알려드리겠습니다.
     ▸ 한 줄로 끝나는 문구는 L 없이 그냥 문자열로 둔다.
     ▸ 한 줄 상한은 한글 25자다 (360px·데스크톱 패널 모두 말풍선 279px로 동일 — 실측).
       넘기면 자동 줄바꿈이 끼어들어 의도한 줄 나눔이 깨진다. 여유를 두고 22자 안쪽 권장.
       숫자·영문이 섞이면 폭이 줄어 26자도 들어갈 때가 있으나, 자수로 세지 말고 아래로 검사할 것.
     ▸ 끊는 자리는 어절·의미 단위. 조사만 다음 줄로 넘기지 않는다.
         (X) '신축·입주 예정 단지는 공동구매를' / '진행합니다.'
         (O) '신축·입주 예정 단지는' / '공동구매를 진행합니다.'
     ▸ 줄 앞뒤 공백은 그대로 화면에 나온다(pre-wrap). 공백으로 정렬하지 말 것.
     ▸ 고친 뒤 검사법 — 챗봇을 열고 브라우저 콘솔에 붙여넣으면 넘친 줄만 뽑아준다:
         (() => { const l=document.querySelector('[data-chat-log]'),p=document.createElement('p');
           p.className='chat__msg chat__msg--bot'; l.appendChild(p);
           const c=getComputedStyle(p), lh=parseFloat(c.lineHeight),
             pd=parseFloat(c.paddingTop)+parseFloat(c.paddingBottom);
           const bad=[...document.querySelectorAll('[data-chat-log] .chat__msg--bot')]
             .flatMap(b=>b.textContent.split('\n')).filter(t=>{ p.textContent=t;
               return Math.round((p.getBoundingClientRect().height-pd)/lh)>1; });
           p.remove(); return bad; })()
       → 빈 배열이면 통과. 화면에 이미 나온 말풍선만 검사하므로 트리를 걸어가며 확인한다.
     ═══════════════════════════════════════════════════════════════════ */
  const L = (...lines: string[]) => lines.join('\n');

  const COPY = {
    /* --- 공통 --- */
    ask_region: '지역이 어디신가요? (시·구까지면 됩니다)',
    // 지역 입력 직후 한 줄. 그 외 지역은 접수 후 안내로 흐른다 (별도 분기 없음)
    say_region: '수도권 전 지역에서 시공합니다.',
    ask_units: '몇 대인가요?',

    /* --- 트리1 세척 --- */
    clean_start: L(
      '세척 견적은 세 가지면 됩니다.',
      '· 기종',
      '· 대수',
      '· 지역',
      '먼저, 기종을 알려주세요.',
    ),
    clean_unsure: L('괜찮습니다.', '천장에 매립된 형태인가요,', '벽이나 바닥에 있는 형태인가요?'),
    clean_end: (d: Data) =>
      L(
        '접수됐습니다. 정리하면',
        `· 기종: ${d.기종 ?? ''}`,
        `· 대수: ${d.대수 ?? ''}`,
        `· 지역: ${d.지역 ?? ''}`,
        '확인 후 금액과 가능한 일정을',
        '안내드립니다.',
        '사전에 말씀드리지 않은',
        '추가금은 없습니다.',
      ),

    /* --- 트리2 AS --- */
    as_q1: L('바람대로에서 시공 또는', '세척·관리를 받으셨나요?'),
    as_nonclient: L(
      'AS는 바람대로 시공·관리 고객 대상으로',
      '운영하고 있습니다.',
      '제품 자체 이상은',
      '제조사 서비스센터가 가장 빠릅니다.',
      '혹시 저희에게 받으신 것 같은데',
      '기억이 안 나신다면,',
      '연락처로 확인해 드립니다.',
    ),
    as_othermaker: L(
      '제품 본체 라벨에 적힌',
      '제조사 고객센터로 문의해 주세요.',
      '세척·점검은 바람대로에서',
      '브랜드 관계없이 가능합니다.',
    ),
    as_symptom: '어떤 증상인가요?',
    // 냄새만 원인이 위치별로 갈려 FAQ 본문으로 이어준다 (앵커 링크는 여기 1곳뿐 — 남발 금지)
    as_smell: L(
      '냄새는 원인 위치가 나뉩니다.',
      '· 곰팡이 — 내부 부품',
      '· 하수구 냄새 — 배수 경로',
      '원인에 따라 대응이 달라서,',
      '상태 확인 후 안내드립니다.',
      '연락처를 남겨주시겠어요?',
    ),
    as_smell_link: '냄새 원인 자세히 보기',
    // 누수 전용 — 안전 안내가 첫 줄이라 공통 블록에 묶지 않는다 (묶었다가 안내가 사라진 이력)
    as_leak: L(
      '먼저 전원을 꺼주세요.',
      '새는 물이 전기 부품에 닿으면',
      '위험할 수 있습니다.',
      '',
      '물이 떨어지는 원인은',
      '크게 세 가지입니다.',
      '· 배수 배관 막힘',
      '· 배관 경사 문제',
      '· 결로 — 단열 상태',
      '',
      '원인에 따라 대응이 달라서',
      '확인 후 안내드리겠습니다.',
      '연락처를 남겨주시겠어요?',
    ),
    // 누수·냉방약함·소음·기타 공통 — 증상만으로 원인을 단정하지 않는다
    as_general: L(
      '원인은 몇 가지로 나뉩니다.',
      '정확한 구분은 확인 후',
      '안내드리겠습니다.',
      '연락처를 남겨주시겠어요?',
    ),

    /* --- 트리3 설치 ---
       진입 멘트는 "말풍선 하나 = 메시지 하나" — 절차 안내와 질문을 분리한다.
       절차 자체는 홈페이지가 이미 설명했으므로 여기선 짧게, 질문은 별도 말풍선. */
    install_start: L('몇 가지만 확인하면', '방문 전에 견적이 나옵니다.'),
    install_type_q: '어떤 설치인가요?',
    install_space: '설치 공간이 어디인가요?',
    install_brand: '브랜드를 선택해 주세요.',
    // 위치 — 공간에 따라 아파트명 / 건물명으로 갈린다
    install_place_home: L('설치할 곳의 아파트명과 층수를', '적어주세요.'),
    install_place_shop: L('설치할 곳의 건물명과 층수를', '적어주세요.'),
    install_place_hint_home: '예: 바람아파트 101동 15층',
    install_place_hint_shop: '예: 바람빌딩 3층',
    install_live: L('지금 살고 계신 곳인가요,', '입주 예정인 곳인가요?'),
    install_say_movein: L(
      '신축·입주 예정 단지는',
      '공동구매를 진행합니다.',
      '접수 남겨주시면',
      '단지 일정에 맞춰 안내드립니다.',
    ),
    install_interior: L('인테리어 공사는', '어떻게 진행되나요?'),
    install_say_interior: L('인테리어 일정과 맞물리는 공정이라', '접수 때 현재 상황을 함께 알려주세요.'),
    install_end: L('방문 전에 견적을 확정해', '알려드리겠습니다.'),

    /* --- 트리4 기타 --- */
    etc: '원하시는 채널로 문의해 주세요.',
  };

  /** 지역 입력 — 시·구까지 자유 입력. 칩 2개(수도권/그 외)였을 때보다 접수 카드에 실지역이 남는다 */
  const regionInput = (next: string): Node['input'] => ({
    placeholder: '예: 성남시 분당구',
    key: '지역',
    next,
    type: 'text',
    max: 30,
    say: COPY.say_region,
  });

  const NODES: Record<string, Node> = {
    // 챗봇 홈 화면 — 런처 진입 첫 화면 (히어로 로우 등 트리 직진입은 이 화면을 건너뛴다)
    home: {
      text: SITE_CONFIG.WELCOME_MESSAGE,
      home: true,
    },

    /* 트리1 — 세척 */
    'clean.start': {
      text: COPY.clean_start,
      options: [
        { label: '벽걸이', next: 'clean.units', set: { 분류: '세척', 기종: '벽걸이' } },
        { label: '스탠드', next: 'clean.units', set: { 분류: '세척', 기종: '스탠드' } },
        { label: '천장형·시스템', next: 'clean.units', set: { 분류: '세척', 기종: '천장형·시스템' } },
        { label: '잘 모르겠어요', next: 'clean.unsure', set: { 분류: '세척' } },
      ],
    },
    // 기종을 모를 때 — 형태 하나만 되물어 기종을 확정한다 (모름 상태로 접수되면 견적이 안 나온다)
    'clean.unsure': {
      text: COPY.clean_unsure,
      options: [
        { label: '천장 매립형', next: 'clean.units', set: { 기종: '천장형·시스템' } },
        { label: '벽걸이·스탠드', next: 'clean.units', set: { 기종: '벽걸이·스탠드' } },
      ],
    },
    'clean.units': {
      text: COPY.ask_units,
      input: { placeholder: '예: 2', key: '대수', next: 'clean.region', type: 'number', suffix: '대' },
    },
    'clean.region': { text: COPY.ask_region, input: regionInput('clean.end') },
    'clean.end': {
      text: COPY.clean_end,
      card: true,
    },

    /* 트리2 — AS */
    'as.q1': {
      text: COPY.as_q1,
      options: [
        { label: '예', next: 'as.symptom', set: { 분류: 'AS' } },
        { label: '아니오 · 모르겠음', next: 'as.nonclient' },
      ],
    },
    'as.nonclient': {
      text: COPY.as_nonclient,
      options: [
        { label: '상담 연결', consult: true },
